diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1046,9 +1046,20 @@
 
 bool CWinSystemGbmGLESContext::DestroyWindowSystem()
 {
+  if (DVBRIDGE::DiagnosticsEnabled())
+    CLog::Log(LOGINFO, "DVBridge native shutdown: window destroy begin captured={} bridge_present={}",
+        m_dvState.Captured(), m_dvBridge != nullptr);
   if (!EndDVBridge())
+  {
+    if (DVBRIDGE::DiagnosticsEnabled())
+      CLog::Log(LOGWARNING, "DVBridge native shutdown: output restore failed; explicit bridge reset/base teardown skipped");
     return false;
+  }
+  if (DVBRIDGE::DiagnosticsEnabled())
+    CLog::Log(LOGINFO, "DVBridge native shutdown: output restore complete; explicit bridge reset begin");
   m_dvBridge.reset();
+  if (DVBRIDGE::DiagnosticsEnabled())
+    CLog::Log(LOGINFO, "DVBridge native shutdown: explicit bridge reset complete; base teardown begin");
   return CWinSystemGbmEGLContext::DestroyWindowSystem();
 }
 #endif

