+VADisplay CQsvMappedBuffer::Display() const
+{
+  if (!m_frame || !m_frame->hw_frames_ctx || !m_frame->hw_frames_ctx->data)
+    return nullptr;
+  const auto* frames = reinterpret_cast<const AVHWFramesContext*>(m_frame->hw_frames_ctx->data);
+  if (!frames->device_ctx || frames->device_ctx->type != AV_HWDEVICE_TYPE_VAAPI ||
+      !frames->device_ctx->hwctx)
+    return nullptr;
+  const auto display = static_cast<const AVVAAPIDeviceContext*>(frames->device_ctx->hwctx)->display;
+  // GetMapped admits only the decoder's shared VAAPI device. Its AVFrame keeps
+  // that device and display owner alive; a fresh window-proxy lookup does not.
+  return display && Valid(display) ? display : nullptr;
+}
