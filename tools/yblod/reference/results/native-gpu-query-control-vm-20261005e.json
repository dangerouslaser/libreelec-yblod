  "scope": "Complete prepared whole-code GPU arithmetic plus a timer-coverage experiment; no validated exclusive compute-performance, playback, display-accuracy or Dolby-conformance claim.",
  "timing_scope": "Instrumented full-frame warm totals include preparation, uploads, preload-completion fences, dispatch/barrier/completion waits, timer instrumentation/result retrieval and readback. File I/O, input/stage allocation, CPU oracle verification, cold setup and teardown excluded.",
  "unbracketed_device_timing_scope": "TIME_ELAPSED around dispatch/barrier, without cross-batch chronological fences. Tiny returned values are published as rejected timing evidence, not as shader execution cost.",
  "control_device_timing_scope": "TIME_ELAPSED start completion is host-fenced before compute submission; compute completion is host-fenced before query end, which is separately fenced before result retrieval. Includes CPU gaps, submission, synchronization and idle time; not pure kernel or exclusive GPU busy time.",
  "host_dispatch_timing_scope": "Host dispatch interval ends after completion fences, before query availability/result retrieval and readback. Synchronized control adds start/end fence waits to that host interval.",
  "verification_scope": "Complete CPU reference/cached stage agreement before GPU access; complete GPU/unchanged-C stage agreement before one warmup and three timed passes.",
  "timed_crosscheck_scope": "Final CPU-subchunk suffix of final GPU batch only.",
  "cold_setup_scope": "Fresh process/context; Mesa shader-cache state uncontrolled.",
  "comparison_policy": "Changed synchronization and non-interleaved cohorts prohibit a speed comparison or subtraction-based estimate of pure compute cost.",
  "limitations": [
    "Arithmetic and execution success remain valid, but do not validate compute timer coverage.",
    "All three raw measurements are published; no cherry-picked fastest result.",
