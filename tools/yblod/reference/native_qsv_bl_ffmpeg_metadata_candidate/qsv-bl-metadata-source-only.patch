+static int qsv_dovi_sync(QSVContext *q, mfxSyncPoint sync)
+{
+    int status;
+    for (int i = 0; i < 5; i++) {
+        status = MFXVideoCORE_SyncOperation(q->session, sync, 1000);
+        if (status != MFX_WRN_IN_EXECUTION)
+            return status == MFX_ERR_NONE ? 0 : AVERROR_EXTERNAL;
+    }
+    return AVERROR_EXTERNAL;
+}
+
+static int qsv_dovi_poison(QSVContext *q)
+{
+    q->dovi.failed = q->dovi_quarantined = 1;
+    atomic_store(&qsv_dovi_process_quarantined, 1);
+    return AVERROR_EXTERNAL;
+}
+
+static int qsv_dovi_retire_hardware(QSVContext *q)
+{
+    if (q->dovi_quarantined)
+        return AVERROR_EXTERNAL;
+    if (q->dovi_untracked_sync &&
+        qsv_dovi_sync(q, *q->dovi_untracked_sync) < 0)
+        return qsv_dovi_poison(q);
+    if (q->async_fifo) {
+        for (size_t i = 0; i < av_fifo_can_read(q->async_fifo); i++) {
+            QSVAsyncFrame aframe;
+            av_fifo_peek(q->async_fifo, &aframe, 1, i);
+            if (qsv_dovi_sync(q, *aframe.sync) < 0)
+                return qsv_dovi_poison(q);
+        }
+    }
+    if (q->session && (q->initialized || q->dovi_submitted) &&
+        MFXVideoDECODE_Close(q->session) != MFX_ERR_NONE)
+        return qsv_dovi_poison(q);
+    q->dovi_submitted = 0;
+    av_freep(&q->dovi_untracked_sync);
+    return 0;
+}
+
+static int qsv_dovi_reject_output(QSVContext *q, mfxSyncPoint **sync, int error)
+{
+    q->dovi.failed = 1;
