+/* SPDX-License-Identifier: MIT */
+/*
+ * big-fella: what the Dolby Vision tunnel's bytes are, the connector
+ * property DVBRIDGE_TUNNEL_FORMAT next to DVBRIDGE_DV_STANDARD_LAB (which
+ * still turns the tunnel on). The pipe and scanout are the tunnel's in every
+ * format (RGB 8 bpc, full range, an unprocessed XRGB8888 primary carrying
+ * 12-bit YCbCr 4:2:2 in HDMI's 4:2:2 lane layout); what changes is what the
+ * sink is told it is:
+ *
+ *   dolby-vision  TV-led Dolby Vision (as before): AVI RGB, no colorimetry,
+ *                 full range; the Dolby VSIF (or HDMI-1.4b's); no HDR
+ *                 metadata. A sink with Standard Dolby Vision.
+ *   hdr10         HDR10 the player made (dv-engine-vk's HDR10 output): AVI
+ *                 YCbCr 4:2:2, BT.2020, limited range; no vendor InfoFrame;
+ *                 the HDR static metadata InfoFrame from HDR_OUTPUT_METADATA,
+ *                 which must be there and PQ. A sink with YCbCr 4:2:2 and
+ *                 PQ in its EDID, Dolby Vision or not.
+ *   lldv          source-led ("low latency") Dolby Vision: AVI as hdr10;
+ *                 the Dolby VSIF with its low-latency bit; no HDR metadata.
+ *                 A sink whose Dolby block has the low-latency interface.
+ *
+ * The pixels are the player's business; these rules only make the link say
+ * what the player meant. Included by i915 (intel_hdmi.c) and amdgpu
+ * (amdgpu_dm_dv.c), as intel_dv_lab_policy.h is, so both apply the same.
+ */
+#ifndef __DVBRIDGE_TUNNEL_FORMAT_H__
+#define __DVBRIDGE_TUNNEL_FORMAT_H__
+
+#include <linux/errno.h>
+#include <linux/hdmi.h>
+#include <linux/kernel.h>
+#include <linux/types.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_property.h>
+
+#include "dvbridge_edid.h"
+
+enum dvbridge_tunnel_format {
+	DVBRIDGE_TUNNEL_DV = 0,
+	DVBRIDGE_TUNNEL_HDR10 = 1,
+	DVBRIDGE_TUNNEL_LLDV = 2,
+};
+
+static const struct drm_prop_enum_list dvbridge_tunnel_formats[] = {
+	{ DVBRIDGE_TUNNEL_DV, "dolby-vision" },
+	{ DVBRIDGE_TUNNEL_HDR10, "hdr10" },
+	{ DVBRIDGE_TUNNEL_LLDV, "lldv" },
+};
+
+static inline struct drm_property *dvbridge_tunnel_format_property(struct drm_device *dev)
+{
+	return drm_property_create_enum(dev, DRM_MODE_PROP_ATOMIC, "DVBRIDGE_TUNNEL_FORMAT",
+					dvbridge_tunnel_formats,
+					ARRAY_SIZE(dvbridge_tunnel_formats));
+}
+
+static inline const char *dvbridge_tunnel_format_name(unsigned int format)
+{
+	return format < ARRAY_SIZE(dvbridge_tunnel_formats) ?
+		dvbridge_tunnel_formats[format].name : "unknown";
+}
+
+/* The Dolby block's low-latency interface: any v2 block (interface 0/1 are
+ * low latency only, 2/3 standard and low latency), a short v1 block with
+ * its LL bit (dvbridge_parse_edid: not legacy_vsif).
+ */
+static inline bool dvbridge_sink_lldv(const struct dvbridge_sink_caps *caps)
+{
+	if (caps->status == DV_EDID_LLDV_ONLY)
+		return true;
+	return caps->status == DV_EDID_STANDARD &&
+		(caps->version == 2 || (caps->version == 1 && !caps->legacy_vsif));
+}
+
+/* Whether the sink takes this format: the Dolby block for dolby-vision and
+ * lldv; YCbCr 4:2:2 and PQ (its HDR static metadata block) for hdr10.
+ */
+static inline bool dvbridge_tunnel_sink(unsigned int format,
+					const struct dvbridge_sink_caps *caps,
+					const struct drm_connector *connector)
+{
+	switch (format) {
+	case DVBRIDGE_TUNNEL_DV:
+		return caps->status == DV_EDID_STANDARD;
+	case DVBRIDGE_TUNNEL_HDR10:
+		return (connector->display_info.color_formats &
+			BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422)) &&
+			(connector->display_info.hdr_sink_metadata.hdmi_type1.eotf &
+			 BIT(HDMI_EOTF_SMPTE_ST2084));
+	case DVBRIDGE_TUNNEL_LLDV:
+		return dvbridge_sink_lldv(caps);
+	}
+	return false;
+}
+
+/* HDR_OUTPUT_METADATA: required (static type 1, PQ) for hdr10, refused
+ * otherwise (the Dolby VSIF and an HDR InfoFrame don't go together).
+ */
+static inline int dvbridge_tunnel_hdr_metadata(unsigned int format,
+					       const struct drm_property_blob *blob)
+{
+	const struct hdr_output_metadata *hdr;
+
+	if (format != DVBRIDGE_TUNNEL_HDR10)
+		return blob ? -EINVAL : 0;
+	if (!blob || blob->length < sizeof(*hdr))
+		return -EINVAL;
+	hdr = blob->data;
+	return hdr->metadata_type == HDMI_STATIC_METADATA_TYPE1 &&
+		hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084 ? 0 : -EINVAL;
+}
+
+/* The AVI InfoFrame of hdr10 and lldv: YCbCr 4:2:2 (the tunnel's bytes are
+ * HDMI's 4:2:2 lanes), BT.2020, limited range. The VIC (the CTA one) and
+ * the content type are the caller's.
+ */
+static inline void dvbridge_tunnel_avi(struct hdmi_avi_infoframe *frame)
+{
+	frame->colorspace = HDMI_COLORSPACE_YUV422;
+	frame->colorimetry = HDMI_COLORIMETRY_EXTENDED;
+	frame->extended_colorimetry = HDMI_EXTENDED_COLORIMETRY_BT2020;
+	frame->quantization_range = HDMI_QUANTIZATION_RANGE_DEFAULT;
+	frame->ycc_quantization_range = HDMI_YCC_QUANTIZATION_RANGE_LIMITED;
+}
+
