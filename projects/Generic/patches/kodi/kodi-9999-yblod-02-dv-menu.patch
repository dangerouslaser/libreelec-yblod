+// Nonzero: pq_input is Kodi's GUI framebuffer (sRGB BT.709, bottom-up rows), drawn over black with
+// its white at graphics_peak (fraction of 10000 cd/m2), as the GUI composite does over video.
+uniform uint graphics;
+uniform float graphics_peak;
+// Menu look: saturation (1 = as authored), gamma (0 sRGB, 1 2.2, 2 2.4), wide colour (the GUI's
+// BT.709 values shown on BT.2020 primaries, like a TV's vivid colour mode).
+uniform float graphics_saturation;
+uniform uint graphics_gamma;
+uniform uint graphics_wide;
 out vec4 color;
 
 // IPT-PQ-c2, as Dolby Vision hardware sends in TV-led mode. The matrices are the exact inverses of
@@ -28,6 +37,24 @@ vec3 dv_ipt_codes(vec3 rgb, vec3 offset) {
     return clamp(floor(ipt * 4096.0 + offset + 0.5), 0.0, 4095.0);
