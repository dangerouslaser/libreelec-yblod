+// GUI white in the menu output (dvbridge.menubrightness). Read live, as the setting can change while
+// the menu is shown.
+inline float MenuWhiteNits()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int nits = settings ? settings->GetInt("dvbridge.menubrightness") : 400;
+  switch (nits)
+  {
+    case 203:
+    case 300:
+    case 500:
+    case 600:
+    case 800:
+      return static_cast<float>(nits);
+    default:
+      return 400.0f;
+  }
+}
+
+// Read live: the menu output follows the settings without a playback.
+inline bool MenuModeEnabled()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.menumode") &&
+         settings->GetInt("dvbridge.outputmode") == static_cast<int>(OutputMode::Standard);
+}
+
+// Menu look (Dolby Vision menu only), read live like the brightness.
+inline float MenuSaturation()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int percent = settings ? settings->GetInt("dvbridge.menusaturation") : 100;
+  return percent >= 50 && percent <= 200 ? percent / 100.0f : 1.0f;
+}
+
+inline unsigned MenuGamma()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int gamma = settings ? settings->GetInt("dvbridge.menugamma") : 0;
+  return gamma >= 0 && gamma <= 2 ? static_cast<unsigned>(gamma) : 0u;
+}
+
+inline bool MenuWideColour()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.menuwidecolour");
+}
