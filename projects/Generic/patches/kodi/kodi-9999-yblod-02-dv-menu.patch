+const mat3 BT2020_FROM_BT709 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);
+vec3 graphics_pq(vec4 gui) {
+    vec3 c = clamp(gui.rgb, 0.0, 1.0);
+    vec3 linear = graphics_gamma == 0u
+        ? mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c))
+        : pow(c, vec3(graphics_gamma == 1u ? 2.2 : 2.4));
+    float luma = dot(linear, vec3(0.2126, 0.7152, 0.0722));
+    linear = max(mix(vec3(luma), linear, graphics_saturation), 0.0);
+    vec3 rgb = graphics_wide != 0u ? linear : BT2020_FROM_BT709 * linear;
+    // Never above the white level the metadata signals.
+    return dv_pq_oetf(min(rgb, vec3(1.0)) * graphics_peak) * gui.a;
+}
+vec3 fetch_pq(ivec2 p) {
+    if (graphics == 0u)
+        return texelFetch(pq_input, p, 0).rgb;
+    return graphics_pq(texelFetch(pq_input, ivec2(p.x, 2159 - p.y), 0));
+}
