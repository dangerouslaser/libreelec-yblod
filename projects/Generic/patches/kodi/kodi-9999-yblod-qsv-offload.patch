+// IPT-PQ-c2, as Dolby Vision hardware sends in TV-led mode. The matrices are the exact inverses of
+// the ones signalled in the DM metadata (dvbridge_metadata.h), so the TV decodes what we encode.
+const mat3 DV_LMS_FROM_RGB = mat3(0.426426931, 0.164319977, 0.012036295, 0.529623456, 0.739572962, 0.050566765, 0.043891015, 0.096105842, 0.937395721);
+const mat3 DV_IPT_FROM_LMS = mat3(0.400030779, 4.455344041, 0.805668000, 0.399792671, -4.851464142, 0.357179480, 0.199932469, 0.396120100, -1.162847480);
+vec3 dv_pq_eotf(vec3 e) {
+    vec3 p = pow(clamp(e, 0.0, 1.0), vec3(1.0 / 78.84375));
+    return pow(max(p - 0.8359375, 0.0) / (18.8515625 - 18.6875 * p), vec3(1.0 / 0.1593017578125));
+}
+vec3 dv_pq_oetf(vec3 y) {
+    vec3 p = pow(max(y, 0.0), vec3(0.1593017578125));
+    return pow((0.8359375 + 18.8515625 * p) / (1.0 + 18.6875 * p), vec3(78.84375));
+}
+// 12-bit I, P, T code values (full range), with the optional hardware-matching offset.
+vec3 dv_ipt_codes(vec3 rgb, vec3 offset) {
+    vec3 ipt = DV_IPT_FROM_LMS * dv_pq_oetf(DV_LMS_FROM_RGB * dv_pq_eotf(rgb)) + vec3(0.0, 0.5, 0.5);
+    return clamp(floor(ipt * 4096.0 + offset + 0.5), 0.0, 4095.0);
+}
