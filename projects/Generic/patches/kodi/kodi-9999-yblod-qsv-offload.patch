+++ b/tools/dvbridge/dvbridge_vpp.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Dolby Vision scaling on the Intel media engine (VA-API video processing, "Quick Sync"). */
+#ifndef DVBRIDGE_VPP_H
+#define DVBRIDGE_VPP_H
+#include "dvbridge_dmabuf.h"
+#include <stdbool.h>
+
+struct dvbridge_vpp;
+
+enum dvbridge_vpp_role {
+    DVBRIDGE_VPP_BASE,        /* base layer: 4:2:0 -> 4:4:4 at the same size */
+    DVBRIDGE_VPP_ENHANCEMENT, /* enhancement layer: upscale to the base layer size */
+};
+
+/* Every call, including destruction, requires the renderer's current EGL/GLES context. */
+struct dvbridge_vpp *dvbridge_vpp_create(void);
+void dvbridge_vpp_destroy(struct dvbridge_vpp **vpp);
+/* Free all media-engine and GL resources (e.g. between playbacks). The object stays usable. */
+void dvbridge_vpp_release(struct dvbridge_vpp *vpp);
+
+/* Process one decoded VAAPI P010 surface (owned by any VADisplay on the same GPU) into a packed
+ * 4:4:4 Y416 texture of out_width x out_height. With rotate180 the output is rotated by 180 degrees,
+ * which makes the driver use its full scaler (proper chroma filtering) even at 1:1; the renderer then
+ * rotates the composed picture back. On success, returns NULL and *out holds one DVBRIDGE_Y416
+ * texture owned by vpp, valid until the next call for the same role. On failure, returns a short
+ * reason and leaves *out untouched. */
+const char *dvbridge_vpp_process(struct dvbridge_vpp *vpp, enum dvbridge_vpp_role role,
+                                 void *source_display, unsigned source_surface,
+                                 int source_width, int source_height,
+                                 int out_width, int out_height, bool rotate180,
+                                 struct dvbridge_dmabuf *out);
+#endif
