+void CDVPrivateSource::QueuePendingPack()
+{
+  const char* enabled = std::getenv("DV_PRIVATE_ASYNC_PACK");
+  if (!enabled || std::strcmp(enabled, "1") != 0 || !m_pending || m_packPending ||
+      !m_scanout || !m_packBegin || !m_packComplete ||
+      eglGetCurrentContext() == EGL_NO_CONTEXT)
+    return;
+  const auto started = std::chrono::steady_clock::now();
+  glFinish();
+  if (!m_scanout->Begin(m_pendingId, m_pendingPts)) return;
+  m_packPending = true;
+  int result = m_selectOutput(m_engine, m_scanout->Slot());
+  if (result == 0)
+    result = m_packBegin(m_engine, m_pendingId, m_pendingPts, m_scanout->Packet(),
+                        m_scanout->Refresh(), 0, 0, nullptr, 0);
+  m_packSubmitMs = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - started).count();
+  if (m_processed < 480)
+    CLog::Log(LOGINFO, "Private source async pack: pts={} status={} enqueue_ms={}",
+              m_pendingPts, result, m_packSubmitMs);
+  if (result != 0) CancelPending();
+}
 void CDVPrivateSource::Reset()
 {
   if (!CancelPending()) m_unsafe = true;
