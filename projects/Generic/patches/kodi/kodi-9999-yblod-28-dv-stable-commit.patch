diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.cpp b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
--- a/xbmc/windowing/gbm/drm/DRMAtomic.cpp
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.cpp
@@ -364,10 +364,17 @@
     FinishRequest(false);
     return false;
   }
-  const int flags = DRM_MODE_ATOMIC_ALLOW_MODESET;
+  // A stable DV scanout keeps the mode it was accepted with: commit only the
+  // new framebuffer and the unchanged transport properties. Entering DV, a
+  // pending modeset, a restore and the frame after a rejected commit still
+  // validate the full state. (Allowing a modeset on every frame made amdgpu
+  // DCN 1.0 latch each flip a refresh late: half the frame rate on screen.)
+  const bool stable = m_dvScanoutStable && !restore && !m_need_modeset;
+  const int flags = stable ? 0 : DRM_MODE_ATOMIC_ALLOW_MODESET;
   const bool accepted = DrmAtomicCommit(fb, flags, true, false, true);
   if (accepted)
     m_need_modeset = false;
+  m_dvScanoutStable = accepted && !restore;
   return accepted;
 }
 
@@ -396,6 +403,8 @@
     CLog::LogF(LOGDEBUG, "Execute modeset at next commit");
   }
 
+  // A regular page between DV pages: the next DV page validates the full state.
+  m_dvScanoutStable = false;
   DrmAtomicCommit(!drm_fb ? 0 : drm_fb->fb_id, flags, rendered, videoLayer);
 }
 
diff --git a/xbmc/windowing/gbm/drm/DRMAtomic.h b/xbmc/windowing/gbm/drm/DRMAtomic.h
--- a/xbmc/windowing/gbm/drm/DRMAtomic.h
+++ b/xbmc/windowing/gbm/drm/DRMAtomic.h
@@ -67,6 +67,7 @@
   uint32_t m_dvSnapshotConnector{0};
 
   bool m_need_modeset{true};
+  bool m_dvScanoutStable{false};
   bool m_active = true;
   bool m_propertyFailure = false;
 
