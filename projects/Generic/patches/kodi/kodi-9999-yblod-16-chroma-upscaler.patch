     params.min_fbo_precision = 32;
     // Plane upsampling (base layer chroma; the enhancement layer when it is not scaled on the media
     // engine). Of libplacebo's filters, Gaussian came closest to Dolby hardware output on every
-    // matched frame; the enhancement-layer filter made no measurable difference.
-    params.plane_upscaler = &pl_filter_gaussian;
+    // matched frame; the enhancement-layer filter made no measurable difference. Lanczos is the
+    // optional sharper choice (dvbridge.chromaupscaler).
+    params.plane_upscaler = r->chroma_upscaler == DVBRIDGE_CHROMA_LANCZOS ? &pl_filter_lanczos
+                                                                          : &pl_filter_gaussian;
     params.peak_detect_params = NULL;
     params.dither_params = NULL;
     params.frame_mixer = NULL;
@@ -453,3 +456,10 @@
     if (r)
         memcpy(r->ipt_offset, offset, sizeof(r->ipt_offset));
 }
+
+void dvbridge_renderer_set_chroma_upscaler(struct dvbridge_renderer *r,
+                                           enum dvbridge_chroma_upscaler upscaler)
+{
+    if (r)
+        r->chroma_upscaler = upscaler == DVBRIDGE_CHROMA_LANCZOS ? upscaler : DVBRIDGE_CHROMA_GAUSSIAN;
+}
