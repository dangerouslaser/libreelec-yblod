--- a/tools/dvbridge/dvbridge_render.h
+++ b/tools/dvbridge/dvbridge_render.h
@@ -20,0 +21,12 @@
+/* Experimental colour-only handoff. paired_source retains the original BL/EL
+ * association for metadata/packets. reconstructed is borrowed RGBA32F, full
+ * source size, unrotated Y/Cb/Cr reconstructed12-bit codes divided by4096,
+ * alpha1 (caller invariant, not scanned by this entry point). Rotated sources
+ * are rejected; alpha is explicitly independent, not inherited from source.
+ * Caller owns colour-plane expansion, exactness, synchronization and lifetime.
+ * This bypasses reshaping/NLQ, NOT inherited colour conversion or output packing.
+ * No default caller is switched to this API. Commit only after presentation. */
+bool dvbridge_render_reconstructed_rgb(struct dvbridge_renderer *renderer,
+                        const struct pl_frame *paired_source, pl_tex reconstructed,
+                        const void *metadata, size_t bytes, double pts, double el_pts,
+                        struct dvbridge_geometry geometry);
