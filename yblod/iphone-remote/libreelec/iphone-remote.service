[Unit]
Description=iPhone remote (the box in the iPhone's Control Center remote)
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/storage/.cache/services/iphone-remote.disabled

[Service]
# Ready once its sockets are bound and it's announced (sd_notify).
Type=notify
ExecStart=/usr/lib/iphone-remote/iphone-remote-start
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
