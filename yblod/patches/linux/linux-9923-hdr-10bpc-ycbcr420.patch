From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 12:00:00 +0000
Subject: [PATCH] drm/amd/display, drm/i915/hdmi: HDR at 4K50/60 as 10 bpc
 YCbCr 4:2:0

big-fella: HDR at 4K50/60 as 10 bpc YCbCr 4:2:0 (amdgpu and i915).

At 3840x2160 50/60 Hz (594 MHz) 10 bpc RGB doesn't fit HDMI 2.0, so both
drivers fall back to 8 bpc RGB, and an LG B4 then ignores the HDR10 metadata
(hdrType none; HDR10 at 4K30 or with 4:2:0). kwin-big-fella did this in the
compositor until now (kwin-big-fella-hdr-ycbcr420.patch: "color format"
YUV 4:2:0 when HDR was on above 480 MHz), which only amdgpu has; i915 has no
"color format" property, so the N150 sent 8 bpc RGB.

The rule now lives where the link budget is known. With PQ or HLG
HDR_OUTPUT_METADATA, max bpc >= 10 and not the Dolby Vision tunnel (RGB, 8
bpc) or reconstructed HDR10 (i915's own rule):
- amdgpu: with "color format" AUTO, amdgpu_dm_create_validate_stream_for_sink
  first tries RGB and then YCbCr 4:2:0 at 10 bpc and up (where the mode allows
  4:2:0), then the usual order. Leaving or entering HDR with metadata on both
  sides (an SDR blob to a PQ one) is a modeset, so the encoding follows.
- i915: intel_hdmi_compute_formats tries YCbCr 4:2:0 again when RGB came out
  below 10 bpc, and keeps it only if it gets 10 bpc.
SDR is unchanged (RGB at 4K60), and so is 4K24/25/30 HDR (10 bpc RGB fits).
amdgpu.hdr_yuv420=0 / i915.hdr_yuv420=0: the old choice.

Tested on ryzen-fella (amdgpu, DCN 1.0) and the N150 (i915), both on an LG
B4, with kwin-big-fella without hdr-ycbcr420.patch: HDR on at 2160p60 and
2160p50 is 10 bpc YCbCr 4:2:0 (amdgpu BT2020_YCC at 10 bpc; i915 30 bpp at a
371.25 MHz port clock), SDR there 8 bpc RGB, HDR at 2160p30 10 bpc RGB, and
the Dolby Vision tunnel over an HDR desktop 8 bpc RGB at 2160p60 and
2160p23.976.

Regrouped from linux-9923-big-fella-hdr-yuv420 (YBLOD 0.3.3 to 0.4.1);
no code change.
---
 .../display/amdgpu_dm/amdgpu_dm_connector.c   | 61 ++++++++++++++++++-
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 52 ++++++++++++++++
 2 files changed, 110 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
index 3d33f6d96a3f..97eb9c20eccb 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm_connector.c
@@ -2242,6 +2242,38 @@ cleanup:
 }
 EXPORT_IF_KUNIT(dm_validate_stream_and_context);
 
+/*
+ * big-fella: HDR over HDMI at 4K50/60. RGB at 10 bpc doesn't fit HDMI 2.0's
+ * 600 MHz there, so AUTO settles on 8 bpc RGB, and an LG B4 ignores HDR10
+ * metadata on 8 bpc RGB (hdrType none). With "color format" AUTO and a PQ or
+ * HLG HDR_OUTPUT_METADATA (and not the Dolby Vision tunnel, which is RGB),
+ * AUTO tries 10 bpc and up in RGB and then in YCbCr 4:2:0 (where the mode
+ * allows 4:2:0) before the usual order. Until linux-yblod 7.3-7 KWin set the
+ * color format itself (kwin-big-fella-hdr-ycbcr420.patch, kwinrc
+ * HdrColorFormat); amdgpu.hdr_yuv420=0 is the old driver choice.
+ */
+static bool hdr_yuv420 = true;
+module_param(hdr_yuv420, bool, 0644);
+MODULE_PARM_DESC(hdr_yuv420,
+	"HDR (PQ/HLG metadata) with color format AUTO: 10 bpc YCbCr 4:2:0 where "
+	"10 bpc RGB doesn't fit, rather than 8 bpc RGB (big-fella; default true)");
+
+static bool dm_hdr_wants_deep_color(const struct drm_connector_state *state)
+{
+	const struct hdr_output_metadata *hdr;
+
+	if (!hdr_yuv420 || !state || state->color_format != DRM_CONNECTOR_COLOR_FORMAT_AUTO ||
+	    to_dm_connector_state(state)->dv_lab_standard || state->max_requested_bpc < 10 ||
+	    !state->hdr_output_metadata ||
+	    state->hdr_output_metadata->length < sizeof(*hdr))
+		return false;
+
+	hdr = state->hdr_output_metadata->data;
+	return hdr->metadata_type == HDMI_STATIC_METADATA_TYPE1 &&
+	       (hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084 ||
+		hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_BT_2100_HLG);
+}
+
 static enum dc_status
 dm_validate_stream_color_format(const struct drm_connector_state *drm_state,
 				const struct dc_stream_state *stream)
@@ -2305,7 +2337,8 @@ amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 	u32 encoding_mask = 0;
 	u32 bpc_mask = 0;
 	bool is_hdmi_ep = false;
-	unsigned int i, j;
+	bool hdr_deep = false;
+	unsigned int i, j, pass;
 
 	if (!dm_state)
 		return NULL;
@@ -2418,6 +2451,11 @@ amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 		bpc_mask |= BIT(bpc);
 	}
 
+	/* big-fella: see hdr_yuv420; an extra first pass, RGB and YCbCr 4:2:0 at 10 bpc and up */
+	hdr_deep = is_hdmi_ep && dm_hdr_wants_deep_color(drm_state) &&
+		   (encoding_mask & BIT(PIXEL_ENCODING_YCBCR420)) &&
+		   (bpc_mask & (BIT(10) | BIT(12) | BIT(16)));
+
 	/*
 	 * Enumerate the supported (encoding, bpc) combinations in priority
 	 * order and return the first that validates. Because the masks only
@@ -2430,17 +2468,22 @@ amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 	 * probe worker (->mode_valid) and from a compositor's atomic check on
 	 * the same connector.
 	 */
+	for (pass = hdr_deep ? 0 : 1; pass < 2; pass++)
 	for (i = 0; i < ARRAY_SIZE(encoding_order); i++) {
 		enum dc_pixel_encoding enc = encoding_order[i];
 
 		if (!(encoding_mask & BIT(enc)))
 			continue;
+		if (pass == 0 && enc != PIXEL_ENCODING_RGB && enc != PIXEL_ENCODING_YCBCR420)
+			continue;
 
 		for (j = 0; j < ARRAY_SIZE(bpc_order); j++) {
 			u8 bpc = bpc_order[j];
 
 			if (!(bpc_mask & BIT(bpc)))
 				continue;
+			if (pass == 0 && bpc < 10)
+				continue;
 
 			drm_dbg_kms(connector->dev,
 				    "Trying %s with %d bpc (encoding_mask=0x%x bpc_mask=0x%x requested_bpc=%d drm max_bpc)\n",
@@ -2467,8 +2510,17 @@ amdgpu_dm_create_validate_stream_for_sink(struct drm_connector *connector,
 			if (dc_result == DC_OK)
 				dc_result = dm_validate_stream_color_format(drm_state, stream);
 
-			if (dc_result == DC_OK)
+			/* big-fella: the HDR pass wants what it asked for, not a capped depth */
+			if (dc_result == DC_OK && pass == 0 &&
+			    stream->timing.display_color_depth < COLOR_DEPTH_101010)
+				dc_result = DC_UNSUPPORTED_VALUE;
+
+			if (dc_result == DC_OK) {
+				if (pass == 0)
+					drm_dbg_kms(connector->dev, "HDR: %s at %d bpc (hdr_yuv420)\n",
+						    dc_pixel_encoding_to_str(enc), bpc);
 				return stream;
+			}
 
 			drm_dbg_kms(connector->dev, "Pruned mode %d x %d (refresh rate %d) %s %s -- %s\n",
 				      drm_mode->hdisplay,
@@ -2700,7 +2752,10 @@ amdgpu_dm_connector_atomic_check(struct drm_connector *conn,
 		 */
 		new_crtc_state->mode_changed = new_crtc_state->mode_changed ||
 			!old_con_state->hdr_output_metadata ||
-			!new_con_state->hdr_output_metadata;
+			!new_con_state->hdr_output_metadata ||
+			/* big-fella: SDR <-> PQ/HLG metadata can change the pixel encoding */
+			dm_hdr_wants_deep_color(old_con_state) !=
+			dm_hdr_wants_deep_color(new_con_state);
 	}
 
 	return 0;
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index e86209bf4cad..8c4a01fe06d0 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2418,6 +2418,37 @@ static bool intel_dvbridge_hdr_deep_requested(struct intel_display *display,
 		hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084;
 }
 
+/*
+ * big-fella: HDR at 4K50/60. 10 bpc RGB doesn't fit HDMI 2.0 there, so the
+ * pipe drops to 8 bpc RGB, and an LG B4 ignores HDR10 metadata on 8 bpc RGB.
+ * With PQ/HLG HDR_OUTPUT_METADATA and max bpc >= 10 (not the Dolby Vision
+ * tunnel, which is RGB, nor reconstructed HDR10, which has its own rule
+ * below), an RGB link below 10 bpc is tried again as YCbCr 4:2:0, kept if
+ * that gets 10 bpc. amdgpu does the same (amdgpu.hdr_yuv420); until
+ * linux-yblod 7.3-7 KWin asked for it (kwin-big-fella-hdr-ycbcr420.patch).
+ */
+static bool hdr_yuv420 = true;
+module_param(hdr_yuv420, bool, 0644);
+MODULE_PARM_DESC(hdr_yuv420,
+	"HDR (PQ/HLG metadata): 10 bpc YCbCr 4:2:0 where 10 bpc RGB doesn't "
+	"fit, rather than 8 bpc RGB (big-fella; default true)");
+
+static bool intel_hdmi_hdr_wants_deep_color(const struct drm_connector_state *state)
+{
+	const struct intel_digital_connector_state *intel_state =
+		to_intel_digital_connector_state(state);
+	const struct hdr_output_metadata *hdr;
+
+	if (!hdr_yuv420 || intel_state->dv_lab_standard || intel_state->dv_hdr10_deep_color ||
+	    state->max_requested_bpc < 10 || !state->hdr_output_metadata ||
+	    state->hdr_output_metadata->length < sizeof(*hdr))
+		return false;
+	hdr = state->hdr_output_metadata->data;
+	return hdr->metadata_type == HDMI_STATIC_METADATA_TYPE1 &&
+	       (hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_SMPTE_ST2084 ||
+		hdr->hdmi_metadata_type1.eotf == HDMI_EOTF_BT_2100_HLG);
+}
+
 static int intel_hdmi_compute_formats(struct intel_encoder *encoder,
 				      struct intel_crtc_state *crtc_state,
 				      const struct drm_connector_state *conn_state,
@@ -2464,6 +2495,27 @@ static int intel_hdmi_compute_formats(struct intel_encoder *encoder,
 				return ret ? ret : -EINVAL;
 		}
 
+		if (!ret && respect_downstream_limits &&
+		    crtc_state->sink_format == INTEL_OUTPUT_FORMAT_RGB &&
+		    crtc_state->pipe_bpp < 30 && requested_bpp >= 30 &&
+		    connector->base.ycbcr_420_allowed &&
+		    drm_mode_is_420_also(info, adjusted_mode) &&
+		    intel_hdmi_hdr_wants_deep_color(conn_state)) {
+			crtc_state->pipe_bpp = requested_bpp;
+			ret = intel_hdmi_compute_output_format(encoder, crtc_state, connector,
+							       true, INTEL_OUTPUT_FORMAT_YCBCR420);
+			if (ret || crtc_state->pipe_bpp < 30) {
+				/* no 10 bpc in 4:2:0 either: RGB as before */
+				crtc_state->pipe_bpp = requested_bpp;
+				ret = intel_hdmi_compute_output_format(encoder, crtc_state, connector,
+								       true, INTEL_OUTPUT_FORMAT_RGB);
+			} else {
+				drm_dbg_kms(display->drm,
+					    "HDR: YCbCr 4:2:0 at %d bpc, RGB fits only 8 (hdr_yuv420)\n",
+					    crtc_state->pipe_bpp / 3);
+			}
+		}
+
 		if (ret && drm_mode_is_420_also(info, adjusted_mode))
 			ret = intel_hdmi_compute_output_format(encoder, crtc_state, connector,
 							       respect_downstream_limits,
