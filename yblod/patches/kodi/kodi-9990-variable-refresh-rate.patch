+namespace
+{
+bool IsProgressive2D(const drmModeModeInfo& mode)
+{
+  return !(mode.flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN | DRM_MODE_FLAG_DBLCLK |
+                         DRM_MODE_FLAG_3D_MASK));
+}
+
+double ProgressiveRate(const drmModeModeInfo& mode)
+{
+  return mode.clock * 1000.0 / (static_cast<double>(mode.htotal) * mode.vtotal);
+}
+
+//! Whether the modes only differ in their vertical front porch.
+bool SameTimingButFrontPorch(const drmModeModeInfo& a, const drmModeModeInfo& b)
+{
+  return a.clock == b.clock && a.hdisplay == b.hdisplay && a.hsync_start == b.hsync_start &&
+         a.hsync_end == b.hsync_end && a.htotal == b.htotal && a.hskew == b.hskew &&
+         a.vdisplay == b.vdisplay && a.vsync_end - a.vsync_start == b.vsync_end - b.vsync_start &&
+         a.vtotal - a.vsync_end == b.vtotal - b.vsync_end && a.vscan == b.vscan &&
+         a.flags == b.flags;
+}
+} // namespace
+
+//! With variable refresh rate, the driver switches between the modes of a size that only
+//! differ in their vertical front porch without a modeset.
+bool CDRMUtils::UseVrr() const
+{
+  if (!m_vrrCapable)
+    return false;
+
+  const auto settingsComponent = CServiceBroker::GetSettingsComponent();
+  const auto settings = settingsComponent ? settingsComponent->GetSettings() : nullptr;
+  return !settings || settings->GetBool(CWinSystemBase::SETTING_WINSYSTEM_VRR);
+}
+
+bool CDRMUtils::IsVrrMode(const drmModeModeInfo& mode) const
+{
+  if (!UseVrr() || !IsProgressive2D(mode))
+    return false;
+
+  for (int i = 0; i < m_connector->GetModesCount(); i++)
+  {
+    const drmModeModeInfo* other = m_connector->GetModeForIndex(i);
+    if (other->vtotal != mode.vtotal && SameTimingButFrontPorch(*other, mode))
+      return true;
+  }
+
+  return false;
+}
+
+//! An ordinary mode that a VRR mode of the same size and refresh rate (within the
+//! tolerance of the refresh rate matching) stands in for.
+bool CDRMUtils::IsReplacedByVrrMode(const drmModeModeInfo& mode) const
+{
+  if (!UseVrr() || !IsProgressive2D(mode) || !mode.htotal || !mode.vtotal || IsVrrMode(mode))
+    return false;
+
+  const double rate = ProgressiveRate(mode);
+  for (int i = 0; i < m_connector->GetModesCount(); i++)
+  {
+    const drmModeModeInfo* other = m_connector->GetModeForIndex(i);
+    if (other->hdisplay == mode.hdisplay && other->vdisplay == mode.vdisplay &&
+        std::abs(ProgressiveRate(*other) - rate) < 0.01 && IsVrrMode(*other))
+      return true;
+  }
+
+  return false;
+}
