// The output colour mapping's 3D LUT (include/dvvk_map.h): run only when the
// mapping's parameters change (a scene's L1).
// PASS 0: the function at the N^3 points of the nonlinear source cube (its
//   output codes, unrounded, / 4096; SDR: / 256), as RGBA16 UNORM texels into `nodes` (copied into the sampled 3D image after).
// PASS 1: per cell, whether trilinear interpolation of its corners misses the
//   exact function by more than `thresh` output codes at the cell's centre or
//   a face's centre (a kink inside: a clamp, the tone curve's ends, the hull's
//   branch): a bit in `cells`.
// PASS 2: alpha 0 in the nodes of every marked cell (1 elsewhere): the pack's
//   sample of a marked cell has alpha 0 (all its corners are), of a cell
//   beside one less than 1, so `alpha < 0.5` marks every marked cell's
//   samples (and some of their neighbours'), and those pairs are computed
//   exactly (map_fixup.comp), with no lookup of the cells per sample.
// SDR output (MAP_SDR): the nodes hold R'G'B' codes / 256, `thresh` is in
// those codes, and PASS 1 also looks at the cell's 12 edge centres: the map
// has more kinks there (a channel reaching the display's black or white, the
// gamut LUT's own cells) and they pass between the 7 points more often.
// Its LUT lies over a box of the reconstructed codes (map_sdr_box), lut_ny
// points along luma and `n` along each chroma; the cells of the box's faces
// are marked whatever they hold, for the samples outside it. The pack takes
// a sample as marked where its alpha is exactly 0: every node of its cell
// belongs to a marked cell (the marked cells, and an unmarked one enclosed by
// them).
#version 460
#define MAP_PARAMS_BINDING 0
#define MAP_TABLES_BINDING 3
#define MAP_GAMUT_BINDING 4
#define MAP_SDR_ID 1
#include "dv_map.glsl"
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(constant_id = 0) const uint PASS = 0;
layout(binding = 1, std430) buffer Nodes { uvec2 nodes[]; };
layout(binding = 2, std430) buffer Cells { uint cells[]; };
layout(push_constant) uniform Push { uint n; float thresh; };

uvec2 pack16(vec3 v)
{
    uvec3 q = uvec3(clamp(v, 0.0, 1.0) * 65535.0 + 0.5);
    return uvec2(q.x | q.y << 16, q.z | 0xffff0000u);
}

vec3 unpack16(uvec2 t)
{
    return vec3(float(t.x & 0xffffu), float(t.x >> 16), float(t.y & 0xffffu)) * (1.0 / 65535.0);
}

vec3 node(uvec3 p) { return unpack16(nodes[(p.z * n + p.y) * n + p.x]); }

vec3 codes(vec3 rgb) { return map_out_codes(rgb); }

const vec3 sdr_pts[19] = vec3[19](vec3(.5, .5, .5), vec3(0, .5, .5), vec3(1, .5, .5), vec3(.5, 0, .5),
                                  vec3(.5, 1, .5), vec3(.5, .5, 0), vec3(.5, .5, 1), vec3(.5, 0, 0), vec3(.5, 1, 0),
                                  vec3(.5, 0, 1), vec3(.5, 1, 1), vec3(0, .5, 0), vec3(1, .5, 0), vec3(0, .5, 1),
                                  vec3(1, .5, 1), vec3(0, 0, .5), vec3(1, 0, .5), vec3(0, 1, .5), vec3(1, 1, .5));

void sdr_bake()
{
    uvec3 g = gl_GlobalInvocationID, size = map_sdr_size(), m = size - 1u;
    if (PASS == 0u) {
        if (any(greaterThanEqual(g, size)))
            return;
        vec3 rgb;
        map_rgb(map_nonlinear(map_sdr_box(vec3(g) / vec3(m))), rgb);
        nodes[(g.z * size.y + g.y) * size.x + g.x] = pack16(codes(rgb) * (1.0 / map_node_scale()));
        return;
    }
    if (PASS == 2u) {
        if (any(greaterThanEqual(g, size)))
            return;
        bool touched = false;
        for (uint k = 0u; k < 8u; k++) {
            uvec3 c = g - uvec3(k & 1u, (k >> 1) & 1u, k >> 2);   // wraps below 0: out of range
            if (all(lessThan(c, m))) {
                uint i = (c.z * m.y + c.y) * m.x + c.x;
                touched = touched || ((cells[i >> 5] >> (i & 31u)) & 1u) != 0u;
            }
        }
        if (touched)
            nodes[(g.z * size.y + g.y) * size.x + g.x].y &= 0xffffu;
        return;
    }
    if (any(greaterThanEqual(g, m)))
        return;
    bool face = (g.x == m.x - 1u && mp.lut_box.x < 4095.0) || g.y == 0u || g.y == m.y - 1u || g.z == 0u || g.z == m.z - 1u;
    float err = face ? 2.0 * thresh + 1.0 : 0.0;
    vec3 c[8];
    for (uint k = 0u; k < 8u && !face; k++) {
        uvec3 p = g + uvec3(k & 1u, (k >> 1) & 1u, k >> 2);
        c[k] = unpack16(nodes[(p.z * size.y + p.y) * size.x + p.x]) * map_node_scale();
    }
    for (uint q = 0u; q < 19u && err <= thresh; q++) {
        vec3 f = sdr_pts[q], exact;
        map_rgb(map_nonlinear(map_sdr_box((vec3(g) + f) / vec3(m))), exact);
        vec3 x00 = mix(c[0], c[1], f.x), x10 = mix(c[2], c[3], f.x), x01 = mix(c[4], c[5], f.x),
             x11 = mix(c[6], c[7], f.x);
        vec3 lerp = mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
        vec3 d = abs(codes(exact) - lerp);
        err = max(err, max(d.x, max(d.y, d.z)));
    }
    if (err > thresh) {
        uint i = (g.z * m.y + g.y) * m.x + g.x;
        atomicOr(cells[i >> 5], 1u << (i & 31u));
    }
}

void main()
{
    if (MAP_SDR != 0u) {
        sdr_bake();
        return;
    }
    uvec3 g = gl_GlobalInvocationID;
    if (PASS == 0u) {
        if (any(greaterThanEqual(g, uvec3(n))))
            return;
        vec3 rgb;
        map_rgb(vec3(g) / float(n - 1u), rgb);
        nodes[(g.z * n + g.y) * n + g.x] = pack16(codes(rgb) * (1.0 / map_node_scale()));
        return;
    }
    uint m = n - 1u;
    if (PASS == 2u) {
        if (any(greaterThanEqual(g, uvec3(n))))
            return;
        bool touched = false;
        for (uint k = 0u; k < 8u; k++) {
            uvec3 c = g - uvec3(k & 1u, (k >> 1) & 1u, k >> 2);   // wraps below 0: out of range
            if (all(lessThan(c, uvec3(m)))) {
                uint i = (c.z * m + c.y) * m + c.x;
                touched = touched || ((cells[i >> 5] >> (i & 31u)) & 1u) != 0u;
            }
        }
        if (touched)
            nodes[(g.z * n + g.y) * n + g.x].y &= 0xffffu;
        return;
    }
    if (any(greaterThanEqual(g, uvec3(m))))
        return;
    vec3 c[8];
    for (uint k = 0u; k < 8u; k++)
        c[k] = node(g + uvec3(k & 1u, (k >> 1) & 1u, k >> 2)) * map_node_scale();
    const vec3 pts[19] = vec3[19](vec3(.5, .5, .5), vec3(0, .5, .5), vec3(1, .5, .5), vec3(.5, 0, .5),
                                  vec3(.5, 1, .5), vec3(.5, .5, 0), vec3(.5, .5, 1), vec3(.5, 0, 0), vec3(.5, 1, 0),
                                  vec3(.5, 0, 1), vec3(.5, 1, 1), vec3(0, .5, 0), vec3(1, .5, 0), vec3(0, .5, 1),
                                  vec3(1, .5, 1), vec3(0, 0, .5), vec3(1, 0, .5), vec3(0, 1, .5), vec3(1, 1, .5));
    const uint points = MAP_SDR != 0u ? 19u : 7u;
    float err = 0.0;
    for (uint q = 0u; q < points && err <= thresh; q++) {
        vec3 f = pts[q], exact;
        map_rgb((vec3(g) + f) / float(m), exact);
        vec3 x00 = mix(c[0], c[1], f.x), x10 = mix(c[2], c[3], f.x), x01 = mix(c[4], c[5], f.x),
             x11 = mix(c[6], c[7], f.x);
        vec3 lerp = mix(mix(x00, x10, f.y), mix(x01, x11, f.y), f.z);
        vec3 d = abs(codes(exact) - lerp);
        err = max(err, max(d.x, max(d.y, d.z)));
    }
    if (err > thresh) {
        uint i = (g.z * m + g.y) * m + g.x;
        atomicOr(cells[i >> 5], 1u << (i & 31u));
    }
}
