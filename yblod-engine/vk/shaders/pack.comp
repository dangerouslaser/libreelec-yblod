// source_tunnel (source_tunnel.cl), movie only, as dv_source_renderer.c builds
// it: SOURCE_PACK_PAIR, SOURCE_PLACED, and SOURCE_SITED (4:2:0 planes),
// SOURCE_422 (full-height chroma) or SOURCE_SITED+SCALED+RESIZE_MAPS. The
// output is the linear XRGB8888 scanout buffer itself (BGRA bytes).
#version 460
#include "dv_common.glsl"
layout(local_size_x = 32, local_size_y_id = 6) in;   // y: 2, or 8 with ANNEXB
layout(constant_id = 0) const uint PACK = 0;     // 0 sited, 1 422, 2 resized
layout(constant_id = 1) const uint FMA = 1;      // resize lerps: 1 fused as IGC contracts them (OpenCL FP_CONTRACT ON), 0 separate
layout(binding = 0, std430) readonly buffer InY { uint16_t yplane[]; };
layout(binding = 0, std430) readonly buffer InY64 { uvec2 yplane4[]; };   // perf: 4 samples per load
layout(binding = 1, std430) readonly buffer InU32 { uint cb2[]; };
layout(binding = 2, std430) readonly buffer InV32 { uint cr2[]; };
bool pre_ok = false;
uint pre_y[4];
layout(binding = 1, std430) readonly buffer InU { uint16_t cb[]; };
layout(binding = 2, std430) readonly buffer InV { uint16_t cr[]; };
layout(binding = 3, std430) readonly buffer Packets { uint packet_words[]; };  // 640 bytes
layout(binding = 4, std430) writeonly buffer Out { uvec4 pixels4[]; };   // stride_words % 4 == 0
layout(binding = 5, std430) readonly buffer YMap { uvec4 ymap[]; };
// Overlay (SOURCE_OVERLAY_INLINE + GRAY_LUT + SHARED: the cache and LUT are
// exact caches of overlay_source_colour, so computing it directly is the same
// value): RGBA8 premultiplied sRGB, coverage alpha, rows top first.
// OVERLAY 1: from overlay_prepare's colour cache and tile map. 2 (fused, the
// shell's layer alone): the pack reads the shell itself and keeps the colour
// cache as overlay_prepare does (keys = the RGBA each colour was made from).
layout(constant_id = 2) const uint OVERLAY = 0;
layout(constant_id = 3) const uint BLEND_FMA = 1;  // the blends as IGC contracts them (FP_CONTRACT ON)
layout(binding = 6, std430) buffer GuiColours { vec4 gui_colours[]; };      // w < 0: a colour out of range
layout(binding = 7, std430) readonly buffer GuiTiles { uint gui_tiles[]; };   // 16x16: bit 0 covered, 1 first column, 2 last
layout(binding = 8, std430) buffer GuiError { uint gui_error; uint gui_changed; };   // OVERLAY 2: pixels whose RGBA changed
layout(binding = 15) uniform sampler2D shell;
layout(binding = 16, std430) buffer Keys { uint keys[]; };
layout(binding = 17, std430) readonly buffer Coeff { float coeff[]; };
layout(binding = 18) uniform sampler2D subtitle_degamma;
layout(binding = 19) uniform sampler2D subtitle_pq;
// CB1: the shell's occupancy per 32x32 tile (cb1_tiles.comp); 0: no alpha
layout(binding = 20, std430) readonly buffer Cb1Tiles { uint cb1_occupied; uint cb1_pad[3]; uint cb1_tiles[]; };
// Where the reconstructed samples come from. 0: the staged planes (yplane,
// cb, cr). 1 (fused single layer): the decoded BL through single_polynomial's
// tables, sample by sample. 2 (fused FEL, pass B): luma from the BL + the EL
// luma upsampled on the fly (vertical_pair then horizontal, as the staged
// kernels), chroma from pass A's planes.
layout(constant_id = 4) const uint SOURCE = 0;
// ANNEXB (PACK 0, no overlay, SOURCE 0 or 1; workgroup 32x8): CB1's Annex B
// 4:2:2 filter from a shared tile of the workgroup's chroma rows k0-3 .. k0+11,
// each fetched (and, fused, reshaped) once instead of eight times per row.
layout(constant_id = 5) const uint ANNEXB = 0;
const bool VEC = PACK == 0u && SOURCE == 0u;
layout(constant_id = 7) const uint CB1_PAIR_REUSE = 0;
const uint CTILE_ROWS = ANNEXB != 0u ? 15u : 1u;
shared uvec2 ctile[CTILE_ROWS][64];
layout(binding = 9) uniform sampler2D bl_luma;
layout(binding = 10) uniform sampler2D bl_uv;
layout(binding = 11) uniform sampler2D el_luma;
layout(binding = 12, std430) readonly buffer Tables { uint16_t tables[]; };   // 1: [3][1024]; 2: luma mapping
layout(binding = 13, std430) readonly buffer Residual { int residual[]; };     // 2: luma residual
layout(binding = 14, std430) buffer ReconError { uint recon_error; };
// MAP (docs/hdr10-output.md): the picture converted to HDR10 (BT.2020 PQ,
// limited-range 12-bit 4:2:2 Y'CbCr in the tunnel's byte layout, no packets)
// instead of tunnelled: 1 through the scene's 3D LUT (map_bake.comp), and a
// pair with a sample in a cell it marked written as its input codes (alpha 0)
// and listed for map_fixup.comp, which computes it exactly; 2 every pixel
// exact (DVVK_MAP_DIRECT=1, a check); 3 the LUT everywhere
// (DVVK_MAP_LUT_ONLY=1, timing); 4 the marked cells exact here
// (DVVK_MAP_INLINE=1, the fix-up pass's comparison).
layout(constant_id = 8) const uint MAP = 0;
// MAP_SDR (constant 10, with MAP != 0; docs/intel-dv/OUTPUT-MODES.md): the
// picture converted to an SDR display's R'G'B' instead, 8-bit XRGB8888,
// dithered; a pair's pixels each from their own luma and the pair's chroma.
// Its overlay is OVERLAY 4: the shell's sRGB layer blended over the
// converted picture, after the map (before it, the layer would go through a
// curve that follows the film's scenes). A pair with a marked sample and the
// layer over it is computed exactly here: map_fixup knows no layer.
#define MAP_PARAMS_BINDING 22
#define MAP_CELLS_BINDING 23
#define MAP_TABLES_BINDING 25
#define MAP_SDR_ID 10
#include "dv_map.glsl"
layout(binding = 21) uniform sampler3D map_lut;
// STATS (MAP != 0; HDR10+ output, dvvk_output_mode DVVK_OUTPUT_HDR10PLUS): the
// statistics CB1's DV -> HDR10+ metadata reads (cb1_hdr10plus_statistics), of
// every pixel of the active film area as the output carries it, before the
// overlay: a 256-bin histogram of maxRGB in 16-nit steps, each channel's
// maximum (PQ, as float bits: non-negative floats order as their bits), the
// sum of maxRGB light (1/64 nit units, 64-bit) and the count. Reduced in
// shared memory per workgroup, then added to the frame's record (host
// visible, zeroed by the engine; gui_flags bit 6 counts: not the reference
// pass). Layout: hist[256], max[3], sum lo, sum hi, count. An invocation
// keeps its own maxima, sum and count (inv_*) and adds them to the
// workgroup's once: an atomic on shared memory per sample and value costs
// more than the arithmetic (integer max and wrapping sums: the same numbers
// in any order).
layout(constant_id = 9) const uint STATS = 0;
layout(binding = 24, std430) buffer Stats { uint stats[]; };
const uint STATS_BINS = STATS != 0u ? 256u : 1u;
shared uint st_hist[STATS_BINS];
shared uint st_max[3];
shared uint st_sum, st_count;
uvec3 inv_max = uvec3(0u);
uint inv_sum = 0u, inv_count = 0u;
layout(push_constant) uniform Push {
    uvec4 active_area, black, placement;
    uint w, h, stride_words, packet_count, top_left, source_w, source_h, el_method;   // EL_ANNEXB / EL_BILINEAR
    uint gui_flags;   // OVERLAY 2: bit 0 invalidate the cache, 1 the shell's rows bottom first, 2 count changed pixels
    // the dispatch covers the workgroups from here (a part of the canvas: only
    // what changed since the output buffer was last written, see the engine)
    uint origin_x, origin_y;
    uint chroma_filter;   // PACK 0: 1 CB1 Master Reference's Annex B 4:2:2 filters
};
#include "overlay_colour.glsl"

uint unorm16_code(float v)
{
    uint q = uint(roundEven(v * 65535.0));
    if ((q & 63u) != 0u)
        atomicOr(recon_error, 1u);
    return q >> 6;
}

// vertical_pair's output V at (x, row) of the EL luma (el_w x el_h), then
// horizontal() over it: the EL luma at full resolution.
uint el_v(uint x, uint row, uint el_h)
{
    uint r = row / 2;
    if (el_method == EL_BILINEAR) {
        int b = int(unorm16_code(texelFetch(el_luma, ivec2(x, r), 0).r));
        int a = int(unorm16_code(texelFetch(el_luma, ivec2(x, edge(int(r) + ((row & 1u) == 0u ? -1 : 1), el_h)), 0).r));
        return el_bilinear_quarter(b, a);
    }
    int s[5];
    for (int k = 0; k < 5; k++)
        s[k] = int(unorm16_code(texelFetch(el_luma, ivec2(x, edge(int(r) + k - 2, el_h)), 0).r));
    return (row & 1u) == 0u ? rounded(-3 * s[0] + 29 * s[1] + 111 * s[2] - 9 * s[3], 128)
                            : rounded(-9 * s[1] + 111 * s[2] + 29 * s[3] - 3 * s[4], 128);
}

// SOURCE 2, the sited pack: the workgroup's EL luma upsampled vertically
// (el_v), once per EL column it needs (its 64 + the 8-tap halo) and per
// output row, instead of up to 8 times (bilinear: 2) per sample.
const uint ELTILE_ROWS = (SOURCE == 2u && PACK == 0u) ? 4u : 1u;
shared uint el_tile[ELTILE_ROWS][71];
bool el_tiled = false;
int el_tile_base;     // the EL column of el_tile[.][0]
uint el_tile_row0;    // the source luma row of el_tile[0]

uint fel_luma(uint x, uint y, uint sw, uint sh)
{
    uint ew = sw / 2, ix = x / 2, el;
    if (el_tiled) {
        uint t = y - el_tile_row0;
        int j = int(ix) - el_tile_base;
        if ((x & 1u) == 0u)
            el = el_tile[t][j];
        else if (el_method == EL_BILINEAR)
            el = el_bilinear_mid(el_tile[t][j], el_tile[t][j + 1]);
        else {
            const int taps[8] = int[8](22, 94, -524, 2456, 2456, -524, 94, 22);
            int v = 0;
            for (int k = 0; k < 8; k++)
                v += taps[k] * int(el_tile[t][j + k - 3]);
            el = rounded(v, 4096);
        }
    } else if ((x & 1u) == 0u)
        el = el_v(ix, y, sh / 2);
    else if (el_method == EL_BILINEAR)
        el = el_bilinear_mid(el_v(ix, y, sh / 2), el_v(uint(edge(int(ix) + 1, ew)), y, sh / 2));
    else {
        const int taps[8] = int[8](22, 94, -524, 2456, 2456, -524, 94, 22);
        int v = 0;
        for (int k = 0; k < 8; k++)
            v += taps[k] * int(el_v(uint(edge(int(ix) + k - 3, ew)), y, sh / 2));
        el = rounded(v, 4096);
    }
    if (el > 1023u) {                   // reported, clamped
        atomicOr(recon_error, 1u);
        el = 1023u;
    }
    uint base = unorm16_code(texelFetch(bl_luma, ivec2(x, y), 0).r);
    int64_t total = int64_t(uint(tables[base])) + int64_t(residual[el]);
    if (overflows32(total)) {
        atomicOr(recon_error, 2u);
        return 0u;
    }
    return recon12(total);
}

// The reconstructed source planes, sample by sample (sw: luma plane width).
uint src_y(uint x, uint y, uint sw, uint sh)
{
    if (SOURCE == 1u)
        return uint(tables[unorm16_code(texelFetch(bl_luma, ivec2(x, y), 0).r)]);
    if (SOURCE == 2u)
        return fel_luma(x, y, sw, sh);
    return uint(yplane[y * sw + x]);
}
uint src_c(bool odd, uint x, uint y, uint cw)
{
    if (SOURCE == 1u) {
        vec2 v = texelFetch(bl_uv, ivec2(x, y), 0).rg;
        return uint(tables[(odd ? 2048u : 1024u) + unorm16_code(odd ? v.g : v.r)]);
    }
    return odd ? uint(cr[y * cw + x]) : uint(cb[y * cw + x]);
}

// One sample of a pair (its own luma, the pair's chroma; t its LUT
// coordinates) mapped: unrounded codes. `marked`: in or beside a cell
// map_bake marked (its alpha; MAP 1: the fix-up's).
vec3 map_lane(uint yy, uint cb, uint cr, vec3 t, out bool marked)
{
    vec4 v = MAP == 2u ? vec4(0.0) : textureLod(map_lut, t, 0.0);
    marked = (MAP == 1u || MAP == 4u) && v.a < 0.5;
    if (MAP == 2u || (MAP == 4u && marked))
        return map_exact(yy, cb, cr);
    return v.rgb * map_node_scale();
}

uint packet_byte(uint i) { return (packet_words[i >> 2] >> (8 * (i & 3))) & 255u; }

// source_linear(): integer position split, float weights.
uint source_linear(bool chroma, bool odd, uint pw, uint ph, int nx, int ny, uint dx, uint dy)
{
    uint px = uint(clamp(nx, 0, int((pw - 1) * dx))), py = uint(clamp(ny, 0, int((ph - 1) * dy)));
    uint x = px / dx, y = py / dy, x1 = min(x + 1, pw - 1), y1 = min(y + 1, ph - 1);
    precise float fx = float(px % dx) / float(dx), fy = float(py % dy) / float(dy);
    float s00 = chroma ? float(src_c(odd, x, y, pw)) : float(src_y(x, y, pw, ph));
    float s01 = chroma ? float(src_c(odd, x1, y, pw)) : float(src_y(x1, y, pw, ph));
    float s10 = chroma ? float(src_c(odd, x, y1, pw)) : float(src_y(x, y1, pw, ph));
    float s11 = chroma ? float(src_c(odd, x1, y1, pw)) : float(src_y(x1, y1, pw, ph));
    precise float a, b, v;
    if (FMA == 0) {
        a = s00 * (1.0 - fx) + s01 * fx;
        b = s10 * (1.0 - fx) + s11 * fx;
        v = a * (1.0 - fy) + b * fy + 0.5;
    } else {
        a = fma(s00, 1.0 - fx, s01 * fx);
        b = fma(s10, 1.0 - fx, s11 * fx);
        v = fma(a, 1.0 - fy, b * fy) + 0.5;
    }
    return uint(floor(v));
}

uint vertical_mapped(bool chroma, bool odd, uint pw, uint ph, uint x, uvec4 m)
{
    precise float fy = uintBitsToFloat(m.z);
    float a = chroma ? float(src_c(odd, x, m.x, pw)) : float(src_y(x, m.x, pw, ph));
    float b = chroma ? float(src_c(odd, x, m.y, pw)) : float(src_y(x, m.y, pw, ph));
    precise float v;
    if (FMA == 0)
        v = a * (1.0 - fy) + b * fy + 0.5;
    else
        v = fma(a, 1.0 - fy, b * fy) + 0.5;
    return uint(floor(v));
}

// The overlay prepare pass's colour cache (exact overlay_source_colour of
// each pixel, zero where transparent) for tiles the overlay touches.
vec4 gui_value(int x, uint y) { return gui_colours[y * w + uint(clamp(x, 0, int(w) - 1))]; }
// The block x0..x0+3 blends pixels x0-1..x0+4: its own tile's coverage, or a
// neighbour tile's edge column next to it.
bool gui_tile(uint x, uint y)
{
    uint row = (y / 16u) * ((w + 15u) / 16u), t = x / 16u;
    if ((gui_tiles[row + t] & 1u) != 0u)
        return true;
    if ((x & 15u) == 0u && t > 0u && (gui_tiles[row + t - 1u] & 4u) != 0u)
        return true;
    return (x & 15u) == 12u && t + 1u < (w + 15u) / 16u && (gui_tiles[row + t + 1u] & 2u) != 0u;
}

// OVERLAY 2: the shell's pixel as overlay_prepare's composed() makes it.
uint shell_rgba(uint x, uint y)
{
    vec2 at = vec2(x, (gui_flags & 2u) != 0u ? h - 1u - y : y) + 0.5;
    vec4 dst = textureLod(shell, at / vec2(w, h), 0.0);
    uvec4 b = uvec4(round(clamp(dst, 0.0, 1.0) * 255.0));
    b.rgb = min(b.rgb, uvec3(b.a));
    return b.r | (b.g << 8) | (b.b << 16) | (b.a << 24);
}

// gui_flags bit 5: the shell is linear half float (premultiplied, 1.0 = the
// overlay's white): its colour straight from the sample, no cache.
vec4 gui_linear(uint x, uint y)
{
    vec2 at = vec2(x, (gui_flags & 2u) != 0u ? h - 1u - y : y) + 0.5;
    vec4 f = textureLod(shell, at / vec2(w, h), 0.0);
    float a = clamp(f.a, 0.0, 1.0);
    if (a <= 0.0)
        return vec4(0.0);
    vec4 c;
    if (!overlay_source_colour_from_linear(max(f.rgb / a, vec3(0.0)) * (coeff[30] / 10000.0), a, c)) {
        atomicOr(gui_error, 1u);
        return vec4(0.0);
    }
    return c;
}

vec4 gui_colour(uint v)
{
    vec4 c;
    if (!overlay_source_colour(uvec4(v & 255u, (v >> 8) & 255u, (v >> 16) & 255u, v >> 24), c)) {
        atomicOr(gui_error, 1u);
        c = vec4(0.0);
    }
    return c;
}

// OVERLAY 2: pixel (x, y)'s colour (zero where transparent). Its owner keeps
// the cache: colour and key are written together by the one invocation that
// owns the pixel, so others never read a half-written entry. A transparent
// pixel reads no key (most of the canvas): its colour is zero whatever the
// cache holds, and a stale key there still names its own colour. With
// gui_flags bit 2 (DVVK_OVERLAY_CHANGES) keys follow every pixel instead, so
// a key differs exactly where the pixel changed (counted in `changed`).
shared uint wg_changed;
uint changed = 0u;

vec4 gui_owned(uint x, uint y)
{
    if ((gui_flags & 32u) != 0u)
        return gui_linear(x, y);
    uint v = shell_rgba(x, y), i = y * w + x;
    if ((gui_flags & 8u) != 0u)
        // direct: no cache (every pixel's colour computed; no key or colour
        // traffic)
        return (v >> 24) == 0u ? vec4(0.0) : gui_colour(v);
    bool invalidate = (gui_flags & 1u) != 0u;
    if ((v >> 24) == 0u && (gui_flags & 4u) == 0u) {
        // An invalidated key must not match a later pixel with an old colour.
        if (invalidate)
            keys[i] = v;
        return vec4(0.0);
    }
    if (!invalidate && keys[i] == v) {
        if ((v >> 24) == 0u)
            return vec4(0.0);
        vec4 c = gui_colours[i];
        if (c.w < 0.0) {
            atomicOr(gui_error, 1u);
            return vec4(0.0);
        }
        return c;
    }
    changed++;
    if ((v >> 24) == 0u) {
        // Transparent: no colour to cache; its key stops a later pixel
        // matching a colour made for something else.
        keys[i] = v;
        return vec4(0.0);
    }
    vec4 c;
    bool ok = overlay_source_colour(uvec4(v & 255u, (v >> 8) & 255u, (v >> 16) & 255u, v >> 24), c);
    if (!ok) {
        atomicOr(gui_error, 1u);
        c = vec4(0.0);
    }
    gui_colours[i] = ok ? c : vec4(0.0, 0.0, 0.0, -1.0);
    keys[i] = v;
    return c;
}

// A pixel another workgroup owns: computed, the cache not read.
vec4 gui_foreign(uint x, uint y)
{
    if ((gui_flags & 32u) != 0u)
        return gui_linear(x, y);
    uint v = shell_rgba(x, y);
    return (v >> 24) == 0u ? vec4(0.0) : gui_colour(v);
}

// OVERLAY 2: the workgroup's pixels (128 x 4), resolved once by their owners.
const uint GUI_ROWS = OVERLAY == 2u ? 4u : 1u;
shared vec4 gui_shared[GUI_ROWS][128];

uint blend_luma(uint yy, vec4 g)
{
    precise float v;
    if (BLEND_FMA != 0u)
        v = fma(float(yy), 1.0 - g.w, g.x * g.w) + 0.5;
    else
        v = float(yy) * (1.0 - g.w) + g.x * g.w + 0.5;
    return uint(floor(v));
}

uint blend_chroma(uint c, bool odd, vec4 l, vec4 m, vec4 r)
{
    precise float coverage = (l.w + 2.0 * m.w + r.w) * 0.25;
    if (!(coverage > 0.0))
        return c;
    float lc = odd ? l.z : l.y, mc = odd ? m.z : m.y, rc = odd ? r.z : r.y;
    precise float contribution, v;
    if (BLEND_FMA != 0u) {
        contribution = fma(rc, r.w, fma(lc, l.w, (2.0 * mc) * m.w));
        v = fma(float(c), 1.0 - coverage, contribution * 0.25) + 0.5;
    } else {
        contribution = lc * l.w + 2.0 * mc * m.w + rc * r.w;
        v = float(c) * (1.0 - coverage) + contribution * 0.25 + 0.5;
    }
    return uint(floor(v));
}

// OVERLAY 3. coeff: 0-8 overlay_decode, 9-11 overlay_offset, 12-20
// overlay_linear (column order, as libplacebo's mat3 variables), 21-24
// overlay_area (x0, y0, x1, y1), 25 nonzero: a PQ layer (CB1_OVERLAY_PQ), 26
// CB1_SOURCE_BLACK. Each expression keeps CB1's operation order; a mat3 * vec3
// is written out as GL's GLSL compiler lowers it (column 0, then each next
// column added), so the driver fuses the same operations as in CB1's shader.
#include "common/cb1_colour.glsl"

vec3 cb1_gui_source(vec4 layer, vec3 base)
{
    vec3 v = clamp(layer.rgb / layer.a, 0.0, 1.0);
    vec3 q = coeff[25] != 0.0 ? v : cb1_gui_pq(v);
    q = cb1_matrix_pq(q);
    return clamp(cb1_mul(0u, q - vec3(coeff[9], coeff[10], coeff[11])) * layer.a + base * (1.0 - layer.a), 0.0, 1.0);
}

// Pixel (x, y)'s code pair with the GUI over it: CB1 mixes the layer at the
// pixel into its own sample (luma, and the chroma it carries) and the layer at
// its pair neighbour into the copy that adds the second chroma half. The
// picture is the codes / 4095, as sh_dovi_reference_output() hands it on, and
// CB1_SOURCE_NEUTRAL outside the active area.
// Whether the 32x32 tile of (x, y) has no alpha: the pair's layers are
// transparent and the picture is v as it is.
bool cb1_tile_empty(uint x, uint y)
{
    return cb1_tiles[(y >> 5) * ((w + 31u) >> 5) + (x >> 5)] == 0u;
}

uvec2 cb1_overlay(uint x, uint y, bool odd, uvec2 v)
{
    if (cb1_tile_empty(x, y))
        return v;
    float row = float((gui_flags & 2u) != 0u ? h - 1u - y : y) + .5;
    vec4 gui = textureLod(shell, vec2((float(x) + .5) / float(w), row / float(h)), 0.0);
    vec4 adjacent = textureLod(shell, vec2((float(x ^ 1u) + .5) / float(w), row / float(h)), 0.0);
    if (!(gui.a > 0.0 || adjacent.a > 0.0))
        return v;
    bool inactive = x < active_area.x || x >= active_area.z || y < active_area.y || y >= active_area.w;
    vec3 own = inactive ? vec3(coeff[26], .5, .5) : clamp(vec3(v.x, v.y, v.y) / 4095.0, 0.0, 1.0), peer = own;
    if (gui.a > 0.0)
        own = cb1_gui_source(gui, own);
    if (adjacent.a > 0.0)
        peer = cb1_gui_source(adjacent, peer);
    float c = odd ? own.z + peer.z : own.y + peer.y;
    return uvec2(uint(floor(4095.0 * own.x + .5)), uint(floor(2047.5 * c + .5)));
}

// Convert the two layers once, then reuse each for both output samples.
// Keep conversion separate from the alpha/base blend to retain operation order.
vec4 cb1_pair_colour(vec4 layer)
{
    if (!(layer.a > 0.0)) return vec4(0.0);
    vec3 v = clamp(layer.rgb / layer.a, 0.0, 1.0);
    vec3 q = coeff[25] != 0.0 ? v : cb1_gui_pq(v);
    q = cb1_matrix_pq(q);
    return vec4(cb1_mul(0u, q - vec3(coeff[9], coeff[10], coeff[11])), layer.a);
}
void cb1_pair_layers(uint x, uint y, out vec4 a, out vec4 b)
{
    a = b = vec4(0.0);
    if (cb1_tile_empty(x, y)) return;
    float row = float((gui_flags & 2u) != 0u ? h - 1u - y : y) + .5;
    a = cb1_pair_colour(textureLod(shell, vec2((float(x) + .5) / float(w), row / float(h)), 0.0));
    b = cb1_pair_colour(textureLod(shell, vec2((float(x + 1u) + .5) / float(w), row / float(h)), 0.0));
}
uvec2 cb1_pair_blend(uint x, uint y, bool odd, uvec2 v, vec4 a, vec4 b)
{
    if (!(a.a > 0.0 || b.a > 0.0)) return v;
    bool inactive = x < active_area.x || x >= active_area.z || y < active_area.y || y >= active_area.w;
    vec3 own = inactive ? vec3(coeff[26], .5, .5) : clamp(vec3(v.x, v.y, v.y) / 4095.0, 0.0, 1.0), peer = own;
    if (a.a > 0.0) own = clamp(a.rgb * a.a + own * (1.0 - a.a), 0.0, 1.0);
    if (b.a > 0.0) peer = clamp(b.rgb * b.a + peer * (1.0 - b.a), 0.0, 1.0);
    float c = odd ? own.z + peer.z : own.y + peer.y;
    return uvec2(uint(floor(4095.0 * own.x + .5)), uint(floor(2047.5 * c + .5)));
}

// One output pixel (x, y): the 12-bit sample pair before overlay/packets.
// chroma_rows: for the sited 4:2:0 pack, this block's chroma rows k-3 .. k+4
// (k = ly / 2) for the pixel's chroma column (cb, cr), fetched once per block.
uvec2 reconstruct(uint x, uint y, bool odd, uvec2 chroma_rows[8])
{
    uint dw = placement.z, dh = placement.w, lx = x - placement.x, ly = y - placement.y;
    uint sw = dw, sh = dh;
    bool inside = x >= placement.x && y >= placement.y && lx < dw && ly < dh;
    if (PACK == 2) {
        sw = source_w;
        sh = source_h;
    }
    uint yy = black.x, c = odd ? black.z : black.y;
    bool shown = !(x < active_area.x || y < active_area.y || x >= active_area.z || y >= active_area.w);
    // Fused: pixels the letterbox blacks out aren't reconstructed at all.
    if (inside && shown) {
        if (PACK == 2 && (sw != dw || sh != dh)) {
            if (sw == dw) {
                yy = vertical_mapped(false, false, sw, sh, lx, ymap[2 * ly]);
                c = vertical_mapped(true, odd, sw / 2, sh / 2, lx / 2, ymap[2 * ly + 1]);
            } else {
                int px = int((2 * lx + 1) * sw) - int(dw);
                int py = int((2 * ly + 1) * sh) - int(dh);
                int cx = int((2 * (lx & ~1u) + 1) * sw) - int(dw);
                int cy = py - (top_left != 0u ? 0 : int(dh));
                yy = source_linear(false, false, sw, sh, px, py, 2 * dw, 2 * dh);
                c = source_linear(true, odd, sw / 2, sh / 2, cx, cy, 4 * dw, 4 * dh);
            }
        } else if (PACK == 1) {
            c = src_c(odd, lx / 2, ly, sw / 2);
            yy = src_y(lx, ly, sw, sh);
        } else {
            int r[8];
            for (uint i = 0; i < 8; i++)
                r[i] = int(odd ? chroma_rows[i].y : chroma_rows[i].x);
            if (chroma_filter != 0u) {
                // CB1 (ETSI GS CCM 001 Annex B): left sited, the six-tap phases;
                // top-left, aligned rows copied and the half-phase eight-tap
                // between them. Clipped to the 12-bit code range.
                int s;
                if (top_left != 0u) {
                    s = (ly & 1u) == 0u ? r[3] << 12 :
                        22 * (r[0] + r[7]) + 94 * (r[1] + r[6]) - 524 * (r[2] + r[5]) + 2456 * (r[3] + r[4]);
                    s = (s + 2048) >> 12;
                } else {
                    s = (ly & 1u) == 0u ? 2 * r[0] - 12 * r[1] + 65 * r[2] + 222 * r[3] - 25 * r[4] + 4 * r[5]
                                        : 4 * r[1] - 25 * r[2] + 222 * r[3] + 65 * r[4] - 12 * r[5] + 2 * r[6];
                    s = (s + 128) >> 8;
                }
                c = uint(clamp(s, 0, 4095));
            } else {
                // rows k-1, k, k+1 (r[2..4]); sited weights as source_tunnel
                uint lo, hi, a;
                if ((ly & 1u) == 0u) { lo = 2u; hi = 3u; a = 1u; } else { lo = 3u; hi = 4u; a = 3u; }
                if (top_left != 0u) { lo = 3u; hi = 4u; a = (ly & 1u) != 0u ? 2u : 4u; }
                c = (a * uint(r[lo]) + (4 - a) * uint(r[hi]) + 2) / 4;
            }
            yy = (VEC && pre_ok) ? pre_y[lx & 3u] : src_y(lx, ly, sw, sh);
        }
    }
    if (!shown) {
        yy = black.x;
        c = odd ? black.z : black.y;
    }
    return uvec2(yy, c);
}

uint finish(uint x, uint y, uvec2 v)
{
    uint yy = v.x, c = v.y, i = y * w + x;
    if (i < packet_count * 3072u) {
        uint bit_index = i % 1024u;
        uint bit = (packet_byte((i / 3072u) * 128u + bit_index / 8u) >> (7u - bit_index % 8u)) & 1u;
        c = (c & 4094u) | (bit ^ (uint(bitCount(yy) + bitCount(c >> 1)) & 1u));
    }
    uint r = c >> 4, g = yy >> 4, b = ((c & 15u) << 4) | (yy & 15u);
    return b | (g << 8) | (r << 16) | 0xff000000u;
}

// The sited pack's chroma rows k-3 .. k+4 (clamped to the plane, as
// source_tunnel's top / bottom are) at chroma column cx, both channels. The
// 2-tap blend reads k-1 .. k+1 only.
void chroma_rows_at(uint cx, uint k, uint sw, uint sh, out uvec2 rows[8])
{
    int last = int(sh / 2) - 1;
    uint cw = sw / 2;
    for (int i = 0; i < 8; i++) {
        if (chroma_filter == 0u && (i < 2 || i > 4)) {
            rows[i] = uvec2(0);
            continue;
        }
        uint row = uint(clamp(int(k) + i - 3, 0, last));
        rows[i] = uvec2(src_c(false, cx, row, cw), src_c(true, cx, row, cw));
    }
}

// The statistics of one output sample: 12-bit Y'CbCr codes (BT.2020
// limited range) to PQ R'G'B', maxRGB light.
void stats_sample(uvec3 c)
{
    float y = (float(c.x) - 256.0) * (1.0 / 3504.0), cb = (float(c.y) - 2048.0) * (1.0 / 3584.0),
          cr = (float(c.z) - 2048.0) * (1.0 / 3584.0);
    float r = y + 1.4746 * cr, b = y + 1.8814 * cb;
    vec3 rgb = clamp(vec3(r, (y - 0.2627 * r - 0.0593 * b) * (1.0 / 0.6780), b), 0.0, 1.0);
    inv_max = max(inv_max, floatBitsToUint(rgb));
    float nits = 10000.0 * map_pq_eotf(vec3(max(rgb.r, max(rgb.g, rgb.b)))).x;
    atomicAdd(st_hist[min(255u, uint(floor(nits / 16.0 + 0.5)))], 1u);
    inv_sum += uint(floor(nits * 64.0 + 0.5));
    inv_count++;
}

// One invocation: 4 pixels x 2 rows (x0 % 4 == 0, y0 even), stored 16 bytes a row.
void pack_main()
{
    uint x0 = (gl_GlobalInvocationID.x + origin_x * 32u) * 4u, y0 = (gl_GlobalInvocationID.y + origin_y * gl_WorkGroupSize.y) * 2u;
    uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    if (OVERLAY == 2u) {
        // Before any return: the barriers need the whole workgroup.
        if (gl_LocalInvocationIndex == 0u)
            wg_changed = 0u;
        barrier();
        for (uint r = 0; r < 2; r++)
            for (uint i = 0; i < 4; i++)
                gui_shared[ly * 2u + r][lx * 4u + i] =
                    x0 + i < w && y0 + r < h ? gui_owned(x0 + i, y0 + r) : vec4(0.0);
        if (changed != 0u)
            atomicAdd(wg_changed, changed);
        barrier();
        if (gl_LocalInvocationIndex == 0u && wg_changed != 0u && (gui_flags & 1u) == 0u)
            atomicAdd(gui_changed, wg_changed);
    }
    if (SOURCE == 2u && PACK == 0u) {
        // The tile's rows: the workgroup's 4 output rows, where reconstructed.
        uint gx = (gl_WorkGroupID.x + origin_x) * 128u, gy = (gl_WorkGroupID.y + origin_y) * 4u;
        el_tiled = true;
        el_tile_base = (int(gx) - int(placement.x)) / 2 - 3;
        el_tile_row0 = gy - placement.y;   // wraps above the placement; those rows aren't read
        uint sw = placement.z, sh = placement.w;
        for (uint e = ly * 32u + lx; e < 4u * 71u; e += 64u) {
            uint t = e / 71u, j = e % 71u, y = gy + t;
            bool used = y >= placement.y && y - placement.y < sh && y >= active_area.y && y < active_area.w;
            el_tile[t][j] = used ? el_v(uint(edge(el_tile_base + int(j), sw / 2)), y - placement.y, sh / 2) : 0u;
        }
        barrier();
    }
    if (ANNEXB != 0u) {
        // The workgroup: 128 pixels (64 chroma columns) by 16 rows (8 chroma
        // rows, k0 .. k0+7); placement x and y are even. Workgroups wholly in
        // the bars or outside the active rows load nothing (all black there).
        uint gx = (gl_WorkGroupID.x + origin_x) * 128u, gy = (gl_WorkGroupID.y + origin_y) * 16u;
        int k0 = (int(gy) - int(placement.y)) / 2, c0 = (int(gx) - int(placement.x)) / 2;
        int cw = int(placement.z / 2u), last = int(placement.w / 2u) - 1;
        bool used = gx + 128u > placement.x && gx < placement.x + placement.z && gy + 16u > placement.y &&
                    gy < placement.y + placement.w && (SOURCE == 0u || (gy + 16u > active_area.y && gy < active_area.w));
        if (used)
            for (uint e = gl_LocalInvocationIndex; e < 15u * 64u; e += 256u) {
                uint tr = e / 64u, tc = e % 64u;
                int c = c0 + int(tc);
                uint r = uint(clamp(k0 - 3 + int(tr), 0, last));
                ctile[tr][tc] = c >= 0 && c < cw ? uvec2(src_c(false, uint(c), r, uint(cw)), src_c(true, uint(c), r, uint(cw)))
                                                 : uvec2(0);
            }
        barrier();
    }
    if (x0 >= w || y0 >= h)
        return;
    // Chroma rows for the sited pack, per chroma column of the block (the
    // placement is even, so the block's two rows share k and its 4 pixels two
    // columns).
    uvec2 rows[2][8];
    for (uint j = 0; j < 2; j++)
        for (uint r = 0; r < 8; r++)
            rows[j][r] = uvec2(0);
    if (PACK == 0) {
        uint ly0 = y0 - placement.y;
        bool any_inside = x0 + 3u >= placement.x && y0 + 1u >= placement.y && x0 < placement.x + placement.z &&
                          y0 < placement.y + placement.w;
        bool any_shown = x0 + 3u >= active_area.x && x0 < active_area.z && y0 + 1u >= active_area.y && y0 < active_area.w;
        if (ANNEXB != 0u && any_inside && any_shown)
            // tile row of chroma row k (= ly0 / 2) is k - k0 + 0 .. 7 = local y + i;
            // column of the pair at x0 + 2j is its offset in the workgroup
            for (uint j = 0; j < 2; j++)
                for (uint i = 0; i < 8; i++)
                    rows[j][i] = ctile[ly + i][lx * 2u + j];
        else if (VEC && chroma_filter != 0u && any_inside && any_shown && (placement.x & 3u) == 0u &&
                 x0 >= placement.x && (x0 - placement.x) / 2u + 1u < placement.z / 2u && (placement.z & 7u) == 0u) {
            // perf: both chroma columns of the block (even c) with one 32-bit load per row and plane
            uint cw = placement.z / 2u, c = (x0 - placement.x) / 2u;
            int last = int(placement.w / 2u) - 1;
            for (int i = 0; i < 8; i++) {
                uint row = uint(clamp(int(ly0 / 2u) + i - 3, 0, last));
                uint u = cb2[(row * cw + c) >> 1], v = cr2[(row * cw + c) >> 1];
                rows[0][i] = uvec2(u & 0xffffu, v & 0xffffu);
                rows[1][i] = uvec2(u >> 16, v >> 16);
            }
        } else if (any_inside && any_shown)
            for (uint j = 0; j < 2; j++) {
                uint xj = x0 + 2u * j;   // the pair's first pixel; placement.x is even
                if (xj >= placement.x && (xj - placement.x) / 2u < placement.z / 2u)
                    chroma_rows_at((xj - placement.x) / 2u, ly0 / 2u, placement.z, placement.w, rows[j]);
            }
    }
    uint fixup = 0u;   // MAP 1: the block's pairs for map_fixup (bit row * 2 + pair)
    for (uint r = 0; r < 2; r++) {
        uint y = y0 + r;
        if (y >= h)
            break;
        // Blocks are 4 wide and 16-aligned tiles hold 4 of them; the tile map
        // is dilated so a neighbour's coverage (x0-1, x0+4) marks it too.
        bool tile = OVERLAY == 1u ? gui_tile(x0, y) : OVERLAY == 2u;
        if (VEC) {
            uint sw = placement.z, lyy = y - placement.y;
            pre_ok = (placement.x & 3u) == 0u && (sw & 3u) == 0u && x0 >= placement.x && x0 - placement.x + 3u < sw &&
                     y >= placement.y && lyy < placement.w;
            if (pre_ok) {
                uvec2 q = yplane4[(lyy * sw + (x0 - placement.x)) >> 2];
                pre_y = uint[4](q.x & 0xffffu, q.x >> 16, q.y & 0xffffu, q.y >> 16);
            }
        }
        uvec4 out4;
        uvec2 lv4[4], film4[4];
        for (uint pair = 0; pair < 2; pair++) {
            uint sx = x0 / 2u + pair;
            vec4 shared_left = vec4(0.0), shared_middle = vec4(0.0), shared_right = vec4(0.0);
            if (OVERLAY == 1u && tile) {
                int center = int(sx * 2);
                shared_left = gui_value(center - 1, y);
                shared_middle = gui_value(center, y);
                shared_right = gui_value(center + 1, y);
            } else if (OVERLAY == 2u) {
                // pixels center-1, center, center+1 (clamped at the canvas edge as gui_value)
                uint row = ly * 2u + r, c = lx * 4u + pair * 2u;
                shared_middle = gui_shared[row][c];
                shared_right = gui_shared[row][c + 1u];
                if (c > 0u)
                    shared_left = gui_shared[row][c - 1u];
                else
                    shared_left = x0 == 0u ? shared_middle : gui_foreign(x0 - 1u, y);
            }
            vec4 pair_a, pair_b;
            if (OVERLAY == 3u && CB1_PAIR_REUSE != 0u)
                cb1_pair_layers(sx * 2u, y, pair_a, pair_b);
            uvec2 lv[2];
            for (uint lane = 0; lane < 2; ++lane) {
                uint x = sx * 2 + lane;
                bool odd = (x & 1u) != 0u;
                uvec2 v = reconstruct(x, y, odd, rows[pair]);
                film4[pair * 2u + lane] = v;
                if (OVERLAY == 3u)
                    v = CB1_PAIR_REUSE != 0u
                        ? cb1_pair_blend(x, y, odd, v, odd ? pair_b : pair_a, odd ? pair_a : pair_b)
                        : cb1_overlay(x, y, odd, v);
                if (OVERLAY != 0u && tile) {
                    vec4 g = odd ? shared_right : shared_middle;
                    if (g.w > 0.0)
                        v.x = blend_luma(v.x, g);
                    v.y = blend_chroma(v.y, odd, shared_left, shared_middle, shared_right);
                }
                lv[lane] = v;
            }
            lv4[pair * 2u] = lv[0];
            lv4[pair * 2u + 1u] = lv[1];
        }
        bool raw[2] = bool[2](false, false);
        vec3 m4[4];
        uint sdr4[4];
        if (MAP != 0u && MAP_SDR != 0u) {
            // The row's four samples as in the HDR10 branch below, then the
            // display's codes: the layer over them, the dither.
            uvec3 bi = mp.black_in.xyz;
            bool marked[4];
            vec4 layer[4];
            for (uint i = 0u; i < 4u; i++) {
                uint e = i & ~1u;
                if (i == e)
                    m4[i] = map_base(lv4[e].y, lv4[e + 1u].y);
                else
                    m4[i] = m4[e];
                layer[i] = vec4(0.0);
                if (OVERLAY == 4u) {
                    uint v = shell_rgba(x0 + i, y);
                    layer[i] = vec4(v & 255u, (v >> 8) & 255u, (v >> 16) & 255u, v >> 24) * (1.0 / 255.0);
                }
            }
            for (uint i = 0u; i < 4u; i++) {
                uint e = i & ~1u;
                m4[i] = map_lane(lv4[i].x, lv4[e].y, lv4[e + 1u].y, map_coord(lv4[i].x, m4[i]), marked[i]);
            }
            for (uint pair = 0u; pair < 2u; pair++) {
                uvec2 a = lv4[2u * pair], b = lv4[2u * pair + 1u];
                bool chroma_black = a.y == bi.y && b.y == bi.z;
                bool black[2] = bool[2](chroma_black && a.x == bi.x, chroma_black && b.x == bi.x);
                bool layered = layer[2u * pair].a > 0.0 || layer[2u * pair + 1u].a > 0.0;
                if (MAP == 1u && (marked[2u * pair] || marked[2u * pair + 1u]) && !(black[0] && black[1])) {
                    if (!layered) {
                        raw[pair] = true;
                        fixup |= 1u << (r * 2u + pair);
                        continue;
                    }
                    m4[2u * pair] = map_exact(a.x, a.y, b.y);
                    m4[2u * pair + 1u] = map_exact(b.x, a.y, b.y);
                }
                for (uint lane = 0u; lane < 2u; lane++) {
                    uint i = 2u * pair + lane;
                    // black is exact (an integer code: the dither leaves it)
                    precise vec3 c = black[lane] ? vec3(mp.black_out.xyz) : m4[i];
                    vec4 g = layer[i];
                    if (g.a > 0.0)
                        // premultiplied sRGB over the display's codes
                        c = (mp.out_code.x * g.rgb + mp.out_code.y * g.a) + (1.0 - g.a) * c;
                    sdr4[i] = map_sdr_word(map_sdr_q(c, uvec2(x0 + i, y)));
                }
            }
        } else if (MAP != 0u) {
            // The row's four samples: the lookups issued together (their
            // latency overlaps), then used. A pair's chroma is the even
            // (co-sited) sample's: Cb on the even lane, Cr on the odd one, as
            // the tunnel carries them. Black (the letterbox) is exact
            // (map_pair). MAP 1: a pair with a marked sample keeps its input
            // codes for the fix-up.
            uvec3 bi = mp.black_in.xyz;
            bool marked[4];
            for (uint i = 0u; i < 4u; i++) {
                uint e = i & ~1u;
                if (i == e)
                    m4[i] = map_base(lv4[e].y, lv4[e + 1u].y);
                else
                    m4[i] = m4[e];
            }
            for (uint i = 0u; i < 4u; i++) {
                uint e = i & ~1u;
                m4[i] = map_lane(lv4[i].x, lv4[e].y, lv4[e + 1u].y, map_coord(lv4[i].x, m4[i]), marked[i]);
            }
            for (uint pair = 0u; pair < 2u; pair++) {
                uvec2 a = lv4[2u * pair], b = lv4[2u * pair + 1u];
                bool black = a.y == bi.y && b.y == bi.z && a.x == bi.x && b.x == bi.x;
                if (MAP == 1u && !black && (marked[2u * pair] || marked[2u * pair + 1u])) {
                    raw[pair] = true;
                    fixup |= 1u << (r * 2u + pair);
                } else
                    map_pair(a, b, m4[2u * pair], m4[2u * pair + 1u], lv4[2u * pair], lv4[2u * pair + 1u]);
            }
        }
        if (STATS != 0u && MAP != 0u && (gui_flags & 64u) != 0u && y >= active_area.y && y < active_area.w &&
            y >= placement.y && y < placement.y + placement.w) {
            // the film's samples as the output carries them (the overlay's:
            // mapped again without it); pairs wholly in the film's area.
            // Without an overlay the film is what was mapped above: m4 are
            // its lookups and lv4 its pairs' codes, but for a pair left as
            // its input codes for the fix-up, mapped here (from the lookups,
            // as with an overlay).
            vec3 sm[4];
            if (OVERLAY != 0u)
                for (uint i = 0u; i < 4u; i++) {
                    uint e = i & ~1u;
                    bool marked;
                    sm[i] = map_lane(film4[i].x, film4[e].y, film4[e + 1u].y,
                                     map_coord(film4[i].x, map_base(film4[e].y, film4[e + 1u].y)), marked);
                }
            for (uint pair = 0u; pair < 2u; pair++) {
                uint xp = x0 + 2u * pair;
                if (xp < active_area.x || xp + 1u >= active_area.z || xp < placement.x || xp + 1u >= placement.x + placement.z)
                    continue;
                uvec2 qa = lv4[2u * pair], qb = lv4[2u * pair + 1u];
                if (OVERLAY != 0u)
                    map_pair(film4[2u * pair], film4[2u * pair + 1u], sm[2u * pair], sm[2u * pair + 1u], qa, qb);
                else if (raw[pair])
                    map_pair(film4[2u * pair], film4[2u * pair + 1u], m4[2u * pair], m4[2u * pair + 1u], qa, qb);
                stats_sample(uvec3(qa.x, qa.y, qb.y));
                stats_sample(uvec3(qb.x, qa.y, qb.y));
            }
        }
        for (uint i = 0u; i < 4u; i++)
            out4[i] = MAP == 1u && raw[i >> 1] ? map_word(lv4[i]) & 0x00ffffffu
                      : MAP != 0u && MAP_SDR != 0u ? sdr4[i] : finish(x0 + i, y, lv4[i]);
        pixels4[(y * stride_words + x0) / 4u] = out4;
    }
    if (MAP == 1u && fixup != 0u) {
        // the list's header is map_fixup's indirect dispatch: groups of 64
        uint slot = atomicAdd(map_cells[mp.list + 3u], 1u);
        if ((slot & 63u) == 0u)
            atomicAdd(map_cells[mp.list], 1u);
        map_cells[mp.list + 4u + slot] = ((y0 / 2u) * (w / 4u) + x0 / 4u) | fixup << 28;
    }
}

void main()
{
    if (STATS != 0u) {
        for (uint i = gl_LocalInvocationIndex; i < STATS_BINS; i += gl_WorkGroupSize.x * gl_WorkGroupSize.y)
            st_hist[i] = 0u;
        if (gl_LocalInvocationIndex == 0u) {
            st_max[0] = st_max[1] = st_max[2] = 0u;
            st_sum = st_count = 0u;
        }
        barrier();
    }
    pack_main();
    if (STATS != 0u) {
        if (inv_count != 0u) {
            atomicMax(st_max[0], inv_max.x);
            atomicMax(st_max[1], inv_max.y);
            atomicMax(st_max[2], inv_max.z);
            atomicAdd(st_sum, inv_sum);
            atomicAdd(st_count, inv_count);
        }
        barrier();
        if (st_count == 0u)
            return;
        for (uint i = gl_LocalInvocationIndex; i < STATS_BINS; i += gl_WorkGroupSize.x * gl_WorkGroupSize.y)
            if (st_hist[i] != 0u)
                atomicAdd(stats[i], st_hist[i]);
        if (gl_LocalInvocationIndex == 0u) {
            for (uint c = 0u; c < 3u; c++)
                atomicMax(stats[256u + c], st_max[c]);
            uint old = atomicAdd(stats[259], st_sum);
            if (old + st_sum < old)
                atomicAdd(stats[260], 1u);
            atomicAdd(stats[261], st_count);
        }
    }
}
