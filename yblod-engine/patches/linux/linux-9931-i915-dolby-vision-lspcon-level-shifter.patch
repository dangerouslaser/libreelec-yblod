+/*
+ * linux-9931: Standard Dolby Vision through the LSPCON in level-shifter mode.
+ * In PCON mode the MCDP2800 (FW 1.77) drops the Dolby VSIF; in level-shifter
+ * mode it repeats the GPU's own TMDS, so the native-HDMI DV path (AVI, VSIF)
+ * reaches the TV (NUC Display Lab v0.4.0-dvlab, report #17). The switch is
+ * the standard dual-mode register (I2C 0x40, offset 0x40) over the LSPCON's
+ * I2C-over-AUX bridge, the register lspcon_probe() uses for PCON mode.
+ *
+ * The switch runs right after the previous output stopped. HPD can be low
+ * then (LG sets drop it when the signal stops, and the chip's own mode
+ * change can glitch it), and i915 refuses AUX on a port whose HPD is low
+ * (-ENXIO). So every step waits for HPD and is retried, and the result is
+ * the mode read back from the chip, not the write's return value.
+ */
+/* At most about 4.5 s with HPD low throughout (TV off): 2 s, then 9 x 0.25 s. */
+#define LSPCON_DV_TRIES		10
+
+static bool lspcon_dv_wait_hpd(struct intel_digital_port *dig_port, int ms)
+{
+	unsigned long end = jiffies + msecs_to_jiffies(ms);
+
+	while (!intel_digital_port_connected(&dig_port->base)) {
+		if (time_after(jiffies, end))
+			return false;
+		usleep_range(10000, 15000);
+	}
+	return true;
+}
+
+static int lspcon_dv_switch(struct intel_digital_port *dig_port, enum drm_lspcon_mode mode)
+{
+	struct intel_lspcon *lspcon = &dig_port->lspcon;
+	struct intel_dp *intel_dp = &dig_port->dp;
+	struct intel_display *display = to_intel_display(dig_port);
+	struct i2c_adapter *ddc = &intel_dp->aux.ddc;
+	enum drm_lspcon_mode cur = DRM_LSPCON_MODE_INVALID;
+	int try, ret = -EIO;
+	bool hpd = true;
+	u8 rev;
+
+	for (try = 0; try < LSPCON_DV_TRIES; try++) {
+		if (try)
+			msleep(50);
+		hpd = lspcon_dv_wait_hpd(dig_port, try ? 200 : 2000);
+		/* Wake from D3; the answer does not matter. */
+		drm_dp_dpcd_readb(&intel_dp->aux, DP_DPCD_REV, &rev);
+		ret = drm_lspcon_get_mode(display->drm, ddc, &cur);
+		if (!ret && cur == mode)
+			break;
+		if (!ret)
+			ret = drm_lspcon_set_mode(display->drm, ddc, mode,
+						  lspcon_get_mode_settle_timeout(lspcon));
+		drm_dbg_kms(display->drm, "LSPCON DV: port %c try %d hpd %d mode %s: %d\n",
+			    port_name(dig_port->base.port), try + 1, hpd,
+			    lspcon_mode_name(cur), ret);
+		if (!ret) {
+			cur = mode;
+			break;
+		}
+	}
+	if (cur != mode)
+		return ret ? ret : -EIO;
+	lspcon->mode = mode;
+
+	/* TMDS output on, in both modes (it is on by default; PCON mode
+	 * expects it). A failure here is logged but not fatal. */
+	for (try = 0; try < 3; try++) {
+		if (try)
+			msleep(50);
+		lspcon_dv_wait_hpd(dig_port, 200);
+		ret = drm_dp_dual_mode_set_tmds_output(display->drm, DRM_DP_DUAL_MODE_LSPCON,
+						       ddc, true);
+		if (!ret)
+			break;
+	}
+	if (ret)
+		drm_warn(display->drm, "LSPCON DV: port %c TMDS output enable failed (%d)\n",
+			 port_name(dig_port->base.port), ret);
+	return 0;
+}
+
+bool intel_lspcon_ls_dv_active(const struct intel_digital_port *dig_port)
+{
+	return dig_port->lspcon.ls_dv;
+}
+
+/*
+ * enable: level-shifter mode for the HDMI-mode DV output. From here on the
+ * port is that HDMI output (ls_dv), even if the switch fails, so PCON-mode
+ * paths (detect, resume, link checks) stay away from it until the disable
+ * path. !enable: PCON mode, then wait for native AUX as lspcon_resume() does.
+ */
+int intel_lspcon_set_ls_dv(struct intel_digital_port *dig_port, bool enable)
+{
+	struct intel_lspcon *lspcon = &dig_port->lspcon;
+	struct intel_display *display = to_intel_display(dig_port);
+	int ret;
+
+	if (!lspcon->active)
+		return -ENODEV;
+
+	if (enable)
+		lspcon->ls_dv = true;
+
+	ret = lspcon_dv_switch(dig_port, enable ? DRM_LSPCON_MODE_LS : DRM_LSPCON_MODE_PCON);
+
+	if (!enable) {
+		lspcon->ls_dv = false;
+		if (!ret && lspcon_wait_mode(lspcon, DRM_LSPCON_MODE_PCON) != DRM_LSPCON_MODE_PCON)
+			ret = -ETIMEDOUT;
+		if (!ret)
+			lspcon_resume_in_pcon_wa(lspcon);
+	}
+
+	drm_dbg_kms(display->drm, "LSPCON DV: port %c %s mode %s (%d)\n",
+		    port_name(dig_port->base.port), enable ? "level-shifter" : "PCON",
+		    ret ? "FAILED" : "set", ret);
+	if (ret)
+		drm_err(display->drm, "LSPCON DV: port %c switch to %s mode failed (%d)\n",
+			port_name(dig_port->base.port),
+			enable ? "level-shifter" : "PCON", ret);
+	return ret;
+}
