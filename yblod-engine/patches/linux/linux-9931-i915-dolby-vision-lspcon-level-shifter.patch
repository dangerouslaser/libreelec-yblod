 };
 
 struct intel_digital_port {
diff --git a/drivers/gpu/drm/i915/display/intel_dp.c b/drivers/gpu/drm/i915/display/intel_dp.c
index 633385523562..7cfd24b6e03e 100644
--- a/drivers/gpu/drm/i915/display/intel_dp.c
+++ b/drivers/gpu/drm/i915/display/intel_dp.c
@@ -3582,6 +3582,61 @@ bool intel_dp_pcon_dv_allowed(const struct intel_digital_port *dig_port)
 	return display->params.dv_pcon > 0 || dmi_check_system(intel_dp_pcon_dv_dmi);
 }
 
+/*
+ * linux-9931: Standard Dolby Vision through a MegaChips MCDP2800 LSPCON in
+ * level-shifter mode (gen9/10). With DV requested, the DP connector's DDI is
+ * driven in HDMI mode (intel_ddi_compute_output_type()) and the LSPCON
+ * repeats its TMDS, so the native-HDMI DV path applies; otherwise the port is
+ * the usual PCON-mode DP connector. Level-shifter mode stops at 340 Mchar/s
+ * and gen9 HDMI at 300 MHz, so DV is 4K up to 30 Hz. Verified with the NUC
+ * Display Lab (nuc-hardware-lab v0.3.1/v0.4.0-dvlab, reports #15 and #17):
+ * NUC7i7BNB, MCDP2800 FW 1.77, LG OLED55C3, 4K23.976.
+ */
+static const struct dmi_system_id intel_dp_lspcon_dv_dmi[] = {
+	{
+		/* Intel NUC7i7BNH/BNK (Kaby Lake GT3): MCDP2800 on port B. */
+		.matches = {
+			DMI_MATCH(DMI_BOARD_VENDOR, "Intel Corporation"),
+			DMI_EXACT_MATCH(DMI_BOARD_NAME, "NUC7i7BNB"),
+		},
+	},
+	{ }
+};
+
+/* Port-level checks, at connector init. */
+bool intel_dp_lspcon_dv_allowed(const struct intel_digital_port *dig_port)
+{
+	struct intel_display *display = to_intel_display(&dig_port->base);
+	const struct intel_bios_encoder_data *devdata = dig_port->base.devdata;
+
+	if (!display->params.enable_dv_lab || !display->params.dv_lspcon ||
+	    DISPLAY_VER(display) < 9 || DISPLAY_VER(display) > 10 ||
+	    !intel_bios_encoder_is_lspcon(devdata))
+		return false;
+	return display->params.dv_lspcon > 0 || dmi_check_system(intel_dp_lspcon_dv_dmi);
+}
+
+/* The chip itself, at modeset: an active MegaChips MCDP2800 LSPCON with a
+ * verified firmware (DPCD branch descriptor, read in PCON mode). */
+bool intel_dp_lspcon_dv_route(struct intel_dp *intel_dp)
+{
+	static const struct { u8 major, minor; } fw[] = {
+		{ 1, 77 },
+	};
+	struct intel_digital_port *dig_port = dp_to_dig_port(intel_dp);
+	const struct drm_dp_dpcd_ident *id = &intel_dp->desc.ident;
+	int i;
+
+	if (!intel_dp_lspcon_dv_allowed(dig_port) || !intel_lspcon_active(dig_port) ||
+	    dig_port->lspcon.vendor != LSPCON_VENDOR_MCA ||
+	    memcmp(id->device_id, "MC2800", 6))
+		return false;
+	for (i = 0; i < ARRAY_SIZE(fw); i++)
+		if (id->sw_major_rev == fw[i].major && id->sw_minor_rev == fw[i].minor)
+			return true;
+	return false;
+}
+
 /* The sink behind this port is HDMI through a protocol converter. */
 static bool intel_dp_pcon_dv_route(struct intel_dp *intel_dp)
 {
@@ -6513,6 +6568,13 @@ intel_dp_detect(struct drm_connector *_connector,
 
 	intel_dp_flush_connector_commits(connector);
 
+	/* linux-9931: in level-shifter mode the LSPCON does not answer native
+	 * AUX, and detect must not switch it back (intel_lspcon_resume()). HPD
+	 * follows the TV; keep the EDID and caps read in PCON mode. */
+	if (intel_lspcon_ls_dv_active(dig_port))
+		return intel_digital_port_connected(encoder) ?
+			connector_status_connected : connector_status_disconnected;
+
 	intel_pps_vdd_on(intel_dp);
 
 	/* Can't disconnect eDP */
@@ -7027,6 +7089,11 @@ intel_dp_hpd_pulse(struct intel_digital_port *dig_port, bool long_hpd)
 		    dig_port->base.base.name,
 		    long_hpd ? "long" : "short");
 
+	/* linux-9931: no native AUX in level-shifter mode. A long pulse gets a
+	 * full detect (HPD live state only, see intel_dp_detect()). */
+	if (intel_lspcon_ls_dv_active(dig_port))
+		return long_hpd ? IRQ_NONE : IRQ_HANDLED;
+
 	/*
 	 * TBT DP tunnels require the GFX driver to read out the DPRX caps in
 	 * response to long HPD pulses. The DP hotplug handler does that,
@@ -7140,6 +7207,26 @@ intel_dp_add_properties(struct intel_dp *intel_dp, struct drm_connector *_connec
 						   connector->dv_lab_property, 0);
 	}
 
+	/* linux-9931: Standard DV through the LSPCON in level-shifter mode.
+	 * The DV output is an HDMI-mode DDI behind this DP connector: the
+	 * port's intel_hdmi takes this connector (its DDC is the LSPCON's
+	 * I2C-over-AUX bridge, which carries the dual-mode registers and the
+	 * TV's DDC in both modes) and the adaptor's limits. The chip itself is
+	 * checked at modeset (intel_dp_lspcon_dv_route()). */
+	if (!intel_dp_is_edp(intel_dp) && intel_dp_lspcon_dv_allowed(dp_to_dig_port(intel_dp))) {
+		struct intel_hdmi *hdmi = &dp_to_dig_port(intel_dp)->hdmi;
+
+		hdmi->attached_connector = connector;
+		hdmi->dp_dual_mode.type = DRM_DP_DUAL_MODE_LSPCON;
+		hdmi->dp_dual_mode.max_tmds_clock = 340000;
+		ratelimit_state_init(&connector->dv_log_limit, 30 * HZ, 1);
+		connector->dv_lab_property = drm_property_create_bool(display->drm,
+			DRM_MODE_PROP_ATOMIC, "DVBRIDGE_DV_STANDARD_LAB");
+		if (connector->dv_lab_property)
+			drm_object_attach_property(&connector->base.base,
+						   connector->dv_lab_property, 0);
+	}
+
 	if (intel_dp_has_gamut_metadata_dip(&dp_to_dig_port(intel_dp)->base))
 		drm_connector_attach_hdr_output_metadata_property(&connector->base);
 
