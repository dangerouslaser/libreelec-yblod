+++ b/drivers/gpu/drm/i915/display/intel_dp_link_training.c
@@ -40,6 +40,7 @@
 #include "intel_dp_mst.h"
 #include "intel_encoder.h"
 #include "intel_hdmi.h"
+#include "intel_lspcon.h"
 #include "intel_hotplug.h"
 #include "intel_modeset_lock.h"
 #include "intel_panel.h"
@@ -2621,6 +2622,10 @@ void intel_dp_link_check(struct intel_encoder *encoder)
 	struct drm_modeset_acquire_ctx ctx;
 	int ret;
 
+	/* linux-9931: an HDMI-mode output through the LSPCON, no DP link. */
+	if (intel_lspcon_ls_dv_active(enc_to_dig_port(encoder)))
+		return;
+
 	intel_modeset_lock_ctx_retry(&ctx, NULL, 0, ret)
 		ret = intel_dp_retrain_link(encoder, &ctx);
 }
@@ -2630,7 +2635,7 @@ void intel_dp_check_link_state(struct intel_dp *intel_dp)
 	struct intel_digital_port *dig_port = dp_to_dig_port(intel_dp);
 	struct intel_encoder *encoder = &dig_port->base;
 
-	if (!intel_dp_is_connected(intel_dp))
+	if (!intel_dp_is_connected(intel_dp) || intel_lspcon_ls_dv_active(dig_port))
 		return;
 
 	/*
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index fd6c204bdbaa..0884d1b037ca 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -3084,9 +3084,14 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		struct dvbridge_sink_caps caps = dvbridge_parse_edid(
 			edid ? edid->data : NULL, edid ? edid->length : 0);
 		unsigned int format = to_intel_digital_connector_state(conn_state)->dv_tunnel_format;
+		/* linux-9931: an LSPCON in level-shifter mode passes the GPU's own
+		 * HDMI packets through (intel_dp_lspcon_dv_route()). */
+		bool lspcon_ls = intel_bios_encoder_is_lspcon(encoder->devdata) &&
+			intel_dp_lspcon_dv_route(&enc_to_dig_port(encoder)->dp);
 		struct intel_dv_lab_link link = {
 			.requested = true,
-			.lab_enabled = display->params.enable_dv_lab && DISPLAY_VER(display) >= 12,
+			.lab_enabled = display->params.enable_dv_lab &&
+				(DISPLAY_VER(display) >= 12 || lspcon_ls),
 			/* big-fella: the sink the format needs (dvbridge_tunnel_format.h) */
 			.sink_standard = dvbridge_tunnel_sink(format, &caps, &connector->base),
 			.hdmi = pipe_config->has_hdmi_sink && pipe_config->has_infoframe &&
@@ -3095,6 +3100,7 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 				enc_to_dig_port(encoder)->lspcon.active,
 				enc_to_intel_hdmi(encoder)->dp_dual_mode.type != DRM_DP_DUAL_MODE_NONE,
 				intel_bios_encoder_supports_dp_dual_mode(encoder->devdata)),
+			.verified_bridge = lspcon_ls,
 			.rgb = pipe_config->output_format == INTEL_OUTPUT_FORMAT_RGB &&
 				pipe_config->sink_format == INTEL_OUTPUT_FORMAT_RGB,
 			.limited_range = pipe_config->limited_color_range,
@@ -3114,6 +3120,11 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 		ret = intel_dv_lab_validate(&link);
 		if (!ret)
 			ret = dvbridge_tunnel_hdr_metadata(format, conn_state->hdr_output_metadata);
+		/* Only the Dolby VSIF tunnel was verified in level-shifter mode;
+		 * gen9 HDMI has no DRM InfoFrame DIP for the HDR10 tunnel. */
+		if (!ret && intel_bios_encoder_is_lspcon(encoder->devdata) &&
+		    format != DVBRIDGE_TUNNEL_DV)
+			ret = -EOPNOTSUPP;
 		/* the Dolby block's 2160p60 bit is about TV-led Dolby Vision */
 		if (!ret && format == DVBRIDGE_TUNNEL_DV && link.width == 3840 &&
 		    link.rounded_refresh > 30 && !caps.supports_2160p60)
@@ -3859,6 +3870,64 @@ static u8 intel_hdmi_ddc_pin(struct intel_encoder *encoder)
 	return ddc_pin;
 }
 
+/*
+ * linux-9931: an LSPCON port that can also drive an HDMI-mode Dolby Vision
+ * output (level-shifter mode). The GPU's own DIPs carry the InfoFrames then;
+ * in PCON mode the LSPCON hooks apply as before. During readout the output
+ * type is not known yet when the InfoFrames are read, so the enabled
+ * transcoder's mode decides.
+ */
+static bool lspcon_dv_hdmi(struct intel_encoder *encoder,
+			   const struct intel_crtc_state *crtc_state)
+{
+	struct intel_display *display = to_intel_display(encoder);
+	u32 ctl;
+
+	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI))
+		return true;
+	ctl = intel_de_read(display, TRANS_DDI_FUNC_CTL(display, crtc_state->cpu_transcoder));
+	return (ctl & TRANS_DDI_FUNC_ENABLE) &&
+		(ctl & TRANS_DDI_MODE_SELECT_MASK) == TRANS_DDI_MODE_SELECT_HDMI;
+}
+
+static void lspcon_dv_write_infoframe(struct intel_encoder *encoder,
+				      const struct intel_crtc_state *crtc_state,
+				      unsigned int type, const void *frame, ssize_t len)
+{
+	if (lspcon_dv_hdmi(encoder, crtc_state))
+		hsw_write_infoframe(encoder, crtc_state, type, frame, len);
+	else
+		lspcon_write_infoframe(encoder, crtc_state, type, frame, len);
+}
+
+static void lspcon_dv_read_infoframe(struct intel_encoder *encoder,
+				     const struct intel_crtc_state *crtc_state,
+				     unsigned int type, void *frame, ssize_t len)
+{
+	if (lspcon_dv_hdmi(encoder, crtc_state))
+		hsw_read_infoframe(encoder, crtc_state, type, frame, len);
+	else
+		lspcon_read_infoframe(encoder, crtc_state, type, frame, len);
+}
+
+static void lspcon_dv_set_infoframes(struct intel_encoder *encoder, bool enable,
+				     const struct intel_crtc_state *crtc_state,
+				     const struct drm_connector_state *conn_state)
+{
+	if (intel_crtc_has_type(crtc_state, INTEL_OUTPUT_HDMI))
+		hsw_set_infoframes(encoder, enable, crtc_state, conn_state);
+	else
+		lspcon_set_infoframes(encoder, enable, crtc_state, conn_state);
+}
+
+static u32 lspcon_dv_infoframes_enabled(struct intel_encoder *encoder,
+					const struct intel_crtc_state *crtc_state)
+{
+	if (lspcon_dv_hdmi(encoder, crtc_state))
+		return hsw_infoframes_enabled(encoder, crtc_state);
+	return lspcon_infoframes_enabled(encoder, crtc_state);
+}
+
 void intel_infoframe_init(struct intel_digital_port *dig_port)
 {
 	struct intel_display *display = to_intel_display(dig_port);
