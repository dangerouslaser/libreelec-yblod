@@ -126,8 +156,10 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 
 	intel_hdcp_atomic_check(conn, old_state, new_state);
 
-	if (!new_state->crtc)
+	if (!new_state->crtc) {
+		new_conn_state->dv_lab_standard = false;
 		return 0;
+	}
 
 	crtc_state = drm_atomic_get_new_crtc_state(state, new_state->crtc);
 
@@ -135,7 +167,10 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	 * These properties are handled by fastset, and might not end
 	 * up in a modeset.
 	 */
-	if (new_conn_state->force_audio != old_conn_state->force_audio ||
+	if (new_conn_state->dv_lab_standard != old_conn_state->dv_lab_standard ||
+	    (new_conn_state->dv_lab_standard &&
+	     new_conn_state->dv_tunnel_format != old_conn_state->dv_tunnel_format) ||
+	    new_conn_state->force_audio != old_conn_state->force_audio ||
 	    new_conn_state->broadcast_rgb != old_conn_state->broadcast_rgb ||
