From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 12:00:00 +0000
Subject: [PATCH] drm/i915/hdmi: DVBRIDGE_HDR10_DEEP_COLOR connector property

For HDR10 that a player reconstructs from Dolby Vision, an 8 bpc HDMI
fallback throws away the precision the conversion made. With this
property set (bool, on the HDMI connectors that have the Dolby Vision
tunnel property) the commit needs a PQ HDR_OUTPUT_METADATA and max bpc
>= 10, the link has to come out at 10 bpc or more (YCbCr 4:2:0 is tried
where RGB does not fit), and the sink's TMDS limit is never overridden;
otherwise the commit fails. Never together with
DVBRIDGE_DV_STANDARD_LAB. A change is a full modeset. Ordinary HDR
playback does not set it.

Origin: the native-dv Kodi port's R0.3.0 "Convert to HDR10" output mode
(the GL conversion).

Regrouped from linux-9904-hdr10-conversion (YBLOD 0.2 to 0.4.1); no code
change.
---
 drivers/gpu/drm/i915/display/intel_atomic.c   | 18 +++++++++++++++++
 .../drm/i915/display/intel_display_types.h    |  2 ++
 drivers/gpu/drm/i915/display/intel_hdmi.c     | 20 ++++++++++++++++++-
 3 files changed, 39 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/i915/display/intel_atomic.c b/drivers/gpu/drm/i915/display/intel_atomic.c
index 78622b34db2a..62dd8d05d3f1 100644
--- a/drivers/gpu/drm/i915/display/intel_atomic.c
+++ b/drivers/gpu/drm/i915/display/intel_atomic.c
@@ -70,6 +70,11 @@ int intel_digital_connector_atomic_get_property(struct drm_connector *connector,
 		*val = intel_conn_state->dv_lab_standard;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_hdr10_property &&
+	    property == to_intel_connector(connector)->dv_hdr10_property) {
+		*val = intel_conn_state->dv_hdr10_deep_color;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_format_property &&
 	    property == to_intel_connector(connector)->dv_format_property) {
 		*val = intel_conn_state->dv_tunnel_format;
@@ -117,6 +122,15 @@ int intel_digital_connector_atomic_set_property(struct drm_connector *connector,
 		intel_conn_state->dv_lab_standard = val;
 		return 0;
 	}
+	if (to_intel_connector(connector)->dv_hdr10_property &&
+	    property == to_intel_connector(connector)->dv_hdr10_property) {
+		if (val > 1 || connector->connector_type != DRM_MODE_CONNECTOR_HDMIA)
+			return -EINVAL;
+		if (val && !display->params.enable_dv_lab)
+			return -EOPNOTSUPP;
+		intel_conn_state->dv_hdr10_deep_color = val;
+		return 0;
+	}
 	if (to_intel_connector(connector)->dv_format_property &&
 	    property == to_intel_connector(connector)->dv_format_property) {
 		/* the enum's values only (DRM checks them too) */
@@ -158,8 +172,11 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 
 	if (!new_state->crtc) {
 		new_conn_state->dv_lab_standard = false;
+		new_conn_state->dv_hdr10_deep_color = false;
 		return 0;
 	}
+	if (new_conn_state->dv_lab_standard && new_conn_state->dv_hdr10_deep_color)
+		return -EINVAL;
 
 	crtc_state = drm_atomic_get_new_crtc_state(state, new_state->crtc);
 
@@ -170,6 +187,7 @@ int intel_digital_connector_atomic_check(struct drm_connector *conn,
 	if (new_conn_state->dv_lab_standard != old_conn_state->dv_lab_standard ||
 	    (new_conn_state->dv_lab_standard &&
 	     new_conn_state->dv_tunnel_format != old_conn_state->dv_tunnel_format) ||
+	    new_conn_state->dv_hdr10_deep_color != old_conn_state->dv_hdr10_deep_color ||
 	    new_conn_state->force_audio != old_conn_state->force_audio ||
 	    new_conn_state->broadcast_rgb != old_conn_state->broadcast_rgb ||
 	    new_conn_state->base.colorspace != old_conn_state->base.colorspace ||
diff --git a/drivers/gpu/drm/i915/display/intel_display_types.h b/drivers/gpu/drm/i915/display/intel_display_types.h
index 49dd54cdbfa3..59d45ceb6e8a 100644
--- a/drivers/gpu/drm/i915/display/intel_display_types.h
+++ b/drivers/gpu/drm/i915/display/intel_display_types.h
@@ -525,6 +525,7 @@ struct intel_connector {
 	struct drm_connector base;
 	/* Private experimental property; absent unless explicitly enabled at boot. */
 	struct drm_property *dv_lab_property;
+	struct drm_property *dv_hdr10_property;
 	/* big-fella: DVBRIDGE_TUNNEL_FORMAT (dvbridge_tunnel_format.h) */
 	struct drm_property *dv_format_property;
 	/* Diagnostics only: no influence on DV admission or recovery. */
@@ -625,6 +626,7 @@ struct intel_digital_connector_state {
 	struct drm_connector_state base;
 	/* Scalar copy/reset lifecycle, no property-blob reference to leak. */
 	bool dv_lab_standard;
+	bool dv_hdr10_deep_color;
 	/* big-fella: enum dvbridge_tunnel_format, what the tunnel's bytes are */
 	u8 dv_tunnel_format;
 
diff --git a/drivers/gpu/drm/i915/display/intel_hdmi.c b/drivers/gpu/drm/i915/display/intel_hdmi.c
index 105db8f83651..2656e99b541a 100644
--- a/drivers/gpu/drm/i915/display/intel_hdmi.c
+++ b/drivers/gpu/drm/i915/display/intel_hdmi.c
@@ -2381,7 +2381,9 @@ static bool intel_dvbridge_hdr_deep_requested(struct intel_display *display,
 {
 	const struct hdr_output_metadata *hdr;
 
-	if (!display->params.enable_dv_lab || !display->platform.lunarlake ||
+	if (!display->params.enable_dv_lab ||
+	    (!display->platform.lunarlake &&
+	     !to_intel_digital_connector_state(state)->dv_hdr10_deep_color) ||
 	    to_intel_digital_connector_state(state)->dv_lab_standard ||
 	    state->max_requested_bpc < 10 || !state->hdr_output_metadata ||
 	    state->hdr_output_metadata->length < sizeof(*hdr))
@@ -2508,6 +2510,11 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 
 	if (!intel_link_bw_compute_pipe_bpp(pipe_config))
 		return -EINVAL;
+	/* This opt-in applies only to reconstructed HDR10, never ordinary Kodi HDR.
+	 * A 10-bit framebuffer alone does not prevent an 8-bit HDMI fallback. */
+	if (to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color &&
+	    !intel_dvbridge_hdr_deep_requested(display, conn_state))
+		return -EINVAL;
 
 	pipe_config->has_audio =
 		intel_hdmi_has_audio(encoder, pipe_config, conn_state) &&
@@ -2518,6 +2525,13 @@ int intel_hdmi_compute_config(struct intel_encoder *encoder,
 	 * that fails assume the user might know something we don't.
 	 */
 	ret = intel_hdmi_compute_formats(encoder, pipe_config, conn_state, true);
+	if (!ret && to_intel_digital_connector_state(conn_state)->dv_hdr10_deep_color &&
+	    pipe_config->pipe_bpp < 30) {
+		if (__ratelimit(&connector->dv_log_limit))
+			drm_info(display->drm, "DVBridge HDR10: rejecting sub-10-bit link on connector=%u bpp=%u\n",
+				 connector->base.base.id, pipe_config->pipe_bpp);
+		return -EINVAL;
+	}
 	/* Experimental DV/HDR must never override the sink bandwidth limit. */
 	if (ret && !to_intel_digital_connector_state(conn_state)->dv_lab_standard &&
 	    !intel_dvbridge_hdr_deep_requested(display, conn_state))
@@ -2899,6 +2913,10 @@ intel_hdmi_add_properties(struct intel_hdmi *intel_hdmi, struct drm_connector *_
 			DRM_MODE_PROP_ATOMIC, "DVBRIDGE_DV_STANDARD_LAB");
 		if (connector->dv_lab_property)
 			drm_object_attach_property(&_connector->base, connector->dv_lab_property, 0);
+		connector->dv_hdr10_property = drm_property_create_bool(display->drm,
+			DRM_MODE_PROP_ATOMIC, "DVBRIDGE_HDR10_DEEP_COLOR");
+		if (connector->dv_hdr10_property)
+			drm_object_attach_property(&_connector->base, connector->dv_hdr10_property, 0);
 		/* big-fella: what the tunnel carries (dvbridge_tunnel_format.h) */
 		connector->dv_format_property = dvbridge_tunnel_format_property(display->drm);
 		if (connector->dv_format_property)
