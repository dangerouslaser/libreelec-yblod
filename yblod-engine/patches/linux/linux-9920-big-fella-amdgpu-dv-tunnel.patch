+/* SPDX-License-Identifier: MIT */
+/*
+ * big-fella: the Standard Dolby Vision RGB8 tunnel on amdgpu DC, with the
+ * connector property and semantics of yblod's i915 patches
+ * (DVBRIDGE_DV_STANDARD_LAB). See big-fella's docs/dv-amd.md.
+ */
+#ifndef __AMDGPU_DM_DV_H__
+#define __AMDGPU_DM_DV_H__
+
+#include <linux/types.h>
+
+struct amdgpu_dm_connector;
+struct dm_connector_state;
+struct dc_stream_state;
+struct drm_atomic_commit;
+struct drm_connector;
+struct drm_display_mode;
+struct drm_property;
+
+void amdgpu_dm_dv_attach_property(struct amdgpu_dm_connector *aconnector);
+bool amdgpu_dm_dv_is_property(const struct drm_connector *connector,
+			      const struct drm_property *property);
+int amdgpu_dm_dv_set_property(struct drm_connector *connector,
+			      struct dm_connector_state *state, u64 val);
+int amdgpu_dm_dv_configure_stream(struct drm_connector *connector,
+				  const struct dm_connector_state *state,
+				  const struct drm_display_mode *mode,
+				  struct dc_stream_state *stream);
+int amdgpu_dm_dv_atomic_check(struct drm_atomic_commit *state);
+
+#endif
