+/* linux-9932: the DV tunnel in its HDR10 format sends no Dolby VSIF: Dolby
+ * Vision to HDR10+ sends the engine's PQ picture through it with HDR10+. */
+bool amdgpu_dm_hdr10plus_tunnel(const struct drm_connector_state *conn)
+{
+	const struct dm_connector_state *state = to_dm_connector_state(conn);
+
+	return state->dv_lab_standard && state->dv_tunnel_format == DVBRIDGE_TUNNEL_HDR10;
+}
