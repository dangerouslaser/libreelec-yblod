 		drm_crtc_vblank_get(&acrtc->base);
 }
 
+/*
+ * linux-9932: HDR10+ (CB1 linux-9920/9940/9941, ported to YBLOD's 7.3).
+ * The connector's HDR10PLUS_METADATA blob is a complete, validated 31-byte
+ * HDR10+ VSIF; it becomes the stream's vsp_infopacket.
+ */
+static int amdgpu_dm_hdr10plus_info_packet(const struct drm_property_blob *blob,
+					   struct dc_info_packet *out)
+{
+	const u8 *packet = blob->data;
+	struct dc_info_packet result = {0};
+
+	if (!drm_hdr10plus_infoframe_valid(packet, blob->length))
+		return -EINVAL;
+	result.hb0 = packet[0];
+	result.hb1 = packet[1];
+	result.hb2 = packet[2];
+	memcpy(result.sb, packet + 3, DRM_HDR10PLUS_INFOFRAME_SIZE - 3);
+	result.valid = true;
+	*out = result;
+	return 0;
+}
+
+static int amdgpu_dm_hdr10plus_stream_packet(const struct drm_property_blob *blob,
+					     struct dc_stream_state *stream,
+					     const struct drm_display_mode *mode)
+{
+	int ret;
+
+	if (stream->timing.hdmi_vic) {
+		u8 vic = drm_match_cea_mode(mode);
+
+		if (!vic)
+			return -EINVAL;
+		/* HDR10+ owns the vendor packet; the timing goes in AVI. */
+		stream->timing.vic = vic;
+		stream->timing.hdmi_vic = 0;
+	}
+	ret = amdgpu_dm_hdr10plus_info_packet(blob, &stream->vsp_infopacket);
+	if (!ret)
+		stream->hdr10plus = true;
+	return ret;
+}
+
+/*
+ * Every commit that carries an HDR10+ blob must carry the CRTC's primary
+ * framebuffer too (@frame_mask, taken before helpers add planes): the packet
+ * goes out in the same stream update as that surface. Native HDMI TMDS, a
+ * real >= 10 bpc stream, no DV tunnel, no HDMI VIC, no 3D, no async flip.
+ */
+static int amdgpu_dm_hdr10plus_atomic_check(struct drm_atomic_commit *state,
+					    u32 frame_mask)
+{
+	struct drm_connector *connector;
+	struct drm_connector_state *conn;
+	int i;
+
+	for_each_new_connector_in_state(state, connector, conn, i) {
+		struct drm_crtc_state *crtc_state;
+		struct drm_plane_state *primary;
+		struct dc_stream_state *stream;
+
+		if (!conn->hdr10plus_metadata)
+			continue;
+		crtc_state = conn->crtc ? drm_atomic_get_new_crtc_state(state, conn->crtc) : NULL;
+		stream = crtc_state ? to_dm_crtc_state(crtc_state)->stream : NULL;
+		primary = conn->crtc ?
+			drm_atomic_get_new_plane_state(state, conn->crtc->primary) : NULL;
+		if (!stream || !(frame_mask & drm_crtc_mask(conn->crtc)) ||
+		    drm_connector_check_hdr10plus(conn, amdgpu_dm_hdr10plus_tunnel(conn)) ||
+		    (to_dm_connector_state(conn)->dv_lab_standard &&
+		     !amdgpu_dm_hdr10plus_tunnel(conn)) ||
+		    !crtc_state->active || !primary || primary->crtc != conn->crtc ||
+		    !primary->fb || !to_dm_plane_state(primary)->dc_state ||
+		    !stream->hdr10plus || stream->signal != SIGNAL_TYPE_HDMI_TYPE_A ||
+		    stream->timing.hdmi_vic ||
+		    /* the HDR10 tunnel's 8 bpc stream carries 12-bit 4:2:2 */
+		    (amdgpu_dm_convert_dc_color_depth_into_bpc(stream->timing.display_color_depth) < 10 &&
+		     !amdgpu_dm_hdr10plus_tunnel(conn)) ||
+		    crtc_state->async_flip ||
+		    (crtc_state->mode.flags & DRM_MODE_FLAG_3D_MASK)) {
+			drm_dbg_atomic(connector->dev,
+				       "[CONNECTOR:%d:%s] HDR10+ refused (frame %d, stream %d)\n",
+				       connector->base.id, connector->name,
+				       conn->crtc ? !!(frame_mask & drm_crtc_mask(conn->crtc)) : 0,
+				       stream ? stream->hdr10plus : -1);
+			return -EINVAL;
+		}
+	}
+	return 0;
+}
