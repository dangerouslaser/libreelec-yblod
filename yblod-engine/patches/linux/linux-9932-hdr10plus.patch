+ *
+ * YBLOD: a connector without a CRTC, or on a CRTC switched off (active=0),
+ * sends no packet. Drop the blob there rather than failing the commit that
+ * disables the output; userspace supplies a new one with the next frame.
+ */
+void drm_connector_hdr10plus_drop_inactive(struct drm_atomic_commit *state,
+					   struct drm_connector_state *conn_state)
+{
+	struct drm_crtc_state *crtc_state;
+
+	if (!conn_state->hdr10plus_metadata)
+		return;
+	if (conn_state->crtc) {
+		crtc_state = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+		if (!crtc_state || crtc_state->active)
+			return;
+	}
