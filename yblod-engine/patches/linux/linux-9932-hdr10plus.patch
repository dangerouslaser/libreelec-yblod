+								new_stream, &new_crtc_state->mode);
+			if (ret)
+				goto fail;
+		}
+
 		/*
 		 * If we already removed the old stream from the context
 		 * (and set the new stream to NULL) then we can't reuse
@@ -5494,6 +5615,8 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 		if (amdgpu_freesync_vid_mode &&
 		    dm_new_crtc_state->stream &&
 		    dm_new_conn_state->dv_lab_standard == dm_old_conn_state->dv_lab_standard &&
+		    !!drm_new_conn_state->hdr10plus_metadata ==
+		    !!drm_old_conn_state->hdr10plus_metadata &&
 		    amdgpu_dm_is_timing_unchanged_for_freesync(new_crtc_state, old_crtc_state))
 			goto skip_modeset;
 
@@ -6155,6 +6278,9 @@ static int amdgpu_dm_atomic_check(struct drm_device *dev,
 	struct drm_dp_mst_topology_state *mst_state;
 	struct dsc_mst_fairness_vars vars[MAX_PIPES] = {0};
 
+	/* linux-9932: before any helper adds planes to the request */
+	u32 hdr10plus_primary_mask = drm_atomic_hdr10plus_frame_mask(state);
+
 	trace_amdgpu_dm_atomic_check_begin(state);
 
 	ret = drm_atomic_helper_check_modeset(dev, state);
@@ -6634,6 +6760,11 @@ static int amdgpu_dm_atomic_check(struct drm_device *dev,
 	if (ret)
 		goto fail;
 
+	/* linux-9932: HDR10+ on the final state */
+	ret = amdgpu_dm_hdr10plus_atomic_check(state, hdr10plus_primary_mask);
+	if (ret)
+		goto fail;
+
 	/* Must be success */
 	WARN_ON(ret);
 
