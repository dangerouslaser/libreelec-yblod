+  m_vulkan = new CDVPrivateVulkan;
+  return m_vulkan->Initialize(display, fd, window->GetGBMDevice().Get(),
+                              m_scanout->Buffer(0), m_scanout->Buffer(1));
+}
+
+bool CDVPrivateSource::CloseVulkan()
+{
+  // Nothing was presented yet: the engine's imports go before their GBM storage.
+  glFinish();
+  if (m_vulkan)
+  {
+    if (!m_vulkan->Close()) return false;
+    delete m_vulkan;
+    m_vulkan = nullptr;
+  }
+  if (m_scanout)
+  {
+    if (!m_scanout->Close()) return false;
+    delete m_scanout;
+    m_scanout = nullptr;
+  }
+  return true;
+}
