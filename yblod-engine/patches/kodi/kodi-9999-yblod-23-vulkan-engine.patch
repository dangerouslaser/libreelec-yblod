new file mode 100644
index 0000000..11c94a4
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include "source_geometry.h"
+#include "source_input.h"
+#include "DVPrivateOverlay.h"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <gbm.h>
+#include <dv-engine-vk/dv_engine_vk.h>
+#include <cstddef>
+#include <cstdint>
+
+/* yblod's engine on Vulkan compute (libdv_engine_vk.so.0, yblod-engine/vk),
+ * selected with DV_ENGINE_VULKAN=1 (Settings > Player > Dolby Vision > Vulkan
+ * engine). It writes the two private scanout buffers itself and reads the GUI
+ * from a GBM copy of Kodi's GUI texture; no OpenCL and no CL-GL interop.
+ * Frames are submitted without waiting (DV_VULKAN_ASYNC=0 waits for each):
+ * the engine puts the frame's fence on the scanout buffer as an implicit
+ * write fence, which the atomic commit waits for, and the caller keeps the
+ * decoded surfaces until Done() reports the ticket complete. */
+class CDVPrivateVulkan
+{
+public:
+  static constexpr int DV_VULKAN_FAILED = -8; // dv_status DV_BACKEND
+  /* The setting, or a display driver other than i915/xe. */
+  static bool Requested(int drmFd);
+  bool Initialize(void* vaDisplay, int drmFd, gbm_device* device, gbm_bo* output0, gbm_bo* output1);
+  /* 0 the picture is in the slot (submitted; Ticket() names it); -2 not this
+   * engine's frame (ordinary picture); -8 the engine or a wait failed
+   * (outputs uncertain); other negative: rejected, nothing written. */
+  int Render(unsigned slot, unsigned blSurface, unsigned elSurface, const void* metadata,
+             size_t size, int64_t pts, const dv_source_geometry& geometry,
+             const dv_source_input& input, unsigned packet, bool refresh,
+             const DVPrivateOverlay* overlay);
+  bool Async() const { return m_async; }
+  uint64_t Ticket() const { return m_ticket; }
+  /* 1 frame `ticket` is complete (its error flags logged), 0 still running
+   * (with wait, after the timeout), -8 failure. */
+  int Done(uint64_t ticket, int64_t pts, bool wait);
+  void Reset();
+  bool Close();
+private:
+  bool InitializeGui(gbm_device* device, unsigned index);
+  bool CopyGui(const DVPrivateOverlay& overlay, unsigned index);
+  int Complete(uint64_t ticket, int64_t pts, bool wait, bool& range);
+  void* m_library{nullptr};
+  dvvk_engine* m_engine{nullptr};
+  decltype(&dvvk_create) m_create{nullptr};
+  decltype(&dvvk_set_output) m_setOutput{nullptr};
+  decltype(&dvvk_set_overlay) m_setOverlay{nullptr};
+  decltype(&dvvk_submit) m_submit{nullptr};
+  decltype(&dvvk_poll) m_poll{nullptr};
+  decltype(&dvvk_wait) m_wait{nullptr};
+  decltype(&dvvk_reset) m_reset{nullptr};
+  decltype(&dvvk_destroy) m_destroy{nullptr};
+  decltype(&dvvk_set_overlay_ex) m_setOverlayEx{nullptr};     // optional
+  decltype(&dvvk_implicit_failed) m_implicitFailed{nullptr};  // optional
+  decltype(&dvvk_overlay_changes) m_overlayChanges{nullptr};  // optional
+  // Kodi's GUI revision against the pixels the engine found changed: a
+  // revision that stays while pixels change would make it unsafe to skip
+  // the GUI on an unchanged revision (the 0.2.1 controls flicker).
+  struct RevisionCheck
+  {
+    uint64_t ticket{0}, revision{0};
+  } m_revisions[8];
+  uint64_t m_lastRevision{0};
+  uint64_t m_sameRevision{0}, m_sameChanged{0}, m_newRevision{0}, m_newUnchanged{0};
+  void CheckRevision(uint64_t ticket);
+  void LogRevisions(const char* when) const;
+  // Two GUI copies: a new GUI goes into the one no frame in flight reads.
+  struct Gui
+  {
+    gbm_bo* bo{nullptr};
+    EGLImageKHR image{EGL_NO_IMAGE_KHR};
+    unsigned texture{0}, framebuffer{0};
+    int fd{-1};
+    dvvk_dmabuf dmabuf{};
+    uint64_t ticket{0}; // the last frame submitted reading it
+  } m_guis[2];
+  EGLDisplay m_display{EGL_NO_DISPLAY};
+  PFNEGLDESTROYIMAGEKHRPROC m_destroyImage{nullptr};
+  unsigned m_readFramebuffer{0}, m_guiIndex{0};
+  DVPrivateOverlay m_gui{};
+  bool m_guiShown{false}, m_async{true};
+  bool m_guiDirect{false}; // the engine reads Kodi's GUI framebuffer in place
+  uint64_t m_guiId{0}, m_ticket{0};
+  unsigned m_elScaler{1}, m_reports{0}, m_colourReports{0}, m_rangeReports{0};
+  bool m_fel{true};
+};
