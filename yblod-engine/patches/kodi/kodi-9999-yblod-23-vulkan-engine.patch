--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
@@ -0,0 +1,379 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVPrivateVulkan.h"
+#include "utils/log.h"
+#include <GLES3/gl3.h>
+#include <drm_fourcc.h>
+#include <dlfcn.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+bool EnvIs(const char* name, const char* value)
+{
+  const char* current = std::getenv(name);
+  return current && std::strcmp(current, value) == 0;
+}
+} // namespace
+
+bool CDVPrivateVulkan::Requested(int drmFd)
+{
+  if (EnvIs("DV_ENGINE_VULKAN", "1"))
+    return true;
+  // yblod's OpenCL engine runs on Intel only: on other display drivers
+  // (amdgpu) the Vulkan engine is the only one.
+  drmVersionPtr version = drmFd >= 0 ? drmGetVersion(drmFd) : nullptr;
+  if (!version)
+    return false;
+  const bool intel = std::strcmp(version->name, "i915") == 0 || std::strcmp(version->name, "xe") == 0;
+  if (!intel)
+    CLog::Log(LOGINFO, "Vulkan engine: display driver {} has no OpenCL engine", version->name);
+  drmFreeVersion(version);
+  return !intel;
+}
+
+bool CDVPrivateVulkan::Initialize(void* vaDisplay, int drmFd, gbm_device* device,
+                                  gbm_bo* output0, gbm_bo* output1)
+{
+  if (m_library || !vaDisplay || drmFd < 0 || !device || !output0 || !output1) return false;
+  const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+  if (!library || !library[0]) library = "libdv_engine_vk.so.0";
+  m_library = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+  if (!m_library)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine load failed: {}", dlerror());
+    return false;
+  }
+#define LOAD(member, symbol) member = reinterpret_cast<decltype(member)>(dlsym(m_library, #symbol)); if (!member) { CLog::Log(LOGERROR, "Vulkan engine: no {} in {}", #symbol, library); return false; }
+  LOAD(m_create, dvvk_create);
+  LOAD(m_setOutput, dvvk_set_output);
+  LOAD(m_setOverlay, dvvk_set_overlay);
+  LOAD(m_submit, dvvk_submit);
+  LOAD(m_poll, dvvk_poll);
+  LOAD(m_wait, dvvk_wait);
+  LOAD(m_reset, dvvk_reset);
+  LOAD(m_destroy, dvvk_destroy);
+#undef LOAD
+  // Reading Kodi's GUI framebuffer in place needs the flag and the read fences.
+  m_setOverlayEx = reinterpret_cast<decltype(m_setOverlayEx)>(dlsym(m_library, "dvvk_set_overlay_ex"));
+  m_implicitFailed = reinterpret_cast<decltype(m_implicitFailed)>(dlsym(m_library, "dvvk_implicit_failed"));
+  m_overlayChanges = reinterpret_cast<decltype(m_overlayChanges)>(dlsym(m_library, "dvvk_overlay_changes"));
+  // The engine logs its reasons on stderr (the journal).
+  if (m_create(drmFd, vaDisplay, &m_engine) != 0 || !m_engine)
+  {
+    m_engine = nullptr;
+    CLog::Log(LOGERROR, "Vulkan engine did not start (no Vulkan device for the DRM node?)");
+    return false;
+  }
+  gbm_bo* outputs[2]{output0, output1};
+  for (unsigned slot = 0; slot < 2; ++slot)
+  {
+    const int fd = gbm_bo_get_fd(outputs[slot]);
+    // The engine imports its own duplicate.
+    const int result = fd < 0 ? -1 : m_setOutput(m_engine, slot, fd, gbm_bo_get_stride(outputs[slot]));
+    if (fd >= 0) close(fd);
+    if (result != 0)
+    {
+      CLog::Log(LOGERROR, "Vulkan engine could not import scanout buffer {}", slot);
+      return false;
+    }
+  }
+  const char* scaler = std::getenv("DV_EL_SCALER");
+  m_elScaler = scaler && (std::strcmp(scaler, "0") == 0 || std::strcmp(scaler, "nearest") == 0) ? 0 : 1;
+  m_fel = !EnvIs("DV_FEL", "0");
+  m_async = !EnvIs("DV_VULKAN_ASYNC", "0");
+  if (!InitializeGui(device, 0) || !InitializeGui(device, 1)) return false;
+  glGenFramebuffers(1, &m_readFramebuffer);
+  CLog::Log(LOGINFO, "Vulkan engine started ({}): el_scaler={} fel={} async={}", library, m_elScaler,
+            m_fel, m_async);
+  return true;
+}
+
+bool CDVPrivateVulkan::InitializeGui(gbm_device* device, unsigned index)
+{
+  // The engine reads the GUI as a dmabuf, top row first: a linear RGBA8 copy
+  // of Kodi's GUI texture (byte for byte, flipped by the blit when needed).
+  Gui& gui = m_guis[index];
+  m_display = eglGetCurrentDisplay();
+  auto create = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+  m_destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+  using Target = void (*)(GLenum, void*);
+  auto target = reinterpret_cast<Target>(eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  if (!create || !m_destroyImage || !target || m_display == EGL_NO_DISPLAY) return false;
+  gui.bo = gbm_bo_create(device, 3840, 2160, GBM_FORMAT_ABGR8888,
+                         GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+  if (!gui.bo) return false;
+  gui.fd = gbm_bo_get_fd(gui.bo);
+  if (gui.fd < 0) return false;
+  const uint32_t stride = gbm_bo_get_stride(gui.bo);
+  const EGLint attrs[] = {EGL_WIDTH, 3840, EGL_HEIGHT, 2160, EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ABGR8888,
+      EGL_DMA_BUF_PLANE0_FD_EXT, gui.fd, EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+      EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(stride), EGL_NONE};
+  gui.image = create(m_display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+  if (gui.image == EGL_NO_IMAGE_KHR) return false;
+  GLint texture, draw;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  glGenTextures(1, &gui.texture);
+  glBindTexture(GL_TEXTURE_2D, gui.texture);
+  target(GL_TEXTURE_2D, gui.image);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glGenFramebuffers(1, &gui.framebuffer);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, gui.framebuffer);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, gui.texture, 0);
+  const bool complete = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  if (!complete || glGetError() != GL_NO_ERROR) return false;
+  gui.dmabuf.width = 3840;
+  gui.dmabuf.height = 2160;
+  gui.dmabuf.format = DRM_FORMAT_ABGR8888;
+  gui.dmabuf.modifier = DRM_FORMAT_MOD_LINEAR;
+  gui.dmabuf.num_planes = 1;
+  gui.dmabuf.fd[0] = gui.fd;
+  gui.dmabuf.fd[1] = gui.dmabuf.fd[2] = gui.dmabuf.fd[3] = -1;
+  gui.dmabuf.stride[0] = stride;
+  return true;
+}
+
+bool CDVPrivateVulkan::CopyGui(const DVPrivateOverlay& overlay, unsigned index)
+{
+  GLint read, draw;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST), dither = glIsEnabled(GL_DITHER);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_DITHER);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, m_readFramebuffer);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, overlay.texture, 0);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_guis[index].framebuffer);
+  if (overlay.flipY)
+    glBlitFramebuffer(0, 0, 3840, 2160, 0, 2160, 3840, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  else
+    glBlitFramebuffer(0, 0, 3840, 2160, 0, 0, 3840, 2160, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  if (scissor) glEnable(GL_SCISSOR_TEST);
+  if (dither) glEnable(GL_DITHER);
+  // Flushed, the blit's fence is on the dmabuf; the engine waits for it on the GPU.
+  glFlush();
+  return glGetError() == GL_NO_ERROR;
+}
+
+int CDVPrivateVulkan::Render(unsigned slot, unsigned blSurface, unsigned elSurface,
+                             const void* metadata, size_t size, int64_t pts,
+                             const dv_source_geometry& geometry, const dv_source_input& input,
+                             unsigned packet, bool refresh, const DVPrivateOverlay* overlay)
+{
+  if (!m_engine || !m_guis[0].bo || !m_guis[1].bo) return DV_VULKAN_FAILED;
+  m_guiDirect = overlay && overlay->dmabufFd >= 0 && m_setOverlayEx && m_implicitFailed;
+  if (m_guiDirect)
+  {
+    // Kodi's GUI framebuffer, read in place. Every frame: the engine compares
+    // its pixels with the last ones it prepared. Flushed, the GUI's writes
+    // are fenced on the buffer, and the engine's read fence on it makes the
+    // next GUI drawing wait on the GPU.
+    glFlush();
+    dvvk_dmabuf gui{};
+    gui.width = 3840;
+    gui.height = 2160;
+    gui.format = overlay->dmabufFormat;
+    gui.modifier = overlay->dmabufModifier;
+    gui.num_planes = 1;
+    gui.fd[0] = overlay->dmabufFd;
+    gui.fd[1] = gui.fd[2] = gui.fd[3] = -1;
+    gui.offset[0] = overlay->dmabufOffset;
+    gui.stride[0] = overlay->dmabufStride;
+    if (m_setOverlayEx(m_engine, &gui, ++m_guiId, DVVK_OVERLAY_FLIP_Y) != 0)
+    {
+      m_guiShown = false;
+      return -1;
+    }
+    m_gui = *overlay;
+    m_guiShown = true;
+  }
+  else if (overlay)
+  {
+    // A nonzero revision names unchanged contents; without one, copy every frame.
+    if (!m_guiShown || !overlay->SameContents(m_gui))
+    {
+      // Into the other copy, once the last frame that read it is done.
+      const unsigned next = m_guiShown ? m_guiIndex ^ 1u : m_guiIndex;
+      if (m_guis[next].ticket && Done(m_guis[next].ticket, pts, true) != 1) return DV_VULKAN_FAILED;
+      if (!CopyGui(*overlay, next) || m_setOverlay(m_engine, &m_guis[next].dmabuf, ++m_guiId) != 0)
+      {
+        m_guiShown = false;
+        return -1;
+      }
+      m_guiIndex = next;
+      m_gui = *overlay;
+      m_guiShown = true;
+    }
+  }
+  else if (m_guiShown)
+  {
+    if (m_setOverlay(m_engine, nullptr, 0) != 0) return -1;
+    m_guiShown = false;
+  }
+  const bool resized = geometry.destination_width &&
+      (geometry.destination_width != geometry.width || geometry.destination_height != geometry.height);
+  dvvk_frame frame{};
+  frame.plan.width = geometry.width;
+  frame.plan.height = geometry.height;
+  frame.plan.x = geometry.x;
+  frame.plan.y = geometry.y;
+  frame.plan.dw = resized ? geometry.destination_width : 0;
+  frame.plan.dh = resized ? geometry.destination_height : 0;
+  frame.plan.chroma_top_left = geometry.chroma_siting == DV_SOURCE_CHROMA_TOP_LEFT;
+  frame.plan.has_el = elSurface != UINT32_MAX;
+  frame.plan.nv12 = input.format == DV_SOURCE_INPUT_NV12;
+  frame.plan.el_scaler = m_elScaler;
+  frame.plan.fel = m_fel;
+  frame.plan.packet_id = packet;
+  frame.plan.refresh = refresh;
+  frame.plan.pts = pts;
+  // The GUI colour stays that of the last GUI, so hiding it changes no coefficients.
+  const DVPrivateOverlay& colour = overlay ? *overlay : m_gui;
+  std::memcpy(frame.plan.rgb_to_lms, colour.rgbToLms, sizeof(frame.plan.rgb_to_lms));
+  frame.plan.white_nits = colour.whiteNits;
+  frame.bl_surface = blSurface;
+  frame.el_surface = elSurface;
+  frame.metadata = metadata;
+  frame.metadata_size = size;
+  frame.output = slot;
+  frame.flags = DVVK_FRAME_AUTO_OVERLAY;
+  uint64_t ticket = 0;
+  const int result = m_submit(m_engine, &frame, &ticket);
+  if (result != 0)
+  {
+    if (m_reports < 16)
+    {
+      ++m_reports;
+      CLog::Log(LOGWARNING, "Vulkan engine {} frame pts={} ({}): {}x{}{} at {},{}",
+                result == -2 ? "does not take this" : "failed on", pts, result,
+                geometry.width, geometry.height, frame.plan.has_el ? " + EL" : "", geometry.x, geometry.y);
+    }
+    return result;
+  }
+  m_ticket = ticket;
+  if (m_guiShown && !m_guiDirect) m_guis[m_guiIndex].ticket = ticket;
+  if (m_guiDirect)
+    m_revisions[ticket % 8] = {ticket, overlay->revisionSeen};
+  // Without implicit fences (an older kernel) the GUI framebuffer must not
+  // be drawn into before the engine has read it.
+  const bool fenced = !m_implicitFailed || !m_implicitFailed(m_engine);
+  if (m_async && (fenced || !m_guiDirect)) return 0;
+  // Synchronous: written means GPU complete, and an out-of-range sample
+  // rejects the picture, as with the OpenCL engine.
+  bool range = false;
+  const int done = Complete(ticket, pts, true, range);
+  if (done != 1) return DV_VULKAN_FAILED;
+  return range ? -4 : 0;
+}
+
+int CDVPrivateVulkan::Done(uint64_t ticket, int64_t pts, bool wait)
+{
+  bool range = false;
+  return Complete(ticket, pts, wait, range);
+}
+
+int CDVPrivateVulkan::Complete(uint64_t ticket, int64_t pts, bool wait, bool& range)
+{
+  if (!m_engine) return DV_VULKAN_FAILED;
+  if (wait && m_wait(m_engine, ticket, 2000000000ull) != 1)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine frame pts={} did not complete", pts);
+    return DV_VULKAN_FAILED;
+  }
+  int done = 0;
+  uint32_t flags = 0;
+  if (m_poll(m_engine, ticket, &done, &flags) != 0) return DV_VULKAN_FAILED;
+  if (!done) return wait ? DV_VULKAN_FAILED : 0;
+  CheckRevision(ticket);
+  range = (flags & 3u) != 0;
+  if (range && m_rangeReports < 16)
+  {
+    // Submitted without waiting, the picture is already on its way to the display.
+    ++m_rangeReports;
+    CLog::Log(LOGERROR, "Vulkan engine range check failed pts={} flags={:#x}{}", pts, flags,
+              m_async ? " (already presented)" : "");
+  }
+  if ((flags & 0x100u) && m_colourReports < 8)
+  {
+    ++m_colourReports;
+    CLog::Log(LOGWARNING, "Vulkan engine: overlay colour out of range, shown clamped (pts={})", pts);
+  }
+  return 1;
+}
+
+void CDVPrivateVulkan::CheckRevision(uint64_t ticket)
+{
+  RevisionCheck& entry = m_revisions[ticket % 8];
+  if (!m_overlayChanges || entry.ticket != ticket)
+    return;
+  entry.ticket = 0;
+  const int64_t changed = m_overlayChanges(m_engine, ticket);
+  if (changed < 0)
+  {
+    m_lastRevision = 0;   // no comparison across an invalidated cache
+    return;
+  }
+  if (m_lastRevision && entry.revision == m_lastRevision)
+  {
+    ++m_sameRevision;
+    if (changed > 0 && ++m_sameChanged <= 8)
+      CLog::Log(LOGWARNING, "Vulkan GUI check: revision {} unchanged but {} pixels changed", entry.revision, changed);
+  }
+  else if (m_lastRevision)
+  {
+    ++m_newRevision;
+    m_newUnchanged += changed == 0;
+  }
+  m_lastRevision = entry.revision;
+  if ((m_sameRevision + m_newRevision) % 1200 == 0)
+    LogRevisions("so far");
+}
+
+void CDVPrivateVulkan::LogRevisions(const char* when) const
+{
+  if (m_sameRevision + m_newRevision)
+    CLog::Log(LOGINFO, "Vulkan GUI check ({}): {} frames on the same revision ({} with changed pixels), "
+              "{} on a new revision ({} with no changed pixel)", when, m_sameRevision, m_sameChanged,
+              m_newRevision, m_newUnchanged);
+}
+
+void CDVPrivateVulkan::Reset()
+{
+  if (m_engine) m_reset(m_engine);
+  m_reports = 0;
+}
+
+bool CDVPrivateVulkan::Close()
+{
+  LogRevisions("at close");
+  if (m_engine)
+  {
+    if (m_ticket && m_wait(m_engine, m_ticket, 2000000000ull) != 1) return false;
+    m_destroy(m_engine);
+    m_engine = nullptr;
+  }
+  for (Gui& gui : m_guis)
+  {
+    if (gui.framebuffer) glDeleteFramebuffers(1, &gui.framebuffer);
+    if (gui.texture) glDeleteTextures(1, &gui.texture);
+    if (gui.image != EGL_NO_IMAGE_KHR) m_destroyImage(m_display, gui.image);
+    if (gui.fd >= 0) close(gui.fd);
+    if (gui.bo) gbm_bo_destroy(gui.bo);
+    gui = Gui{};
+  }
+  if (m_readFramebuffer) glDeleteFramebuffers(1, &m_readFramebuffer);
+  m_readFramebuffer = 0;
+  m_guiIndex = 0;
+  m_ticket = 0;
+  m_guiShown = false;
+  if (m_library) dlclose(m_library);
+  m_library = nullptr;
+  return true;
+}
