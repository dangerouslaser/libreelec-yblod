+void CWinSystemGbmGLESContext::CleanupGuiFbo()
+{
+  // The texture goes first, then its storage.
+  m_guiFbo.Cleanup();
+  if (m_guiImage != EGL_NO_IMAGE_KHR)
+  {
+    auto destroy = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+    if (destroy)
+      destroy(m_eglContext.GetEGLDisplay(), m_guiImage);
+  }
+  if (m_guiBoFd >= 0)
+    close(m_guiBoFd);
+  if (m_guiBo)
+    gbm_bo_destroy(m_guiBo);
+  m_guiImage = EGL_NO_IMAGE_KHR;
+  m_guiBoFd = -1;
+  m_guiBo = nullptr;
+}
