+bool CDVPrivateSource::RetireVulkan(bool wait)
+{
+  // In submission order; with wait, all of them.
+  while (!m_inFlight.empty())
+  {
+    InFlight& frame = m_inFlight.front();
+    const int done = m_vulkan ? m_vulkan->Done(frame.ticket, frame.pts, wait) : CDVPrivateVulkan::DV_VULKAN_FAILED;
+    if (done == 0) return true;
+    if (done != 1)
+    {
+      // The surfaces may still be read: keep their leases.
+      m_unsafe = true;
+      CLog::Log(LOGFATAL, "Private source Vulkan frame pts={} did not complete; retaining frame leases; restart Kodi", frame.pts);
+      return false;
+    }
+    frame.enhancement.reset();
+    if (frame.owner) frame.owner->Release();
+    m_inFlight.pop_front();
+  }
+  return true;
+}
