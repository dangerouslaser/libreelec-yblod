     m_guiHalfBound = false;
@@ -431,6 +433,86 @@ void CWinSystemGbmGLESContext::SetScissors(const CRect& rect)
     ScaleGuiRaster(false);
 }
 
+bool CWinSystemGbmGLESContext::ShareGuiFbo(int width, int height)
+{
+  auto create = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+  using Target = void (*)(GLenum, void*);
+  auto target = reinterpret_cast<Target>(eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  gbm_device* device = GetGBMDevice().Get();
+  if (!create || !target || !device || !m_guiFbo.IsValid())
+    return false;
+  // The driver's layout if it names it in one plane, else linear.
+  const uint32_t layouts[] = {GBM_BO_USE_RENDERING, GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR};
+  for (const uint32_t flags : layouts)
+  {
+    m_guiBo = gbm_bo_create(device, width, height, GBM_FORMAT_ABGR8888, flags);
+    if (m_guiBo && gbm_bo_get_plane_count(m_guiBo) == 1 &&
+        ((flags & GBM_BO_USE_LINEAR) || gbm_bo_get_modifier(m_guiBo) != DRM_FORMAT_MOD_INVALID))
+      break;
+    if (m_guiBo)
+      gbm_bo_destroy(m_guiBo);
+    m_guiBo = nullptr;
+  }
+  if (!m_guiBo)
+    return false;
+  m_guiBoFd = gbm_bo_get_fd(m_guiBo);
+  m_guiBoStride = gbm_bo_get_stride(m_guiBo);
+  m_guiBoOffset = gbm_bo_get_offset(m_guiBo, 0);
+  m_guiBoModifier = gbm_bo_get_modifier(m_guiBo);
+  if (m_guiBoModifier == DRM_FORMAT_MOD_INVALID)
+    m_guiBoModifier = DRM_FORMAT_MOD_LINEAR;
+  if (m_guiBoFd < 0)
+    return false;
+  const EGLint attrs[] = {EGL_WIDTH, width, EGL_HEIGHT, height,
+      EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ABGR8888,
+      EGL_DMA_BUF_PLANE0_FD_EXT, m_guiBoFd,
+      EGL_DMA_BUF_PLANE0_OFFSET_EXT, static_cast<EGLint>(m_guiBoOffset),
+      EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(m_guiBoStride),
+      EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, static_cast<EGLint>(m_guiBoModifier & 0xffffffff),
+      EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, static_cast<EGLint>(m_guiBoModifier >> 32), EGL_NONE};
+  m_guiImage = create(m_eglContext.GetEGLDisplay(), EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+  if (m_guiImage == EGL_NO_IMAGE_KHR)
+    return false;
+  // The FBO's texture takes the buffer as its storage (its sampling state stays).
+  GLint texture, framebuffer;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &framebuffer);
+  glBindTexture(GL_TEXTURE_2D, m_guiFbo.Texture());
+  target(GL_TEXTURE_2D, m_guiImage);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  bool complete = m_guiFbo.BeginRender();
+  if (complete)
+  {
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, m_guiFbo.Texture(), 0);
+    complete = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+  }
+  glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+  if (!complete || glGetError() != GL_NO_ERROR)
+    return false;
