+
+struct dvbridge_candidate *dvbridge_prepare_graphics(
+    const struct dvbridge_context *context, unsigned min_pq, unsigned max_pq,
+    unsigned avg_pq, double pts)
+{
+    if (!context || !(min_pq <= avg_pq && avg_pq <= max_pq && max_pq <= 4095))
+        return NULL;
+    size_t size = 0;
+    AVDOVIMetadata *graphics = av_dovi_metadata_alloc(&size);
+    if (!graphics)
+        return NULL;
+    AVDOVIRpuDataHeader *header = av_dovi_get_header(graphics);
+    AVDOVIColorMetadata *color = av_dovi_get_color(graphics);
+    header->disable_residual_flag = 1;
+    color->signal_eotf = 65535;
+    color->signal_color_space = 0;
+    color->source_min_pq = min_pq;
+    color->source_max_pq = max_pq;
+    graphics->num_ext_blocks = 1;
+    AVDOVIDmData *l1 = av_dovi_get_ext(graphics, 0);
+    memset(l1, 0, sizeof(*l1));
+    l1->level = 1;
+    l1->l1.min_pq = min_pq;
+    l1->l1.max_pq = max_pq;
+    l1->l1.avg_pq = avg_pq;
+    const struct dvbridge_geometry geometry = {3840, 2160, 0, 0, 3840, 2160};
+    struct dvbridge_candidate *candidate =
+        dvbridge_prepare(context, graphics, size, pts, geometry, false);
+    av_free(graphics);
+    return candidate;
+}
+
+bool dvbridge_fel_active(const void *metadata, size_t bytes)
+{
+    if (!metadata || (uintptr_t)metadata % _Alignof(AVDOVIMetadata) ||
+        !dvbridge_dv_bounds(metadata, bytes))
+        return false;
+    const AVDOVIMetadata *m = metadata;
+    return !av_dovi_get_header(m)->disable_residual_flag && !dvbridge_dv_is_mel(m);
+}
