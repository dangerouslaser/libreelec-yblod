From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 13:24:59 -0500
Subject: [PATCH] kodi: retry a refused restore of the display after Dolby
 Vision

EndDVBridge() clears every flag that says who owns the tunnel's output
(menu, held stop, startup) and then commits the ordinary display back.
When that commit was refused, nothing remembered it: the output stayed
captured with no owner, PresentRender() found no Dolby Vision picture
to present, and Kodi's GUI was never shown again under the tunnel's
signal until another video happened to start.

A refused restore now sets m_dvRestorePending, and PresentRender()
calls EndDVBridge() again while it is set, spaced by the retry delay
the DRM layer already keeps for rejected Dolby Vision commits (a
restore itself is never held back by it). The flag is dropped as soon
as something takes the captured output again: the menu output, a held
stop, or a video whose BeginDVBridge() finds the output ready.

Once the restore commit is taken, GUI compositing is switched back
before the bridge is asked to retire its scanout buffers, so a bridge
that cannot (an engine that did not drain) no longer leaves the GUI
composed for the tunnel on an ordinary signal.
---
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 42 ++++++++++++++++---
 xbmc/windowing/gbm/WinSystemGbmGLESContext.h  |  3 ++
 2 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 4bc8712..f527e40 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -221,6 +221,7 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 
   if (m_dvExitPending)
   {
+    m_dvRestorePending = false;
     if (!m_dvExitDeadline.IsTimePast())
     {
       // Hold the last DV frame until the refresh restore: GUI pixels must never be scanned
@@ -238,10 +239,26 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 
   if (m_dvMenu)
   {
+    m_dvRestorePending = false;
     PresentDVMenu(rendered);
     sendPendingDisplayReset();
     return;
   }
+  if (m_dvRestorePending && m_dvState.Captured())
+  {
+    // The signal is still the tunnel's and no GUI page is shown under it. The restore is
+    // tried again, spaced by the output's retry delay like any rejected commit.
+    auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+    if ((!drm || drm->DVRetryReady()) && EndDVBridge())
+    {
+      m_dvBridge.reset();
+      CLog::Log(LOGINFO, "DVBridge: normal display restored on a later attempt");
+    }
+    else
+      KODI::TIME::Sleep(10ms);
+    sendPendingDisplayReset();
+    return;
+  }
   if (m_dvState.Captured())
   {
     bool presented = false;
@@ -1148,7 +1165,13 @@ bool CWinSystemGbmGLESContext::BeginDVBridge()
       m_renderableType != EGL_OPENGL_ES3_BIT)
     return failure("output-format");
   if (m_dvState.Captured())
-    return m_dvBridge && m_guiCompositing && m_compositeShader;
+  {
+    // Video takes the output as it is, also one a refused restore left behind.
+    const bool ready = m_dvBridge && m_guiCompositing && m_compositeShader;
+    if (ready)
+      m_dvRestorePending = false;
+    return ready;
+  }
   auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
   if (!drm)
     return failure("atomic-output-unavailable");
@@ -1299,7 +1322,10 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
   m_dvFrame = false;
   // Never reset Kodi's ordinary HDR GUI compositor unless we owned DV output.
   if (!m_dvState.Captured())
+  {
+    m_dvRestorePending = false;
     return true;
+  }
   {
     // Restore signaling with a clean ordinary framebuffer, never tunnel pixels.
     glBindFramebuffer(GL_FRAMEBUFFER, 0);
@@ -1310,6 +1336,9 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
     glFinish();
     if (!m_eglContext.TrySwapBuffers() || !FlipDVBridgePage(m_dvState, true))
     {
+      // The state flags above are cleared: without this nothing would come back here, and
+      // the GUI would stay unseen under the tunnel's signal.
+      m_dvRestorePending = true;
       if (DVBRIDGE::DiagnosticsEnabled() &&
           m_dvSetupFailures.Record(DVBRIDGE::DiagnosticNowMs(), "restore"))
         CLog::Log(LOGERROR, "DVBridge: output restoration failed; retaining scanout state; failures={}",
@@ -1317,15 +1346,18 @@ bool CWinSystemGbmGLESContext::EndDVBridge()
       return false;
     }
   }
+  m_dvRestorePending = false;
+  if (DVBRIDGE::DiagnosticsEnabled() &&
+      m_dvSetupFailures.Recovered(DVBRIDGE::DiagnosticNowMs()))
+    CLog::Log(LOGINFO, "DVBridge: normal display restored after failures={}", m_dvSetupFailures.Count());
+  // The ordinary signal is on the display: the GUI is composed for it from here on, whatever
+  // the bridge's own retirement says.
+  SetGuiCompositing(0);
   if (m_dvBridge)
   {
     if (!m_dvBridge->DisplayReplaced()) return false;
     m_dvBridge->Reset();
   }
-  if (DVBRIDGE::DiagnosticsEnabled() &&
-      m_dvSetupFailures.Recovered(DVBRIDGE::DiagnosticNowMs()))
-    CLog::Log(LOGINFO, "DVBridge: normal display restored after failures={}", m_dvSetupFailures.Count());
-  SetGuiCompositing(0);
   return true;
 }
 
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
index a1a4728..fdf115a 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.h
@@ -154,6 +154,9 @@ private:
   XbmcThreads::EndTime<> m_dvModesetDeadline;
   bool m_dvExitPending = false;
   bool m_dvRestoreWithModeset = false;
+  // EndDVBridge() could not commit the ordinary display back: nothing owns the tunnel's
+  // output any more, and PresentRender() tries the restore again until it is taken.
+  bool m_dvRestorePending = false;
   XbmcThreads::EndTime<> m_dvExitDeadline;
   // Menu output (dvbridge.menumode): while no video is shown, the GUI is packed into the DV
   // transport with static graphics metadata. Native DV video takes this output over and hands it
