--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
@@ -351,7 +351,7 @@ bool CDVPrivateVulkan::MasterReference()
 }
 
 bool CDVPrivateVulkan::Initialize(void* vaDisplay, int drmFd, gbm_device* device,
-                                  gbm_bo* output0, gbm_bo* output1)
+                                  gbm_bo* output0, gbm_bo* output1, bool masterReference)
 {
   if (m_library || !vaDisplay || drmFd < 0 || !device || !output0 || !output1) return false;
   const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
@@ -416,7 +416,7 @@ bool CDVPrivateVulkan::Initialize(void* vaDisplay, int drmFd, gbm_device* device
   //  annexb   Annex B (Master Reference): CB1 Master Reference's processing
   //           (cb1_contract) for unscaled pictures, the Annex B EL filter for all;
   //  bilinear yblod's own processing with the bilinear EL pass, for every picture.
-  m_cb1 = MasterReference();
+  m_cb1 = masterReference;
   m_elScaler = m_cb1 ? kElScalerAnnexB : kElScalerBilinear;
   m_fel = !EnvIs("DV_FEL", "0");
   m_async = !EnvIs("DV_VULKAN_ASYNC", "0");
@@ -798,6 +798,10 @@ void CDVPrivateVulkan::Reset()
     }
   }
   m_last.valid = false;
+  // CB1's refresh rule starts over: the next picture is a first one.
+  m_cb1Frames = 0;
+  m_cb1LastPts = 0;
+  m_cb1Refresh = true;
   m_reports = 0;
   m_lastDmStatus = UINT32_MAX;
   m_dmReports = 0;
