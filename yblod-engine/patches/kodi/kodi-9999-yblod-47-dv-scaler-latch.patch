index 45010f9..329b505 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -35,10 +35,9 @@ unsigned SourcePlaneSiting(bool enhancement, int location)
 // upscaling Annex B, DVPrivateVulkan) sites an unscaled picture as CB1 does:
 // top-left when the stream says so (also with an EL), or unspecified in
 // Profile 7 (an EL, or a MEL's undecoded one); left otherwise.
-bool VulkanCB1(int baseWidth, int baseHeight, const dvbridge_geometry& geometry)
+bool VulkanCB1(bool masterReference, int baseWidth, int baseHeight, const dvbridge_geometry& geometry)
 {
-  return CDVPrivateVulkan::MasterReference() && geometry.width == baseWidth &&
-         geometry.height == baseHeight;
+  return masterReference && geometry.width == baseWidth && geometry.height == baseHeight;
 }
 
 unsigned PlaneSiting(bool cb1, bool profile7, int location)
@@ -157,7 +156,8 @@ bool CDVBridgeGLES::PrepareHardware(const Layer& decoded, const AVFrame* enhance
     if (!m_wasSource) m_source->Reset();
     const dv_source_geometry placement{static_cast<unsigned>(base.width), static_cast<unsigned>(base.height),
                                        3840, 2160, static_cast<unsigned>(geometry.x), static_cast<unsigned>(geometry.y),
-                                       PlaneSiting(VulkanCB1(base.width, base.height, geometry),
+                                       PlaneSiting(VulkanCB1(m_source->MasterReference(), base.width,
+                                                             base.height, geometry),
                                                    enhancement || base.pairedSiting, base.chromaPosition),
                                        static_cast<unsigned>(geometry.width), static_cast<unsigned>(geometry.height)};
     const dv_source_input input{sizeof(dv_source_input),
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp
index c8fa322..1e3cdbf 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp
@@ -81,6 +81,13 @@ void CDVPrivateSource::ReleasePool()
   av_buffer_unref(&m_poolFrames);
 }
 
+bool CDVPrivateSource::MasterReference()
+{
+  if (m_masterReference < 0)
+    m_masterReference = CDVPrivateVulkan::MasterReference();
+  return m_masterReference != 0;
+}
+
 bool CDVPrivateSource::Initialize(void* display)
 {
   if (eglGetCurrentContext() == EGL_NO_CONTEXT)
@@ -108,7 +115,7 @@ bool CDVPrivateSource::Initialize(void* display)
     {
       m_vulkan = new CDVPrivateVulkan;
       if (m_vulkan->Initialize(display, fd, window->GetGBMDevice().Get(), m_scanout->Buffer(0),
-                               m_scanout->Buffer(1)))
+                               m_scanout->Buffer(1), MasterReference()))
       {
         m_display = display;
         CLog::Log(LOGINFO, "Private source direct scanout initialized: two cached buffers, Vulkan engine");
@@ -126,7 +133,7 @@ bool CDVPrivateSource::Initialize(void* display)
 
 bool CDVPrivateSource::CloseVulkan()
 {
-  // Nothing was presented yet: the engine's imports go before their GBM storage.
+  // The engine's imports go before their GBM storage.
   glFinish();
   if (m_vulkan)
   {
@@ -134,6 +141,7 @@ bool CDVPrivateSource::CloseVulkan()
     delete m_vulkan;
     m_vulkan = nullptr;
   }
+  m_masterReference = -1;
   // A buffer on screen stays until the display has been handed back (Close()).
   if (m_scanout && m_scanout->CanClose())
   {
@@ -155,6 +163,7 @@ bool CDVPrivateSource::DestroyEngine()
     delete m_vulkan;
     m_vulkan = nullptr;
   }
+  m_masterReference = -1;
   for (InFlight& frame : m_inFlight)
   {
     frame.enhancement.reset();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h
index a4ed31e..504701c 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h
@@ -37,6 +37,11 @@ public:
   void Reset();
   void Presented(bool success);
   gbm_bo* ScanoutBuffer() const;
+  /* The enhancement layer upscaling of this adapter's engine: read from the
+   * setting once, before the engine starts, and kept while that engine lives.
+   * The chroma siting chosen for each picture and the engine's contract must
+   * come from the same value, also when the setting changes during a title. */
+  bool MasterReference();
   bool DisplayReplaced();
 private:
   bool Initialize(void* display);
@@ -99,6 +104,7 @@ private:
   // until a later drain succeeds (DisplayReplaced(), Close()).
   bool m_ready{false}, m_unsafe{false}, m_startFailed{false};
   // Engine failures answered by draining, destroying and starting it again.
+  int m_masterReference{-1};
   unsigned m_recoveries{0};
   uint64_t m_recoveryMark{0};
   std::chrono::steady_clock::time_point m_unsafeChecked{};
