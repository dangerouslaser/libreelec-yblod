+namespace
+{
+// The stream WantsNativeOutput() last announced, and the playback it belonged to. The
+// player, the codec factory, the codec and the demuxer each ask, and ask again at seeks: the
+// answer is a query, and only a new stream starts the telemetry over and is logged.
+struct AnnouncedStream
+{
+  uint64_t playback{0};
+  unsigned profile{0}, level{0}, major{0}, minor{0}, compatibility{0}, width{0}, height{0};
+  bool bl{false}, el{false}, rpu{false}, software{false}, interlaced{false}, stereo{false};
+  bool eligible{false}, mastering{false}, light{false};
+  int mode{0};
+  int maxLuminance[2]{}, minLuminance[2]{};
+  unsigned maxCLL{0}, maxFALL{0};
+  bool operator==(const AnnouncedStream&) const = default;
+};
+std::mutex announcedMutex;
+AnnouncedStream announced;
+bool announcedAny{false};
+// Counts the videos that have ended (SetVideoOutput without a picture).
+std::atomic<uint64_t> playbacksEnded{0};
+} // namespace
