diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h
new file mode 100644
index 0000000..81b5476
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "ServiceBroker.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "settings/lib/ISettingCallback.h"
+#include "settings/lib/Setting.h"
+#include "settings/SettingsContainer.h"
+#include "utils/log.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+/*!
+ * Settings > Player > Dolby Vision: the settings the Vulkan engine path reads
+ * through the environment (normally set by native-dv.env). The values are
+ * applied once at window-system start, before any playback, and again whenever
+ * a setting changes; they take precedence over native-dv.env. Every managed
+ * variable is defined at start, so a later change only replaces an existing
+ * value and never grows the environment table that other threads may be
+ * reading. Each is read when a video starts (the engine is made per video).
+ *
+ * The other Dolby Vision settings are read by Kodi itself: dvbridge.outputmode
+ * and dvbridge.enhancedinfo (DVOutputSettings.h, per video), the menu output's
+ * (live).
+ */
+namespace DVEngineSettings
+{
+using Values = std::vector<std::pair<const char*, std::string>>;
+using Settings = std::shared_ptr<CSettings>;
+struct Mapping
+{
+  const char* setting;
+  Values (*values)(const Settings& settings);
+};
+
+inline Values Bool(const Settings& settings, const char* id, const Values& on, const Values& off)
+{
+  return settings->GetBool(id) ? on : off;
+}
+
+inline const std::vector<Mapping>& Mappings()
+{
+  static const std::vector<Mapping> mappings = {
+      // Video
+      // Enhancement layer upscaling: Annex B (Master Reference) or Bilinear (DVPrivateVulkan:
+      // cb1_contract and plan.el_scaler).
+      {"dvbridge.elupscaler",
+       [](const Settings& s) -> Values {
+         return {{"DV_EL_SCALER", s->GetInt("dvbridge.elupscaler") == 1 ? "bilinear" : "annexb"}};
+       }},
+      // Dolby Vision metadata: Original, CM4.0 auto (CB1's Auto 2 with the TV's peak; Auto by
+      // the mastering peak without one), CM4.0 always (DVPrivateVulkan DmOptions).
+      {"dvbridge.dvmetadata",
+       [](const Settings& s) -> Values {
+         switch (s->GetInt("dvbridge.dvmetadata"))
+         {
+           case 1:
+             return {{"DV_VULKAN_CM4", "auto2"}};
+           case 2:
+             return {{"DV_VULKAN_CM4", "always"}};
+           default:
+             return {{"DV_VULKAN_CM4", "off"}};
+         }
+       }},
+      {"dvbridge.removel2",
+       [](const Settings& s) { return Bool(s, "dvbridge.removel2", {{"DV_VULKAN_NO_L2", "1"}},
+                                           {{"DV_VULKAN_NO_L2", "0"}}); }},
+      // 0: from the TV's EDID (DVPrivateVulkan).
+      {"dvbridge.tvpeak",
+       [](const Settings& s) -> Values {
+         const int nits = s->GetInt("dvbridge.tvpeak");
+         return {{"DV_VULKAN_TV_PEAK",
+                  std::to_string(nits > 0 && nits <= 10000 ? nits : 0)}};
+       }},
+      // Performance (Kodi's GUI composition over the video)
+      {"dvbridge.guicache",
+       [](const Settings& s) { return Bool(s, "dvbridge.guicache", {{"DV_PRIVATE_GUI_CACHE", "1"}},
+                                           {{"DV_PRIVATE_GUI_CACHE", "0"}}); }},
+      {"dvbridge.homecache",
+       [](const Settings& s) { return Bool(s, "dvbridge.homecache",
+                                           {{"DV_PRIVATE_GUI_CACHE_HOME", "1"}},
+                                           {{"DV_PRIVATE_GUI_CACHE_HOME", "0"}}); }},
+      {"dvbridge.halfgui",
+       [](const Settings& s) { return Bool(s, "dvbridge.halfgui", {{"DV_PRIVATE_GUI_HALF", "1"}},
+                                           {{"DV_PRIVATE_GUI_HALF", "0"}}); }},
+      // Diagnostics (the Vulkan engine's own, options.rs; read when an engine is made)
+      // Every 60th frame rendered again by the engine's staged reference route and compared.
+      {"dvbridge.verify",
+       [](const Settings& s) { return Bool(s, "dvbridge.verify", {{"DVVK_VERIFY", "60"}},
+                                           {{"DVVK_VERIFY", "0"}}); }},
+      // Kodi's first-480-frame startup timing lines and the engine's per-frame deadline JSON.
+      {"dvbridge.frametrace",
+       [](const Settings& s) { return Bool(s, "dvbridge.frametrace",
+                                           {{"DV_PRIVATE_FRAME_TIMING", "1"}, {"DVVK_DEADLINE_TRACE", "1"}},
+                                           {{"DV_PRIVATE_FRAME_TIMING", "0"}, {"DVVK_DEADLINE_TRACE", "0"}}); }},
+      // GPU time per pass over 120 frames.
+      {"dvbridge.gputiming",
+       [](const Settings& s) { return Bool(s, "dvbridge.gputiming", {{"DVVK_PROFILE", "1"}},
+                                           {{"DVVK_PROFILE", "0"}}); }},
+  };
+  return mappings;
+}
+
+/*!
+ * Settings of YBLOD 0.3 that 0.4.0 removed with the OpenCL engine and the
+ * compatibility renderer. Kodi keeps no values for settings it does not
+ * define; the migration below saves the settings once so these are dropped
+ * from guisettings.xml instead of lingering until the next change.
+ */
+inline constexpr const char* kRemovedSettings[] = {
+    "dvbridge.engine",        "dvbridge.vulkan",     "dvbridge.elnearest",
+    "dvbridge.letterboxskip", "dvbridge.inlineoverlay", "dvbridge.tablecache",
+    "dvbridge.packahead",     "dvbridge.chromaupscaler", "dvbridge.qsvmode",
+    "dvbridge.matchhardware",
+};
+inline constexpr int kSettingsVersion = 2; // 0.4.0: the Vulkan-only menu
+
+inline void Apply(const Values& values)
+{
+  for (const auto& [name, value] : values)
+  {
+    const char* current = std::getenv(name);
+    if (!current || value != current)
+      setenv(name, value.c_str(), 1);
+  }
+}
+
+class Callback : public ISettingCallback
+{
+public:
+  void OnSettingChanged(const std::shared_ptr<const CSetting>& setting) override
+  {
+    if (!setting)
+      return;
+    const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+    for (const auto& mapping : Mappings())
+      if (setting->GetId() == mapping.setting)
+      {
+        const Values values = mapping.values(settings);
+        Apply(values);
+        for (const auto& [name, value] : values)
+          CLog::Log(LOGINFO, "Dolby Vision setting {}: {}={}", mapping.setting, name, value);
+      }
+  }
+};
+
+//! Apply all settings and watch for changes. Call once settings are loaded.
+inline void Register()
+{
+  static bool registered = false;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (registered || !settings)
+    return;
+  registered = true;
+  SettingsContainer ids;
+  for (const auto& mapping : Mappings())
+  {
+    Apply(mapping.values(settings));
+    ids.insert(mapping.setting);
+  }
+  static Callback callback;
+  settings->RegisterCallback(&callback, ids);
+  CLog::Log(LOGINFO, "Dolby Vision settings applied ({} settings)", ids.size());
+  if (settings->GetInt("dvbridge.settingsversion") < kSettingsVersion)
+  {
+    settings->SetInt("dvbridge.settingsversion", kSettingsVersion);
+    settings->Save();
+    std::string removed;
+    for (const char* id : kRemovedSettings)
+      removed += std::string(removed.empty() ? "" : ", ") + id;
+    CLog::Log(LOGINFO, "Dolby Vision settings migrated to version {}: removed {}", kSettingsVersion,
+              removed);
+  }
+}
+} // namespace DVEngineSettings
diff --git a/xbmc/dialogs/DVPixelFormat.h b/xbmc/dialogs/DVPixelFormat.h
new file mode 100644
index 0000000..17d77b4
--- /dev/null
+++ b/xbmc/dialogs/DVPixelFormat.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <string>
+extern "C"
+{
+#include <libavutil/pixdesc.h>
+}
+
+namespace DVBRIDGE
+{
+// Describe the decoded source, never the opaque hardware surface or HDMI tunnel.
+inline std::string SourcePixelFormat(AVPixelFormat format)
+{
+  const auto* desc = av_pix_fmt_desc_get(format);
+  if (!desc || (desc->flags & AV_PIX_FMT_FLAG_HWACCEL))
+    return {};
+  if (desc->flags & AV_PIX_FMT_FLAG_RGB)
+    return "RGB 4:4:4";
+  if (desc->nb_components < 3)
+    return "Grayscale";
+  if (desc->log2_chroma_w == 1 && desc->log2_chroma_h == 1)
+    return "YUV 4:2:0";
+  if (desc->log2_chroma_w == 1 && desc->log2_chroma_h == 0)
+    return "YUV 4:2:2";
+  if (desc->log2_chroma_w == 0 && desc->log2_chroma_h == 0)
+    return "YUV 4:4:4";
+  return desc->name ? desc->name : "";
+}
+}
