+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cstdint>
+#include <iosfwd>
+#include <map>
+#include <optional>
+#include <string>
+
+namespace DVBRIDGE
+{
+// Shared by playback diagnostics and the information panel. No GPU synchronization.
+class RenderUsage
+{
+public:
+  struct Client
+  {
+    std::string device;
+    uint64_t busy{};
+    unsigned capacity{1};
+  };
+  using Clients = std::map<std::string, Client>;
+
+  // Adds the i915/xe render client an fdinfo describes; true if it describes a DRM file.
+  static bool Parse(std::istream& input, Clients& clients);
+  std::optional<double> Update(const Clients& current, uint64_t now, uint64_t maxGap = 3000000000ULL);
+  std::optional<double> Sample(uint64_t maxGap = 3000000000ULL);
+  void Reset();
+
+private:
+  Clients m_previous;
+  uint64_t m_time{};
+  // Which of the process's descriptors are DRM files, by fdinfo name, so a sample opens only
+  // those; forgotten every RESCAN_NS, as a descriptor number can be reused for another file.
+  std::map<std::string, bool> m_drm;
+  uint64_t m_scanTime{};
+};
+}
