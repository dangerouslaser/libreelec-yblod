diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
new file mode 100644
index 0000000..3aa8f33
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
@@ -0,0 +1,211 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "ServiceBroker.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "settings/lib/SettingDefinitions.h"
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace DVBRIDGE
+{
+// Settings > Player > Dolby Vision > Output mode (dvbridge.outputmode). The values are stored in
+// guisettings.xml, so they keep their meaning: a new output takes the next free value, is offered
+// by OutputModeOptions where the connection has it, and is accepted by SelectOutputSettings below.
+enum class OutputMode : int { Standard = 0, HDR10 = 1, Disabled = 2, HDR10Plus = 3 };
+
+// Playback preparation latches the preferences. An open settings dialog must not
+// change the output encoding of an already running playback session.
+inline std::atomic<OutputMode> playbackMode{OutputMode::Standard};
+
+// HDR10 output through the tunnel: the Vulkan engine's HDR10 (the Master
+// Reference conversion, dvvk_set_output_mode) sent as the tunnel's 12-bit
+// YCbCr 4:2:2 with DVBRIDGE_TUNNEL_FORMAT hdr10 (linux-9928). The window sets
+// it for the output it begins (OutputMode HDR10 where the connector has it)
+// and clears it at the end; the engine reads it for every frame.
+inline std::atomic<bool> playbackTunnelHDR10{false};
+
+// Dolby Vision -> HDR10+ (OutputMode HDR10Plus): the tunnel's HDR10 output
+// (playbackTunnelHDR10 is set too) with the engine in DVVK_OUTPUT_HDR10PLUS and
+// each picture's HDR10+ vendor InfoFrame in the connector's HDR10PLUS_METADATA
+// (linux-9932), committed with that picture. The window sets it with
+// playbackTunnelHDR10 where the TV and the connector have HDR10+, and
+// playbackHDR10PlusFlags (DVVK_HDR10PLUS_*) from the TV's HDR10+ VSVDB.
+inline std::atomic<bool> playbackTunnelHDR10Plus{false};
+inline std::atomic<uint32_t> playbackHDR10PlusFlags{0};
+// Set once the engine could not represent a picture as HDR10+ (or the kernel
+// refused the packets): the rest of the title is HDR10 (the Master Reference
+// conversion) and the property is cleared. Cleared when the output ends.
+inline std::atomic<bool> playbackHDR10PlusFallback{false};
+
+// Settings > Player > Dolby Vision > HDR10+ videos (dvbridge.hdr10plussources), latched per
+// video: 1 plays HDR10+ titles as Dolby Vision (Profile 8.1 with metadata made from each
+// picture's HDR10+, dvvk_hdr10plus_to_dovi), 0 as Kodi plays them today.
+inline std::atomic<bool> playbackHDR10PlusToDV{false};
+
+// The HDR static metadata (CTA-861.3 type 1 units) of the last tunnel picture
+// the engine made in HDR10, for the HDR_OUTPUT_METADATA the tunnel's link
+// carries. The film's (L6 or its source peak, L9's primaries), so it changes
+// with the film, not the scene.
+struct TunnelHDR10Signal
+{
+  uint16_t primaries[3][2]{}; // R, G, B x, y in 0.00002
+  uint16_t white[2]{};
+  uint16_t maxLuminance{0};   // cd/m2
+  uint16_t minLuminance{0};   // 0.0001 cd/m2
+  uint16_t maxCll{0}, maxFall{0};
+  bool operator==(const TunnelHDR10Signal&) const = default;
+};
+
+namespace detail
+{
+inline std::mutex tunnelSignalLock;
+inline TunnelHDR10Signal tunnelSignal;
+inline bool tunnelSignalValid{false};
+} // namespace detail
+
+// The engine, after each frame: the picture's signal, or nullptr (a Dolby Vision picture).
+inline void PublishTunnelHDR10(const TunnelHDR10Signal* signal)
+{
+  std::lock_guard lock(detail::tunnelSignalLock);
+  detail::tunnelSignalValid = signal != nullptr;
+  detail::tunnelSignal = signal ? *signal : TunnelHDR10Signal{};
+}
+
+// The window, at the flip: whether the last picture is HDR10, and its signal.
+inline bool CurrentTunnelHDR10(TunnelHDR10Signal& signal)
+{
+  std::lock_guard lock(detail::tunnelSignalLock);
+  signal = detail::tunnelSignal;
+  return detail::tunnelSignalValid;
+}
+
+// The HDR10+ packet of the last tunnel picture (DVVK_OUTPUT_HDR10PLUS), for the
+// HDR10PLUS_METADATA of the commit that shows it.
+struct TunnelHDR10PlusPacket
+{
+  enum class State
+  {
+    None, // no HDR10+ (not an HDR10+ picture, or the fallback to HDR10): the property is 0
+    Keep, // no statistics for this picture yet: the property stays as it is
+    Send, // vsif: the picture's 31-byte HDR10+ vendor InfoFrame
+  };
+  State state{State::None};
+  uint8_t vsif[31]{};
+};
+
+namespace detail
+{
+inline TunnelHDR10PlusPacket tunnelPacket;
+} // namespace detail
+
+// The engine, after each frame.
+inline void PublishTunnelHDR10Plus(const TunnelHDR10PlusPacket& packet)
+{
+  std::lock_guard lock(detail::tunnelSignalLock);
+  detail::tunnelPacket = packet;
+}
+
+// The window, at the flip.
+inline TunnelHDR10PlusPacket CurrentTunnelHDR10Plus()
+{
+  std::lock_guard lock(detail::tunnelSignalLock);
+  return detail::tunnelPacket;
+}
+
+// Settings > Player > Dolby Vision > Output mode: the values this connection
+// has (settings.xml's "dvbridgeoutputmodes" filler, WinSystemGbmGLESContext).
+void OutputModeOptions(const std::shared_ptr<const CSetting>& setting,
+                       IntegerSettingOptions& list,
+                       int& current);
+
+// Settings > Player > Dolby Vision > HDR10+ videos is shown: a Dolby Vision TV on this
+// connection and an engine that converts HDR10+ (settings condition "dvbridgehdr10plustodv",
+// WinSystemGbmGLESContext).
+bool HDR10PlusToDVAvailable(const std::string& condition,
+                            const std::string& value,
+                            const std::shared_ptr<const CSetting>& setting);
+
+inline void SelectOutputSettings()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int mode = settings ? settings->GetInt("dvbridge.outputmode") : 0;
+  switch (static_cast<OutputMode>(mode))
+  {
+    case OutputMode::Standard:
+    case OutputMode::HDR10:
+    case OutputMode::Disabled:
+    case OutputMode::HDR10Plus:
+      playbackMode.store(static_cast<OutputMode>(mode));
+      break;
+    default:
+      playbackMode.store(OutputMode::Standard);
+      break;
+  }
+  playbackHDR10PlusToDV.store(settings && settings->GetInt("dvbridge.hdr10plussources") == 1);
+}
+
+// GUI white in the menu output (dvbridge.menubrightness). Read live, as the setting can change while
+// the menu is shown.
+inline float MenuWhiteNits()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int nits = settings ? settings->GetInt("dvbridge.menubrightness") : 400;
+  switch (nits)
+  {
+    case 203:
+    case 300:
+    case 500:
+    case 600:
+    case 800:
+      return static_cast<float>(nits);
+    default:
+      return 400.0f;
+  }
+}
+
+// Read live: the menu output follows the settings without a playback.
+inline bool MenuModeEnabled()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.menumode") &&
+         settings->GetInt("dvbridge.outputmode") == static_cast<int>(OutputMode::Standard);
+}
+
+// Menu look (Dolby Vision menu only), read live like the brightness.
+inline float MenuSaturation()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int percent = settings ? settings->GetInt("dvbridge.menusaturation") : 100;
+  return percent >= 50 && percent <= 200 ? percent / 100.0f : 1.0f;
+}
+
+inline unsigned MenuGamma()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  const int gamma = settings ? settings->GetInt("dvbridge.menugamma") : 0;
+  return gamma >= 0 && gamma <= 2 ? static_cast<unsigned>(gamma) : 0u;
+}
+
+inline bool MenuWideColour()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.menuwidecolour");
+}
+
+inline bool EnhancedInfoEnabled()
+{
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  return settings && settings->GetBool("dvbridge.enhancedinfo");
+}
+} // namespace DVBRIDGE
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
new file mode 100644
index 0000000..f15d49a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <atomic>
+#include <string>
+
+// The render thread publishes one coherent snapshot only after presentation.
+// This is output telemetry, never a source-format or TV certification flag.
+struct CDVPlaybackInfo
+{
+  enum : unsigned { HDMI = 1, FEL = 2, CM4 = 4, HDR10 = 8 };
+  inline static std::atomic<unsigned> presented{0};
+
+  static std::string Detail(std::string source, unsigned output)
+  {
+    if (!(output & (HDMI | HDR10)))
+      return source;
+    if ((output & FEL) && source.find("FEL") == std::string::npos)
+      source += " FEL";
+    source += (output & CM4) ? " · CM4" : " · CM2.9";
+    return source + ((output & HDR10) ? " · HDR10 output" : " · HDMI DV");
+  }
+};
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h
new file mode 100644
index 0000000..691c40a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVStreamTelemetry.h
@@ -0,0 +1,154 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <mutex>
+
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+#include <libavutil/mastering_display_metadata.h>
+#include <libavutil/pixfmt.h>
+}
+
+namespace DVBRIDGE
+{
+struct StreamSnapshot
+{
+  unsigned profile{}, level{}, major{}, minor{};
+  bool bl{}, el{}, rpu{}, metadata{}, cm4{}, fel{};
+  bool l1{}, l5{}, l6{};
+  std::array<unsigned, 3> pq{};
+  std::array<unsigned, 4> area{};
+  unsigned maxMaster{}, minMaster{}, maxCLL{}, maxFALL{};
+  unsigned framebufferBits{}, sourceBits{};
+  AVPixelFormat sourceFormat{AV_PIX_FMT_NONE};
+  int dropped{}, skipped{};
+  bool counters{};
+  bool sourceMastering{}, sourceLight{};
+  double sourceMax{}, sourceMin{};
+  unsigned sourceCLL{}, sourceFALL{};
+};
+
+class StreamTelemetry
+{
+public:
+  inline static std::atomic<bool> observing{false};
+
+  static void SourceBits(unsigned bits, AVPixelFormat format)
+  {
+    m_sourceBits.store(bits, std::memory_order_relaxed);
+    m_sourceFormat.store(format, std::memory_order_relaxed);
+  }
+
+  static void Counters(int dropped, int skipped)
+  {
+    m_dropped.store(dropped, std::memory_order_relaxed);
+    m_skipped.store(skipped, std::memory_order_relaxed);
+    m_counters.store(true, std::memory_order_relaxed);
+  }
+
+  static void StaticMetadata(const AVMasteringDisplayMetadata* mastering,
+                             const AVContentLightMetadata* light)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (mastering && mastering->has_luminance &&
+        mastering->max_luminance.den > 0 && mastering->min_luminance.den > 0)
+    {
+      m_snapshot.sourceMastering = true;
+      m_snapshot.sourceMax = av_q2d(mastering->max_luminance);
+      m_snapshot.sourceMin = av_q2d(mastering->min_luminance);
+    }
+    if (light)
+    {
+      m_snapshot.sourceLight = true;
+      m_snapshot.sourceCLL = light->MaxCLL;
+      m_snapshot.sourceFALL = light->MaxFALL;
+    }
+  }
+
+  static void Begin(unsigned profile, unsigned level, unsigned major, unsigned minor,
+                    bool bl, bool el, bool rpu)
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_snapshot = {};
+    m_counters.store(false, std::memory_order_relaxed);
+    m_sourceBits.store(0, std::memory_order_relaxed);
+    m_sourceFormat.store(AV_PIX_FMT_NONE, std::memory_order_relaxed);
+    m_snapshot.profile = profile;
+    m_snapshot.level = level;
+    m_snapshot.major = major;
+    m_snapshot.minor = minor;
+    m_snapshot.bl = bl;
+    m_snapshot.el = el;
+    m_snapshot.rpu = rpu;
+    m_next = {};
+  }
+
+  // Called on the renderer thread only, after its metadata bounds validation.
+  static void Metadata(const AVDOVIMetadata* data, bool fel, unsigned bits)
+  {
+    if (!observing.load(std::memory_order_relaxed))
+      return;
+    const auto now = std::chrono::steady_clock::now();
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (now < m_next)
+      return;
+    m_next = now + std::chrono::milliseconds(500);
+    auto& out = m_snapshot;
+    out.metadata = true;
+    out.fel = fel;
+    out.framebufferBits = bits;
+    out.l1 = out.l5 = out.l6 = out.cm4 = false;
+    for (int i = 0; i < data->num_ext_blocks; ++i)
+    {
+      const auto* ext = av_dovi_get_ext(data, i);
+      switch (ext->level)
+      {
+        case 1:
+          out.l1 = true;
+          out.pq = {ext->l1.min_pq, ext->l1.max_pq, ext->l1.avg_pq};
+          break;
+        case 5:
+          out.l5 = true;
+          out.area = {ext->l5.left_offset, ext->l5.right_offset,
+                      ext->l5.top_offset, ext->l5.bottom_offset};
+          break;
+        case 6:
+          out.l6 = true;
+          out.maxMaster = ext->l6.max_luminance;
+          out.minMaster = ext->l6.min_luminance;
+          out.maxCLL = ext->l6.max_cll;
+          out.maxFALL = ext->l6.max_fall;
+          break;
+        case 3: case 8: case 9: case 10: case 11: case 254:
+          out.cm4 = true;
+          break;
+      }
+    }
+  }
+
+  static StreamSnapshot Read()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    auto result = m_snapshot;
+    result.counters = m_counters.load(std::memory_order_relaxed);
+    result.dropped = m_dropped.load(std::memory_order_relaxed);
+    result.skipped = m_skipped.load(std::memory_order_relaxed);
+    result.sourceBits = m_sourceBits.load(std::memory_order_relaxed);
+    result.sourceFormat = m_sourceFormat.load(std::memory_order_relaxed);
+    return result;
+  }
+
+private:
+  inline static std::atomic<int> m_dropped{}, m_skipped{};
+  inline static std::atomic<unsigned> m_sourceBits{0};
+  inline static std::atomic<AVPixelFormat> m_sourceFormat{AV_PIX_FMT_NONE};
+  inline static std::atomic<bool> m_counters{false};
+  inline static std::mutex m_mutex;
+  inline static StreamSnapshot m_snapshot;
+  inline static std::chrono::steady_clock::time_point m_next;
+};
+} // namespace DVBRIDGE
