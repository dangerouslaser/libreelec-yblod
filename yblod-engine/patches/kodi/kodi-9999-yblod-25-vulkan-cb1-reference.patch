+// The Vulkan engine with CB1 Master Reference's processing (DV_VULKAN_CB1=1,
+// DVPrivateVulkan) sites an unscaled picture as CB1 does: top-left when the
+// stream says so (also with an EL), or unspecified in Profile 7 (an EL, or a
+// MEL's undecoded one); left otherwise.
+bool VulkanCB1(int baseWidth, int baseHeight, const dvbridge_geometry& geometry)
+{
+  const char* cb1 = std::getenv("DV_VULKAN_CB1");
+  const char* vulkan = std::getenv("DV_ENGINE_VULKAN");
+  return cb1 && std::strcmp(cb1, "1") == 0 && vulkan && std::strcmp(vulkan, "1") == 0 &&
+      geometry.width == baseWidth && geometry.height == baseHeight;
+}
+
+unsigned PlaneSiting(bool cb1, bool profile7, int location)
+{
+  if (!cb1)
+    return SourcePlaneSiting(profile7, location);
+  return location == AVCHROMA_LOC_TOPLEFT || (location == AVCHROMA_LOC_UNSPECIFIED && profile7)
+      ? DV_SOURCE_CHROMA_TOP_LEFT : DV_SOURCE_CHROMA_CENTER_LEFT;
+}
