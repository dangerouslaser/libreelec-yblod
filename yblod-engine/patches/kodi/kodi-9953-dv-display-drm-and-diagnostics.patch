diff --git a/xbmc/utils/DVBridgeDiagnosticState.h b/xbmc/utils/DVBridgeDiagnosticState.h
new file mode 100644
index 0000000..e471b46
--- /dev/null
+++ b/xbmc/utils/DVBridgeDiagnosticState.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+
+namespace DVBRIDGE
+{
+// Enabled without Kodi's global debug mode. Developers can disable the entire
+// supplement in one place; it must never change output or retry decisions.
+inline bool DiagnosticsEnabled()
+{
+  static const bool enabled = [] {
+    const char* setting = std::getenv("DVBRIDGE_DIAGNOSTICS");
+    return !setting || setting[0] != '0' || setting[1] != '\0';
+  }();
+  return enabled;
+}
+
+// DVBRIDGE_DIAGNOSTICS=1 (set, not 0) also asks for the periodic playback health line at INFO;
+// otherwise it is a debug-log line.
+inline bool DiagnosticsRequested()
+{
+  static const bool requested = [] {
+    const char* setting = std::getenv("DVBRIDGE_DIAGNOSTICS");
+    return setting && setting[0] && (setting[0] != '0' || setting[1] != '\0');
+  }();
+  return requested;
+}
+
+inline uint64_t DiagnosticNowMs()
+{
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// A bounded first-event/change budget plus a 30-second summary. Alternating
+// failures/recoveries cannot reset the budget and turn this into per-frame IO.
+class DiagnosticFailures
+{
+public:
+  bool Record(uint64_t now, const char* stage = "failure", int error = 0)
+  {
+    ++m_count;
+    ++m_consecutive;
+    const bool changed = stage != m_stage || error != m_error;
+    m_stage = stage;
+    m_error = error;
+    if (!m_reported || now - m_window >= 30000)
+    {
+      m_window = now;
+      m_reports = 0;
+    }
+    if ((!m_reported || changed || now - m_last >= 30000) && m_reports < 4)
+    {
+      m_reported = true;
+      ++m_reports;
+      m_last = now;
+      return true;
+    }
+    return false;
+  }
+  bool Recovered(uint64_t now)
+  {
+    if (!m_consecutive)
+      return false;
+    m_consecutive = 0;
+    ++m_recoveries;
+    if (m_recoveries == 1 || now - m_lastRecovery >= 30000)
+    {
+      m_lastRecovery = now;
+      return true;
+    }
+    return false;
+  }
+  uint64_t Count() const { return m_count; }
+  uint64_t Recoveries() const { return m_recoveries; }
+  void Reset() { *this = {}; }
+
+private:
+  uint64_t m_count{0}, m_consecutive{0}, m_recoveries{0};
+  uint64_t m_window{0}, m_last{0}, m_lastRecovery{0};
+  unsigned m_reports{0};
+  const char* m_stage{nullptr}; // Callers pass static stage labels.
+  int m_error{0};
+  bool m_reported{false};
+};
+} // namespace DVBRIDGE
diff --git a/xbmc/utils/DVBridgeEdid.h b/xbmc/utils/DVBridgeEdid.h
new file mode 100644
index 0000000..f7ca959
--- /dev/null
+++ b/xbmc/utils/DVBridgeEdid.h
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: MIT */
+/* Shared, side-effect-free Standard-DV eligibility. The kernel and player
+ * copies must remain identical (checked by the source tests). This only
+ * parses public display capabilities; it does not alter EDID or movie data.
+ */
+#ifndef DVBRIDGE_EDID_H
+#define DVBRIDGE_EDID_H
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdbool.h>
+#include <stddef.h>
+#endif
+
+enum dvbridge_edid_status {
+	DV_EDID_ABSENT, DV_EDID_INVALID, DV_EDID_NO_DV, DV_EDID_DUPLICATE,
+	DV_EDID_VERSION, DV_EDID_LENGTH, DV_EDID_LLDV_ONLY, DV_EDID_STANDARD
+};
+
+struct dvbridge_sink_caps {
+	enum dvbridge_edid_status status;
+	unsigned int version, offset, length;
+	bool legacy_vsif, supports_2160p60;
+};
+
+static inline const char *dvbridge_edid_reason(enum dvbridge_edid_status status)
+{
+	switch (status) {
+	case DV_EDID_ABSENT: return "edid-unavailable";
+	case DV_EDID_INVALID: return "edid-invalid";
+	case DV_EDID_NO_DV: return "no-dv-block";
+	case DV_EDID_DUPLICATE: return "multiple-dv-blocks";
+	case DV_EDID_VERSION: return "unknown-dv-version";
+	case DV_EDID_LENGTH: return "invalid-dv-block-length";
+	case DV_EDID_LLDV_ONLY: return "no-standard-dv-interface";
+	case DV_EDID_STANDARD: return "standard-dv";
+	}
+	return "unknown";
+}
+
+static inline struct dvbridge_sink_caps
+dvbridge_parse_edid(const unsigned char *edid, size_t size)
+{
+	static const unsigned char magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
+	struct dvbridge_sink_caps result = {DV_EDID_ABSENT, 0, 0, 0, false, false};
+	unsigned int block, i, found = 0;
+	unsigned char sum;
+
+	if (!edid || !size)
+		return result;
+	result.status = DV_EDID_INVALID;
+	/* An HDMI Forum EEODB overrides byte 126: the blob can hold more
+	 * blocks than it says, never fewer. */
+	if (size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
+		return result;
+	for (i = 0; i < 8; i++)
+		if (edid[i] != magic[i])
+			return result;
+	for (i = 0, sum = 0; i < 128; i++)
+		sum += edid[i];
+	if (sum)
+		return result;
+	result.status = DV_EDID_NO_DV;
+	for (block = 1; block < size / 128; block++) {
+		const unsigned char *b = edid + block * 128;
+		unsigned int end = b[2], pos;
+
+		/* A corrupt extension is skipped, as DRM drops such blocks. */
+		for (i = 0, sum = 0; i < 128; i++)
+			sum += b[i];
+		if (sum)
+			continue;
+		if (b[0] != 2 || b[1] < 3 || !end)
+			continue;
+		if (end < 4 || end > 127) {
+			result.status = DV_EDID_INVALID;
+			return result;
+		}
+		for (pos = 4; pos < end;) {
+			unsigned int len = b[pos] & 31;
+			const unsigned char *data = b + pos + 1;
+
+			if (pos + len + 1 > end) {
+				result.status = DV_EDID_INVALID;
+				return result;
+			}
+			if ((b[pos] >> 5) == 7 && len >= 4 && data[0] == 1 &&
+			    data[1] == 0x46 && data[2] == 0xd0 && data[3] == 0) {
+				if (++found != 1) {
+					result.status = DV_EDID_DUPLICATE;
+					return result;
+				}
+				result.offset = block * 128 + pos + 1;
+				result.length = len;
+				result.status = DV_EDID_LENGTH;
+				if (len < 5)
+					return result;
+				result.version = data[4] >> 5;
+				switch (result.version) {
+				case 0:
+					/* 26 bytes with the header: 0x19 */
+					if (len != 25)
+						return result;
+					result.legacy_vsif = true;
+					result.supports_2160p60 = (data[4] & 2) != 0;
+					break;
+				case 1:
+					if (len != 11 && len != 14)
+						return result;
+					/* Long V1 and short V1 without LL use HDMI-1.4b
+					 * signaling, not the modern Dolby-OUI packet. */
+					result.legacy_vsif = len == 14 || !(data[7] & 1);
+					result.supports_2160p60 = (data[4] & 2) != 0;
+					break;
+				case 2:
+					if (len < 11)
+						return result;
+					if ((data[6] & 3) < 2) {
+						result.status = DV_EDID_LLDV_ONLY;
+						return result;
+					}
+					result.supports_2160p60 = true;
+					break;
+				default:
+					result.status = DV_EDID_VERSION;
+					return result;
+				}
+				result.status = DV_EDID_STANDARD;
+			}
+			pos += len + 1;
+		}
+	}
+	return result;
+}
+#endif
diff --git a/xbmc/utils/DVBridgeKernelLog.h b/xbmc/utils/DVBridgeKernelLog.h
new file mode 100644
index 0000000..d96935c
--- /dev/null
+++ b/xbmc/utils/DVBridgeKernelLog.h
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <charconv>
+#include <cstdint>
+#include <deque>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace DVBRIDGE
+{
+// /dev/kmsg records: priority,sequence,monotonic_us,flags;message\ncontext.
+// Only kernel-origin DV/display incidents are copied, never general system logs.
+class KernelLogFilter
+{
+public:
+  std::optional<std::string> Accept(std::string_view record, uint64_t nowUs)
+  {
+    uint64_t priority, sequence, timestamp;
+    if (!Number(record, priority) || !Number(record, sequence) || !Number(record, timestamp))
+      return {};
+    const auto separator = record.find(';');
+    if (separator == record.npos || priority > 7)
+      return {};
+    if (m_seen && sequence <= m_sequence)
+      return {};
+    m_seen = true;
+    m_sequence = sequence;
+    if (timestamp > nowUs || nowUs - timestamp > 60000000)
+      return {};
+    auto message = record.substr(separator + 1);
+    message = message.substr(0, message.find('\n'));
+    // i915/xe faults can explain a failed flip without a DV-specific rejection.
+    // Restrict these additional records to warning-or-worse display incidents.
+    const bool intel = message.find("i915 ") != message.npos ||
+                       message.find("xe ") != message.npos;
+    const bool incident = priority <= 4 && intel &&
+        (message.find("GPU HANG") != message.npos ||
+         message.find("Resetting") != message.npos ||
+         message.find("reset failed") != message.npos ||
+         message.find("underrun") != message.npos ||
+         message.find("flip_done timed out") != message.npos ||
+         message.find("vblank wait timed out") != message.npos ||
+         message.find("link training failed") != message.npos ||
+         message.find("link-status BAD") != message.npos);
+    if (message.find("DVBridge:") == message.npos && !incident)
+      return {};
+    // Kernel escapes untrusted characters. Bound the copied record as well.
+    const std::string text(message.substr(0, 2048));
+    for (const auto& recent : m_recent)
+      if (recent.first == text && nowUs - recent.second < 30000000)
+        return {};
+    m_recent.emplace_back(text, nowUs);
+    if (m_recent.size() > 16)
+      m_recent.pop_front();
+    return "boot_us=" + std::to_string(timestamp) + " seq=" + std::to_string(sequence) +
+           " " + text;
+  }
+
+private:
+  static bool Number(std::string_view& input, uint64_t& value)
+  {
+    const auto comma = input.find(',');
+    if (comma == input.npos || comma == 0)
+      return false;
+    const auto result = std::from_chars(input.data(), input.data() + comma, value);
+    if (result.ec != std::errc{} || result.ptr != input.data() + comma)
+      return false;
+    input.remove_prefix(comma + 1);
+    return true;
+  }
+  uint64_t m_sequence{0};
+  bool m_seen{false};
+  std::deque<std::pair<std::string, uint64_t>> m_recent;
+};
+}
diff --git a/xbmc/utils/DVBridgeOutputRetry.h b/xbmc/utils/DVBridgeOutputRetry.h
new file mode 100644
index 0000000..73bfde6
--- /dev/null
+++ b/xbmc/utils/DVBridgeOutputRetry.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cstdint>
+
+namespace DVBRIDGE
+{
+// Output recovery only; diagnostic counters never influence this state.
+// Preserve early transient recovery, then space attempts without sleeping on
+// the GUI thread or permanently blacklisting a potentially usable display.
+class OutputRetry
+{
+public:
+  bool Ready(uint64_t now) const { return !m_failures || now >= m_next; }
+  void Failed(uint64_t now, int error)
+  {
+    if (!m_failures)
+      m_since = now;
+    ++m_failures;
+    m_error = error;
+    m_delay = m_failures <= 2 ? 0 : (now - m_since < 3000 ? 250 : 1000);
+    m_next = now + m_delay;
+  }
+  void Reset() { *this = {}; }
+  bool PollDue(uint64_t now)
+  {
+    if (!m_failures || (m_polled && now - m_poll < 1000))
+      return false;
+    m_polled = true;
+    m_poll = now;
+    return true;
+  }
+  uint64_t Count() const { return m_failures; }
+  unsigned Delay() const { return m_delay; }
+  int Error() const { return m_error; }
+
+private:
+  uint64_t m_failures{0}, m_since{0}, m_next{0}, m_poll{0};
+  unsigned m_delay{0};
+  int m_error{0};
+  bool m_polled{false};
+};
+} // namespace DVBRIDGE
