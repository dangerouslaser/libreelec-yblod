+
+void CDRMAtomic::DVFlipCompleted()
+{
+  // The out-fence carries the time of the vertical blank the flip completed at: the number
+  // of refreshes since the flip before it says whether every refresh got its new picture.
+  sync_fence_info fence{};
+  sync_file_info info{};
+  info.num_fences = 1;
+  info.sync_fence_info = reinterpret_cast<uint64_t>(&fence);
+  const bool timed = ioctl(m_dvFlipFence, SYNC_IOC_FILE_INFO, &info) == 0 && info.num_fences == 1 &&
+                     fence.timestamp_ns;
+  close(m_dvFlipFence);
+  m_dvFlipFence = -1;
+  m_dvFlipDone = m_dvFlips.queued;
+  const double refresh = m_mode && m_mode->htotal && m_mode->vtotal
+                             ? m_mode->clock * 1000.0 / m_mode->htotal / m_mode->vtotal : 0.0;
+  if (timed && refresh >= 1.0)
+  {
+    const double waited = (static_cast<double>(fence.timestamp_ns) - static_cast<double>(m_dvFlipQueued)) / 1e6;
+    const long gap = m_dvFlipTime
+                         ? std::lround(static_cast<double>(fence.timestamp_ns - m_dvFlipTime) * refresh / 1e9)
+                         : 1;
+    m_dvFlips.waitMs += waited;
+    m_dvFlips.waitMaxMs = std::max(m_dvFlips.waitMaxMs, waited);
+    ++(gap <= 1 ? m_dvFlips.onTime : m_dvFlips.late);
+    static const bool trace = [] {
+      const char* value = std::getenv("DV_PRIVATE_FLIP_TRACE");
+      return value && strcmp(value, "1") == 0;
+    }();
+    if (trace)
+      CLog::Log(LOGINFO, "DV flip: fb={} vblank_ns={} refreshes_since_last={} queued_to_vblank_ms={:.2f}",
+                m_dvFlipFb, fence.timestamp_ns, gap, waited);
+    m_dvFlipTime = fence.timestamp_ns;
+  }
+  if (m_dvFlips.queued % 600 == 0)
+  {
+    CLog::Log(LOGINFO, "DV flips queued={}: on_time={} late={} blocking={} busy={} timeouts={} "
+              "queued_to_vblank_ms mean={:.2f} max={:.2f}", m_dvFlips.queued, m_dvFlips.onTime,
+              m_dvFlips.late, m_dvFlips.blocking, m_dvFlips.busy, m_dvFlips.timeouts,
+              m_dvFlips.waitMs / 600.0, m_dvFlips.waitMaxMs);
+    m_dvFlips.waitMs = m_dvFlips.waitMaxMs = 0.0;
+  }
+}
+
+bool CDRMAtomic::WaitDVFlip(int timeoutMs)
+{
+  if (m_dvFlipFence < 0)
+    return true;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeoutMs);
+  for (;;)
+  {
+    pollfd fence{m_dvFlipFence, POLLIN, 0};
+    const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(
+        deadline - std::chrono::steady_clock::now()).count();
+    const int result = poll(&fence, 1, static_cast<int>(std::max<long long>(left, 0)));
+    if (result == 0)
+    {
+      if (timeoutMs > 0)
+        ++m_dvFlips.timeouts;
+      return false;
+    }
+    if (result > 0 || errno != EINTR)
+    {
+      // Signalled; a fence that cannot be waited for is not waited for again.
+      if (result < 0)
+        CLog::Log(LOGERROR, "DV flip: cannot wait for the out-fence: {}", strerror(errno));
+      DVFlipCompleted();
+      return true;
+    }
+  }
+}
+
+bool CDRMAtomic::DVFlipPending()
+{
+  return !WaitDVFlip(0);
+}
+
+void CDRMAtomic::WaitDVRefresh()
+{
+  if (m_dvFlipFence >= 0)
+    WaitDVFlip();
+  else
+    WaitVBlank();
+}
