+bool CDRMAtomic::FlipPageTransactional(struct gbm_bo* bo, bool restore, bool* queued)
+{
+  if (queued)
+    *queued = false;
+  // Restoration must always be attempted, including after rejected DV output.
+  if (!restore && !DVRetryReady())
+  {
+    FinishRequest(false);
+    return false;
+  }
+  if (!bo)
+  {
+    m_dvRetry.Failed(DVNowMs(), EINVAL);
+    ReportDVFailure("missing-buffer", EINVAL);
+    FinishRequest(false);
+    return false;
+  }
+  const uint32_t fb = DrmOpaqueFbGetFromBo(bo);
+  if (!fb)
+  {
+    m_dvRetry.Failed(DVNowMs(), 0);
+    ReportDVFailure("framebuffer-import", 0);
+    FinishRequest(false);
+    return false;
+  }
+  // A stable DV scanout keeps the mode it was accepted with: commit only the
+  // new framebuffer and the unchanged transport properties. Entering DV, a
+  // pending modeset, a restore and the frame after a rejected commit still
+  // validate the full state. (Allowing a modeset on every frame made amdgpu
+  // DCN 1.0 latch each flip a refresh late: half the frame rate on screen.)
+  const bool stable = m_dvScanoutStable && !restore && !m_need_modeset;
+  int flags = stable ? 0 : DRM_MODE_ATOMIC_ALLOW_MODESET;
+  if (m_dvFlipFence >= 0)
+  {
+    // One flip at a time. The caller has waited for the queued one where a picture follows
+    // it; anything else (a mode or signal change, a restore, the menu) waits here and then
+    // commits as it always did. Still queued after that: this commit is not attempted.
+    // A restore is attempted in any case: its blocking commit waits in the kernel.
+    if (!WaitDVFlip(stable && queued ? 0 : 1000) && !restore)
+    {
+      m_dvRetry.Failed(DVNowMs(), EBUSY);
+      ReportDVFailure("flip-pending", EBUSY);
+      FinishRequest(false);
+      return false;
+    }
+  }
+  m_dvQueue = stable && queued && DVNonblock() && !m_dvNoFence && m_dvFlipFence < 0;
+  if (m_dvQueue)
+    flags |= DRM_MODE_ATOMIC_NONBLOCK;
+  const bool accepted = DrmAtomicCommit(fb, flags, true, false, true);
+  if (accepted && m_dvQueue && m_dvOutFence >= 0)
+  {
+    timespec now{};
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    m_dvFlipFence = m_dvOutFence;
+    m_dvFlipQueued = static_cast<uint64_t>(now.tv_sec) * 1000000000ull + static_cast<uint64_t>(now.tv_nsec);
+    m_dvFlipFb = fb;
+    ++m_dvFlips.queued;
+    *queued = true;
+  }
+  else if (accepted)
+  {
+    if (m_dvQueue)
+    {
+      // Taken without blocking, but with no fence to know its completion by: two refreshes
+      // are more than it needs once its buffer is finished, and no flip is queued again.
+      m_dvNoFence = true;
+      CLog::Log(LOGERROR, "DV flip: the kernel gave no out-fence; presenting with blocking commits");
+      WaitVBlank();
+      WaitVBlank();
+    }
+    // Shown on return (also a flip the kernel made wait for the one before it): a flip
+    // queued before it has completed.
+    if (DVNonblock())
+    {
+      ++m_dvFlips.blocking;
+      m_dvFlipTime = 0;
+    }
+    if (m_dvOutFence >= 0)
+      close(m_dvOutFence);
+    WaitDVFlip(0);
+  }
+  m_dvOutFence = -1;
+  m_dvQueue = false;
+  if (accepted)
+    m_need_modeset = false;
+  m_dvScanoutStable = accepted && !restore;
+  return accepted;
 }
 
