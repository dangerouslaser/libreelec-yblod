+void CDRMAtomic::WaitVBlank()
+{
+  // The time of the last vertical blank plus one refresh period, then the count as the
+  // check: the timer and the display do not run from the same clock.
+  uint64_t sequence = 0, ns = 0;
+  const double refresh = m_mode && m_mode->htotal && m_mode->vtotal
+                             ? m_mode->clock * 1000.0 / m_mode->htotal / m_mode->vtotal : 0.0;
+  if (!m_crtc || refresh < 1.0 ||
+      drmCrtcGetSequence(m_fd, m_crtc->GetCrtcId(), &sequence, &ns) != 0 || !ns)
+  {
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    return;
+  }
+  const uint64_t due = ns + static_cast<uint64_t>(1e9 / refresh) + 200000;
+  const timespec target{static_cast<time_t>(due / 1000000000), static_cast<long>(due % 1000000000)};
+  while (clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &target, nullptr) == EINTR)
+    ;
+  for (int attempt = 0; attempt < 8; ++attempt)
+  {
+    uint64_t now = 0;
+    if (drmCrtcGetSequence(m_fd, m_crtc->GetCrtcId(), &now, &ns) != 0 || now != sequence)
+      break;
+    std::this_thread::sleep_for(std::chrono::microseconds(250));
+  }
+}
