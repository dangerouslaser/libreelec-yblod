diff --git a/xbmc/windowing/gbm/drm/DVBridgeKernelLogReader.h b/xbmc/windowing/gbm/drm/DVBridgeKernelLogReader.h
new file mode 100644
index 0000000..84bd40d
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeKernelLogReader.h
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include "utils/DVBridgeKernelLog.h"
+#include "utils/log.h"
+
+#include <array>
+#include <cerrno>
+#include <chrono>
+#include <mutex>
+#include <fcntl.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace DVBRIDGE
+{
+// Used only by a Kodi background job after a rate-limited DV output failure.
+// Read-only, nonblocking and bounded. No external process, new service or GPU work.
+class KernelLogReader
+{
+public:
+  ~KernelLogReader()
+  {
+    if (m_fd >= 0)
+      close(m_fd);
+  }
+
+  // True means the independent cursor still has work; callers may run a small
+  // bounded continuation after yielding. Never blocks the render thread.
+  bool Collect()
+  {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_fd < 0)
+    {
+      m_fd = open("/dev/kmsg", O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+      if (m_fd < 0)
+      {
+        if (!m_warned)
+          CLog::Log(LOGWARNING, "DVBridge kernel: cannot read /dev/kmsg errno={}; kernel reason unavailable", errno);
+        m_warned = true;
+        return false;
+      }
+    }
+    timespec now{};
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0)
+    {
+      if (!m_warned)
+        CLog::Log(LOGWARNING, "DVBridge kernel: monotonic clock unavailable; evidence incomplete");
+      m_warned = true;
+      return false;
+    }
+    const uint64_t nowUs = uint64_t(now.tv_sec) * 1000000 + now.tv_nsec / 1000;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(50);
+    std::array<char, 16384> buffer{};
+    // The output budget spans continuation batches, not just one read call.
+    if (!m_window || nowUs - m_window >= 30000000)
+    {
+      m_window = nowUs;
+      m_copied = 0;
+      m_notices = 0;
+    }
+    unsigned int suppressed = 0, overruns = 0;
+    bool incomplete = true;
+    for (unsigned int records = 0; records < 4096; ++records)
+    {
+      if (std::chrono::steady_clock::now() >= deadline)
+        break;
+      const auto count = read(m_fd, buffer.data(), buffer.size());
+      if (count < 0)
+      {
+        if (errno == EPIPE) { ++overruns; continue; }
+        if (errno == EINTR) continue;
+        if (errno != EAGAIN && !m_warned)
+        {
+          CLog::Log(LOGWARNING, "DVBridge kernel: read failed errno={}; kernel reason unavailable", errno);
+          m_warned = true;
+        }
+        incomplete = false;
+        break;
+      }
+      if (!count) { incomplete = false; break; }
+      const auto message = m_filter.Accept({buffer.data(), static_cast<size_t>(count)}, nowUs);
+      if (!message)
+        continue;
+      if (m_copied < 8)
+      {
+        CLog::Log(LOGERROR, "DVBridge kernel: {}", *message);
+        ++m_copied;
+      }
+      else
+        ++suppressed;
+    }
+    if ((suppressed || overruns || incomplete) && m_notices++ < 2)
+      CLog::Log(LOGWARNING,
+          "DVBridge kernel: evidence incomplete={} ring_overruns={} suppressed={} (bounded collection)",
+          incomplete, overruns, suppressed);
+    return incomplete;
+  }
+
+private:
+  std::mutex m_mutex;
+  KernelLogFilter m_filter;
+  int m_fd{-1};
+  bool m_warned{false};
+  uint64_t m_window{0};
+  unsigned m_copied{0}, m_notices{0};
+};
+}
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.cpp b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
new file mode 100644
index 0000000..a661278
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.cpp
@@ -0,0 +1,233 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVBridgeState.h"
+#include "DRMAtomic.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h"
+#include "utils/log.h"
+
+#include <cstring>
+
+using namespace KODI::WINDOWING::GBM;
+
+bool CDVBridgeState::Capture(CDRMAtomic& drm)
+{
+  if (Captured())
+    return false;
+  auto* connector = drm.GetConnector();
+  auto* crtc = drm.GetCrtc();
+  auto* plane = drm.GetGuiPlane() ? drm.GetGuiPlane() : drm.GetVideoPlane();
+  if (!connector || !crtc || !plane || (drm.GetGuiPlane() && drm.GetVideoPlane()))
+    return false;
+  if (connector->GetPropertyValue("DVBRIDGE_DV_STANDARD_LAB") != 0)
+    return false;
+
+  std::vector<Property> saved;
+  const auto save = [&](CDRMObject* object, const char* name, uint64_t transport,
+                        bool required, bool blob, const char* enumName = nullptr) {
+    auto value = object->GetPropertyValue(name);
+    if (!value)
+      return !required;
+    if (enumName)
+    {
+      auto selected = object->GetPropertyEnumValue(name, enumName);
+      if (!selected)
+        return false;
+      transport = *selected;
+    }
+    Property property{object, name, *value, transport, {}};
+    if (blob && *value)
+    {
+      auto* original = drmModeGetPropertyBlob(drm.GetFileDescriptor(), *value);
+      if (!original)
+        return false;
+      property.blob = CDRMPropertyBlob(drm.GetFileDescriptor(), original->data, original->length);
+      drmModeFreePropertyBlob(original);
+      if (!property.blob.IsValid())
+        return false;
+      property.original = property.blob.Get();
+    }
+    saved.push_back(std::move(property));
+    return true;
+  };
+
+  // linux-9928: what the tunnel's pictures are (Dolby Vision until SetSignal)
+  if (!save(connector, "DVBRIDGE_TUNNEL_FORMAT", 0, false, false, "dolby-vision"))
+    return false;
+  // linux-9932: no HDR10+ packet until the engine makes one; none after the restore either
+  // (the GUI never sends HDR10+, and a stale blob id may be gone).
+  if (!save(connector, "HDR10PLUS_METADATA", 0, false, false))
+    return false;
+  if (!save(connector, "DVBRIDGE_DV_STANDARD_LAB", 1, true, false) ||
+      !save(connector, "HDR_OUTPUT_METADATA", 0, true, true) ||
+      !save(connector, "max bpc", 8, true, false) ||
+      !save(connector, "Broadcast RGB", 0, true, false, "Full") ||
+      !save(connector, "Colorspace", 0, true, false, "Default") ||
+      !save(crtc, "CTM", 0, false, true) ||
+      !save(crtc, "GAMMA_LUT", 0, false, true) ||
+      !save(crtc, "DEGAMMA_LUT", 0, false, true) ||
+      !save(crtc, "VRR_ENABLED", 0, false, false) ||
+      !save(plane, "rotation", DRM_MODE_ROTATE_0, false, false) ||
+      !save(plane, "alpha", 65535, false, false) ||
+      !save(plane, "COLOR_PIPELINE", 0, false, false) ||
+      !save(plane, "pixel blend mode", 0, false, false, "None"))
+    return false;
+
+  // Do not silently corrupt tunnel bytes with another plane or hardware cursor.
+  auto* planes = drmModeGetPlaneResources(drm.GetFileDescriptor());
+  if (!planes)
+    return false;
+  bool safe = true;
+  for (uint32_t i = 0; i < planes->count_planes; ++i)
+  {
+    auto* other = drmModeGetPlane(drm.GetFileDescriptor(), planes->planes[i]);
+    if (!other)
+    {
+      safe = false;
+      break;
+    }
+    safe &= other->plane_id == plane->GetId() || other->crtc_id != crtc->GetCrtcId();
+    drmModeFreePlane(other);
+  }
+  drmModeFreePlaneResources(planes);
+  if (!safe)
+    return false;
+  m_saved = std::move(saved);
+  m_owner = &drm;
+  m_hdr10.reset();
+  m_hdr10Blob = CDRMPropertyBlob();
+  m_hdr10PlusBlob = CDRMPropertyBlob();
+  if (auto* hdr10plus = Find("HDR10PLUS_METADATA"))
+    hdr10plus->original = 0;
+  return true;
+}
+
+CDVBridgeState::Property* CDVBridgeState::Find(const char* name)
+{
+  for (auto& property : m_saved)
+    if (property.name == name)
+      return &property;
+  return nullptr;
+}
+
+bool CDVBridgeState::SupportsHDR10(CDRMObject& connector)
+{
+  return connector.SupportsProperty("DVBRIDGE_DV_STANDARD_LAB") &&
+         connector.GetPropertyEnumValue("DVBRIDGE_TUNNEL_FORMAT", "hdr10").has_value();
+}
+
+bool CDVBridgeState::SetSignal(CDRMAtomic& drm, const DVBRIDGE::TunnelHDR10Signal* hdr10)
+{
+  if (!Captured() || m_owner != &drm)
+    return false;
+  auto* format = Find("DVBRIDGE_TUNNEL_FORMAT");
+  auto* metadata = Find("HDR_OUTPUT_METADATA");
+  if (!format)
+    return !hdr10; // a kernel before linux-9928: Dolby Vision only
+  const auto value = format->object->GetPropertyEnumValue("DVBRIDGE_TUNNEL_FORMAT",
+                                                          hdr10 ? "hdr10" : "dolby-vision");
+  if (!value || !metadata)
+    return false;
+  format->transport = *value;
+  if (!hdr10)
+  {
+    metadata->transport = 0;
+    // no HDR10+ with a Dolby Vision picture
+    if (auto* hdr10plus = Find("HDR10PLUS_METADATA"))
+      hdr10plus->transport = 0;
+    return true;
+  }
+  const std::array<uint16_t, 12> key{hdr10->primaries[0][0], hdr10->primaries[0][1],
+      hdr10->primaries[1][0], hdr10->primaries[1][1], hdr10->primaries[2][0], hdr10->primaries[2][1],
+      hdr10->white[0], hdr10->white[1], hdr10->maxLuminance, hdr10->minLuminance, hdr10->maxCll,
+      hdr10->maxFall};
+  if (!m_hdr10 || *m_hdr10 != key || !m_hdr10Blob.IsValid())
+  {
+    // struct hdr_output_metadata: a u32 metadata_type (0, static type 1), then
+    // hdr_metadata_infoframe (eotf 2 PQ, its metadata_type 0, then the u16s
+    // in the order above: primaries, white point, max/min mastering, MaxCLL,
+    // MaxFALL), native byte order, padded to its 32 bytes (the kernel takes
+    // exactly sizeof(struct hdr_output_metadata)).
+    uint8_t blob[32]{};
+    blob[4] = 2;
+    std::memcpy(blob + 6, key.data(), sizeof(key[0]) * key.size());
+    m_hdr10Blob = CDRMPropertyBlob(drm.GetFileDescriptor(), blob, sizeof(blob));
+    if (!m_hdr10Blob.IsValid())
+      return false;
+    m_hdr10 = key;
+    CLog::Log(LOGINFO, "DVBridge tunnel HDR10 metadata: mastering {} / {:.4f} cd/m2, MaxCLL {}, MaxFALL {}",
+              hdr10->maxLuminance, hdr10->minLuminance / 10000.0, hdr10->maxCll, hdr10->maxFall);
+  }
+  metadata->transport = m_hdr10Blob.Get();
+  return true;
+}
+
+bool CDVBridgeState::SupportsHDR10Plus(CDRMObject& connector)
+{
+  return connector.SupportsProperty("HDR10PLUS_METADATA");
+}
+
+bool CDVBridgeState::HDR10PlusStaged()
+{
+  const auto* hdr10plus = Find("HDR10PLUS_METADATA");
+  return hdr10plus && hdr10plus->transport != 0;
+}
+
+bool CDVBridgeState::SetHDR10Plus(CDRMAtomic& drm, const DVBRIDGE::TunnelHDR10PlusPacket* packet,
+                                  bool& toggled)
+{
+  toggled = false;
+  using State = DVBRIDGE::TunnelHDR10PlusPacket::State;
+  const State state = packet ? packet->state : State::None;
+  if (!Captured() || m_owner != &drm)
+    return false;
+  auto* hdr10plus = Find("HDR10PLUS_METADATA");
+  if (!hdr10plus)
+    return state != State::Send; // a connector without HDR10+: nothing to clear
+  const bool was = hdr10plus->transport != 0;
+  switch (state)
+  {
+    case State::None:
+      hdr10plus->transport = 0;
+      break;
+    case State::Keep:
+      break;
+    case State::Send:
+    {
+      // A new blob per picture; the previous one is released here, the kernel holds its own
+      // reference for as long as a committed state uses it.
+      CDRMPropertyBlob blob(drm.GetFileDescriptor(), packet->vsif, sizeof(packet->vsif));
+      if (!blob.IsValid())
+        return false;
+      m_hdr10PlusBlob = std::move(blob);
+      hdr10plus->transport = m_hdr10PlusBlob.Get();
+      break;
+    }
+  }
+  toggled = was != (hdr10plus->transport != 0);
+  if (toggled)
+    CLog::Log(LOGINFO, "DVBridge tunnel HDR10+ metadata: {}", was ? "off" : "on");
+  return true;
+}
+
+void CDVBridgeState::RestoreSDR()
+{
+  // Renderer teardown invalidates the previous video's HDR/colorimetry snapshot.
+  for (auto& property : m_saved)
+  {
+    // no HDR metadata (an HDR10 tunnel's transport is its blob, not SDR's 0)
+    if (property.name == "HDR_OUTPUT_METADATA")
+      property.original = 0;
+    else if (property.name == "Colorspace")
+      property.original = property.transport;
+  }
+}
+
+bool CDVBridgeState::Stage(CDRMAtomic& drm, bool restore)
+{
+  if (!Captured() || m_owner != &drm || m_saved.front().object != drm.GetConnector())
+    return false;
+  bool valid = true;
+  for (const auto& property : m_saved)
+    valid &= drm.AddProperty(property.object, property.name.c_str(),
+                             restore ? property.original : property.transport);
+  return valid;
+}
diff --git a/xbmc/windowing/gbm/drm/DVBridgeState.h b/xbmc/windowing/gbm/drm/DVBridgeState.h
new file mode 100644
index 0000000..3c8f4f6
--- /dev/null
+++ b/xbmc/windowing/gbm/drm/DVBridgeState.h
@@ -0,0 +1,67 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "DRMObject.h"
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace DVBRIDGE
+{
+struct TunnelHDR10Signal;
+struct TunnelHDR10PlusPacket;
+}
+
+namespace KODI::WINDOWING::GBM
+{
+class CDRMAtomic;
+
+class CDVBridgeState
+{
+public:
+  bool Capture(CDRMAtomic& drm);
+  bool Stage(CDRMAtomic& drm, bool restore);
+  void RestoreSDR();
+  void Restored() { m_saved.clear(); m_owner = nullptr; }
+  bool Captured() const { return !m_saved.empty(); }
+  /* What the tunnel's pictures are, from the next Stage: Dolby Vision
+   * (nullptr), or HDR10 with its static metadata (DVBRIDGE_TUNNEL_FORMAT
+   * hdr10 and an HDR_OUTPUT_METADATA blob, linux-9928). False when the
+   * connector has no such format. */
+  bool SetSignal(CDRMAtomic& drm, const DVBRIDGE::TunnelHDR10Signal* hdr10);
+  /* The connector takes HDR10 tunnel pictures (DVBRIDGE_TUNNEL_FORMAT's hdr10). */
+  static bool SupportsHDR10(CDRMObject& connector);
+  /* The HDR10+ packet of the next Stage (linux-9932's HDR10PLUS_METADATA, a
+   * 31-byte HDR10+ vendor InfoFrame blob), after SetSignal: nullptr or None
+   * 0, Keep the current one, Send a new blob. Only with an HDR10 signal (the
+   * kernel refuses HDR10+ in the Dolby Vision formats). toggled: HDR10+ turns
+   * on or off with it, which the kernel makes a modeset. False when the
+   * connector has no such property and a packet is to be sent. */
+  bool SetHDR10Plus(CDRMAtomic& drm, const DVBRIDGE::TunnelHDR10PlusPacket* packet, bool& toggled);
+  /* The connector has HDR10PLUS_METADATA. */
+  static bool SupportsHDR10Plus(CDRMObject& connector);
+  /* A commit with this state sends an HDR10+ packet. */
+  bool HDR10PlusStaged();
+
+private:
+  struct Property
+  {
+    CDRMObject* object;
+    std::string name;
+    uint64_t original;
+    uint64_t transport;
+    CDRMPropertyBlob blob;
+  };
+  Property* Find(const char* name);
+  std::vector<Property> m_saved;
+  CDRMAtomic* m_owner = nullptr;
+  // the HDR10 signal staged, and its blob (kept until the next one: the
+  // kernel holds its own reference once a commit uses it)
+  std::optional<std::array<uint16_t, 12>> m_hdr10;
+  CDRMPropertyBlob m_hdr10Blob;
+  // the HDR10+ packet staged (the kernel keeps its own reference once committed)
+  CDRMPropertyBlob m_hdr10PlusBlob;
+};
+}
