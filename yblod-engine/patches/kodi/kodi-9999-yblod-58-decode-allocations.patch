From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 13:16:03 -0500
Subject: [PATCH 9/9] yblod-58: trim per-frame allocations and lookups on the
 decode path

- Each picture's Dolby Vision metadata was copied into a new buffer;
  share the frame's side-data buffer instead (FFmpeg allocates it per
  frame and does not write it once attached; anything else is still
  copied).
- The enhancement-layer pairing allocated a VideoPicture for every
  frame; reuse up to four, Reset as Kodi resets its own picture.
- ProcessDecoderOutput read DV_PRIVATE_ENDPOINT_TRACE from the
  environment for every picture; read it once.
---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 43 ++++++++++++++++---
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.h     |  5 +++
 .../DVDCodecs/Video/DVMetadataBuffer.h        | 17 ++++++++
 xbmc/cores/VideoPlayer/VideoPlayerVideo.cpp   |  7 ++-
 4 files changed, 63 insertions(+), 9 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index 16dfc7c..9cf6f1b 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -829,9 +829,37 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::DVEmitUnpaired(VideoPicture* pict
 {
   m_dvPending.front()->doviElSkipped = true;
   picture->CopyRef(*m_dvPending.front());
-  m_dvPending.pop_front();
+  DVPopPending();
   return VC_PICTURE;
 }
+
+std::shared_ptr<VideoPicture> CDVDVideoCodecFFmpeg::DVTakePicture()
+{
+  if (m_dvSpare.empty())
+  {
+    auto picture = std::make_shared<VideoPicture>();
+    picture->Reset();
+    return picture;
+  }
+  auto picture = std::move(m_dvSpare.back());
+  m_dvSpare.pop_back();
+  return picture;
+}
+
+void CDVDVideoCodecFFmpeg::DVRecycle(std::shared_ptr<VideoPicture> picture)
+{
+  // Releases its surface and enhancement picture, as destroying it would.
+  picture->Reset();
+  if (m_dvSpare.size() < 4)
+    m_dvSpare.push_back(std::move(picture));
+}
+
+void CDVDVideoCodecFFmpeg::DVPopPending()
+{
+  auto picture = std::move(m_dvPending.front());
+  m_dvPending.pop_front();
+  DVRecycle(std::move(picture));
+}
 #endif
 
