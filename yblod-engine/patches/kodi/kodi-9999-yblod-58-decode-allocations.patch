@@ -914,11 +941,13 @@ CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPicture(VideoPicture* pVideoPi
       if (m_dvPending.empty())
         return result;
       pVideoPicture->CopyRef(*m_dvPending.front());
-      m_dvPending.pop_front();
+      DVPopPending();
