diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h
new file mode 100644
index 0000000..7358d66
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+extern "C"
+{
+#include <libavutil/buffer.h>
+}
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+
+class CDVMetadataBuffer
+{
+public:
+  bool Assign(const uint8_t* data, size_t size)
+  {
+    if (!data || size == 0 || size > MAX_PAYLOAD_SIZE)
+    {
+      Reset();
+      return false;
+    }
+
+    AVBufferRef* buffer = av_buffer_alloc(size);
+    if (!buffer)
+    {
+      Reset();
+      return false;
+    }
+    std::memcpy(buffer->data, data, size);
+    m_buffer = std::shared_ptr<AVBufferRef>(buffer, [](AVBufferRef* ref) { av_buffer_unref(&ref); });
+    return true;
+  }
+
+  // Shares the buffer that holds exactly data/size (a frame's side data) instead of copying it;
+  // side-data buffers are not written once attached to a frame.
+  bool Share(const AVBufferRef* buffer, const uint8_t* data, size_t size)
+  {
+    if (!buffer || buffer->data != data || buffer->size != size || size == 0 ||
+        size > MAX_PAYLOAD_SIZE)
+      return Assign(data, size);
+    AVBufferRef* ref = av_buffer_ref(buffer);
+    if (!ref)
+    {
+      Reset();
+      return false;
+    }
+    m_buffer = std::shared_ptr<AVBufferRef>(ref, [](AVBufferRef* r) { av_buffer_unref(&r); });
+    return true;
+  }
+
+  void Reset() { m_buffer.reset(); }
+  const uint8_t* Data() const { return m_buffer ? m_buffer->data : nullptr; }
+  size_t Size() const { return m_buffer ? m_buffer->size : 0; }
+
+private:
+  // Bound unexpected side data before allocating; no truncation is allowed.
+  static constexpr size_t MAX_PAYLOAD_SIZE = 1024 * 1024;
+  std::shared_ptr<AVBufferRef> m_buffer;
+};
