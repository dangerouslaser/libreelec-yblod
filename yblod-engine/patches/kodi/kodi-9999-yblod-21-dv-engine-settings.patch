diff -ruN a/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h	1969-12-31 19:00:00
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVEngineSettings.h	2026-10-12 10:10:27
@@ -0,0 +1,123 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "ServiceBroker.h"
+#include "settings/Settings.h"
+#include "settings/SettingsComponent.h"
+#include "settings/lib/ISettingCallback.h"
+#include "settings/lib/Setting.h"
+#include "settings/SettingsContainer.h"
+#include "utils/log.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+/*!
+ * Settings > Player > Dolby Vision > Engine and Diagnostics.
+ *
+ * Each setting maps to native engine environment switches (normally set by
+ * native-dv.env). The values are applied once at window-system start, before
+ * any playback, and again whenever a setting changes; they take precedence over
+ * native-dv.env. Every managed variable is defined at start, so a later change
+ * only replaces an existing value and never grows the environment table that
+ * other threads may be reading. Most switches are read when a video starts.
+ */
+namespace DVEngineSettings
+{
+using Values = std::vector<std::pair<const char*, const char*>>;
+struct Mapping
+{
+  const char* setting;
+  Values on;
+  Values off;
+};
+
+inline const std::vector<Mapping>& Mappings()
+{
+  static const std::vector<Mapping> mappings = {
+      // Disabling the source alone would leave native-only composition and drain hooks active.
+      {"dvbridge.engine",
+       {{"DV_PRIVATE_SOURCE", "1"}, {"DV_PRIVATE_OVERLAY", "1"}, {"DV_PRIVATE_DRAIN_EOF", "1"}},
+       {{"DV_PRIVATE_SOURCE", "0"}, {"DV_PRIVATE_OVERLAY", "0"}, {"DV_PRIVATE_DRAIN_EOF", "0"}}},
+      {"dvbridge.letterboxskip", {{"DV_RECON_ACTIVE_ROWS", "1"}}, {{"DV_RECON_ACTIVE_ROWS", "0"}}},
+      {"dvbridge.inlineoverlay", {{"DV_OVERLAY_INLINE", "1"}}, {{"DV_OVERLAY_INLINE", "0"}}},
+      {"dvbridge.tablecache",
+       {{"DV_SINGLE_TABLE_CACHE", "1"}, {"DV_DUAL_TABLE_CACHE", "1"}},
+       {{"DV_SINGLE_TABLE_CACHE", "0"}, {"DV_DUAL_TABLE_CACHE", "0"}}},
+      {"dvbridge.guicache", {{"DV_PRIVATE_GUI_CACHE", "1"}}, {{"DV_PRIVATE_GUI_CACHE", "0"}}},
+      {"dvbridge.homecache", {{"DV_PRIVATE_GUI_CACHE_HOME", "1"}}, {{"DV_PRIVATE_GUI_CACHE_HOME", "0"}}},
+      {"dvbridge.packahead", {{"DV_PRIVATE_ASYNC_PACK", "1"}}, {{"DV_PRIVATE_ASYNC_PACK", "0"}}},
+      {"dvbridge.halfgui", {{"DV_PRIVATE_GUI_HALF", "1"}}, {{"DV_PRIVATE_GUI_HALF", "0"}}},
+      {"dvbridge.verify",
+       {{"DV_PRIVATE_VERIFY", "1"},
+        {"DV_VERIFY_ACTIVE_ROWS", "100"},
+        {"DV_OVERLAY_INLINE_VERIFY", "100"},
+        {"DV_SINGLE_TABLE_CACHE_VERIFY", "1"},
+        {"DV_DUAL_TABLE_CACHE_VERIFY", "1"}},
+       {{"DV_PRIVATE_VERIFY", "0"},
+        {"DV_VERIFY_ACTIVE_ROWS", "0"},
+        {"DV_OVERLAY_INLINE_VERIFY", "0"},
+        {"DV_SINGLE_TABLE_CACHE_VERIFY", "0"},
+        {"DV_DUAL_TABLE_CACHE_VERIFY", "0"}}},
+      {"dvbridge.frametrace",
+       {{"DV_ENGINE_FRAME_TRACE", "1"}, {"DV_PRIVATE_FRAME_TIMING", "1"}},
+       {{"DV_ENGINE_FRAME_TRACE", "0"}, {"DV_PRIVATE_FRAME_TIMING", "0"}}},
+      {"dvbridge.gputiming",
+       {{"DV_SOURCE_PROFILE_ASYNC", "1"}, {"DV_OVERLAY_PROFILE", "1"}},
+       {{"DV_SOURCE_PROFILE_ASYNC", "0"}, {"DV_OVERLAY_PROFILE", "0"}}},
+  };
+  return mappings;
+}
+
+inline void Apply(const Mapping& mapping, bool enabled)
+{
+  for (const auto& [name, value] : enabled ? mapping.on : mapping.off)
+  {
+    const char* current = std::getenv(name);
+    if (!current || std::strcmp(current, value) != 0)
+      setenv(name, value, 1);
+  }
+}
+
+class Callback : public ISettingCallback
+{
+public:
+  void OnSettingChanged(const std::shared_ptr<const CSetting>& setting) override
+  {
+    if (!setting)
+      return;
+    const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+    for (const auto& mapping : Mappings())
+      if (setting->GetId() == mapping.setting)
+      {
+        Apply(mapping, settings->GetBool(mapping.setting));
+        CLog::Log(LOGINFO, "Dolby Vision engine setting {} = {}", mapping.setting,
+                  settings->GetBool(mapping.setting));
+      }
+  }
+};
+
+//! Apply all settings and watch for changes. Call once settings are loaded.
+inline void Register()
+{
+  static bool registered = false;
+  const auto component = CServiceBroker::GetSettingsComponent();
+  const auto settings = component ? component->GetSettings() : nullptr;
+  if (registered || !settings)
+    return;
+  registered = true;
+  SettingsContainer ids;
+  for (const auto& mapping : Mappings())
+  {
+    Apply(mapping, settings->GetBool(mapping.setting));
+    ids.insert(mapping.setting);
+  }
+  static Callback callback;
+  settings->RegisterCallback(&callback, ids);
+  CLog::Log(LOGINFO, "Dolby Vision engine settings applied ({} switches)", ids.size());
+}
+} // namespace DVEngineSettings
