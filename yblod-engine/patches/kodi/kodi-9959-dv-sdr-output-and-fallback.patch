+
+DVBRIDGE::OutputMode CWinSystemGbmGLESContext::DVOutput()
+{
+  using Mode = DVBRIDGE::OutputMode;
+  const Mode selected = DVBRIDGE::playbackMode.load();
+  const bool fallback = DVBRIDGE::playbackFallback.load();
+  if (selected == Mode::Disabled || (selected == Mode::Standard && SupportsNativeDVOutput()))
+    return selected;
+  if (selected != Mode::SDR)
+  {
+    // The HDR10 conversion: selected (HDR10+ is HDR10 where the TV has no HDR10+), or in
+    // place of Dolby Vision on a TV without it.
+    if ((selected != Mode::Standard || fallback) && SupportsTunnelHDR10())
+      return selected == Mode::Standard ? Mode::HDR10 : selected;
+    if (!fallback)
