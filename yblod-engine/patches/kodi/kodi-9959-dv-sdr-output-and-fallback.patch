+bool CWinSystemGbmGLESContext::SupportsSDROutput()
+{
+  // DV_SDR_OUTPUT=0 (native-dv.env): no SDR output at all, selected or as the fallback.
+  const char* enabled = std::getenv("DV_SDR_OUTPUT");
+  if ((enabled && std::strcmp(enabled, "0") == 0) || !std::dynamic_pointer_cast<CDRMAtomic>(m_DRM))
+    return false;
+  // An ordinary picture on the bridge's scanout: a progressive mode of a size the engine
+  // takes as its canvas (dvvk_create_canvas: both sides multiples of 4, 64 to 4096).
+  const auto* mode = m_DRM->GetSelectedMode();
+  auto* connector = m_DRM->GetConnector();
+  const auto sized = [](unsigned value) { return value >= 64 && value <= 4096 && value % 4 == 0; };
+  return connector && connector->IsConnected() && mode && sized(mode->hdisplay) &&
+         sized(mode->vdisplay) &&
+         !(mode->flags & (DRM_MODE_FLAG_INTERLACE | DRM_MODE_FLAG_DBLSCAN)) &&
+         CDVPrivateVulkan::HasSDR();
+}
