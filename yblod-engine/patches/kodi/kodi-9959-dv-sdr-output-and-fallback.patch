+bool CDVPrivateVulkan::HasSDR()
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!HasHDR10())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    auto modes = reinterpret_cast<decltype(&dvvk_output_modes)>(dlsym(handle, "dvvk_output_modes"));
+    has = modes && (modes() & (1u << DVVK_OUTPUT_SDR)) && dlsym(handle, "dvvk_create_canvas");
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: SDR output {}", library, has ? "available" : "not available");
+  });
+  return has;
+}
+
+namespace
+{
+// SDR output's display (DVVK_OUTPUT_SDR's dvvk_output_mode), from the environment that
+// Settings > Player > Dolby Vision and native-dv.env set (DVEngineSettings.h):
+//   DV_SDR_WHITE   the display's white in cd/m2 (203; 100 for a projector)
+//   DV_SDR_GAMMA   2.2 for a pure 2.2 power, anything else BT.1886 (gamma 2.4)
+//   DV_SDR_RANGE   full or limited; auto (the default) follows Kodi's
+//                  "Use limited colour range" (videoscreen.limitedrange)
+//   DV_SDR_DITHER  0: rounded codes instead of the dither pattern
+//   DV_SDR_BLACK   the display's black in cd/m2 (0: white / 1000)
+dvvk_output_mode SdrMode()
+{
+  dvvk_output_mode mode{};
+  mode.mode = DVVK_OUTPUT_SDR;
+  const unsigned white = EnvNumber("DV_SDR_WHITE", 203, 1000);
+  mode.peak_nits = white >= 40 ? static_cast<float>(white) : 203.0f;
+  if (const char* black = std::getenv("DV_SDR_BLACK"); black && black[0])
+  {
+    const float nits = std::strtof(black, nullptr);
+    if (nits > 0.0f && nits < mode.peak_nits / 20.0f)
+      mode.min_nits = nits;
+  }
+  if (EnvIs("DV_SDR_GAMMA", "2.2"))
+    mode.flags |= DVVK_SDR_GAMMA22;
+  auto* window = CServiceBroker::GetWinSystem();
+  if (EnvIs("DV_SDR_RANGE", "limited") ||
+      (!EnvIs("DV_SDR_RANGE", "full") && window && window->UseLimitedColor()))
+    mode.flags |= DVVK_SDR_LIMITED;
+  if (EnvIs("DV_SDR_DITHER", "0"))
+    mode.flags |= DVVK_SDR_NO_DITHER;
+  return mode;
+}
