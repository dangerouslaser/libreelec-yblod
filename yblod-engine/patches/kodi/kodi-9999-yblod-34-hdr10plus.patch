+bool CDVPrivateVulkan::HasHDR10Plus()
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!HasHDR10())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    has = dlsym(handle, "dvvk_hdr10plus_packet") != nullptr;
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: HDR10+ output {}", library, has ? "available" : "not available");
+  });
+  return has;
+}
