From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 13:05:49 -0500
Subject: [PATCH] kodi: give the Dolby Vision engine the surface without a GL
 texture

CLinuxRendererGLES::Render made a texture of every picture before it
took the Dolby Vision branch. For a VAAPI surface that is an export
(vaExportSurfaceHandle), a blocking vaSyncSurface, EGL images and
texture binds, and after the frame an EGL fence, all for a texture the
Dolby Vision path never samples: the Vulkan engine reads the decoded
surface itself. The CPU-side sync also defeats the engine's wait for
the decoder on the GPU.

The Dolby Vision branch now comes first. Nothing replaces the fence:
NeedBuffer() reports a buffer without one as free, and the surface is
kept by the adapter's own lease (CDVPrivateSource holds the picture
until the engine's ticket is done). An invalid picture is still refused
quietly, as the texture upload refused it.

The YUV and scaling shaders are not compiled for a renderer configured
for Dolby Vision either: they draw nothing there. A renderer leaves the
Dolby Vision path only through Configure(), which validates the render
target again and compiles them then.
---
 .../HwDecRender/RendererVAAPIGLES.cpp         | 18 +++++-----
 .../VideoRenderers/LinuxRendererGLES.cpp      | 35 +++++++++++--------
 2 files changed, 29 insertions(+), 24 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
index 06847ed..5e74e7b 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/HwDecRender/RendererVAAPIGLES.cpp
@@ -186,7 +186,9 @@ bool CRendererVAAPIGLES::RenderDVBridge(int idx)
   auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbmGLESContext*>(
       CServiceBroker::GetWinSystem());
   auto& buffer = m_buffers[idx];
-  if (!window || !buffer.doviMetadata.Data() || buffer.doviPts == DVD_NOPTS_VALUE)
+  auto* picture = dynamic_cast<CVaapiRenderPicture*>(buffer.videoBuffer);
+  if (!window || !picture || !picture->valid || !buffer.doviMetadata.Data() ||
+      buffer.doviPts == DVD_NOPTS_VALUE)
     return false;
   CDVBridgeGLES::Layer layer{};
   switch (m_vaapiFourcc)
@@ -198,15 +200,11 @@ bool CRendererVAAPIGLES::RenderDVBridge(int idx)
   layer.width = m_sourceWidth;
   layer.height = m_sourceHeight;
   layer.pts = buffer.doviPts;
-  if (auto* picture = dynamic_cast<CVaapiRenderPicture*>(buffer.videoBuffer);
-      picture && picture->valid)
-  {
-    layer.vaDisplay = picture->vadsp;
-    layer.vaSurface = picture->procPic.videoSurface;
-    layer.vaOwner = picture;
-    layer.chromaPosition = picture->DVDPic.chroma_position;
-    layer.pairedSiting = picture->DVDPic.doviElSkipped;
-  }
+  layer.vaDisplay = picture->vadsp;
+  layer.vaSurface = picture->procPic.videoSurface;
+  layer.vaOwner = picture;
+  layer.chromaPosition = picture->DVDPic.chroma_position;
+  layer.pairedSiting = picture->DVDPic.doviElSkipped;
   if (m_sourceRect.x1 != 0 || m_sourceRect.y1 != 0 ||
       m_sourceRect.Width() != m_sourceWidth || m_sourceRect.Height() != m_sourceHeight)
     return false;
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
index fa9813f..ab5e729 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/LinuxRendererGLES.cpp
@@ -148,13 +148,20 @@ bool CLinuxRendererGLES::ValidateRenderTarget()
     // trigger update of video filters
     m_scalingMethodGui = VS_SCALINGMETHOD_MAX;
 
-    // create the yuv textures
-    UpdateVideoFilter();
-    LoadShaders();
-
-    if (m_renderMethod < 0)
+#ifdef HAVE_DVBRIDGE
+    // The Dolby Vision engine reads the decoded surfaces: no picture is drawn
+    // with the YUV and scaling shaders, so none are compiled.
+    if (!m_dvRequested)
+#endif
     {
-      return false;
+      // create the yuv textures
+      UpdateVideoFilter();
+      LoadShaders();
+
+      if (m_renderMethod < 0)
+      {
+        return false;
+      }
     }
 
     for (int i = 0; i < m_NumYUVBuffers; i++)
@@ -1221,20 +1228,20 @@ bool CLinuxRendererGLES::Render(unsigned int flags, int index)
     m_currentField = FIELD_FULL;
   }
 
+#ifdef HAVE_DVBRIDGE
+  // The engine reads the decoded surface itself and waits for the decoder on
+  // the GPU: no texture is made of it and no fence of ours guards it (the
+  // engine's adapter keeps the surface until its frame is done).
+  if (m_dvRequested)
+    return m_buffers[index].videoBuffer && m_currentField == FIELD_FULL && RenderDVBridge(index);
+#endif
+
   // call texture load function
   if (!UploadTexture(index))
   {
     return false;
   }
 
-#ifdef HAVE_DVBRIDGE
-  if (m_dvRequested)
-  {
-    const bool rendered = m_currentField == FIELD_FULL && RenderDVBridge(index);
-    AfterRenderHook(index);
-    return rendered;
-  }
-#endif
   if (RenderHook(index))
   {
     ;
