+#ifdef HAVE_DVBRIDGE
+void CDVDVideoCodecFFmpeg::DVFelFault(const char* reason)
+{
+  ++m_dvFelFaults;
+  if (!m_dvFelWarned)
+  {
+    m_dvFelWarned = true;
+    CLog::Log(LOGWARNING,
+              "Dolby Vision FEL: the enhancement layer lost its pairing ({}); showing the base "
+              "layer and metadata until the next common key frame (logged once per title)",
+              reason);
+  }
+  else
+    CLog::Log(LOGDEBUG, "Dolby Vision FEL: pairing fault {} since the last seek: {}",
+              m_dvFelFaults, reason);
+  dvbridge_fel_reset(m_dvFel.get());
+  m_dvFelResyncing = true;
+  if (m_dvFelFaults > DV_FEL_RESYNCS && !m_dvFelBypass)
+  {
+    m_dvFelBypass = true;
+    CLog::Log(LOGWARNING,
+              "Dolby Vision FEL: {} pairing faults since the last seek; the enhancement layer is "
+              "not decoded until the next seek",
+              m_dvFelFaults);
+  }
+}
+
+CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::DVEmitUnpaired(VideoPicture* picture)
+{
+  m_dvPending.front()->doviElSkipped = true;
+  picture->CopyRef(*m_dvPending.front());
+  DVPopPending();
+  return VC_PICTURE;
+}
+
+std::shared_ptr<VideoPicture> CDVDVideoCodecFFmpeg::DVTakePicture()
+{
+  if (m_dvSpare.empty())
+  {
+    auto picture = std::make_shared<VideoPicture>();
+    picture->Reset();
+    return picture;
+  }
+  auto picture = std::move(m_dvSpare.back());
+  m_dvSpare.pop_back();
+  return picture;
+}
+
+void CDVDVideoCodecFFmpeg::DVRecycle(std::shared_ptr<VideoPicture> picture)
+{
+  // Releases its surface and enhancement picture, as destroying it would.
+  picture->Reset();
+  if (m_dvSpare.size() < 4)
+    m_dvSpare.push_back(std::move(picture));
+}
+
+void CDVDVideoCodecFFmpeg::DVPopPending()
+{
+  auto picture = std::move(m_dvPending.front());
+  m_dvPending.pop_front();
+  DVRecycle(std::move(picture));
+}
+#endif
+
 CDVDVideoCodec::VCReturn CDVDVideoCodecFFmpeg::GetPicture(VideoPicture* pVideoPicture)
+{
+#ifdef HAVE_DVBRIDGE
+  if (m_dvFel && !m_dvFelBypass && dvbridge_fel_failed(m_dvFel.get()))
+    DVFelFault(dvbridge_fel_error(m_dvFel.get()));
+  if (m_dvFel && !m_dvFelBypass)
+  {
+    auto emit = [&]() -> VCReturn
+    {
+      if (m_dvPending.empty())
+        return VC_NONE;
+      if (m_dvFelBypass)
+        return DVEmitUnpaired(pVideoPicture);
+      auto& base = m_dvPending.front();
+      if (base->doviSourcePts == AV_NOPTS_VALUE)
+      {
+        DVFelFault("a base picture has no time");
+        return DVEmitUnpaired(pVideoPicture);
+      }
+      AVFrame* enhancement = nullptr;
+      int result = dvbridge_fel_take(m_dvFel.get(), base->doviSourcePts,
+                                     &enhancement);
+      if (result == 2)
+      {
+        // Before the first common key frame: Kodi's preroll after a seek, but shown while the
+        // pairing restarts after a fault.
+        if (m_dvFelResyncing)
+          return DVEmitUnpaired(pVideoPicture);
+        DVPopPending();
+        return VC_BUFFER;
+      }
+      if (result < 0)
+      {
+        if (dvbridge_fel_exhausted(m_dvFel.get()))
+        {
+          CLog::Log(LOGWARNING, "DV FEL: enhancement EOF with {} unpaired base pictures; "
+                               "ending video without substituting enhancement frames",
+                    m_dvPending.size());
+          m_dvPending.clear();
+          return VC_EOF;
+        }
+        DVFelFault(dvbridge_fel_failed(m_dvFel.get()) ? dvbridge_fel_error(m_dvFel.get())
+                                                     : "an enhancement picture is missing");
+        return DVEmitUnpaired(pVideoPicture);
+      }
+      if (!result)
+        return VC_NONE;
+      if (m_dvFelResyncing)
+      {
+        m_dvFelResyncing = false;
+        CLog::Log(LOGDEBUG, "Dolby Vision FEL: the enhancement layer is paired again");
+      }
+      base->doviEnhancement = {enhancement, [](AVFrame* f) { av_frame_free(&f); }};
+      pVideoPicture->CopyRef(*base);
+      DVPopPending();
+      return VC_PICTURE;
+    };
+    VCReturn paired = emit();
+    if (paired != VC_NONE)
+      return paired;
+    if (m_dvPending.size() >= 16)
+    {
+      DVFelFault("16 base pictures wait for their enhancement pictures");
+      return DVEmitUnpaired(pVideoPicture);
+    }
+    auto base = DVTakePicture();
+    VCReturn result = GetBasePicture(base.get());
+    if (m_dvMel)
+    {
+      // Decided on this picture: stop decoding and feeding the EL.
+      CLog::Log(LOGINFO, "Dolby Vision MEL: the enhancement layer adds nothing; not decoding it");
+      m_dvFel.reset();
+      if (result == VC_PICTURE)
+        m_dvPending.push_back(std::move(base));
+      for (auto& picture : m_dvPending)
+        picture->doviElSkipped = true;
+      if (m_dvPending.empty())
+        return result;
+      pVideoPicture->CopyRef(*m_dvPending.front());
+      DVPopPending();
+      return VC_PICTURE;
+    }
+    if (result == VC_PICTURE)
+      m_dvPending.push_back(std::move(base));
+    else
+      DVRecycle(std::move(base));
+    if (m_pCodecContext->hw_frames_ctx)
+    {
+      auto* frames = reinterpret_cast<AVHWFramesContext*>(m_pCodecContext->hw_frames_ctx->data);
+      if (!dvbridge_fel_device(m_dvFel.get(), frames->device_ref))
+        DVFelFault(dvbridge_fel_error(m_dvFel.get()));
+    }
+    // While the pairing restarts there is nothing to drain: its pictures are shown unpaired.
+    if ((result == VC_EOF || (m_codecControlFlags & DVD_CODEC_CTRL_DRAIN)) && !m_dvFelResyncing &&
+        !dvbridge_fel_drain(m_dvFel.get()))
+      DVFelFault(dvbridge_fel_error(m_dvFel.get()));
+    paired = emit();
+    if (paired != VC_NONE)
+      return paired;
+    // The base layer ended: nothing is left to pair the rest with.
+    if (result == VC_EOF && !m_dvPending.empty())
+      return DVEmitUnpaired(pVideoPicture);
+    return result == VC_PICTURE ? VC_BUFFER : result;
+  }
+  // Pictures that waited for an EL partner before the stream turned out a MEL, or before the
+  // pairing was given up.
+  if (!m_dvPending.empty())
+    return DVEmitUnpaired(pVideoPicture);
+  VCReturn result = GetBasePicture(pVideoPicture);
+  if (result == VC_PICTURE && (m_dvMel || m_dvFelBypass || m_dvFelUnavailable))
+    pVideoPicture->doviElSkipped = true;
+  return result;
+#else
+  return GetBasePicture(pVideoPicture);
+#endif
+}
