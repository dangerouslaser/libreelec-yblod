diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVHDR10PlusToDovi.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVHDR10PlusToDovi.h
new file mode 100644
index 0000000..5da577a
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVHDR10PlusToDovi.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include "utils/log.h"
+
+#include <dlfcn.h>
+
+#include <cstdlib>
+#include <mutex>
+
+#include <dv-engine-vk/dv_engine_vk.h>
+
+/*!
+ * HDR10+ -> Dolby Vision (YBLOD 0.4.0 F): the Vulkan engine library's
+ * dvvk_hdr10plus_to_dovi (optional symbol, no engine instance needed) turns a
+ * picture's HDR10+ (AV_FRAME_DATA_DYNAMIC_HDR_PLUS) into the Profile 8.1
+ * AVDOVIMetadata the engine takes with an HDR10 base layer. The decoder calls
+ * it for each picture, so the result travels with the picture exactly as a
+ * Dolby Vision picture's AVDOVIMetadata does (VideoPicture::doviMetadata).
+ */
+namespace DVHDR10PlusToDovi
+{
+using Convert = decltype(&dvvk_hdr10plus_to_dovi);
+
+//! The library's converter, or nullptr (no library, another ABI, or an engine without it).
+inline Convert Function()
+{
+  static std::once_flag probed;
+  static Convert convert = nullptr;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0])
+      library = DVVK_LIBRARY;
+    // Kept loaded for the life of Kodi (the engine instances dlopen it again).
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    auto abi = reinterpret_cast<uint32_t (*)()>(dlsym(handle, "dvvk_abi_version"));
+    if (abi && abi() == DVVK_ABI_VERSION)
+      convert = reinterpret_cast<Convert>(dlsym(handle, "dvvk_hdr10plus_to_dovi"));
+    if (!convert)
+      dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: HDR10+ to Dolby Vision {}", library,
+              convert ? "available" : "not available");
+  });
+  return convert;
+}
+
+inline bool Available()
+{
+  return Function() != nullptr;
+}
+} // namespace DVHDR10PlusToDovi
