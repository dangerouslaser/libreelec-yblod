+// yblod-engine's dv_metadata_no_residual() (dv_nlq_metadata.h): the RPU adds no
+// residual (disable_residual_flag, or the MEL values of Dolby's Profile 7 Annex II
+// on all three channels), so the engine never reads the enhancement layer.
+bool DVNoResidual(const AVDOVIRpuDataHeader* h, const AVDOVIDataMapping* m)
+{
+  if (h->disable_residual_flag == 1)
+    return true;
+  if (h->disable_residual_flag || h->coef_data_type || h->coef_log2_denom > 32 ||
+      h->bl_bit_depth != 10 || h->el_bit_depth != 10 || h->vdr_bit_depth != 12 ||
+      m->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+    return false;
+  const uint64_t maximum = UINT64_C(1) << h->coef_log2_denom;
+  for (const auto& n : m->nlq)
+    if (n.nlq_offset || n.vdr_in_max != maximum || n.linear_deadzone_slope ||
+        n.linear_deadzone_threshold)
+      return false;
+  return true;
+}
+} // namespace
+#endif
 
