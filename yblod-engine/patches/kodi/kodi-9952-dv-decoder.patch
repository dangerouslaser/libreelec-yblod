+#ifdef HAVE_DVBRIDGE
+void CDVDVideoCodecFFmpeg::ConvertHDR10Plus(VideoPicture* picture,
+                                           const AVFrameSideData* hdr10plus)
+{
+  const auto convert = DVHDR10PlusToDovi::Function();
+  if (!convert || !hdr10plus->data || !hdr10plus->size)
+    return;
+  // The stream's static HDR10 metadata (L6, and the source range), as the picture has it.
+  dvvk_hdr10_static hdr10{};
+  if (picture->hasDisplayMetadata && picture->displayMetadata.has_luminance)
+  {
+    hdr10.max_luminance = static_cast<float>(av_q2d(picture->displayMetadata.max_luminance));
+    hdr10.min_luminance = static_cast<float>(av_q2d(picture->displayMetadata.min_luminance));
+  }
+  if (picture->hasLightMetadata)
+  {
+    hdr10.max_cll = static_cast<uint16_t>(std::min(picture->lightMetadata.MaxCLL, 65535u));
+    hdr10.max_fall = static_cast<uint16_t>(std::min(picture->lightMetadata.MaxFALL, 65535u));
+  }
+  if (m_dvHDR10PlusDovi.empty())
+    m_dvHDR10PlusDovi.resize(DVVK_HDR10PLUS_DOVI_BYTES / sizeof(uint64_t));
+  size_t size = 0;
+  dvvk_hdr10plus_dovi_info info{};
+  const int result = convert(hdr10plus->data, hdr10plus->size, &hdr10,
+                             m_dvHDR10PlusPreviousSize ? m_dvHDR10PlusPrevious.data() : nullptr,
+                             m_dvHDR10PlusDovi.data(), DVVK_HDR10PLUS_DOVI_BYTES, &size, &info);
+  // The next picture's scene comparison is against this one.
+  m_dvHDR10PlusPrevious.resize((hdr10plus->size + sizeof(uint64_t) - 1) / sizeof(uint64_t));
+  std::memcpy(m_dvHDR10PlusPrevious.data(), hdr10plus->data, hdr10plus->size);
+  m_dvHDR10PlusPreviousSize = hdr10plus->size;
+  if (result == 0 && picture->doviMetadata.Assign(
+                         reinterpret_cast<const uint8_t*>(m_dvHDR10PlusDovi.data()), size))
+  {
+    if (m_dvHDR10Plus == HDR10PlusToDV::Untried)
+      CLog::Log(LOGINFO, "HDR10+ to Dolby Vision: the title plays as Dolby Vision Profile 8.1 "
+                "(L1 {}/{}/{}, source {}..{} PQ{}{})", info.l1_min, info.l1_max, info.l1_avg,
+                info.source_min_pq, info.source_max_pq,
+                info.estimated_fields ? ", L1 partly estimated" : "",
+                info.untranslated_curve || info.untranslated_saturation
+                    ? ", the HDR10+ curve/saturation are not translated" : "");
+    m_dvHDR10Plus = HDR10PlusToDV::Converting;
+    m_dvHDR10PlusLast = picture->doviMetadata;
+    return;
+  }
+  if (m_dvHDR10Plus == HDR10PlusToDV::Untried)
+  {
+    // Not representable (several windows, no usable peak) or malformed: plain HDR10 for the title.
+    m_dvHDR10Plus = HDR10PlusToDV::Plain;
+    picture->doviMetadata.Reset();
+    CLog::Log(LOGWARNING, "HDR10+ to Dolby Vision: not possible for this title ({}); it plays as HDR10",
+              result == -2 ? "not representable" : "invalid HDR10+");
+    return;
+  }
+  // Already shown as Dolby Vision: switching outputs mid-title would blank the screen, so this
+  // picture keeps the previous picture's metadata.
+  picture->doviMetadata = m_dvHDR10PlusLast;
+  if (!m_dvHDR10PlusReported)
+  {
+    m_dvHDR10PlusReported = true;
+    CLog::Log(LOGWARNING, "HDR10+ to Dolby Vision: a picture could not be converted ({}); it keeps "
+              "the previous picture's metadata (logged once)", result);
+  }
+}
+#endif
+
 void CDVDVideoCodecFFmpeg::Reset()
 {
+#ifdef HAVE_DVBRIDGE
+  m_dvPending.clear();
+  dvbridge_fel_reset(m_dvFel.get());
+  m_dvFelFaults = 0;
+  m_dvFelResyncing = false;
+  m_dvFelBypass = false;
+  // After a seek the next HDR10+ picture starts a scene.
+  m_dvHDR10PlusPreviousSize = 0;
+#endif
   m_started = false;
