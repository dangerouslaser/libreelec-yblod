+      m->nlq_method_idc != AV_DOVI_NLQ_LINEAR_DZ)
+    return false;
+  const uint64_t maximum = UINT64_C(1) << h->coef_log2_denom;
+  for (const auto& n : m->nlq)
+    if (n.nlq_offset || n.vdr_in_max != maximum || n.linear_deadzone_slope ||
+        n.linear_deadzone_threshold)
+      return false;
+  return true;
+}
