   const unsigned packet = m_scanout->Packet();
   const bool refresh = m_scanout->Refresh();
   const unsigned elSurface = enhancement ? static_cast<unsigned>(reinterpret_cast<uintptr_t>(enhancement->data[3])) : UINT32_MAX;
+  // Whatever comes of it, the engine's last frame is no longer the one on screen.
+  m_shown.valid = m_preparing.valid = false;
   // The engine waits for the decoder's and the GUI's implicit fences on the GPU.
   const int result = m_vulkan->Render(m_scanout->Slot(), surface, elSurface, metadata, size, pts,
