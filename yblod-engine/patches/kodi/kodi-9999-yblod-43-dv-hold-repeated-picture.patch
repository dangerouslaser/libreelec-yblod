@@ -310,7 +334,9 @@ void CDVPrivateSource::Presented(bool success)
     if (!m_unsafe)
       CDVPrivateDrain::Get().Commit(m_drainTicket);
     ++m_presented;
+    m_shown = m_preparing;
   }
+  m_preparing.valid = false;
   m_ready = false;
 }
 
@@ -321,6 +347,7 @@ void CDVPrivateSource::Reset()
   if (m_vulkan && RetireVulkan(true)) m_vulkan->Reset();
   // The pools stay until no frame can read their surfaces any more.
   if (!m_unsafe) ReleasePool();
+  m_shown.valid = m_preparing.valid = false;
   m_ready = false;
   m_transitionFrames = 3;
 }
@@ -343,7 +370,8 @@ bool CDVPrivateSource::Close()
     delete m_scanout;
     m_scanout = nullptr;
   }
-  CLog::Log(LOGINFO, "Private source renderer closed: processed={} submissions={} presented={}", m_processed, m_serial, m_presented);
+  CLog::Log(LOGINFO, "Private source renderer closed: processed={} submissions={} presented={} held={}",
+            m_processed, m_serial, m_presented, m_held);
   return true;
 }
 
@@ -354,6 +382,7 @@ bool CDVPrivateSource::DisplayReplaced()
 {
   if (!m_scanout) return true;
   if (!m_scanout->Replaced()) return false;
+  m_shown.valid = m_preparing.valid = false;
   m_ready = false;
   return true;
 }
