                               const AVFrame* enhancement, const void* metadata,
                               size_t size, int64_t pts, const dv_source_geometry& geometry, const dv_source_input& input,
-                              const DVPrivateOverlay* overlay)
+                              const DVPrivateOverlay* overlay, uint64_t sequence, bool mayHold)
 {
   m_ready = false;
   if (m_unsafe) return -1;
   // Done Vulkan frames give their surfaces back; at most two stay in flight.
   if (m_vulkan && (!RetireVulkan(false) || (m_inFlight.size() >= 2 && !RetireVulkan(true)))) return -1;
+  // The same queued picture again, with nothing changed that it is made of:
+  // the buffer on screen is that picture already. Nothing is rendered and
+  // nothing committed (a pause, or a 24p film on a 60 Hz mode, would otherwise
+  // run the whole pipeline every refresh).
+  static const bool skipRepeats = !EnvIs("DV_PRIVATE_SKIP_REPEATS", "0");
+  if (skipRepeats && mayHold && sequence && m_vulkan && m_scanout && m_shown.valid &&
+      m_shown.sequence == sequence && m_shown.owner == owner && display == m_display &&
+      m_shown.slot == m_scanout->Current() && !m_scanout->NextRefresh() &&
+      m_vulkan->Repeats(surface,
+                        enhancement ? static_cast<unsigned>(reinterpret_cast<uintptr_t>(enhancement->data[3]))
+                                    : UINT32_MAX,
+                        metadata, size, pts, geometry, input, false, overlay))
+  {
+    // Shown is committed: a wait for this picture's commit (the first one of
+    // a start, the last one at the end) is over.
+    if (CDVPrivateDrain::Enabled())
+      CDVPrivateDrain::Get().Commit(CDVPrivateDrain::Get().Ticket(owner, pts));
+    if (++m_held <= 3 || m_held % 600 == 0)
+      CLog::Log(LOGINFO, "Private source frame held: pts={} held={} (already on screen)", pts, m_held);
+    return 2;
+  }
   const bool trace = (m_transitionFrames && EnvIs("DV_PRIVATE_TRANSITION_TIMING", "1")) ||
