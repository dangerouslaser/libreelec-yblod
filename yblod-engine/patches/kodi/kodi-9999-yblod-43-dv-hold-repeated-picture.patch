+dvvk_frame CDVPrivateVulkan::Frame(unsigned blSurface, unsigned elSurface, const void* metadata,
+                                   size_t size, int64_t pts, const dv_source_geometry& geometry,
+                                   const dv_source_input& input, bool refresh,
+                                   const DVPrivateOverlay* overlay) const
+{
+  const bool resized = geometry.destination_width &&
+      (geometry.destination_width != geometry.width || geometry.destination_height != geometry.height);
+  dvvk_frame frame{};
+  frame.plan.width = geometry.width;
+  frame.plan.height = geometry.height;
+  frame.plan.x = geometry.x;
+  frame.plan.y = geometry.y;
+  frame.plan.dw = resized ? geometry.destination_width : 0;
+  frame.plan.dh = resized ? geometry.destination_height : 0;
+  frame.plan.chroma_top_left = geometry.chroma_siting == DV_SOURCE_CHROMA_TOP_LEFT;
+  frame.plan.has_el = elSurface != UINT32_MAX;
+  frame.plan.nv12 = input.format == DV_SOURCE_INPUT_NV12;
+  frame.plan.el_scaler = m_elScaler;
+  frame.plan.fel = m_fel;
+  frame.plan.refresh = refresh;
+  // CB1 Master Reference's processing (CroqueMr's CB1, byte for byte): its
+  // siting (DVBridgeGLES chose it for this picture), 4:2:0 reshaping, no
+  // chroma pre-filter, the Annex B EL and 4:2:2 filters, its metadata block
+  // order, L5 and packet ids (the engine's own then). Unscaled pictures only,
+  // as CB1's; scaled ones stay yblod's. Its refresh: the first picture, a
+  // step back or a gap over 0.1 s; a repeated picture keeps its value.
+  if (m_cb1 && !resized)
+  {
+    frame.plan.cb1_contract = 1;
+    frame.plan.el_scaler = kElScalerAnnexB;
+    frame.plan.refresh = !m_cb1Frames ? true
+                         : pts != m_cb1LastPts ? pts < m_cb1LastPts || pts - m_cb1LastPts > 100000
+                                               : m_cb1Refresh;
+  }
+  frame.plan.pts = pts;
+  frame.plan.dm_options = m_dmOptions;
+  // The GUI colour stays that of the last GUI, so hiding it changes no coefficients.
+  const DVPrivateOverlay& colour = overlay ? *overlay : m_gui;
+  std::memcpy(frame.plan.rgb_to_lms, colour.rgbToLms, sizeof(frame.plan.rgb_to_lms));
+  frame.plan.white_nits = colour.whiteNits;
+  frame.bl_surface = blSurface;
+  frame.el_surface = elSurface;
+  frame.metadata = metadata;
+  frame.metadata_size = size;
+  frame.flags = DVVK_FRAME_AUTO_OVERLAY;
+  return frame;
+}
+
+bool CDVPrivateVulkan::Repeats(unsigned blSurface, unsigned elSurface, const void* metadata,
+                               size_t size, int64_t pts, const dv_source_geometry& geometry,
+                               const dv_source_input& input, bool refresh,
+                               const DVPrivateOverlay* overlay) const
+{
+  if (!m_engine || m_failed || !m_last.valid || overlay || m_last.overlay || m_last.overlayBefore ||
+      m_outputMode == DVVK_OUTPUT_HDR10PLUS || WantedOutputMode() != m_outputMode ||
+      m_last.outputMode != m_outputMode)
+    return false;
+  const dvvk_frame frame = Frame(blSurface, elSurface, metadata, size, pts, geometry, input, refresh, nullptr);
+  const dvvk_plan_in& a = frame.plan;
+  const dvvk_plan_in& b = m_last.frame.plan;
+  // Every member of the plan but the packet id (a new member is a new size).
+  static_assert(sizeof(dvvk_plan_in) == 160, "Repeats() compares dvvk_plan_in member by member");
+  return a.width == b.width && a.height == b.height && a.x == b.x && a.y == b.y && a.dw == b.dw &&
+         a.dh == b.dh && a.chroma_top_left == b.chroma_top_left && a.has_el == b.has_el &&
+         a.nv12 == b.nv12 && a.el_scaler == b.el_scaler && a.fel == b.fel && a.refresh == b.refresh &&
+         a.overlay == b.overlay && a.overlay_visible_before == b.overlay_visible_before &&
+         a.pts == b.pts && std::memcmp(a.rgb_to_lms, b.rgb_to_lms, sizeof(a.rgb_to_lms)) == 0 &&
+         a.white_nits == b.white_nits && a.cb1_contract == b.cb1_contract &&
+         a.dm_options == b.dm_options && frame.bl_surface == m_last.frame.bl_surface &&
+         frame.el_surface == m_last.frame.el_surface && frame.flags == m_last.frame.flags &&
+         frame.release_wait == m_last.frame.release_wait && size == m_last.metadata.size() &&
+         std::memcmp(metadata, m_last.metadata.data(), size) == 0;
+}
