+      m_scanout->Written(DV_SCANOUT_UNCERTAIN);
     return -1;
   }
   if (result == 0 && m_vulkan->Async())
@@ -342,9 +420,17 @@ void CDVPrivateSource::Presented(bool success)
 
 void CDVPrivateSource::Reset()
 {
+  if (m_unsafe) return;
   ReleaseInputs();
   if (m_scanout && !m_scanout->ResetStream()) m_unsafe = true;
-  if (m_vulkan && RetireVulkan(true)) m_vulkan->Reset();
+  if (m_vulkan)
+  {
+    // A reset is not a recovery: an engine that cannot complete its frames
+    // or its reset is drained and destroyed.
+    const bool retired = RetireVulkan(true);
+    if (retired) m_vulkan->Reset();
+    if (!retired || m_vulkan->Failed()) Recover("reset");
+  }
   // The pools stay until no frame can read their surfaces any more.
   if (!m_unsafe) ReleasePool();
   m_shown.valid = m_preparing.valid = false;
@@ -354,16 +440,13 @@ void CDVPrivateSource::Reset()
 
 bool CDVPrivateSource::Close()
 {
-  if (m_scanout && !m_scanout->CanClose()) return false;
   glFinish();
-  if (m_vulkan)
-  {
-    if (!RetireVulkan(true) || !m_vulkan->Close()) return false;
-    delete m_vulkan;
-    m_vulkan = nullptr;
-  }
-  ReleaseInputs();
-  ReleasePool();
+  // Frames in flight are waited for (their error flags logged); whether or
+  // not that worked, the drain decides if anything may still be read.
+  if (m_vulkan) RetireVulkan(true);
+  if (!DestroyEngine()) return false;
+  m_unsafe = false;
+  if (m_scanout && !m_scanout->CanClose()) return false;
   if (m_scanout)
   {
     if (!m_scanout->Close()) return false;
@@ -381,6 +464,14 @@ gbm_bo* CDVPrivateSource::ScanoutBuffer() const
 bool CDVPrivateSource::DisplayReplaced()
 {
   if (!m_scanout) return true;
+  // After a failure that did not drain: by now it may have. Not on every
+  // page of a menu: a drain that still fails takes its whole timeout.
+  const auto now = std::chrono::steady_clock::now();
+  if (m_unsafe && now - m_unsafeChecked >= std::chrono::seconds(10))
+  {
+    m_unsafeChecked = now;
+    if (DestroyEngine()) m_unsafe = false;
+  }
   if (!m_scanout->Replaced()) return false;
   m_shown.valid = m_preparing.valid = false;
   m_ready = false;
