+void CDVPrivateVulkan::VideoConfigured()
+{
+  int restarting = 1;
+  titleWithout.compare_exchange_strong(restarting, 2);
+}
+
+void CDVPrivateVulkan::PlaybackIdle()
+{
+  int playing = 2;
+  titleWithout.compare_exchange_strong(playing, 0);
 }
 
