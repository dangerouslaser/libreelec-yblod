 {
@@ -115,7 +120,7 @@ uint32_t DmOptions()
 
 bool CDVPrivateVulkan::Usable()
 {
-  if (engineFailed)
+  if (engineFailed || titleWithout.load() != 0)
     return false;
   // The library loads and is the ABI Kodi was built with (checked once).
   static std::once_flag probed;
@@ -143,11 +148,29 @@ bool CDVPrivateVulkan::Usable()
 
 void CDVPrivateVulkan::StartFailed()
 {
-  const bool first = !failureReported.load();
-  ReportUnavailable("the engine did not start");
+  // A cause that passes (memory, a GPU reset) must not cost Dolby Vision for
+  // the rest of the Kodi run; one that stays must not restart every title.
+  const unsigned failures = ++startFailures;
+  if (failures >= kStartFailureLimit)
+    ReportUnavailable("the engine did not start");
+  else
+    CLog::Log(LOGERROR, "Dolby Vision: the Vulkan engine did not start ({} of {}); this video plays as "
+              "plain base-layer video, the next one tries again", failures, kStartFailureLimit);
+  titleWithout = 1;
   // The title that tried it starts again where it was, as plain playback.
-  if (first)
-    CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
+}
