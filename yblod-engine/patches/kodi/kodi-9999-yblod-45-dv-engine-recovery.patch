+bool CDVPrivateSource::DestroyEngine()
+{
+  // The engine's contract after a failure, and the order at any end: every
+  // input stays until all submitted work has drained and the engine is
+  // destroyed. False: it did not drain, and nothing is released.
+  if (m_vulkan)
+  {
+    if (!m_vulkan->Close()) return false;
+    delete m_vulkan;
+    m_vulkan = nullptr;
+  }
+  for (InFlight& frame : m_inFlight)
+  {
+    frame.enhancement.reset();
+    if (frame.owner) frame.owner->Release();
+  }
+  m_inFlight.clear();
+  ReleaseInputs();
+  ReleasePool();
+  if (m_scanout) m_scanout->Drained();
+  m_shown.valid = m_preparing.valid = false;
+  m_ready = false;
+  return true;
+}
+
+bool CDVPrivateSource::Recover(const char* stage)
+{
+  if (!DestroyEngine())
+  {
+    // Fail-stop: its work may still read the decoded surfaces.
+    m_unsafe = true;
+    CLog::Log(LOGFATAL, "Private source: the Vulkan engine failed ({}) and did not drain; retaining "
+              "frame leases, no Dolby Vision picture until it does", stage);
+    return false;
+  }
+  // A failure now and then over a long title is recovered every time; one
+  // that comes straight back is not retried for ever.
+  if (m_processed - m_recoveryMark > 1000)
+    m_recoveries = 0;
+  m_recoveryMark = m_processed;
+  if (++m_recoveries > 2)
+  {
+    CLog::Log(LOGERROR, "Private source: the Vulkan engine failed again ({}); drained and destroyed, "
+              "not started again for this video", stage);
+    m_startFailed = true;
+    CDVPrivateVulkan::StartFailed();
+  }
+  else
+    CLog::Log(LOGWARNING, "Private source: the Vulkan engine failed ({}); drained and destroyed, "
+              "starting again with the next picture (recovery {})", stage, m_recoveries);
+  return true;
+}
+
