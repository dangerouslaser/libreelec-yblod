@@ -272,9 +349,10 @@ int CDVPrivateSource::Prepare(void* display, unsigned surface, CVideoBuffer* own
     CLog::Log(LOGINFO, "Private source consume: pts={} status={}", pts, result);
   if (result == CDVPrivateVulkan::DV_VULKAN_FAILED)
   {
-    m_scanout->Written(DV_SCANOUT_UNCERTAIN);
