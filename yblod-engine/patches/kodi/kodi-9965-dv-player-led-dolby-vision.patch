 // by OutputModeOptions where the connection has it, and is accepted by SelectOutputSettings below.
-enum class OutputMode : int { Standard = 0, HDR10 = 1, Disabled = 2, HDR10Plus = 3, SDR = 4 };
+enum class OutputMode : int { Standard = 0, HDR10 = 1, Disabled = 2, HDR10Plus = 3, SDR = 4,
+                              PlayerLed = 5 };
 
 // Playback preparation latches the preferences. An open settings dialog must not
 // change the output encoding of an already running playback session.
@@ -68,6 +69,42 @@ inline std::atomic<uint32_t> playbackHDR10PlusFlags{0};
 // conversion) and the property is cleared. Cleared when the output ends.
 inline std::atomic<bool> playbackHDR10PlusFallback{false};
 
+// Player-led Dolby Vision (OutputMode PlayerLed, never chosen by the fallback): the Vulkan
+// engine maps the picture to the TV's own target from its Dolby Vision VSVDB (DVVK_OUTPUT_LLDV)
+// and the tunnel's 12-bit YCbCr 4:2:2 goes out with DVBRIDGE_TUNNEL_FORMAT lldv (the Dolby VSIF
+// with its low-latency bit, no HDR static metadata). The window sets it and the target for the
+// output it begins and clears it at the end; the engine reads both for every frame and says
+// of each picture it made whether it is player-led (pictureLLDV), which the commit that shows
+// it signals.
+struct LLDVTarget
+{
+  float peakNits{0.0f}, minNits{0.0f};
+  float primaries[3][2]{}; // R, G, B (x, y), fitted inside BT.2020
+  uint32_t edidVersion{0};
+  unsigned bits{12}; // useful bits in the 12-bit carrier: 12, or 10 (DV_LLDV_BITS)
+  bool operator==(const LLDVTarget&) const = default;
+};
+inline std::atomic<bool> playbackTunnelLLDV{false};
+inline std::atomic<bool> pictureLLDV{false};
+// The kernel refused player-led commits on this connection, or the engine the TV's target: it
+// is not offered again until Kodi restarts (the window's SupportsTunnelLLDV).
+inline std::atomic<bool> lldvUnavailable{false};
+namespace detail
+{
+inline std::mutex lldvLock;
+inline LLDVTarget lldvTarget;
+} // namespace detail
+inline void SetLLDVTarget(const LLDVTarget& target)
+{
+  std::lock_guard lock(detail::lldvLock);
+  detail::lldvTarget = target;
+}
+inline LLDVTarget CurrentLLDVTarget()
+{
+  std::lock_guard lock(detail::lldvLock);
+  return detail::lldvTarget;
+}
+
 // Settings > Player > Dolby Vision > HDR10+ videos (dvbridge.hdr10plussources), latched per
 // video: 1 plays HDR10+ titles as Dolby Vision (Profile 8.1 with metadata made from each
 // picture's HDR10+, dvvk_hdr10plus_to_dovi), 0 as Kodi plays them today.
@@ -91,12 +128,14 @@ enum class TitleOutput : int
   HDR10Plus = 2,
   HLG = 3,
   SDR = 4,
+  PlayerLed = 5, // a Dolby Vision video's player-led Dolby Vision
 };
 inline const char* TitleOutputName(TitleOutput output)
 {
-  static constexpr const char* names[]{"Dolby Vision", "HDR10", "HDR10+", "HLG", "SDR"};
+  static constexpr const char* names[]{"Dolby Vision", "HDR10", "HDR10+", "HLG", "SDR",
+                                       "Dolby Vision (player-led)"};
   const int index = static_cast<int>(output);
-  return index >= 0 && index < 5 ? names[index] : "none";
+  return index >= 0 && index < 6 ? names[index] : "none";
 }
 
 // HDR10 videos as Dolby Vision (TitleOutput DolbyVision of an HDR10 video): each picture with
@@ -283,6 +322,7 @@ inline void SelectOutputSettings(const std::string& path)
     case OutputMode::Disabled:
     case OutputMode::HDR10Plus:
     case OutputMode::SDR:
+    case OutputMode::PlayerLed:
       playbackMode.store(static_cast<OutputMode>(mode));
       break;
     default:
