+uint32_t CDVPrivateVulkan::TargetFlags()
+{
+  static std::once_flag probed;
+  static uint32_t flags = 0;
+  if (!HasHDR10())
+    return 0;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    auto targetFlags = reinterpret_cast<decltype(&dvvk_target_flags)>(dlsym(handle, "dvvk_target_flags"));
+    flags = targetFlags ? targetFlags() : 0;
