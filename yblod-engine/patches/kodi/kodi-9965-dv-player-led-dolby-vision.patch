+bool CWinSystemGbmGLESContext::SupportsTunnelLLDV(DVBRIDGE::LLDVTarget* target)
+{
+  // DV_LLDV_BITS (native-dv.env): 12 useful bits (the default) or 10 in the 12-bit carrier.
+  const char* bits = std::getenv("DV_LLDV_BITS");
+  const bool tenBits = bits && std::strcmp(bits, "10") == 0;
+  const char* enabled = std::getenv("DV_LLDV_OUTPUT");
