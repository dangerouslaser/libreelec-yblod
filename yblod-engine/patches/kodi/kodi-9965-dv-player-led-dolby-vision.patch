+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  dvvk_lldv_display display{};
+  std::string missing;
+  if (enabled && std::strcmp(enabled, "0") == 0)
+    missing = "DV_LLDV_OUTPUT=0";
+  else if (DVBRIDGE::lldvUnavailable.load())
+    missing = "refused before in this Kodi run";
+  else if (!std::dynamic_pointer_cast<CDRMAtomic>(m_DRM) || !connector || !connector->IsConnected())
+    missing = "no connected atomic DRM output";
+  else if (!CDVBridgeState::SupportsLLDV(*connector))
+    missing = "the connector has no DVBRIDGE_TUNNEL_FORMAT lldv";
+  else if (!mode || mode->hdisplay != 3840 || mode->vdisplay != 2160 ||
+           (mode->flags & DRM_MODE_FLAG_INTERLACE))
+    missing = "the display mode is not progressive 3840x2160";
+  else if (!CDVPrivateVulkan::HasLLDV(tenBits))
+    missing = tenBits ? "the engine library has no player-led output with 10 useful bits"
+                      : "the engine library has no player-led output";
+  else if (!DisplayLowLatencyDolbyVision())
+    missing = "the TV's EDID has no Dolby Vision block with the low-latency interface";
+  else
+  {
+    const auto block = DisplayDolbyVisionBlock();
+    if (CDVPrivateVulkan::LLDVDisplay(block.data(), block.size(), display) != 0)
+    {
+      static constexpr const char* reasons[] = {
+          "", "not a Dolby Vision VSVDB the engine reads", "its version has no player-led target",
+          "the TV does not take low-latency 4:2:2", "its luminance is invalid",
+          "its primaries are invalid", "its primaries are outside BT.2020"};
+      missing = StringUtils::Format("the TV's Dolby Vision block gives no target: {} (status {})",
+                                    display.status < 7 ? reasons[display.status] : "unknown",
+                                    display.status);
+    }
+  }
+  DVBRIDGE::LLDVTarget lldv;
+  if (missing.empty())
+  {
+    lldv.peakNits = static_cast<float>(display.peak_nits);
+    lldv.minNits = static_cast<float>(display.min_nits);
+    for (unsigned i = 0; i < 3; ++i)
+      for (unsigned j = 0; j < 2; ++j)
+        lldv.primaries[i][j] = static_cast<float>(display.primaries[i][j]);
+    lldv.edidVersion = display.version;
+    lldv.bits = tenBits ? 10 : 12;
+  }
+  // Asked often (the settings, the OSD, each picture's output): said when it changes.
+  static std::mutex lock;
+  static std::string reported;
+  const std::string now = missing.empty()
+      ? StringUtils::Format("available: the TV's target {:.0f} / {:.4f} cd/m2, primaries "
+                            "R {:.4f},{:.4f} G {:.4f},{:.4f} B {:.4f},{:.4f}, VSVDB version {}, "
+                            "{} useful bits (the block says {} for its low-latency 4:2:2)",
+                            lldv.peakNits, lldv.minNits, lldv.primaries[0][0],
+                            lldv.primaries[0][1], lldv.primaries[1][0], lldv.primaries[1][1],
+                            lldv.primaries[2][0], lldv.primaries[2][1], lldv.edidVersion,
+                            lldv.bits, display.flags & DVVK_VSVDB_422_12 ? 12 : 10)
+      : "not available: " + missing;
+  {
+    std::lock_guard guard(lock);
+    if (reported != now)
+    {
+      reported = now;
+      CLog::Log(LOGINFO, "DVBridge output: player-led Dolby Vision {}", now);
+    }
+  }
+  if (!missing.empty())
+    return false;
+  if (target)
+    *target = lldv;
+  return true;
+}
