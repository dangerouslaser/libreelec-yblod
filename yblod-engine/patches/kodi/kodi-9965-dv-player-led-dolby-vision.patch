+  return has && (!tenBits || (TargetFlags() & DVVK_LLDV_10BIT));
+}
+
+int CDVPrivateVulkan::LLDVDisplay(const uint8_t* block, size_t size, dvvk_lldv_display& out)
+{
+  out = {};
+  if (!HasLLDV(false))
+    return -3;
+  // Asked for each picture while it plays: the library is asked again only for another block.
+  static std::mutex lock;
+  static std::vector<uint8_t> last;
+  static int lastResult = -3;
+  static dvvk_lldv_display lastDisplay{};
+  std::lock_guard guard(lock);
+  if (lastResult == -3 || last.size() != size || !std::equal(last.begin(), last.end(), block))
+  {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    auto fromVsvdb = handle ? reinterpret_cast<decltype(&dvvk_lldv_display_from_vsvdb)>(
+                                  dlsym(handle, "dvvk_lldv_display_from_vsvdb"))
+                            : nullptr;
+    lastDisplay = {};
+    lastResult = fromVsvdb ? fromVsvdb(block, size, &lastDisplay) : -3;
+    if (handle)
+      dlclose(handle);
+    last.assign(block, block + size);
+  }
+  out = lastDisplay;
+  return lastResult;
+}
