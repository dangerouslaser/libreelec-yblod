+namespace
+{
+// The engine does not take player-led Dolby Vision for this TV (its library, or the target from
+// the TV's VSVDB): not offered again until Kodi restarts, and the title restarts with the
+// output the Automatic fallback gives (WinSystemGbmGLESContext DVOutput).
+void LLDVRefused(const char* what, int result)
+{
+  if (DVBRIDGE::lldvUnavailable.exchange(true))
+    return;
+  CLog::Log(LOGERROR, "Vulkan engine refused player-led Dolby Vision ({}: {}); not offered again "
+            "until Kodi restarts, the title restarts with the Automatic fallback's output", what,
+            result);
+  auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(45010),
+                                        strings.Get(45170));
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
+}
+
+std::string LLDVTargetName(const DVBRIDGE::LLDVTarget& target)
+{
+  return StringUtils::Format(
+      "{:.0f} nits, black {:.4f}, primaries R {:.4f},{:.4f} G {:.4f},{:.4f} B {:.4f},{:.4f}, "
+      "EDID v{}, {}-bit",
+      target.peakNits, target.minNits, target.primaries[0][0], target.primaries[0][1],
+      target.primaries[1][0], target.primaries[1][1], target.primaries[2][0],
+      target.primaries[2][1], target.edidVersion, target.bits);
+}
