+
+bool CDVPrivateVulkan::HasLLDV(bool tenBits)
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!HasHDR10())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    auto modes = reinterpret_cast<decltype(&dvvk_output_modes)>(dlsym(handle, "dvvk_output_modes"));
+    auto fromVsvdb = reinterpret_cast<decltype(&dvvk_lldv_display_from_vsvdb)>(
+        dlsym(handle, "dvvk_lldv_display_from_vsvdb"));
+    has = modes && (modes() & (1u << DVVK_OUTPUT_LLDV)) && fromVsvdb &&
+          dlsym(handle, "dvvk_set_display_primaries");
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: player-led Dolby Vision {}", library,
+              has ? "available" : "not available");
