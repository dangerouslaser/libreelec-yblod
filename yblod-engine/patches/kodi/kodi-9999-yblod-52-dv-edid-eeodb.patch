From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 12:58:57 -0500
Subject: [PATCH 3/9] yblod-52: accept HF-EEODB EDIDs and real v0 Dolby Vision
 blocks

dvbridge_parse_edid required the EDID to be exactly (byte 126 + 1)
blocks. A sink with an HDMI Forum EDID Extension Override Data Block
declares more blocks there than byte 126 does, and the kernel's EDID
blob then holds them all, so such sinks were rejected as edid-invalid.
Accept any whole number of blocks that is at least what byte 126 says
and walk all of them. A bad checksum in an extension block now skips
that block, as DRM drops such blocks; block 0 must still be valid.

The v0 Dolby Vision VSVDB check compared the header's length field with
21, but a v0 block is 26 bytes with its header: the field is 25 (0x19).
edid-decode reports "Version: 0 (26 bytes)" for the Vizio and Sharp v0
EDIDs in the linuxhw/EDID collection, and Amlogic's HDMI driver accepts
v0 only with length 0x19 ("DV 2.9 Page 27"). Every v0 sink was rejected
as invalid-dv-block-length.

The kernel's copy of this parser (linux-9902, dvbridge_edid.h) needs the
same change.
---
 xbmc/utils/DVBridgeEdid.h | 25 +++++++++++++++----------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/xbmc/utils/DVBridgeEdid.h b/xbmc/utils/DVBridgeEdid.h
index 1611a4e..f7ca959 100644
--- a/xbmc/utils/DVBridgeEdid.h
+++ b/xbmc/utils/DVBridgeEdid.h
@@ -44,28 +44,32 @@ dvbridge_parse_edid(const unsigned char *edid, size_t size)
 	static const unsigned char magic[8] = {0, 255, 255, 255, 255, 255, 255, 0};
 	struct dvbridge_sink_caps result = {DV_EDID_ABSENT, 0, 0, 0, false, false};
 	unsigned int block, i, found = 0;
+	unsigned char sum;
 
 	if (!edid || !size)
 		return result;
 	result.status = DV_EDID_INVALID;
-	if (size < 128 || size != ((size_t)edid[126] + 1) * 128)
+	/* An HDMI Forum EEODB overrides byte 126: the blob can hold more
+	 * blocks than it says, never fewer. */
+	if (size < 128 || size % 128 || size < ((size_t)edid[126] + 1) * 128)
 		return result;
 	for (i = 0; i < 8; i++)
 		if (edid[i] != magic[i])
 			return result;
-	/* Check every block before interpreting any capability. */
-	for (block = 0; block < size / 128; block++) {
-		unsigned char sum = 0;
-		for (i = 0; i < 128; i++)
-			sum += edid[block * 128 + i];
-		if (sum)
-			return result;
-	}
+	for (i = 0, sum = 0; i < 128; i++)
+		sum += edid[i];
+	if (sum)
+		return result;
 	result.status = DV_EDID_NO_DV;
 	for (block = 1; block < size / 128; block++) {
 		const unsigned char *b = edid + block * 128;
 		unsigned int end = b[2], pos;
 
+		/* A corrupt extension is skipped, as DRM drops such blocks. */
+		for (i = 0, sum = 0; i < 128; i++)
+			sum += b[i];
+		if (sum)
+			continue;
 		if (b[0] != 2 || b[1] < 3 || !end)
 			continue;
 		if (end < 4 || end > 127) {
@@ -94,7 +98,8 @@ dvbridge_parse_edid(const unsigned char *edid, size_t size)
 				result.version = data[4] >> 5;
 				switch (result.version) {
 				case 0:
-					if (len != 21)
+					/* 26 bytes with the header: 0x19 */
+					if (len != 25)
 						return result;
 					result.legacy_vsif = true;
 					result.supports_2160p60 = (data[4] & 2) != 0;
