diff --git a/xbmc/application/Application.cpp b/xbmc/application/Application.cpp
index fde4e79..87dd40d 100644
--- a/xbmc/application/Application.cpp
+++ b/xbmc/application/Application.cpp
@@ -1547,6 +1547,8 @@ void CApplication::UnlockFrameMoveGuard()
 void CApplication::FrameMove(bool processEvents, bool processGUI)
 {
   const auto appPlayer = GetComponent<CApplicationPlayer>();
+  bool nativeGuiSkip = false;
+  uint64_t nativeGuiGeneration = 0;
   bool renderGUI = GetComponent<CApplicationPowerHandling>()->GetRenderGUI();
   if (processEvents)
   {
@@ -1640,10 +1642,26 @@ void CApplication::FrameMove(bool processEvents, bool processGUI)
     if (!m_skipGuiRender && appPlayer->IsRenderingVideoLayer() &&
         !CServiceBroker::GetGUI()->GetWindowManager().HasDirtyRegions())
       m_skipGuiRender = true;
+    const char* homeCache = std::getenv("DV_PRIVATE_GUI_CACHE_HOME");
+    if (!m_skipGuiRender &&
+        (CServiceBroker::GetWinSystem()->GetGfxContext().IsFullScreenVideo() ||
+         (homeCache && std::strcmp(homeCache, "1") == 0)) &&
+        CServiceBroker::GetWinSystem()->CanReuseGuiComposite() &&
+        !CServiceBroker::GetGUI()->GetWindowManager().HasDirtyRegions())
+    {
+      nativeGuiSkip = true;
+      m_skipGuiRender = true;
+      nativeGuiGeneration = CServiceBroker::GetGUI()->GetWindowManager().GetDirtyGeneration();
+    }
     CServiceBroker::GetGUI()->GetWindowManager().FrameMove();
   }
 
   appPlayer->FrameMove();
+  // Subtitle preparation can invalidate the GUI after its Process pass.
+  if (nativeGuiSkip &&
+      (!CServiceBroker::GetWinSystem()->CanReuseGuiComposite() ||
+       nativeGuiGeneration != CServiceBroker::GetGUI()->GetWindowManager().GetDirtyGeneration()))
+    m_skipGuiRender = false;
 
   // this will go away when render systems gets its own thread
   CServiceBroker::GetWinSystem()->DriveRenderLoop();
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
index f3d63e0..797be00 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRenderer.cpp
@@ -152,8 +152,11 @@ void CRenderer::Render(int idx, float depth)
   std::unique_lock lock(m_section);
 
   // during HDR composite the m_isHDROverlay overlays render via
-  // RenderHDROverlays instead
-  const bool hdrComposite = CServiceBroker::GetWinSystem()->IsHdrComposite();
+  // RenderHDROverlays instead, except with native Dolby Vision GUI coverage:
+  // there the GUI layer is composited by the engine, so PGS subtitles are drawn
+  // into it like other subtitles (palette converted to sRGB)
+  const bool hdrComposite = CServiceBroker::GetWinSystem()->IsHdrComposite() &&
+                            !CServiceBroker::GetWinSystem()->UsesNativeGuiCoverage();
   const RenderStereoView stereoView =
       CServiceBroker::GetWinSystem()->GetGfxContext().GetStereoView();
 
@@ -182,7 +185,8 @@ void CRenderer::Render(int idx, float depth)
 // FBO's sRGB->HDR conversion
 void CRenderer::RenderHDROverlays(int idx)
 {
-  if (!CServiceBroker::GetWinSystem()->IsHdrComposite())
+  if (!CServiceBroker::GetWinSystem()->IsHdrComposite() ||
+      CServiceBroker::GetWinSystem()->UsesNativeGuiCoverage())
     return;
 
   std::unique_lock lock(m_section);
@@ -299,6 +303,18 @@ void CRenderer::Render(COverlay* o)
   o->Render(state);
 }
 
+bool CRenderer::HasHDROverlay(int idx) const
+{
+  std::unique_lock lock(m_section);
+  if (idx < 0 || idx >= NUM_BUFFERS)
+    return false;
+  for (const auto& e : m_buffers[idx])
+    if (e.overlay_dvd && e.overlay_dvd->IsOverlayType(DVDOVERLAY_TYPE_IMAGE) &&
+        static_cast<const CDVDOverlayImage&>(*e.overlay_dvd).m_isHDROverlay)
+      return true;
+  return false;
+}
+
 bool CRenderer::HasVisibleOverlay(int idx) const
 {
   std::unique_lock lock(m_section);
