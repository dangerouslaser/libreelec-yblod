diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
index bb48ad4..bb34cb9 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/OverlayRendererUtil.cpp
@@ -287,8 +287,11 @@ bool ShouldConvertPQPaletteToSRGB(bool isHDROverlay)
     return false;
 
   // Convert to sRGB unless the overlay is going to a PQ destination: the HDR
-  // composite, or a GUI layer that is output as an HDR signal.
+  // composite, or a GUI layer that is output as an HDR signal. The native Dolby
+  // Vision engine converts its sRGB GUI layer itself, so it always gets sRGB.
   const CWinSystemBase* winSystem = CServiceBroker::GetWinSystem();
+  if (winSystem->UsesNativeGuiCoverage())
+    return true;
   const bool destinationIsPQ =
       winSystem->IsHdrComposite() || winSystem->GetEotf() != KODI::UTILS::Eotf::TRADITIONAL_SDR;
   return !destinationIsPQ;
diff --git a/xbmc/guilib/GUIFontTTFGLES.cpp b/xbmc/guilib/GUIFontTTFGLES.cpp
index 6554740..9cd729d 100644
--- a/xbmc/guilib/GUIFontTTFGLES.cpp
+++ b/xbmc/guilib/GUIFontTTFGLES.cpp
@@ -135,7 +135,8 @@ bool CGUIFontTTFGLES::FirstBegin()
   // alpha blend that approximately matches SDR perceived translucency. It
   // is a "close enough" compromise; a mathematically correct fix would
   // require linear-light compositing (too expensive on typical ARM GPUs).
-  if (CServiceBroker::GetWinSystem()->IsHdrComposite())
+  if (CServiceBroker::GetWinSystem()->IsHdrComposite() &&
+      !CServiceBroker::GetWinSystem()->UsesNativeGuiCoverage())
     glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
   else
     glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE_MINUS_DST_ALPHA, GL_ONE);
diff --git a/xbmc/guilib/GUITextureGLES.cpp b/xbmc/guilib/GUITextureGLES.cpp
index a55365e..34ef705 100644
--- a/xbmc/guilib/GUITextureGLES.cpp
+++ b/xbmc/guilib/GUITextureGLES.cpp
@@ -123,7 +123,8 @@ void CGUITextureGLES::Begin(KODI::UTILS::COLOR::Color color)
     // coverage alpha; HDR FBO composite uses a compensated squared-alpha
     // blend because the FBO is color-transformed to PQ/HLG before composite,
     // and alpha blending in non-linear space is mathematically wrong.
-    if (CServiceBroker::GetWinSystem()->IsHdrComposite())
+    if (CServiceBroker::GetWinSystem()->IsHdrComposite() &&
+        !CServiceBroker::GetWinSystem()->UsesNativeGuiCoverage())
       glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_SRC_ALPHA,
                           GL_ONE_MINUS_SRC_ALPHA);
     else
@@ -295,7 +296,10 @@ void CGUITextureGLES::DrawQuad(const CRect& rect,
 
   if (blending)
   {
-    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    if (CServiceBroker::GetWinSystem()->UsesNativeGuiCoverage())
+      glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    else
+      glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
     glEnable(GL_BLEND);
   }
   else
diff --git a/xbmc/guilib/GUIVideoControl.cpp b/xbmc/guilib/GUIVideoControl.cpp
