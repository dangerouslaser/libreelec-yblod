+bool NativeDVEligible(bool source, bool software, bool interlaced, bool stereo)
+{
+  if (!source || software)
+    return false;
+  auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  const auto mode = DVBRIDGE::playbackMode.load();
+  // The Vulkan engine is the only Dolby Vision renderer: without it (its library missing, or it
+  // did not start), Dolby Vision titles play as plain base-layer video.
+  bool available = false;
+  switch (mode)
+  {
+    case DVBRIDGE::OutputMode::Standard:
+      available = window && window->SupportsNativeDVOutput();
+      break;
+    case DVBRIDGE::OutputMode::HDR10:
+    case DVBRIDGE::OutputMode::HDR10Plus: // HDR10 where the TV has no HDR10+
+      available = window && window->SupportsTunnelHDR10();
+      break;
+    default:
+      break;
+  }
+  available = available && CDVPrivateVulkan::Usable();
+  return DVBRIDGE::Eligible(available, available, source, software, interlaced, stereo);
+}
+} // namespace
+
