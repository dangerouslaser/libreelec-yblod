+         DVHDR10PlusToDovi::Available();
+}
+
+bool CWinSystemGbmGLESContext::BeginDVBridge()
+{
+  const auto failure = [this](const char* stage) {
+    if (DVBRIDGE::DiagnosticsEnabled() &&
+        m_dvSetupFailures.Record(DVBRIDGE::DiagnosticNowMs(), stage))
+      CLog::Log(LOGERROR, "DVBridge setup: stage={} failures={} size={}x{} depth={} renderable={}",
+          stage, m_dvSetupFailures.Count(), m_nWidth, m_nHeight,
+          GetOutputBitDepth(), m_renderableType);
+    return false;
+  };
+  if (m_nWidth != 3840 || m_nHeight != 2160 || GetOutputBitDepth() != 8 ||
+      m_renderableType != EGL_OPENGL_ES3_BIT)
+    return failure("output-format");
+  if (m_dvState.Captured())
+  {
+    // Video takes the output as it is, also one a refused restore left behind.
+    const bool ready = m_dvBridge && m_guiCompositing && m_compositeShader;
+    if (ready)
+      m_dvRestorePending = false;
+    return ready;
+  }
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm)
+    return failure("atomic-output-unavailable");
+  if (!m_dvBridge)
+    m_dvBridge = std::make_unique<CDVBridgeGLES>();
+  if (!m_dvBridge->Initialize())
+    return failure("renderer-init");
+  if (!m_dvState.Captured() && !m_dvState.Capture(*drm))
+    return failure("drm-state-capture");
+  // HDR10 through the tunnel is the tunnel's output with the engine in HDR10.
+  const bool tunnelHDR10 = TunnelHDR10Selected();
+  // HDR10+ on top where asked for and the TV has it (else HDR10), with the TV's version.
+  const bool tunnelHDR10Plus = tunnelHDR10 &&
+                               DVBRIDGE::playbackMode.load() == DVBRIDGE::OutputMode::HDR10Plus &&
+                               SupportsTunnelHDR10Plus();
+  DVBRIDGE::playbackHDR10PlusFlags.store(
+      DisplayHDR10PlusVersion() >= 1 ? static_cast<uint32_t>(DVVK_HDR10PLUS_V1) : 0u);
+  const bool plusChanged = DVBRIDGE::playbackTunnelHDR10Plus.exchange(tunnelHDR10Plus) != tunnelHDR10Plus;
+  if (DVBRIDGE::playbackTunnelHDR10.exchange(tunnelHDR10) != tunnelHDR10 || plusChanged)
+    CLog::Log(LOGINFO, "DVBridge output: {}", tunnelHDR10Plus
+              ? "HDR10+ through the tunnel (Vulkan engine, DVBRIDGE_TUNNEL_FORMAT hdr10, HDR10PLUS_METADATA)"
+              : tunnelHDR10
+              ? "HDR10 through the tunnel (Vulkan engine, DVBRIDGE_TUNNEL_FORMAT hdr10)"
+              : "Dolby Vision");
+  if (tunnelHDR10Plus && plusChanged)
+    CLog::Log(LOGINFO, "DVBridge HDR10+: the TV's HDR10+ application version {}",
+              DisplayHDR10PlusVersion());
+  m_compositeShader.reset();
+  return SetGuiCompositing(AVCOL_TRC_SMPTE2084);
+}
+
+bool CWinSystemGbmGLESContext::SetVideoOutput(const VideoPicture* picture)
+{
+  m_dvVideo = picture != nullptr;
+  if (picture)
+    CDVPrivateVulkan::VideoConfigured();
+  else
+    ++playbacksEnded;
+  // A video that does not use the bridge after all (a software-decoded picture of a Dolby
+  // Vision stream): its mode goes with the next ordinary page, not with a native frame that
+  // never comes.
+  if (picture && !DVBridgeRequested(picture))
+    m_dvModesetDeferred = false;
+  // A stop held for the refresh restore (EndDVBridgeAtStop) keeps the signal through renderer
+  // teardown while the surface keeps its depth; it is restored in the refresh change.
+  const bool sameDepth = VideoOutputBitDepth(picture) == GetOutputBitDepth();
+  const bool keepHeldStop = m_dvExitPending && !picture && sameDepth;
+  // The menu output continues into native DV video, and through the teardown that handed it back.
+  const bool keepMenu = (m_dvMenu || m_dvStartup) && sameDepth &&
+                        (!picture || (DVBridgeRequested(picture) &&
+                                      DVBRIDGE::playbackMode.load() == DVBRIDGE::OutputMode::Standard));
+  if (keepMenu && picture)
+  {
+    m_dvMenu = false;
+    m_dvStartup = false;
+    m_dvMenuModeset = false;
+    m_dvBridge->Reset();
+    CLog::Log(LOGINFO, "DVBridge: menu output handed to the video");
+  }
+  else if (!keepHeldStop && !keepMenu)
+  {
+    // Restore with the current surface before EGL replaces its buffers.
+    if (m_dvState.Captured() && !EndDVBridge())
+      return false;
+    m_dvBridge.reset();
+  }
+  return CWinSystemGbmEGLContext::SetVideoOutput(picture);
+}
+
+bool CWinSystemGbmGLESContext::RenderDVBridge(const CDVBridgeGLES::Layer& layer,
+                                            const AVFrame* enhancement,
+                                            const CDVMetadataBuffer& metadata,
+                                            dvbridge_geometry geometry)
+{
+  if (m_dvStartup)
+  {
+    m_dvStartup = false;
+    m_dvBridge->Reset();
+    CLog::Log(LOGINFO, "DVBridge: startup output handed to the video");
+  }
+  m_dvFrame = false;
+  if (auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM); drm && !drm->DVRetryReady())
+    return false;
+  if (!BeginDVBridge())
+    return false;
+  // PGS (PQ bitmap) subtitles are drawn into the GUI layer with native coverage
+  // (palette converted to sRGB), so the engine composites them like other GUI.
+  const bool overlayFree = !m_dvOverlays &&
+      (m_guiWillRender ? GetGUIElementCount() == 0 : CanReuseGuiComposite() && m_guiFboClean);
+  DVPrivateOverlay gui;
+  if (m_nativeGuiCoverage)
+  {
+    if (!m_guiRasterReady || !m_guiFbo.IsValid() ||
+        m_guiFboWidth != 3840 || m_guiFboHeight != 2160)
+      return false;
+    if (!overlayFree)
+    {
+      gui.texture = m_guiFbo.Texture();
+      if (m_guiBo)
+      {
+        gui.dmabufFd = m_guiBoFd;
+        gui.dmabufFormat = DRM_FORMAT_ABGR8888;
+        gui.dmabufStride = m_guiBoStride;
+        gui.dmabufOffset = m_guiBoOffset;
+        gui.dmabufModifier = m_guiBoModifier;
+      }
+    }
+    gui.flipY = 1;
+    gui.writes = m_guiWrites;
+    const char* revisionCache = std::getenv("DV_PRIVATE_GUI_REVISION");
+    if (revisionCache && std::strcmp(revisionCache, "1") == 0)
+      gui.revision = m_guiRevision;
+    // GUI709 -> BT2020 -> common LMS; the engine inverts the current movie matrices.
+    const double rgb[9]{.6274,.3293,.0433,.0691,.9195,.0114,.0164,.0880,.8956};
+    const double lms[9]{7222,8771,390,2654,12430,1300,0,422,15962};
+    for (unsigned i = 0; i < 3; ++i)
+      for (unsigned j = 0; j < 3; ++j)
+        for (unsigned k = 0; k < 3; ++k)
+          gui.rgbToLms[3*i+j] += lms[3*i+k] * rgb[3*k+j] / 16384.0;
+  }
+  if (!m_nativeGuiCoverage && !overlayFree)
+    return false;
+  // The picture on screen may stay there for this refresh unless a mode or signal change
+  // waits for the next commit.
+  const auto atomic = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const bool mayHold = atomic && atomic->DVScanoutStable() && !m_dvModesetDeferred;
+  m_dvFrame = m_dvBridge->PrepareHardware(layer, enhancement, metadata, geometry,
+                                         m_nativeGuiCoverage ? &gui : nullptr, mayHold);
+  if (m_dvFrame)
+    m_dvExitPending = false;
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  return m_dvFrame;
+}
+
+bool CWinSystemGbmGLESContext::EndDVBridge()
+{
+  DVBRIDGE::playbackTunnelHDR10.store(false);
+  DVBRIDGE::PublishTunnelHDR10(nullptr);
+  // HDR10+ ends with the output (the restore commit clears HDR10PLUS_METADATA).
+  DVBRIDGE::playbackTunnelHDR10Plus.store(false);
+  DVBRIDGE::playbackHDR10PlusFallback.store(false);
+  DVBRIDGE::PublishTunnelHDR10Plus({});
+  m_dvTunnelHDR10PlusFailures = 0;
+  m_dvTunnelHDR10Warned = false;
+  m_dvTunnelHDR10Failures = 0;
+  m_dvStartup = false;
+  m_dvExitPending = false;
+  m_dvMenu = false;
+  m_dvMenuModeset = false;
+  m_dvFrame = false;
+  // Never reset Kodi's ordinary HDR GUI compositor unless we owned DV output.
+  if (!m_dvState.Captured())
+  {
+    m_dvRestorePending = false;
+    return true;
+  }
+  {
+    // Restore signaling with a clean ordinary framebuffer, never tunnel pixels.
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glFinish();
+    // The swap leaves another buffer of the chain as the back buffer.
+    m_nativeBackBufferCleared = false;
+    if (!m_eglContext.TrySwapBuffers() || !FlipDVBridgePage(m_dvState, true))
+    {
+      // The state flags above are cleared: without this nothing would come back here, and
+      // the GUI would stay unseen under the tunnel's signal.
+      m_dvRestorePending = true;
+      if (DVBRIDGE::DiagnosticsEnabled() &&
+          m_dvSetupFailures.Record(DVBRIDGE::DiagnosticNowMs(), "restore"))
+        CLog::Log(LOGERROR, "DVBridge: output restoration failed; retaining scanout state; failures={}",
+            m_dvSetupFailures.Count());
+      return false;
+    }
+  }
+  m_dvRestorePending = false;
+  if (DVBRIDGE::DiagnosticsEnabled() &&
+      m_dvSetupFailures.Recovered(DVBRIDGE::DiagnosticNowMs()))
+    CLog::Log(LOGINFO, "DVBridge: normal display restored after failures={}", m_dvSetupFailures.Count());
+  // The ordinary signal is on the display: the GUI is composed for it from here on, whatever
+  // the bridge's own retirement says.
+  SetGuiCompositing(0);
+  if (m_dvBridge)
+  {
+    if (!m_dvBridge->DisplayReplaced()) return false;
+    m_dvBridge->Reset();
+  }
+  return true;
+}
+
+bool CWinSystemGbmGLESContext::EndDVBridgeAtStop()
+{
+  m_dvState.RestoreSDR();
+  // The menu output continues; a refresh restore is carried by its next frame.
+  if (m_dvState.Captured() && m_dvBridge && !m_dvMenuFailed &&
+      DVBRIDGE::MenuModeEnabled())
+  {
+    m_dvMenu = true;
+    m_dvFrame = false;
+    m_dvBridge->Reset();
+    // The menu must not reuse the GUI target shared with native movie composition.
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    CleanupGuiFbo();
+    m_guiFboWidth = m_guiFboHeight = 0;
+    m_guiFboClean = false;
+    m_guiRasterReady = false;
+    CLog::Log(LOGINFO, "DVBridge: output handed back to the menu");
+    return true;
+  }
+  // Kodi restores the desktop refresh rate right after a stop when it switched for the video.
+  // Keep the DV signal (and the last frame) until then, so the restore is one HDMI change.
+  if (m_dvState.Captured())
+  {
+    auto& gfx = GetGfxContext();
+    const RESOLUTION desktop = CDisplaySettings::GetInstance().GetCurrentResolution();
+    const auto& desktopInfo = CDisplaySettings::GetInstance().GetResolutionInfo(desktop);
+    const bool restoreExpected =
+        CServiceBroker::GetSettingsComponent()->GetSettings()->GetInt(
+            CSettings::SETTING_VIDEOPLAYER_ADJUSTREFRESHRATE) != ADJUST_REFRESHRATE_OFF &&
+        gfx.GetVideoResolution() != desktop && desktopInfo.iWidth == m_nWidth &&
+        desktopInfo.iHeight == m_nHeight;
+    if (restoreExpected)
+    {
+      m_dvExitPending = true;
+      m_dvExitDeadline.Set(2500ms);
+      m_dvFrame = false;
+      CLog::Log(LOGINFO, "DVBridge: keeping the signal for the refresh restore");
+      return true;
+    }
+  }
+  return EndDVBridge();
+}
+
+bool CWinSystemGbmGLESContext::CompleteModeset()
+{
+  if (m_dvRestoreWithModeset)
+  {
+    m_dvRestoreWithModeset = false;
+    // The restore commit carries the mode SetFullScreen() selected.
+    if (!EndDVBridge())
+      return false;
+    m_dvBridge.reset();
+    CLog::Log(LOGINFO, "DVBridge: signal restored in the refresh change");
+    return true;
+  }
+  if (m_dvMenuModeset)
+  {
+    CLog::Log(LOGINFO, "DVBridge: refresh change left to the next menu frame");
+    return true;
+  }
+  if (m_dvModesetDeferred)
+  {
+    const char* startup = std::getenv("DV_PRIVATE_STARTUP_SIGNAL");
+    if ((!startup || std::strcmp(startup, "0") != 0) &&
+        DVBRIDGE::playbackMode.load() == DVBRIDGE::OutputMode::Standard && BeginDVStartup())
+    {
+      m_dvModesetDeferred = false;
+      m_dvModesetDeadline.Set(10000ms);
+      return true;
+    }
+    // The bridge's first commit carries the mode (see PresentRender).
+    m_dvModesetDeadline.Set(3000ms);
+    CLog::Log(LOGINFO, "DVBridge: refresh change left to the first native frame");
+    return true;
+  }
+  return CWinSystemGbm::CompleteModeset();
+}
+
+bool CWinSystemGbmGLESContext::BeginDVStartup()
+{
+  // Establish the final HDMI signal while clients are still display-lost, before
+  // decoding releases the playback clocks. The black frame carries valid metadata.
+  if (!BeginDVBridge())
+    return false;
+  CFrameBufferObject black;
+  bool presented = false;
+  if (black.Initialize() &&
+      black.CreateAndBindToTexture(GL_TEXTURE_2D, m_nWidth, m_nHeight, GL_RGBA) &&
+      black.BeginRender())
+  {
+    const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+    GLboolean mask[4];
+    GLfloat colour[4];
+    glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+    glGetFloatv(GL_COLOR_CLEAR_VALUE, colour);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glClearColor(colour[0], colour[1], colour[2], colour[3]);
+    glColorMask(mask[0], mask[1], mask[2], mask[3]);
+    if (scissor)
+      glEnable(GL_SCISSOR_TEST);
+    black.EndRender();
+    if (m_dvBridge->PrepareGraphics(400.0f, 0.0) &&
+        m_dvBridge->PackGraphics(black.Texture(), 0, m_nWidth, m_nHeight, true, 1.0f, 0, false))
+    {
+      glFinish();
+      m_nativeBackBufferCleared = false;
+      if (m_eglContext.TrySwapBuffers())
+        presented = FlipDVBridgePage(m_dvState, false);
+    }
+  }
+  black.Cleanup();
+  m_dvBridge->Presented(presented);
+  if (!presented)
+  {
+    EndDVBridge();
+    CLog::Log(LOGWARNING, "DVBridge: startup signal unavailable, using first-frame handoff");
+    return false;
+  }
+  m_dvStartup = true;
+  CLog::Log(LOGINFO, "DVBridge: startup signal established before display reset");
+  return true;
+}
+
+void CWinSystemGbmGLESContext::UpdateDVMenu()
+{
+  // A title that had to play without the engine has ended: the next one tries it again.
+  if (const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+      player && !player->IsPlaying())
+    CDVPrivateVulkan::PlaybackIdle();
+  if (m_dvStartup)
+  {
+    const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+    if (((player && !player->IsPlaying()) || m_dvModesetDeadline.IsTimePast()) && EndDVBridge())
+      m_dvBridge.reset();
+    return;
+  }
+  const bool enabled = DVBRIDGE::MenuModeEnabled();
+  if (m_dvMenu)
+  {
+    if (!enabled && EndDVBridge())
+      m_dvBridge.reset();
+    return;
+  }
+  if (!enabled)
+  {
+    m_dvMenuFailed = false;
+    return;
+  }
+  if (m_dvMenuFailed || m_dvVideo || m_dvState.Captured() ||
+      m_dvModesetDeferred || m_dvRestoreWithModeset || !SupportsNativeDVOutput())
+    return;
+  const auto& components = CServiceBroker::GetAppComponents();
+  const auto player = components.GetComponent<CApplicationPlayer>();
+  if (player && player->IsPlaying())
+    return;
+  if (!BeginDVMenu())
+  {
+    m_dvMenuFailed = true;
+    CLog::Log(LOGWARNING, "DVBridge: menu output unavailable");
+  }
+}
+
+bool CWinSystemGbmGLESContext::BeginDVMenu()
+{
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  if (!drm || m_nWidth != 3840 || m_nHeight != 2160 || GetOutputBitDepth() != 8 ||
+      m_renderableType != EGL_OPENGL_ES3_BIT)
+    return false;
+  m_dvBridge = std::make_unique<CDVBridgeGLES>();
+  if (!m_dvBridge->Initialize() || !m_dvState.Capture(*drm))
+  {
+    m_dvBridge.reset();
+    return false;
+  }
+  m_compositeShader.reset();
+  if (!SetGuiCompositing(AVCOL_TRC_SMPTE2084))
+  {
+    // Nothing was committed yet.
+    m_dvState.Restored();
+    m_dvBridge.reset();
+    return false;
+  }
+  m_dvMenu = true;
+  m_dvMenuModeset = false;
+  CLog::Log(LOGINFO, "DVBridge: menu output started (graphics white {} cd/m2)",
+            DVBRIDGE::MenuWhiteNits());
+  return true;
+}
+
+void CWinSystemGbmGLESContext::PresentDVMenu(bool rendered)
+{
+  // Without a new GUI frame the scanout keeps the last one, metadata included.
+  if (!rendered && !m_dvMenuModeset)
+  {
+    KODI::TIME::Sleep(10ms);
+    return;
+  }
+  const double pts = std::chrono::duration<double>(
+                         std::chrono::steady_clock::now().time_since_epoch())
+                         .count();
+  bool presented = false;
+  if (m_guiFbo.IsValid() && m_dvBridge->PrepareGraphics(DVBRIDGE::MenuWhiteNits(), pts) &&
+      m_dvBridge->PackGraphics(m_guiFbo.Texture(), 0, m_nWidth, m_nHeight, true,
+                                DVBRIDGE::MenuSaturation(), DVBRIDGE::MenuGamma(),
+                                DVBRIDGE::MenuWideColour()))
+  {
+    glFinish();
+    if (m_eglContext.TrySwapBuffers())
+      presented = FlipDVBridgePage(m_dvState, false);
+  }
+  m_dvBridge->Presented(presented);
+  if (presented)
+  {
+    m_dvMenuModeset = false;
+    return;
+  }
+  CLog::Log(LOGWARNING, "DVBridge: menu output failed, restoring the normal display");
+  m_dvMenuFailed = true;
+  if (EndDVBridge())
+    m_dvBridge.reset();
+}
+
+bool CWinSystemGbmGLESContext::DestroyWindowSystem()
+{
+  if (!EndDVBridge())
+    return false;
+  m_dvBridge.reset();
+  return CWinSystemGbmEGLContext::DestroyWindowSystem();
+}
