+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+class CDVDStreamInfo;
+class VideoPicture;
+
+namespace DVBRIDGE
+{
+// Keep software metadata probes and ordinary HDR/SDR playback on Kodi's path.
+constexpr bool Eligible(bool standardDVDisplay, bool transportAvailable,
+                        bool dolbySource, bool softwareProbe, bool interlaced, bool stereo)
+{
+  return standardDVDisplay && transportAvailable && dolbySource &&
+         !softwareProbe && !interlaced && !stereo;
+}
+
+bool WantsNativeOutput(const CDVDStreamInfo& stream);
+bool WantsNativeOutput(const VideoPicture* picture);
+
+// Set around a refresh-rate switch made for a stream that will use native output, so the
+// window system can leave the mode change for the bridge's first commit (one HDMI change).
+void ExpectNativeOutput(bool expected);
+bool NativeOutputExpected();
+// Set around any refresh-rate switch made for a video stream.
+void ExpectVideoModeset(bool expected);
+bool VideoModesetExpected();
+} // namespace DVBRIDGE
