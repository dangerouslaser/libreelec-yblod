+void CWinSystemGbmGLESContext::ScaleGuiRaster(bool viewport)
+{
+  GLint box[4];
+  glGetIntegerv(viewport ? GL_VIEWPORT : GL_SCISSOR_BOX, box);
+  const GLint left = static_cast<GLint>(std::floor(box[0] / 2.0));
+  const GLint bottom = static_cast<GLint>(std::floor(box[1] / 2.0));
+  const GLint right = static_cast<GLint>(std::ceil((box[0] + box[2]) / 2.0));
+  const GLint top = static_cast<GLint>(std::ceil((box[1] + box[3]) / 2.0));
+  if (viewport)
+    glViewport(left, bottom, right - left, top - bottom);
+  else
+    glScissor(left, bottom, right - left, top - bottom);
+}
