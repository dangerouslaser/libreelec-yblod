diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
new file mode 100644
index 0000000..0b6ffd1
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVBridgeGLES.cpp
@@ -0,0 +1,288 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVBridgeGLES.h"
+
+#include "DVPrivateSource.h"
+#include "DVPrivateVulkan.h"
+#include "DVPrivateOverlay.h"
+#include "DVBridgeShaders.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVPlaybackInfo.h"
+#include "utils/log.h"
+extern "C"
+{
+#include <libavutil/pixfmt.h>
+}
+
+#include <EGL/egl.h>
+#include <GLES3/gl3.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+namespace
+{
+// The source's chroma siting for the engine. A top-left 4:2:0 base layer is
+// sited so; a Profile 7 base layer (paired with its EL) is always sited as
+// the enhancement layer expects (centre-left).
+unsigned SourcePlaneSiting(bool enhancement, int location)
+{
+  return !enhancement && location == AVCHROMA_LOC_TOPLEFT ? DV_SOURCE_CHROMA_TOP_LEFT
+                                                          : DV_SOURCE_CHROMA_CENTER_LEFT;
+}
+
+// The Vulkan engine with CB1 Master Reference's processing (enhancement layer
+// upscaling Annex B, DVPrivateVulkan) sites an unscaled picture as CB1 does:
+// top-left when the stream says so (also with an EL), or unspecified in
+// Profile 7 (an EL, or a MEL's undecoded one); left otherwise.
+bool VulkanCB1(bool masterReference, int baseWidth, int baseHeight, const dvbridge_geometry& geometry)
+{
+  return masterReference && geometry.width == baseWidth && geometry.height == baseHeight;
+}
+
+unsigned PlaneSiting(bool cb1, bool profile7, int location)
+{
+  if (!cb1)
+    return SourcePlaneSiting(profile7, location);
+  return location == AVCHROMA_LOC_TOPLEFT || (location == AVCHROMA_LOC_UNSPECIFIED && profile7)
+      ? DV_SOURCE_CHROMA_TOP_LEFT : DV_SOURCE_CHROMA_CENTER_LEFT;
+}
+
+unsigned PQCode(float nits)
+{
+  const double y = std::pow(std::clamp(static_cast<double>(nits) / 10000.0, 0.0, 1.0), 2610.0 / 16384);
+  const double e = std::pow((3424.0 / 4096 + 2413.0 / 128 * y) / (1 + 2392.0 / 128 * y), 2523.0 / 32);
+  return static_cast<unsigned>(std::lround(e * 4095));
+}
+} // namespace
+
+bool CDVBridgeGLES::Failure(const char* stage)
+{
+  if (DVBRIDGE::DiagnosticsEnabled() && m_failures.Record(DVBRIDGE::DiagnosticNowMs(), stage))
+    CLog::Log(LOGERROR, "DVBridge renderer: stage={} failures={}", stage, m_failures.Count());
+  return false;
+}
+
+CDVBridgeGLES::~CDVBridgeGLES()
+{
+  if (m_source && m_source->Close())
+    delete m_source;
+  CDVPlaybackInfo::presented.store(0);
+  dvbridge_candidate_destroy(m_graphicsCandidate);
+  dvbridge_destroy(m_graphics);
+  dvbridge_gl_packer_destroy(m_packer);
+}
+
+bool CDVBridgeGLES::Initialize()
+{
+  if (m_packer)
+    return m_graphics != nullptr;
+  if (eglGetCurrentContext() == EGL_NO_CONTEXT)
+    return Failure("no-egl-context");
+  // The menu output's packer and metadata state; video goes to the Vulkan engine.
+  m_packer = dvbridge_gl_packer_create(DVBRIDGE_VERTEX, DVBRIDGE_FRAGMENT);
+  m_graphics = dvbridge_create();
+  return (m_packer && m_graphics) || Failure("packer-init");
+}
+
+void CDVBridgeGLES::Reset()
+{
+  if (m_source) m_source->Reset();
+  m_sourceFrame = m_wasSource = m_held = false;
+  CDVPlaybackInfo::presented.store(0);
+  m_pendingInfo = 0;
+  m_prepared = m_packed = false;
+  m_graphicsFrame = false;
+  dvbridge_candidate_destroy(m_graphicsCandidate);
+  m_graphicsCandidate = nullptr;
+  dvbridge_reset(m_graphics);
+  m_unsupportedReports = 0;
+}
+
+bool CDVBridgeGLES::SourceEligible(const Layer& base, const AVFrame* enhancement,
+                                 dvbridge_geometry geometry) const
+{
+  const bool paired = enhancement || base.pairedSiting;
+  // 8-bit bases: single-layer pictures sited left only.
+  const bool allowNV12 = !paired && base.chromaPosition == AVCHROMA_LOC_LEFT;
+  // As the engine: 4:2:0 sizes are even (cropped encodes such as 3840x1746); an enhancement
+  // layer (half size, 4:2:0 itself) or a scaled picture needs multiples of 4.
+  const bool scaled = geometry.width != base.width || geometry.height != base.height;
+  const int align = paired || scaled ? 4 : 2;
+  return base.width > 0 && base.width <= 3840 && base.height > 0 && base.height <= 2160 &&
+      base.width % align == 0 && base.height % align == 0 &&
+      (base.format == Format::P010 || (allowNV12 && base.format == Format::NV12)) &&
+      geometry.x >= 0 && geometry.y >= 0 && geometry.x % 2 == 0 && geometry.y % 2 == 0 &&
+      geometry.width > 0 && geometry.width <= 3840 && geometry.height > 0 && geometry.height <= 2160 &&
+      geometry.width % align == 0 && geometry.height % align == 0 &&
+      geometry.x <= 3840 - geometry.width && geometry.y <= 2160 - geometry.height &&
+      (paired || base.chromaPosition == AVCHROMA_LOC_TOPLEFT ||
+       base.chromaPosition == AVCHROMA_LOC_LEFT) &&
+      base.vaOwner && base.vaDisplay && std::isfinite(base.pts) &&
+      base.pts >= -9223372036854775808.0 && base.pts < 9223372036854775808.0;
+}
+
+bool CDVBridgeGLES::PrepareHardware(const Layer& decoded, const AVFrame* enhancement,
+                                  const CDVMetadataBuffer& metadata, dvbridge_geometry geometry,
+                                  const DVPrivateOverlay* overlay, bool mayHold)
+{
+  m_sourceFrame = m_held = false;
+  m_prepared = m_packed = false;
+  m_graphicsFrame = false;
+  Layer base = decoded;
+  // The engine scales in multiples of 4: a scaled single-layer picture (1920x1038 to 4K, or
+  // 3834 wide to 3840) leaves out its last 1-3 rows and columns, and its rectangle shrinks
+  // to match around the same centre. An unscaled picture keeps every row.
+  if ((geometry.width != base.width || geometry.height != base.height) && !enhancement &&
+      !base.pairedSiting && base.width > 0 && base.height > 0)
+  {
+    const int width = base.width & ~3, height = base.height & ~3;
+    const int dw = static_cast<int>(std::lround(static_cast<double>(geometry.width) * width / base.width)) & ~3;
+    const int dh = static_cast<int>(std::lround(static_cast<double>(geometry.height) * height / base.height)) & ~3;
+    geometry.x += (geometry.width - dw) / 2;
+    geometry.y += (geometry.height - dh) / 2;
+    geometry.width = dw;
+    geometry.height = dh;
+    base.width = width;
+    base.height = height;
+  }
+  // A 4:2:0 picture starts on an even row and column (each chroma sample covers two of
+  // each); centring 1746 rows on 2160 gives row 207, so it moves up one.
+  geometry.x &= ~1;
+  geometry.y &= ~1;
+  if (SourceEligible(base, enhancement, geometry))
+  {
+    if (!m_source) m_source = new CDVPrivateSource;
+    if (!m_wasSource) m_source->Reset();
+    const dv_source_geometry placement{static_cast<unsigned>(base.width), static_cast<unsigned>(base.height),
+                                       3840, 2160, static_cast<unsigned>(geometry.x), static_cast<unsigned>(geometry.y),
+                                       PlaneSiting(VulkanCB1(m_source->MasterReference(), base.width,
+                                                             base.height, geometry),
+                                                   enhancement || base.pairedSiting, base.chromaPosition),
+                                       static_cast<unsigned>(geometry.width), static_cast<unsigned>(geometry.height)};
+    const dv_source_input input{sizeof(dv_source_input),
+        base.format == Format::NV12 ? DV_SOURCE_INPUT_NV12 : DV_SOURCE_INPUT_P010,
+        base.format == Format::NV12 ? 8u : 10u};
+    const int result = m_source->Prepare(base.vaDisplay, base.vaSurface, base.vaOwner, enhancement,
+                                         metadata.Data(), metadata.Size(), static_cast<int64_t>(base.pts),
+                                         placement, input, overlay && overlay->texture ? overlay : nullptr,
+                                         base.sequence, mayHold);
+    if (result < 0) return Failure("private-source");
+    if (result == 2)
+    {
+      // The picture on screen: it stays, and so does what the playback info says of it.
+      m_held = true;
+      return true;
+    }
+    if (result > 0)
+    {
+      const bool entering = !m_wasSource;
+      m_sourceFrame = m_wasSource = m_prepared = true;
+      m_packed = false;
+      const bool fel = enhancement && dvbridge_fel_active(metadata.Data(), metadata.Size());
+      // The engine's HDR10 through the tunnel (DV -> HDR10), or Dolby Vision.
+      m_pendingInfo = (DVBRIDGE::playbackTunnelHDR10.load() ? CDVPlaybackInfo::HDR10
+                                                             : CDVPlaybackInfo::HDMI) |
+                      (fel ? CDVPlaybackInfo::FEL : 0u);
+      const char* trace = std::getenv("DV_PRIVATE_ROUTE_TRACE");
+      if (entering && trace && std::strcmp(trace, "1") == 0)
+        CLog::Log(LOGINFO, "Private source composition: pts={} enhancement={} fel={} prepared=true",
+                  base.pts, enhancement != nullptr, fel);
+      return true;
+    }
+  }
+  // No other renderer: a picture the engine does not take is not shown (the last one stays).
+  if (m_unsupportedReports < 8)
+  {
+    ++m_unsupportedReports;
+    CLog::Log(LOGWARNING, "DVBridge: picture not supported by the Vulkan engine, not shown: pts={} "
+              "size={}x{} format={} chroma={} placement={},{},{}x{} enhancement={}",
+              base.pts, base.width, base.height, static_cast<int>(base.format), base.chromaPosition,
+              geometry.x, geometry.y, geometry.width, geometry.height, enhancement != nullptr);
+  }
+  if (m_wasSource)
+  {
+    m_source->Reset();
+    m_wasSource = false;
+  }
+  return Failure("source-unsupported");
+}
+
+bool CDVBridgeGLES::PrepareGraphics(float whiteNits, double pts)
+{
+  m_prepared = m_packed = m_held = false;
+  m_pendingInfo = 0;
+  m_graphicsFrame = false;
+  dvbridge_candidate_destroy(m_graphicsCandidate);
+  m_graphicsCandidate = nullptr;
+  if (!m_graphics || !m_packer)
+    return Failure("graphics-unavailable");
+  // 0.005 cd/m2 black (the spec's default source minimum, as Amlogic's graphics minimum). The
+  // average follows the static-metadata convention of midway between the scene limits.
+  const unsigned black = PQCode(0.005f);
+  const unsigned white = PQCode(whiteNits);
+  m_graphicsWhite = whiteNits;
+  if (white > black)
+    m_graphicsCandidate =
+        dvbridge_prepare_graphics(m_graphics, black, white, (black + white) / 2, pts);
+  m_prepared = m_graphicsFrame = m_graphicsCandidate != nullptr;
+  return m_prepared || Failure("graphics-prepare");
+}
+
+bool CDVBridgeGLES::PackGraphics(unsigned int guiTexture, unsigned int framebuffer, int width,
+                                 int height, bool flipY, float saturation, unsigned gamma,
+                                 bool wideColour)
+{
+  m_packed = false;
+  if (!m_prepared || !m_graphicsFrame)
+    return Failure("pack-without-prepared-graphics");
+  unsigned int count;
+  const auto* packets = dvbridge_packets(m_graphicsCandidate, &count);
+  const dvbridge_graphics_style style{m_graphicsWhite, saturation, gamma, wideColour};
+  m_packed = dvbridge_gl_pack_graphics(m_packer, guiTexture, framebuffer, width, height, packets,
+                                       count, flipY, &style);
+  return m_packed || Failure("graphics-pack");
+}
+
+gbm_bo* CDVBridgeGLES::GetPrivateScanout()
+{
+  if (!m_sourceFrame || !m_prepared || !m_source) return nullptr;
+  auto* bo = m_source->ScanoutBuffer();
+  if (bo) m_packed = true;
+  return bo;
+}
+
+bool CDVBridgeGLES::DisplayReplaced()
+{ return !m_source || m_source->DisplayReplaced(); }
+
+bool CDVBridgeGLES::Presented(bool success, bool queued)
+{
+  if (m_held)
+  {
+    m_held = false;
+    return true;
+  }
+  if (m_sourceFrame)
+  {
+    const bool committed = success && m_prepared && m_packed;
+    m_source->Presented(committed, queued);
+    CDVPlaybackInfo::presented.store(committed ? m_pendingInfo : 0);
+    m_prepared = m_packed = m_sourceFrame = false;
+    return committed;
+  }
+  if (success && m_source && !m_source->DisplayReplaced())
+    return Failure("private-scanout-retirement");
+  bool committed = false;
+  if (m_graphicsFrame)
+  {
+    committed = success && m_prepared && m_packed &&
+                dvbridge_commit(m_graphics, m_graphicsCandidate);
+    dvbridge_candidate_destroy(m_graphicsCandidate);
+    m_graphicsCandidate = nullptr;
+    if (!committed)
+      dvbridge_reset(m_graphics);
+  }
+  CDVPlaybackInfo::presented.store(0);
+  m_prepared = m_packed = m_graphicsFrame = false;
+  return committed;
+}
