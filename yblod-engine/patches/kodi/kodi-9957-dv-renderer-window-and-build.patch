+// The stream WantsNativeOutput() last announced, and the playback it belonged to. The
+// player, the codec factory, the codec and the demuxer each ask, and ask again at seeks: the
+// answer is a query, and only a new stream starts the telemetry over and is logged.
+struct AnnouncedStream
+{
+  uint64_t playback{0};
+  unsigned profile{0}, level{0}, major{0}, minor{0}, compatibility{0}, width{0}, height{0};
+  bool bl{false}, el{false}, rpu{false}, software{false}, interlaced{false}, stereo{false};
+  bool eligible{false}, mastering{false}, light{false};
+  int mode{0};
+  int maxLuminance[2]{}, minLuminance[2]{};
+  unsigned maxCLL{0}, maxFALL{0};
+  bool operator==(const AnnouncedStream&) const = default;
+};
+std::mutex announcedMutex;
+AnnouncedStream announced;
+bool announcedAny{false};
+// Counts the videos that have ended (SetVideoOutput without a picture).
+std::atomic<uint64_t> playbacksEnded{0};
+} // namespace
+
+bool DVBRIDGE::WantsNativeOutput(const CDVDStreamInfo& stream)
+{
+  const bool software = (stream.codecOptions & CODEC_FORCE_SOFTWARE) != 0;
+  const bool sized = SourceSizeSupported(stream.width, stream.height, stream.dovi.dv_profile == 7);
+  const bool eligible = sized && NativeDVEligible(stream.dovi.dv_profile != 0, software,
+                          stream.interlaced, !stream.stereo_mode.empty());
+  AnnouncedStream now;
+  now.playback = playbacksEnded.load();
+  now.profile = stream.dovi.dv_profile;
+  now.level = stream.dovi.dv_level;
+  now.major = stream.dovi.dv_version_major;
+  now.minor = stream.dovi.dv_version_minor;
+  now.compatibility = stream.dovi.dv_bl_signal_compatibility_id;
+  now.width = static_cast<unsigned>(stream.width);
+  now.height = static_cast<unsigned>(stream.height);
+  now.bl = stream.dovi.bl_present_flag;
+  now.el = stream.dovi.el_present_flag;
+  now.rpu = stream.dovi.rpu_present_flag;
+  now.software = software;
+  now.interlaced = stream.interlaced;
+  now.stereo = !stream.stereo_mode.empty();
+  now.eligible = eligible;
+  now.mode = static_cast<int>(playbackMode.load());
+  if (const auto* mastering = stream.masteringMetadata.get(); mastering && mastering->has_luminance)
+  {
+    now.mastering = true;
+    now.maxLuminance[0] = mastering->max_luminance.num;
+    now.maxLuminance[1] = mastering->max_luminance.den;
+    now.minLuminance[0] = mastering->min_luminance.num;
+    now.minLuminance[1] = mastering->min_luminance.den;
+  }
+  if (const auto* light = stream.contentLightMetadata.get())
+  {
+    now.light = true;
+    now.maxCLL = light->MaxCLL;
+    now.maxFALL = light->MaxFALL;
+  }
+  {
+    std::lock_guard<std::mutex> lock(announcedMutex);
+    if (announcedAny && now == announced)
+      return eligible;
+    announced = now;
+    announcedAny = true;
+  }
+  if (!software)
+  {
+    StreamTelemetry::Begin(stream.dovi.dv_profile, stream.dovi.dv_level,
+        stream.dovi.dv_version_major, stream.dovi.dv_version_minor,
+        stream.dovi.bl_present_flag, stream.dovi.el_present_flag, stream.dovi.rpu_present_flag);
+    StreamTelemetry::StaticMetadata(stream.masteringMetadata.get(), stream.contentLightMetadata.get());
+  }
+  if (stream.dovi.dv_profile && !sized)
+    CLog::Log(LOGWARNING, "DVBridge: the Vulkan engine does not take {}x{} Dolby Vision pictures; playing the base layer",
+              stream.width, stream.height);
+  if (stream.dovi.dv_profile && DiagnosticsEnabled())
+    CLog::Log(LOGINFO, "DVBridge stream candidate: profile={} level={} compatibility={} size={}x{} native_eligible={} software={} interlaced={} stereo={} mode={} (selection probe, not active output)",
+        stream.dovi.dv_profile, stream.dovi.dv_level, stream.dovi.dv_bl_signal_compatibility_id,
+        stream.width, stream.height, eligible,
+        (stream.codecOptions & CODEC_FORCE_SOFTWARE) != 0, stream.interlaced,
+        !stream.stereo_mode.empty(), static_cast<int>(playbackMode.load()));
+  return eligible;
+}
