+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "cores/VideoPlayer/DVDCodecs/Video/DVMetadataBuffer.h"
+#include "utils/DVBridgeDiagnosticState.h"
+
+extern "C"
+{
+#include "dvbridge_core.h"
+#include "dvbridge_gl_pack.h"
+}
+
+class CVideoBuffer;
+class CDVPrivateSource;
+struct DVPrivateOverlay;
+struct AVFrame;
+struct gbm_bo;
+
+/* The Dolby Vision output: video through the native route (CDVPrivateSource,
+ * the Vulkan engine) and the menu output (graphics-only frames packed from
+ * the GUI with static metadata). */
+class CDVBridgeGLES
+{
+public:
+  enum class Format
+  {
+    Other,
+    NV12,
+    P010,
+  };
+  struct Layer
+  {
+    Format format{Format::Other};
+    int width;
+    int height;
+    double pts;
+    // Decoded VAAPI surface of this layer.
+    void* vaDisplay = nullptr;
+    unsigned vaSurface = 0xffffffff; // VA_INVALID_SURFACE
+    CVideoBuffer* vaOwner{nullptr};
+    int chromaPosition{0};
+    // A Profile 7 MEL whose EL was not decoded: sited and routed as when paired.
+    bool pairedSiting{false};
+    // Names one picture in the renderer's queue: the same number is the same
+    // picture asked for again (0: not known).
+    uint64_t sequence{0};
+  };
+
+  CDVBridgeGLES() = default;
+  ~CDVBridgeGLES();
+  CDVBridgeGLES(const CDVBridgeGLES&) = delete;
+  CDVBridgeGLES& operator=(const CDVBridgeGLES&) = delete;
+
+  bool Initialize();
+  void Reset();
+  // mayHold: when the picture is the one on screen already, nothing is rendered and Held()
+  // says so; the caller then presents nothing for this refresh.
+  bool PrepareHardware(const Layer& base, const AVFrame* enhancement,
+                       const CDVMetadataBuffer& metadata, dvbridge_geometry geometry,
+                       const DVPrivateOverlay* overlay, bool mayHold = false);
+  bool Held() const { return m_held; }
+  // Graphics only (no video): static metadata for a GUI whose white is at whiteNits, then the
+  // transport packed directly from the sRGB GUI texture.
+  bool PrepareGraphics(float whiteNits, double pts);
+  bool PackGraphics(unsigned int guiTexture, unsigned int framebuffer, int width, int height,
+                    bool flipY, float saturation, unsigned gamma, bool wideColour);
+  // queued: the display took the picture without waiting for its flip.
+  bool Presented(bool success, bool queued = false);
+  gbm_bo* GetPrivateScanout();
+  bool DisplayReplaced();
+
+private:
+  bool SourceEligible(const Layer& base, const AVFrame* enhancement,
+                      dvbridge_geometry geometry) const;
+  bool Failure(const char* stage);
+  DVBRIDGE::DiagnosticFailures m_failures;
+  float m_graphicsWhite{0.0f};
+  // All methods, including destruction, require the owning GL context/thread.
+  dvbridge_gl_packer* m_packer = nullptr;
+  bool m_prepared = false;
+  bool m_packed = false;
+  unsigned m_pendingInfo = 0;
+  // Menu output (graphics-only frames): its own metadata state and candidate.
+  dvbridge_context* m_graphics = nullptr;
+  dvbridge_candidate* m_graphicsCandidate = nullptr;
+  bool m_graphicsFrame = false;
+  CDVPrivateSource* m_source{nullptr};
+  bool m_sourceFrame{false}, m_wasSource{false}, m_held{false};
+  unsigned m_unsupportedReports{0};
+};
