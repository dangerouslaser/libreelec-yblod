+namespace
+{
+// Whether an HDR10 tunnel commit ever worked on this connection (1), or the
+// kernel refused every one (2: an LSPCON in level-shifter mode offers the
+// format but takes only Dolby Vision, linux-9931).
+std::atomic<int> tunnelHDR10Verdict{0};
+} // namespace
+
+bool CWinSystemGbmGLESContext::SupportsTunnelHDR10()
+{
+  if (tunnelHDR10Verdict.load() == 2 || !IsHDRDisplay() ||
+      !GetDisplayHDRCapabilities().SupportsHDR10())
+    return false;
+  // linux-9928's DVBRIDGE_TUNNEL_FORMAT with an hdr10 value: native HDMI connectors (gen12+
+  // Intel, amdgpu). The converter routes (linux-9930's DP connectors) have no such property.
+  auto drm = std::dynamic_pointer_cast<CDRMAtomic>(m_DRM);
+  const auto* mode = m_DRM ? m_DRM->GetSelectedMode() : nullptr;
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  return drm && connector && connector->IsConnected() && CDVBridgeState::SupportsHDR10(*connector) &&
+         mode && mode->hdisplay == 3840 && mode->vdisplay == 2160 &&
+         !(mode->flags & DRM_MODE_FLAG_INTERLACE) && CDVPrivateVulkan::HasHDR10();
+}
+
+bool CWinSystemGbmGLESContext::TunnelHDR10Selected()
+{
+  return DVBRIDGE::playbackMode.load() == DVBRIDGE::OutputMode::HDR10 && SupportsTunnelHDR10();
+}
+
+void CWinSystemGbmGLESContext::TunnelHDR10Presented(bool presented)
+{
+  if (presented)
+  {
+    tunnelHDR10Verdict = 1;
+    m_dvTunnelHDR10Failures = 0;
+    return;
+  }
+  // A connection that never took one: the kernel refuses the format here. Give the title back
+  // to plain playback (the option is hidden from now on). Ten attempted commits, so that a
+  // few failures while the link settles do not count (frames held back by the HDMI recovery
+  // are not attempted).
+  if (tunnelHDR10Verdict.load() != 0 || ++m_dvTunnelHDR10Failures < 10)
+    return;
+  tunnelHDR10Verdict = 2;
+  CLog::Log(LOGERROR, "DVBridge: this connection refuses HDR10 through the tunnel; Convert Dolby "
+            "Vision to HDR10 is unavailable until Kodi restarts, the title plays without conversion");
+  auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(40810),
+                                        strings.Get(40901));
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
+}
+
+void DVBRIDGE::OutputModeOptions(const std::shared_ptr<const CSetting>& setting,
+                                 IntegerSettingOptions& list, int& current)
+{
+  // Dolby Vision and Off always; the conversions only where this connection has them.
+  auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  list.emplace_back(strings.Get(40812), static_cast<int>(OutputMode::Standard));
+  if (window && window->SupportsTunnelHDR10())
+    list.emplace_back(strings.Get(40813), static_cast<int>(OutputMode::HDR10));
+  list.emplace_back(strings.Get(40814), static_cast<int>(OutputMode::Disabled));
