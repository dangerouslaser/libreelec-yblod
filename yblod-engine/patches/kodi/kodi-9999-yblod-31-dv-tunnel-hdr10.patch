+bool CDVPrivateVulkan::HasHDR10()
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!Usable())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    has = dlsym(handle, "dvvk_set_output_mode") && dlsym(handle, "dvvk_output_signal");
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: HDR10 output {}", library, has ? "available" : "not available");
+  });
+  return has;
+}
+
+void CDVPrivateVulkan::SelectOutputMode()
+{
+  // HDR10 when the window asks for it (the tunnel's format follows the
+  // signal this publishes); otherwise Dolby Vision.
+  const uint32_t want = DVBRIDGE::playbackTunnelHDR10.load() ? DVVK_OUTPUT_HDR10 : DVVK_OUTPUT_DV;
+  if (want == m_outputMode)
+    return;
+  if (!m_setOutputMode)
+  {
+    if (want == DVVK_OUTPUT_HDR10 && m_reports < 16)
+    {
+      ++m_reports;
+      CLog::Log(LOGERROR, "Vulkan engine: no HDR10 output in this library; Dolby Vision pictures");
+    }
+    return;
+  }
+  dvvk_output_mode mode{};
+  mode.mode = want;
+  const int result = m_setOutputMode(m_engine, &mode);
+  if (result != 0)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine refused output mode {} ({})", want, result);
+    return;
+  }
+  m_outputMode = want;
+  CLog::Log(LOGINFO, "Vulkan engine output: {}", want == DVVK_OUTPUT_HDR10
+            ? "HDR10, the Master Reference conversion (BT.2020 PQ, 12-bit 4:2:2 through the tunnel)"
+            : "Dolby Vision");
+}
+
+void CDVPrivateVulkan::PublishSignal(int64_t pts)
+{
+  dvvk_hdr_signal signal{};
+  if (m_outputMode != DVVK_OUTPUT_HDR10 || !m_outputSignal || m_outputSignal(m_engine, &signal) != 0 ||
+      signal.mode != DVVK_OUTPUT_HDR10)
+  {
+    DVBRIDGE::PublishTunnelHDR10(nullptr);
+    return;
+  }
+  DVBRIDGE::TunnelHDR10Signal out;
+  std::memcpy(out.primaries, signal.primaries, sizeof(out.primaries));
+  out.white[0] = signal.white[0];
+  out.white[1] = signal.white[1];
+  out.maxLuminance = signal.max_luminance;
+  out.minLuminance = signal.min_luminance;
+  out.maxCll = signal.max_cll;
+  out.maxFall = signal.max_fall;
+  DVBRIDGE::PublishTunnelHDR10(&out);
+  if (std::memcmp(&signal, &m_loggedSignal, sizeof(signal)) != 0)
+  {
+    m_loggedSignal = signal;
+    CLog::Log(LOGINFO, "Vulkan engine HDR10 pts={}: mastering {} / {:.4f} cd/m2, MaxCLL {}, MaxFALL {}, "
+              "primaries {:.4f},{:.4f} {:.4f},{:.4f} {:.4f},{:.4f} white {:.4f},{:.4f}",
+              pts, signal.max_luminance, signal.min_luminance / 10000.0, signal.max_cll, signal.max_fall,
+              signal.primaries[0][0] / 50000.0, signal.primaries[0][1] / 50000.0,
+              signal.primaries[1][0] / 50000.0, signal.primaries[1][1] / 50000.0,
+              signal.primaries[2][0] / 50000.0, signal.primaries[2][1] / 50000.0,
+              signal.white[0] / 50000.0, signal.white[1] / 50000.0);
+  }
+}
