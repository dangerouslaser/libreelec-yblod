diff --git a/xbmc/utils/DVRenderUsage.cpp b/xbmc/utils/DVRenderUsage.cpp
new file mode 100644
index 0000000..ae425a4
--- /dev/null
+++ b/xbmc/utils/DVRenderUsage.cpp
@@ -0,0 +1,130 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "DVRenderUsage.h"
+
+#include <algorithm>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <utility>
+
+namespace DVBRIDGE
+{
+namespace
+{
+constexpr uint64_t RESCAN_NS = 30000000000ULL;
+}
+
+bool RenderUsage::Parse(std::istream& input, Clients& clients)
+{
+  std::string line, driver, device, id;
+  Client client;
+  bool engine = false;
+  for (unsigned count = 0; count < 128 && std::getline(input, line); ++count)
+  {
+    const auto colon = line.find(':');
+    if (colon == std::string::npos)
+      continue;
+    const auto key = line.substr(0, colon);
+    std::istringstream value(line.substr(colon + 1));
+    if (key == "drm-driver") value >> driver;
+    else if (key == "drm-pdev") value >> device;
+    else if (key == "drm-client-id") value >> id;
+    else if (key == "drm-engine-render")
+    {
+      std::string unit;
+      engine = bool(value >> client.busy >> unit) && unit == "ns";
+    }
+    else if (key == "drm-engine-capacity-render")
+    {
+      if (!(value >> client.capacity) || !client.capacity)
+        return true;
+    }
+  }
+  if (!engine || id.empty() || device.empty() || (driver != "i915" && driver != "xe"))
+    return !driver.empty();
+  client.device = device;
+  const auto key = driver + ":" + device + ":" + id;
+  auto found = clients.find(key);
+  if (found == clients.end() || found->second.busy < client.busy)
+    clients[key] = client; // Shared/duplicated descriptors count only once.
+  return true;
+}
+
+std::optional<double> RenderUsage::Update(const Clients& current, uint64_t now, uint64_t maxGap)
+{
+  if (current.empty())
+  {
+    Reset();
+    return {};
+  }
+  const auto& device = current.begin()->second.device;
+  const auto capacity = current.begin()->second.capacity;
+  bool valid = m_time && now > m_time && now - m_time <= maxGap &&
+               current.size() == m_previous.size();
+  long double busy = 0;
+  Clients next = current;
+  for (const auto& [id, client] : current)
+  {
+    const auto previous = m_previous.find(id);
+    if (client.device != device || client.capacity != capacity ||
+        previous == m_previous.end() || previous->second.capacity != capacity)
+      valid = false;
+    else
+    {
+      // The kernel permits temporarily decreasing counters; retain the high-water mark.
+      next[id].busy = std::max(client.busy, previous->second.busy);
+      busy += next[id].busy - previous->second.busy;
+    }
+  }
+  const auto elapsed = now - m_time;
+  m_previous = std::move(next);
+  m_time = now;
+  if (!valid)
+    return {};
+  return std::clamp(double(100.0L * busy / elapsed / capacity), 0.0, 100.0);
+}
+
+std::optional<double> RenderUsage::Sample(uint64_t maxGap)
+{
+  const uint64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                           std::chrono::steady_clock::now().time_since_epoch())
+                           .count();
+  if (!m_scanTime || now - m_scanTime >= RESCAN_NS)
+  {
+    m_drm.clear();
+    m_scanTime = now;
+  }
+  Clients clients;
+  std::map<std::string, bool> drm;
+  std::error_code error;
+  std::filesystem::directory_iterator it("/proc/self/fdinfo", error), end;
+  unsigned count = 0;
+  while (!error && it != end && count++ < 512)
+  {
+    auto name = it->path().filename().string();
+    const auto known = m_drm.find(name);
+    if (known != m_drm.end() && !known->second)
+      drm.emplace(std::move(name), false);
+    else
+    {
+      std::ifstream input(it->path());
+      drm.emplace(std::move(name), Parse(input, clients));
+    }
+    it.increment(error);
+  }
+  if (error || it != end)
+  {
+    Reset();
+    return {};
+  }
+  m_drm = std::move(drm);
+  return Update(clients, now, maxGap);
+}
+
+void RenderUsage::Reset()
+{
+  m_previous.clear();
+  m_time = 0;
+}
+}
