   const char* current = std::getenv(name);
   return current && std::strcmp(current, value) == 0;
 }
+
+unsigned EnvNumber(const char* name, unsigned fallback, unsigned limit)
+{
+  const char* value = std::getenv(name);
+  if (!value || !value[0]) return fallback;
+  char* end = nullptr;
+  const unsigned long number = std::strtoul(value, &end, 10);
+  if (*end || number > limit)
+  {
+    CLog::Log(LOGWARNING, "Vulkan engine: {}={} is not 0-{}; using {}", name, value, limit, fallback);
+    return fallback;
+  }
+  return static_cast<unsigned>(number);
+}
+
+// CroqueMr's optional CM2.9 -> CM4.0 metadata and L2 trim removal
+// (dvvk_plan_in.dm_options): DV_VULKAN_CM4 off, no-l2, always, auto, auto2;
+// DV_VULKAN_CM4_TRIGGER (auto) source, 1000, 2000, 4000, 10000;
+// DV_VULKAN_CM4_HEADROOM (auto2) 0-50 %; DV_VULKAN_TV_PEAK in nits;
+// DV_VULKAN_NO_L2=1. Metadata only: no pixel changes.
+uint32_t DmOptions()
+{
+  static const char* const modes[] = {"off", "no-l2", "always", "auto", "auto2"};
+  static const char* const triggers[] = {"source", "1000", "2000", "4000", "10000"};
+  const char* mode = std::getenv("DV_VULKAN_CM4");
+  const char* trigger = std::getenv("DV_VULKAN_CM4_TRIGGER");
+  unsigned m = 0, t = 0;
+  if (mode && mode[0])
+  {
+    while (m < 5 && std::strcmp(mode, modes[m]) != 0) ++m;
+    if (m == 5)
+    {
+      CLog::Log(LOGWARNING, "Vulkan engine: DV_VULKAN_CM4={} is not off, no-l2, always, auto or auto2; off", mode);
+      m = 0;
+    }
+  }
+  if (trigger && trigger[0])
+  {
+    while (t < 5 && std::strcmp(trigger, triggers[t]) != 0) ++t;
+    if (t == 5)
+    {
+      CLog::Log(LOGWARNING, "Vulkan engine: DV_VULKAN_CM4_TRIGGER={} is not source, 1000, 2000, 4000 or 10000; source",
+                trigger);
+      t = 0;
+    }
+  }
+  const unsigned headroom = EnvNumber("DV_VULKAN_CM4_HEADROOM", 20, 50);
+  const unsigned peak = EnvNumber("DV_VULKAN_TV_PEAK", 0, 10000);
+  const bool noL2 = EnvIs("DV_VULKAN_NO_L2", "1");
+  if (!m && !noL2) return 0;   // the stream's metadata as is
+  return DVVK_DM_OPTIONS(m, t, headroom, noL2, peak);
+}
