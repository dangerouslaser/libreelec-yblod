+namespace
+{
+// The stream's static HDR10 metadata (L6, and the source range), as the picture has it.
+// primaries: with the mastering display's (the SDR output's gamut mapping reads them: L9),
+// the container's BT.2020 where the stream names none.
+dvvk_hdr10_static StaticMetadata(const VideoPicture& picture, bool primaries)
 {
-  const auto convert = DVHDR10PlusToDovi::Function();
-  if (!convert || !hdr10plus->data || !hdr10plus->size)
-    return;
-  // The stream's static HDR10 metadata (L6, and the source range), as the picture has it.
   dvvk_hdr10_static hdr10{};
-  if (picture->hasDisplayMetadata && picture->displayMetadata.has_luminance)
+  if (picture.hasDisplayMetadata && picture.displayMetadata.has_luminance)
   {
-    hdr10.max_luminance = static_cast<float>(av_q2d(picture->displayMetadata.max_luminance));
-    hdr10.min_luminance = static_cast<float>(av_q2d(picture->displayMetadata.min_luminance));
+    hdr10.max_luminance = static_cast<float>(av_q2d(picture.displayMetadata.max_luminance));
+    hdr10.min_luminance = static_cast<float>(av_q2d(picture.displayMetadata.min_luminance));
   }
-  if (picture->hasLightMetadata)
+  if (picture.hasLightMetadata)
   {
-    hdr10.max_cll = static_cast<uint16_t>(std::min(picture->lightMetadata.MaxCLL, 65535u));
-    hdr10.max_fall = static_cast<uint16_t>(std::min(picture->lightMetadata.MaxFALL, 65535u));
+    hdr10.max_cll = static_cast<uint16_t>(std::min(picture.lightMetadata.MaxCLL, 65535u));
+    hdr10.max_fall = static_cast<uint16_t>(std::min(picture.lightMetadata.MaxFALL, 65535u));
   }
+  if (primaries)
+  {
+    hdr10.primaries = DVVK_PRIMARIES_BT2020;
+    if (picture.hasDisplayMetadata && picture.displayMetadata.has_primaries)
+    {
+      const double redX = av_q2d(picture.displayMetadata.display_primaries[0][0]);
+      const double greenY = av_q2d(picture.displayMetadata.display_primaries[1][1]);
+      if (std::abs(redX - 0.680) < 0.01 && std::abs(greenY - 0.690) < 0.01)
+        hdr10.primaries = DVVK_PRIMARIES_P3D65;
+      else if (std::abs(redX - 0.640) < 0.01 && std::abs(greenY - 0.600) < 0.01)
+        hdr10.primaries = DVVK_PRIMARIES_BT709;
+    }
+  }
+  return hdr10;
+}
+} // namespace
+
+void CDVDVideoCodecFFmpeg::AttachPlainMetadata(VideoPicture* picture)
+{
+  const bool hlg = picture->hdrType == StreamHdrType::HDR_TYPE_HLG;
+  const auto convert = DVHDR10PlusToDovi::StaticFunction();
+  // The metadata says BT.2020 limited-range 10-bit Y'CbCr: what HDR10 and HLG videos are.
+  if (!(hlg ? m_dvPlainHLG : m_dvPlainPQ) || !convert ||
+      picture->color_primaries != AVCOL_PRI_BT2020 || picture->color_range ||
+      picture->colorBits != 10)
+    return;
+  const dvvk_hdr10_static hdr10 = hlg ? dvvk_hdr10_static{} : StaticMetadata(*picture, true);
+  std::vector<uint8_t> key(sizeof(hdr10) + 1, hlg ? 1 : 0);
+  std::memcpy(key.data(), &hdr10, sizeof(hdr10));
+  if (!m_dvPlainStatic.Data() || key != m_dvPlainKey)
+  {
+    std::vector<uint64_t> buffer(DVVK_HDR10PLUS_DOVI_BYTES / sizeof(uint64_t));
+    size_t size = 0;
+    const int result = convert(hlg ? nullptr : &hdr10, buffer.data(), DVVK_HDR10PLUS_DOVI_BYTES,
+                               &size);
+    if (result != 0 ||
+        !m_dvPlainStatic.Assign(reinterpret_cast<const uint8_t*>(buffer.data()), size))
+    {
+      CLog::Log(LOGWARNING, "SDR output: no metadata for this {} video ({}); Kodi's tone mapping "
+                "shows it", hlg ? "HLG" : "HDR10", result);
+      m_dvPlainPQ = m_dvPlainHLG = false;
+      m_dvPlainStatic.Reset();
+      return;
+    }
+    m_dvPlainKey = std::move(key);
+    if (hlg)
+      CLog::Log(LOGINFO, "SDR output: an HLG video (the engine's conversion, static)");
+    else
+      CLog::Log(LOGINFO, "SDR output: an HDR10 video (the engine's conversion, static): mastering "
+                "{:.4f}..{:.0f} cd/m2, MaxCLL {}, MaxFALL {}, primaries {}",
+                hdr10.min_luminance, hdr10.max_luminance, hdr10.max_cll, hdr10.max_fall,
+                hdr10.primaries == DVVK_PRIMARIES_P3D65 ? "P3-D65"
+                : hdr10.primaries == DVVK_PRIMARIES_BT709 ? "BT.709" : "BT.2020");
+  }
+  picture->doviMetadata = m_dvPlainStatic;
+  picture->doviPlain = hlg ? DVBRIDGE::PLAIN_HLG : DVBRIDGE::PLAIN_PQ;
+}
