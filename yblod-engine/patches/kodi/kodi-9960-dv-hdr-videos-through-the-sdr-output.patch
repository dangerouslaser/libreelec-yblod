   if (!m_dvHDR10PlusReported)
   {
     m_dvHDR10PlusReported = true;
@@ -1700,7 +1783,17 @@ bool CDVDVideoCodecFFmpeg::GetPictureCommon(VideoPicture* pVideoPicture)
   // A picture of a converted title without HDR10+ of its own keeps the last picture's metadata.
   if (m_dvHDR10Plus == HDR10PlusToDV::Converting && !pVideoPicture->doviMetadata.Data() &&
       pVideoPicture->hdrType == StreamHdrType::HDR_TYPE_HDR10)
+  {
     pVideoPicture->doviMetadata = m_dvHDR10PlusLast;
+    pVideoPicture->doviPlain = m_dvPlainPQ ? DVBRIDGE::PLAIN_PQ : DVBRIDGE::PLAIN_NONE;
+  }
+  // The SDR output's static metadata for an HDR10 or HLG picture, and for an HDR10+ one whose
+  // title could not be converted.
+  if ((m_dvPlainPQ || m_dvPlainHLG) && !pVideoPicture->doviMetadata.Data() &&
+      (pVideoPicture->hdrType == StreamHdrType::HDR_TYPE_HDR10 ||
+       pVideoPicture->hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS ||
+       pVideoPicture->hdrType == StreamHdrType::HDR_TYPE_HLG))
+    AttachPlainMetadata(pVideoPicture);
 #endif
 
   if (pVideoPicture->iRepeatPicture)
