                 info.untranslated_curve || info.untranslated_saturation
@@ -1335,6 +1417,7 @@ void CDVDVideoCodecFFmpeg::ConvertHDR10Plus(VideoPicture* picture,
   // Already shown as Dolby Vision: switching outputs mid-title would blank the screen, so this
