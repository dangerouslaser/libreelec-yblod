 .../DVDCodecs/Video/DVOutputSettings.h        | 21 +++++++++++++++++++
 .../VideoRenderers/DVPrivateVulkan.cpp        |  6 +++---
 .../VideoRenderers/RenderManager.cpp          | 11 ++++++++--
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 12 ++++++++---
 4 files changed, 42 insertions(+), 8 deletions(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
index 3799ee7..77e87c0 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h
@@ -166,8 +166,28 @@ inline std::string titlePath; // the title whose playback was prepared last
 // 1 from a choice that restarts the title until the title has configured its video again (a
 // stop in between is the restart's), 2 while it plays: the next stop forgets the choice.
 inline std::atomic<int> titleState{0};
+// A restart for another output (RestartForOutput) is on its way until the title is prepared
+// again; then the title's first picture configures the renderer again (OutputReconfigure).
+inline std::atomic<bool> outputRestart{false};
+inline std::atomic<bool> outputReconfigure{false};
 } // namespace detail
 
+// Restarts the playing title where it is for another output (TMSG_MEDIA_RESTART): the video
+// OSD's choice, an output refused while the title plays (the tunnel's HDR10 or player-led
+// commits, the engine's player-led mode), the engine not starting or refusing the title's
+// pictures. The restart reopens the title in the same player, whose renderer stays
+// configured while the pictures keep their size and colours, and the window chooses its
+// output (SetVideoOutput, BeginDVBridge) only when the renderer is configured: so the
+// restarted title's first picture configures it again, once. Restarts for anything else
+// (audio passthrough) are Kodi's own and stay as they are. (WinSystemGbmGLESContext)
+void RestartForOutput();
+
+// The render manager: the first picture of a title restarted for another output.
+inline bool OutputReconfigure()
+{
+  return detail::outputReconfigure.exchange(false);
+}
+
 // The window: a video configured its output.
 inline void TitleOutputConfigured()
 {
@@ -345,6 +365,7 @@ inline void SelectOutputSettings(const std::string& path)
   playbackHDR10ToDV.store(false);
   playbackPlainSDR.store(false);
   playbackSourceHDR10Plus.store(false);
+  detail::outputReconfigure.store(detail::outputRestart.exchange(false));
   std::lock_guard lock(detail::titleLock);
   detail::titlePath = path;
   if (detail::title.output == TitleOutput::None)
