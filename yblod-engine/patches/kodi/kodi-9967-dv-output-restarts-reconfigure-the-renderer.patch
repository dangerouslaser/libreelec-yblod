@@ -107,8 +108,14 @@ bool CRenderManager::Configure(const VideoPicture& picture, float fps, unsigned
     if (!m_bRenderGUI)
       return true;
 
-    if (m_pRenderer != nullptr && m_picture.IsSameParams(picture) && m_orientation == orientation &&
