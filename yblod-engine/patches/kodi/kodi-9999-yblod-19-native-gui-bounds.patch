+// Top-down pixel rectangle covering the GL scissor of a CRect, plus a margin
+// for scissor truncation. Everything outside it is the cleared FBO.
+std::array<unsigned, 4> CWinSystemGbmGLESContext::PublishedGuiBounds(const CRect& rect, int width, int height)
+{
+  std::array<unsigned, 4> result{};
+  const auto clampTo = [](double v, int limit) {
+    return static_cast<unsigned>(std::max(0.0, std::min(v, static_cast<double>(limit))));
+  };
+  result[0] = clampTo(std::floor(rect.x1) - 2, width);
+  result[1] = clampTo(std::floor(rect.y1) - 2, height);
+  result[2] = clampTo(std::ceil(rect.x2) + 2, width);
+  result[3] = clampTo(std::ceil(rect.y2) + 2, height);
+  if (rect.IsEmpty())
+    result.fill(0);
+  return result;
+}
