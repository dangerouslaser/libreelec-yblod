diff -ruN a/xbmc/guilib/DVNativeGuiBounds.h b/xbmc/guilib/DVNativeGuiBounds.h
--- a/xbmc/guilib/DVNativeGuiBounds.h	1969-12-31 19:00:00
+++ b/xbmc/guilib/DVNativeGuiBounds.h	2026-10-12 08:24:25
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include "utils/Geometry.h"
+
+#include <cstdlib>
+
+/*!
+ * Native DV GUI bounds, render thread only.
+ *
+ * Window processing collects the screen-clipped render regions of every
+ * visible leaf control. The GBM context requests bounds before the GUI pass;
+ * the window manager then renders that pass with their union as the GL
+ * scissor, so the cleared FBO is guaranteed transparent outside it. The
+ * native packer reads GUI pixels only inside the published rectangle.
+ */
+namespace DVNativeGuiBounds
+{
+struct State
+{
+  bool requested{false}; // set by the GBM context for this GUI pass
+  bool check{false}; // diagnostic: compute bounds but do not scissor
+  bool processed{false}; // leaves were collected since the last pass
+  CRect leaves; // union of visible leaf regions, clipped to the screen
+  bool valid{false}; // published by the window manager after the pass
+  CRect rect;
+};
+inline State& Get()
+{
+  static State state;
+  return state;
+}
+inline bool Collecting()
+{
+  static const bool enabled = std::getenv("DV_PRIVATE_GUI_BOUNDS") != nullptr;
+  return enabled;
+}
+} // namespace DVNativeGuiBounds
