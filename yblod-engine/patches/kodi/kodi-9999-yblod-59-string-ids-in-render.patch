From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Bryan Hoban <bryan.hoban@gmail.com>
Date: Wed, 11 Nov 2026 13:52:57 -0500
Subject: [PATCH] yblod-59: ask for the Dolby Vision strings by their new ids

yblod-54 moved the fork's strings to ids 45000-45999 but kept eight old
entries (#40810, #40812-#40814, #40900, #40901, #40920, #40925) because
the render code's notifications and the output-mode list still asked
for them by number. Use the new ids there and drop the old entries.

#40818 ("Player information") comes back beside #45018: the
pre-installed skin.estuary.yblod add-on shows $LOCALIZE[40818] and is
updated on its own schedule, so Kodi keeps answering the old id until
the skin has moved. Every other fork string is only in the 45000 block.
---
 .../resources/strings.po                      | 50 ++-----------------
 .../VideoRenderers/DVPrivateVulkan.cpp        |  4 +-
 .../windowing/gbm/WinSystemGbmGLESContext.cpp | 16 +++---
 3 files changed, 13 insertions(+), 57 deletions(-)

diff --git a/addons/resource.language.en_gb/resources/strings.po b/addons/resource.language.en_gb/resources/strings.po
index b3268b1..b6c2e1e 100644
--- a/addons/resource.language.en_gb/resources/strings.po
+++ b/addons/resource.language.en_gb/resources/strings.po
@@ -25968,53 +25968,9 @@ msgctxt "#40804"
 msgid "{0:.1f} dB"
 msgstr ""
 
-#. Old id of #45010: still used by the render code until it uses the new one
-#: xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40810"
-msgid "Dolby Vision"
-msgstr ""
-
-#. Old id of #45012: still used by the render code until it uses the new one
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40812"
-msgid "Dolby Vision (TV-led)"
-msgstr ""
-
-#. Old id of #45013: still used by the render code until it uses the new one
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40813"
-msgid "Convert to HDR10"
-msgstr ""
-
-#. Old id of #45014: still used by the render code until it uses the new one
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40814"
-msgid "Off"
-msgstr ""
-
-#. Old id of #45100: still used by the render code until it uses the new one
-#: xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
-msgctxt "#40900"
-msgid "The Dolby Vision engine (Vulkan) could not start. Dolby Vision videos play without Dolby Vision until Kodi restarts."
-msgstr ""
-
-#. Old id of #45101: still used by the render code until it uses the new one
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40901"
-msgid "This connection does not take HDR10 from Dolby Vision. Videos play without conversion until Kodi restarts."
-msgstr ""
-
-#. Old id of #45120: still used by the render code until it uses the new one
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40920"
-msgid "Convert to HDR10+"
-msgstr ""
-
-#. Old id of #45125: still used by the render code until it uses the new one
-#: xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
-msgctxt "#40925"
-msgid "This connection does not take HDR10+ packets. The video continues as HDR10."
+#. Old id of #45018: the pre-installed skin.estuary.yblod uses $LOCALIZE[40818] and updates on its own schedule
+msgctxt "#40818"
+msgid "Player information"
 msgstr ""
 
 # YBLOD: the fork's strings use ids 45000 to 45999, a block Kodi does not use, so that
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
index a29b789..d4c0d51 100644
--- a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
@@ -38,8 +38,8 @@ void ReportUnavailable(const char* reason)
   CLog::Log(LOGERROR, "Dolby Vision: the Vulkan engine is not available ({}); Dolby Vision titles "
             "play as plain base-layer video until Kodi restarts", reason);
   auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
-  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(40810),
-                                        strings.Get(40900));
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(45010),
+                                        strings.Get(45100));
 }
 
 bool EnvIs(const char* name, const char* value)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index 0e32e2c..89df288 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -1204,8 +1204,8 @@ void CWinSystemGbmGLESContext::TunnelHDR10PlusPresented(bool presented)
             "rest of this video{}", tunnelHDR10PlusVerdict.load() == 2
                 ? ", and Convert Dolby Vision to HDR10+ is unavailable until Kodi restarts" : "");
   auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
-  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, strings.Get(40810),
-                                        strings.Get(40925));
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, strings.Get(45010),
+                                        strings.Get(45125));
 }
 
 void CWinSystemGbmGLESContext::TunnelHDR10Presented(bool presented)
@@ -1226,8 +1226,8 @@ void CWinSystemGbmGLESContext::TunnelHDR10Presented(bool presented)
   CLog::Log(LOGERROR, "DVBridge: this connection refuses HDR10 through the tunnel; Convert Dolby "
             "Vision to HDR10 is unavailable until Kodi restarts, the title plays without conversion");
   auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
-  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(40810),
-                                        strings.Get(40901));
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(45010),
+                                        strings.Get(45101));
   CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
 }
 
@@ -1237,12 +1237,12 @@ void DVBRIDGE::OutputModeOptions(const std::shared_ptr<const CSetting>& setting,
   // Dolby Vision and Off always; the conversions only where this connection has them.
   auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
   auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
-  list.emplace_back(strings.Get(40812), static_cast<int>(OutputMode::Standard));
+  list.emplace_back(strings.Get(45012), static_cast<int>(OutputMode::Standard));
   if (window && window->SupportsTunnelHDR10())
-    list.emplace_back(strings.Get(40813), static_cast<int>(OutputMode::HDR10));
+    list.emplace_back(strings.Get(45013), static_cast<int>(OutputMode::HDR10));
   if (window && window->SupportsTunnelHDR10Plus())
-    list.emplace_back(strings.Get(40920), static_cast<int>(OutputMode::HDR10Plus));
-  list.emplace_back(strings.Get(40814), static_cast<int>(OutputMode::Disabled));
+    list.emplace_back(strings.Get(45120), static_cast<int>(OutputMode::HDR10Plus));
+  list.emplace_back(strings.Get(45014), static_cast<int>(OutputMode::Disabled));
 }
 
 bool DVBRIDGE::HDR10PlusToDVAvailable(const std::string& /*condition*/,
