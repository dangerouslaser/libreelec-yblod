 {
@@ -242,21 +244,92 @@ bool CDVPrivateVulkan::HasSDR()
   return has;
 }
 
+uint32_t CDVPrivateVulkan::SDRFlags()
+{
+  static std::once_flag probed;
+  static uint32_t flags = 0;
+  if (!HasSDR())
+    return 0;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    // (a library from before CroqueMr's CB1 targets has no dvvk_sdr_flags)
+    auto sdrFlags = reinterpret_cast<decltype(&dvvk_sdr_flags)>(dlsym(handle, "dvvk_sdr_flags"));
+    flags = sdrFlags ? sdrFlags()
+                     : DVVK_SDR_GAMMA22 | DVVK_SDR_LIMITED | DVVK_SDR_NO_DITHER | DVVK_SDR_HLG;
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: SDR display flags {:#x}", library, flags);
+  });
+  return flags;
+}
