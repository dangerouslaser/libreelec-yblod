+bool CWinSystemGbmGLESContext::SDRBT2020()
+{
+  // DV_SDR_BT2020=1 (BT.2020 colours). The picture is BT.2020 only where the link says so: the
+  // driver signals BT.2020 RGB (the connector's Colorspace) and the display takes it (its
+  // EDID's colorimetry block), as CroqueMr's CB1 asks; else BT.709, as without the setting.
+  const char* wanted = std::getenv("DV_SDR_BT2020");
+  if (!wanted || std::strcmp(wanted, "1") != 0)
+    return false;
+  auto* connector = m_DRM ? m_DRM->GetConnector() : nullptr;
+  const char* missing =
+      !(CDVPrivateVulkan::SDRFlags() & DVVK_SDR_BT2020) ? "the engine library has no BT.2020"
+      : !connector || !connector->GetPropertyEnumValue("Colorspace", "BT2020_RGB")
+          ? "the driver cannot signal BT.2020 RGB on this connector (Colorspace)"
+      : !DisplayBT2020RGB() ? "the display's EDID does not list BT.2020 RGB"
+      : sdrBT2020Verdict.load() == 2 ? "this connection refused it before"
+                                     : nullptr;
+  if (missing)
+  {
+    CLog::Log(LOGINFO, "DVBridge output: SDR in BT.709, not BT.2020: {}", missing);
+    return false;
+  }
+  return true;
+}
+
+void CWinSystemGbmGLESContext::SDRBT2020Presented(bool presented)
+{
+  if (presented)
+  {
+    sdrBT2020Verdict = 1;
+    m_dvSDRBT2020Failures = 0;
+    return;
+  }
+  // Three refused commits, so that the link settling does not count; BT.709 from the next
+  // picture, and where none ever worked, for the rest of the Kodi run.
+  if (++m_dvSDRBT2020Failures < 3 || !DVBRIDGE::playbackSDRBT2020.exchange(false))
+    return;
+  if (sdrBT2020Verdict.load() == 0)
+    sdrBT2020Verdict = 2;
+  CLog::Log(LOGERROR, "DVBridge: the kernel refuses the SDR picture in BT.2020 on this "
+            "connection; BT.709 for the rest of this video{}",
+            sdrBT2020Verdict.load() == 2 ? " and until Kodi restarts" : "");
+  auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Warning, strings.Get(45010),
+                                        strings.Get(45160));
 }
 
