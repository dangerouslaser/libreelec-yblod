 namespace
 {
 // SDR output's display (DVVK_OUTPUT_SDR's dvvk_output_mode), from the environment that
 // Settings > Player > Dolby Vision and native-dv.env set (DVEngineSettings.h):
+//   DV_SDR_TARGET  default (or unset): the display DV_SDR_WHITE, _GAMMA and _BLACK describe;
+//                  reference, brightroom: CroqueMr's CB1 presets; custom: DV_SDR_CUSTOM_*
 //   DV_SDR_WHITE   the display's white in cd/m2 (203; 100 for a projector)
 //   DV_SDR_GAMMA   2.2 for a pure 2.2 power, anything else BT.1886 (gamma 2.4)
 //   DV_SDR_RANGE   full or limited; auto (the default) follows Kodi's
 //                  "Use limited colour range" (videoscreen.limitedrange)
 //   DV_SDR_DITHER  0: rounded codes instead of the dither pattern
 //   DV_SDR_BLACK   the display's black in cd/m2 (0: white / 1000)
-// hlg: the pictures are a plain HLG video's (DVVK_SDR_HLG).
-dvvk_output_mode SdrMode(bool hlg)
+//   DV_SDR_CUSTOM_WHITE, DV_SDR_CUSTOM_GAMMA, DV_SDR_CUSTOM_BLACK  the custom display's
+//                  white (20-500 cd/m2), pure power (1.8-2.8) and black (0-5 cd/m2, 0 a
+//                  true zero)
+// RANGE and DITHER apply to every display. False: DV_SDR_TARGET names no display, or a
+// custom one is out of those ranges; the SDR output is then not offered (SDRDisplayUsable)
+// rather than made for another display.
+bool SdrDisplay(dvvk_output_mode& mode, std::string& name)
 {
-  dvvk_output_mode mode{};
+  mode = {};
   mode.mode = DVVK_OUTPUT_SDR;
+  const char* target = std::getenv("DV_SDR_TARGET");
+  const auto power = [&mode](float white, float black, float gamma) {
+    mode.flags = DVVK_SDR_POWER | DVVK_SDR_BLACK;
+    mode.peak_nits = white;
+    mode.min_nits = black;
+    mode.reserved[DVVK_SDR_GAMMA_WORD] = static_cast<uint32_t>(std::lround(gamma * 1000.0f));
+  };
+  if (EnvIs("DV_SDR_TARGET", "reference"))
+  {
+    power(100.0f, 0.0f, 2.4f);
+    name = "Reference";
+    return true;
+  }
+  if (EnvIs("DV_SDR_TARGET", "brightroom"))
+  {
+    power(200.0f, 0.0f, 2.2f);
+    name = "Bright room";
+    return true;
+  }
+  if (EnvIs("DV_SDR_TARGET", "custom"))
+  {
+    const auto number = [](const char* variable, float fallback) {
+      const char* value = std::getenv(variable);
+      if (!value || !value[0])
+        return fallback;
+      char* end = nullptr;
+      const float parsed = std::strtof(value, &end);
+      return *end ? -1.0f : parsed;
+    };
+    const float white = number("DV_SDR_CUSTOM_WHITE", 100.0f);
+    const float gamma = number("DV_SDR_CUSTOM_GAMMA", 2.4f);
+    const float black = number("DV_SDR_CUSTOM_BLACK", 0.0f);
+    name = StringUtils::Format("Custom (white {:g}, gamma {:g}, black {:g})", white, gamma, black);
+    if (!(white >= 20.0f && white <= 500.0f && gamma >= 1.8f && gamma <= 2.8f && black >= 0.0f &&
+          black <= 5.0f))
+      return false;
+    power(white, black, gamma);
+    return true;
+  }
+  name = target && target[0] ? target : "default";
+  if (target && target[0] && std::strcmp(target, "default") != 0)
+    return false;
   const unsigned white = EnvNumber("DV_SDR_WHITE", 203, 1000);
