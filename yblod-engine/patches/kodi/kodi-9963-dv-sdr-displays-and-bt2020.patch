+bool CDVBridgeState::SetSDRGamut(CDRMAtomic& drm, bool bt2020, bool& changed)
+{
+  changed = false;
+  if (!Captured() || m_owner != &drm)
+    return false;
+  auto* colorspace = Find("Colorspace");
+  if (m_tunnel || !colorspace)
+    return !bt2020;
+  const auto value = colorspace->object->GetPropertyEnumValue("Colorspace",
+                                                              bt2020 ? "BT2020_RGB" : "Default");
+  if (!value)
+    return false;
+  changed = colorspace->transport != *value;
+  colorspace->transport = *value;
+  if (changed)
+    CLog::Log(LOGINFO, "DVBridge SDR picture: Colorspace {}", bt2020 ? "BT2020_RGB" : "Default");
+  return true;
+}
