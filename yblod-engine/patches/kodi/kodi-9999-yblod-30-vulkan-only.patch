-    VASurfaceID input;
-    if ((reason = import_source(v, (VADisplay)source_display, (VASurfaceID)source_surface, &input)))
-        return reason;
-    int k = r->next;
-    r->next = (r->next + 1) % VPP_RING;
-    VARectangle sr = {0, 0, (uint16_t)source_width, (uint16_t)source_height};
-    VARectangle dr = {0, 0, (uint16_t)out_width, (uint16_t)out_height};
-    VAProcPipelineParameterBuffer pp = {0};
-    pp.surface = input;
-    pp.surface_region = &sr;
-    pp.output_region = &dr;
-    pp.surface_color_standard = pp.output_color_standard = VAProcColorStandardBT2020;
-    pp.input_color_properties.color_range = pp.output_color_properties.color_range = VA_SOURCE_RANGE_REDUCED;
-    pp.input_color_properties.chroma_sample_location =
-        VA_CHROMA_SITING_VERTICAL_CENTER | VA_CHROMA_SITING_HORIZONTAL_LEFT;
-    pp.filter_flags = VA_FILTER_SCALING_DEFAULT;
-    if (rotate180)
-        pp.rotation_state = VA_ROTATION_180;
-    VABufferID buf;
-    bool ok = vaCreateBuffer(v->dpy, v->ctx, VAProcPipelineParameterBufferType, sizeof(pp), 1, &pp, &buf) ==
-              VA_STATUS_SUCCESS;
-    /* Synchronous: the media engine finishes before composition starts, so it does not compete
-     * with the shaders for memory bandwidth on the same frame. */
-    if (ok) {
-        ok = vaBeginPicture(v->dpy, v->ctx, r->surf[k]) == VA_STATUS_SUCCESS &&
