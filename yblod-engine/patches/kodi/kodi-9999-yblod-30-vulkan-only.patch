-/* Static frame metadata for graphics only: no reshaping, one L1 block, full-raster L5 (added by the
- * serializer). Mastering display and scene ranges are both the graphics range. */
-bool dvbridge_render_graphics(struct dvbridge_renderer *r, unsigned min_pq, unsigned max_pq,
-                              unsigned avg_pq, double pts)
-{
-    if (!r)
-        return false;
-    r->ready = false;
-    r->packed = true;
-    dvbridge_candidate_destroy(r->pending);
-    r->pending = NULL;
-    if (!(min_pq <= avg_pq && avg_pq <= max_pq && max_pq <= 4095))
-        return false;
-    if (!r->graphics && !(r->graphics = av_dovi_metadata_alloc(&r->graphics_size)))
-        return false;
-    AVDOVIRpuDataHeader *header = av_dovi_get_header(r->graphics);
-    AVDOVIColorMetadata *color = av_dovi_get_color(r->graphics);
-    header->disable_residual_flag = 1;
-    color->signal_eotf = 65535;
-    color->signal_color_space = 0;
-    color->source_min_pq = min_pq;
-    color->source_max_pq = max_pq;
-    r->graphics->num_ext_blocks = 1;
-    AVDOVIDmData *l1 = av_dovi_get_ext(r->graphics, 0);
-    memset(l1, 0, sizeof(*l1));
-    l1->level = 1;
-    l1->l1.min_pq = min_pq;
-    l1->l1.max_pq = max_pq;
-    l1->l1.avg_pq = avg_pq;
-    const struct dvbridge_geometry geometry = {3840, 2160, 0, 0, 3840, 2160};
-    r->pending = dvbridge_prepare(r->context, r->graphics, r->graphics_size, pts, geometry, false);
-    r->ready = r->pending != NULL;
-    return r->ready;
-}
-
-const struct dvbridge_candidate *dvbridge_render_candidate(const struct dvbridge_renderer *r)
-{
-    return r && r->ready ? r->pending : NULL;
-}
-
-bool dvbridge_render_commit(struct dvbridge_renderer *r)
-{
-    return r && r->ready && r->pending && dvbridge_commit(r->context, r->pending);
-}
-
-void dvbridge_renderer_set_ipt_offset(struct dvbridge_renderer *r, const float offset[3])
-{
-    if (r)
-        memcpy(r->ipt_offset, offset, sizeof(r->ipt_offset));
-}
