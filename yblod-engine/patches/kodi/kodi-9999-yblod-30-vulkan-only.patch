-             vaEndPicture(v->dpy, v->ctx) == VA_STATUS_SUCCESS &&
-             vaSyncSurface(v->dpy, r->surf[k]) == VA_STATUS_SUCCESS;
-        vaDestroyBuffer(v->dpy, buf);
-    }
-    vaDestroySurfaces(v->dpy, &input, 1);
-    if (!ok)
-        return "process";
-    memset(out, 0, sizeof(*out));
-    out->borrowed = true;
-    out->layout = DVBRIDGE_Y416;
-    out->planes[0].texture = r->tex[k];
-    out->planes[0].width = out_width;
-    out->planes[0].height = out_height;
-    return NULL;
-}
