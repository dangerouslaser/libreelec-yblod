-/* SPDX-License-Identifier: GPL-3.0-or-later */
-/* Dolby Vision scaling on the Intel media engine (VA-API video processing, "Quick Sync").
- *
- * Two jobs move from libplacebo's shaders to the media engine:
- *  - base layer chroma, 4:2:0 -> 4:4:4 at the same size;
- *  - the Profile 7 FEL enhancement layer, 1920x1080 -> base layer size.
- * The output is a packed 4:4:4 Y416 surface (12 significant bits), shared with the renderer through
- * DMA-BUF.
- *
- * Measured on Tiger Lake (iHD 26.3):
- *  - SCALING_DEFAULT runs on the video-enhance engine (SFC); HQ and FAST run as render-engine
- *    kernels with much worse results, so DEFAULT is forced.
- *  - At 1:1 the driver bypasses the SFC and replicates chroma (nearest neighbour, wrong siting).
- *    Requesting a 180 degree rotation forces the SFC path: chroma is then filtered (Catmull-Rom class)
- *    with correct left siting, and luma stays bit-exact.
- *  - The SFC scales center-aligned; the DV enhancement layer is co-sited horizontally, which the
- *    renderer corrects with a half-pixel shift when sampling.
- *
- * Surfaces from the decoders (Kodi's VAAPI decoder for the base layer, FFmpeg's for the enhancement
- * layer) are imported into this module's own VADisplay through DMA-BUF, so its lifetime does not
- * depend on either decoder.
- */
-#include "dvbridge_vpp.h"
-#include <EGL/eglext.h>
-#include <GLES3/gl3.h>
-#include <GLES2/gl2ext.h>
-#include <fcntl.h>
-#include <libdrm/drm_fourcc.h>
-#include <stdint.h>
-#include <stdlib.h>
-#include <string.h>
-#include <unistd.h>
-#include <va/va.h>
-#include <va/va_drm.h>
-#include <va/va_drmcommon.h>
-#include <va/va_vpp.h>
-
-#define VPP_RING 3
-
-struct vpp_ring {
-    VASurfaceID surf[VPP_RING];
-    EGLImage image[VPP_RING];
-    unsigned tex[VPP_RING];
-    bool have_surf;
-    int w, h, next;
-};
-
-struct dvbridge_vpp {
-    int fd;
-    VADisplay dpy;
-    VAConfigID cfg;
-    VAContextID ctx;
-    bool have_cfg, have_ctx;
-    EGLDisplay egl;
-    struct vpp_ring ring[2];
-};
-
-struct dvbridge_vpp *dvbridge_vpp_create(void)
-{
-    struct dvbridge_vpp *v = calloc(1, sizeof(*v));
-    if (v)
-        v->fd = -1;
-    return v;
-}
-
-static void ring_release(struct dvbridge_vpp *v, struct vpp_ring *r)
-{
-    PFNEGLDESTROYIMAGEKHRPROC destroy = (void *)eglGetProcAddress("eglDestroyImageKHR");
-    for (int i = 0; i < VPP_RING; ++i) {
-        if (r->tex[i])
-            glDeleteTextures(1, &r->tex[i]);
-        if (r->image[i] && destroy)
-            destroy(v->egl, r->image[i]);
-    }
-    if (r->have_surf)
-        vaDestroySurfaces(v->dpy, r->surf, VPP_RING);
-    memset(r, 0, sizeof(*r));
-}
-
-void dvbridge_vpp_release(struct dvbridge_vpp *v)
-{
-    if (!v)
-        return;
-    for (int i = 0; i < 2; ++i)
-        ring_release(v, &v->ring[i]);
-    if (v->have_ctx)
-        vaDestroyContext(v->dpy, v->ctx);
-    if (v->have_cfg)
-        vaDestroyConfig(v->dpy, v->cfg);
-    if (v->dpy)
-        vaTerminate(v->dpy);
-    if (v->fd >= 0)
-        close(v->fd);
-    memset(v, 0, sizeof(*v));
-    v->fd = -1;
-}
-
-void dvbridge_vpp_destroy(struct dvbridge_vpp **v)
-{
-    if (!v || !*v)
-        return;
-    dvbridge_vpp_release(*v);
-    free(*v);
-    *v = NULL;
-}
-
-/* Open a VADisplay on the GPU that renders, as reported by the current EGL display. */
-static const char *open_display(struct dvbridge_vpp *v)
-{
-    v->egl = eglGetCurrentDisplay();
-    if (v->egl == EGL_NO_DISPLAY)
-        return "egl";
-    const char *node = NULL;
-    PFNEGLQUERYDISPLAYATTRIBEXTPROC query_display = (void *)eglGetProcAddress("eglQueryDisplayAttribEXT");
-    PFNEGLQUERYDEVICESTRINGEXTPROC query_device = (void *)eglGetProcAddress("eglQueryDeviceStringEXT");
-    EGLAttrib device = 0;
-    if (query_display && query_device && query_display(v->egl, EGL_DEVICE_EXT, &device) && device)
-        node = query_device((EGLDeviceEXT)device, EGL_DRM_RENDER_NODE_FILE_EXT);
-    v->fd = open(node ? node : "/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
-    if (v->fd < 0)
-        return "render-node";
-    v->dpy = vaGetDisplayDRM(v->fd);
-    int major, minor;
-    if (!v->dpy || vaInitialize(v->dpy, &major, &minor) != VA_STATUS_SUCCESS) {
-        v->dpy = NULL;
-        return "va-initialize";
-    }
-    if (vaCreateConfig(v->dpy, VAProfileNone, VAEntrypointVideoProc, NULL, 0, &v->cfg) != VA_STATUS_SUCCESS)
-        return "va-config";
-    v->have_cfg = true;
-    return NULL;
-}
-
-static const char *ring_setup(struct dvbridge_vpp *v, struct vpp_ring *r, int w, int h)
-{
-    PFNEGLCREATEIMAGEKHRPROC create = (void *)eglGetProcAddress("eglCreateImageKHR");
-    PFNGLEGLIMAGETARGETTEXTURE2DOESPROC bind = (void *)eglGetProcAddress("glEGLImageTargetTexture2DOES");
-    const char *extensions = eglQueryString(v->egl, EGL_EXTENSIONS);
-    if (!create || !bind || !extensions || !strstr(extensions, "EGL_EXT_image_dma_buf_import_modifiers"))
-        return "egl-modifiers";
-    VASurfaceAttrib attr = {.type = VASurfaceAttribPixelFormat, .flags = VA_SURFACE_ATTRIB_SETTABLE,
-                            .value = {.type = VAGenericValueTypeInteger, .value.i = VA_FOURCC_Y416}};
-    if (vaCreateSurfaces(v->dpy, VA_RT_FORMAT_YUV444_12, w, h, r->surf, VPP_RING, &attr, 1) != VA_STATUS_SUCCESS)
-        return "y416-surfaces";
-    r->have_surf = true;
-    r->w = w;
-    r->h = h;
-    for (int i = 0; i < VPP_RING; ++i) {
-        VADRMPRIMESurfaceDescriptor desc;
-        if (vaExportSurfaceHandle(v->dpy, r->surf[i], VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2,
-                                  VA_EXPORT_SURFACE_READ_ONLY | VA_EXPORT_SURFACE_COMPOSED_LAYERS,
-                                  &desc) != VA_STATUS_SUCCESS)
-            return "export";
-        bool single = desc.num_layers == 1 && desc.layers[0].num_planes == 1 &&
-                      desc.layers[0].drm_format == DRM_FORMAT_Y416;
-        uint64_t mod = desc.objects[0].drm_format_modifier;
-        EGLint attrs[] = {
-            EGL_WIDTH, w, EGL_HEIGHT, h, EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ABGR16161616,
-            EGL_DMA_BUF_PLANE0_FD_EXT, desc.objects[0].fd,
-            EGL_DMA_BUF_PLANE0_OFFSET_EXT, (EGLint)desc.layers[0].offset[0],
-            EGL_DMA_BUF_PLANE0_PITCH_EXT, (EGLint)desc.layers[0].pitch[0],
-            EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT, (EGLint)(mod & UINT32_MAX),
-            EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT, (EGLint)(mod >> 32),
-            EGL_NONE};
-        r->image[i] = single ? create(v->egl, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, NULL, attrs) : NULL;
-        for (uint32_t o = 0; o < desc.num_objects; ++o)
-            close(desc.objects[o].fd);
-        if (!single)
-            return "export-layout";
-        if (!r->image[i])
-            return "egl-import";
-        GLint previous;
-        glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous);
-        glGenTextures(1, &r->tex[i]);
-        glBindTexture(GL_TEXTURE_2D, r->tex[i]);
-        bind(GL_TEXTURE_2D, r->image[i]);
-        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
-        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
-        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
-        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
-        glBindTexture(GL_TEXTURE_2D, previous);
-        if (glGetError() != GL_NO_ERROR)
-            return "gl-texture";
-    }
-    return NULL;
-}
-
-/* Import a decoder's P010 surface into our display through DMA-BUF. */
-static const char *import_source(struct dvbridge_vpp *v, VADisplay source_display, VASurfaceID source,
-                                 VASurfaceID *imported)
-{
-    if (vaSyncSurface(source_display, source) != VA_STATUS_SUCCESS)
-        return "source-sync";
-    VADRMPRIMESurfaceDescriptor desc;
-    if (vaExportSurfaceHandle(source_display, source, VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2,
-                              VA_EXPORT_SURFACE_READ_ONLY | VA_EXPORT_SURFACE_SEPARATE_LAYERS,
-                              &desc) != VA_STATUS_SUCCESS)
-        return "source-export";
-    const char *reason = NULL;
-    if (desc.fourcc != VA_FOURCC_P010)
-        reason = "source-format";
-    VASurfaceAttrib attrs[2] = {
-        {.type = VASurfaceAttribMemoryType, .flags = VA_SURFACE_ATTRIB_SETTABLE,
-         .value = {.type = VAGenericValueTypeInteger, .value.i = VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2}},
-        {.type = VASurfaceAttribExternalBufferDescriptor, .flags = VA_SURFACE_ATTRIB_SETTABLE,
-         .value = {.type = VAGenericValueTypePointer, .value.p = &desc}},
-    };
-    if (!reason && vaCreateSurfaces(v->dpy, VA_RT_FORMAT_YUV420_10, desc.width, desc.height,
-                                    imported, 1, attrs, 2) != VA_STATUS_SUCCESS)
-        reason = "source-import";
-    for (uint32_t o = 0; o < desc.num_objects; ++o)
-        close(desc.objects[o].fd);
-    return reason;
-}
-
-const char *dvbridge_vpp_process(struct dvbridge_vpp *v, enum dvbridge_vpp_role role,
-                                 void *source_display, unsigned source_surface,
-                                 int source_width, int source_height,
-                                 int out_width, int out_height, bool rotate180,
-                                 struct dvbridge_dmabuf *out)
-{
-    if (!v || !out || out->mapping || !source_display || source_surface == VA_INVALID_SURFACE ||
-        (role != DVBRIDGE_VPP_BASE && role != DVBRIDGE_VPP_ENHANCEMENT))
-        return "input";
-    if (source_width < 1 || source_height < 1 || out_width < 1 || out_height < 1 ||
-        out_width > 3840 || out_height > 2160 || source_width > out_width || source_height > out_height)
-        return "geometry";
-    const char *reason;
-    if (!v->dpy && (reason = open_display(v)))
-        return reason;
-    struct vpp_ring *r = &v->ring[role];
-    if (!r->have_surf || r->w != out_width || r->h != out_height) {
