+  std::string path; // the title it was chosen for
+  TitleOutput output{TitleOutput::None};
+  OutputMode mode{OutputMode::Standard};
+  bool hdr10PlusToDV{false};
+  bool hdr10ToDV{false};
+  bool plainSDR{false};
+};
+inline std::mutex titleLock;
+inline TitleOverride title;
+inline std::string titlePath; // the title whose playback was prepared last
+// 1 from a choice that restarts the title until the title has configured its video again (a
+// stop in between is the restart's), 2 while it plays: the next stop forgets the choice.
+inline std::atomic<int> titleState{0};
+} // namespace detail
+
+// The window: a video configured its output.
+inline void TitleOutputConfigured()
+{
+  int restarting = 1;
+  detail::titleState.compare_exchange_strong(restarting, 2);
+}
+
+// The window: no video is playing.
+inline void TitleOutputIdle()
+{
+  int playing = 2;
+  if (!detail::titleState.compare_exchange_strong(playing, 0))
+    return;
+  std::lock_guard lock(detail::titleLock);
+  detail::title = {};
+}
