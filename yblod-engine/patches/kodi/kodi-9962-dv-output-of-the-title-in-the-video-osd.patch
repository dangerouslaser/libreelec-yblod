+// The video OSD's Output mode (CGUIDialogVideoSettings, during playback): another output for
+// the playing title alone, applied over the settings above when that title's playback is
+// prepared (SelectOutputSettings) and forgotten when playback stops. The settings are not
+// changed. The choices are the outputs this display and the engine have for the video
+// (TitleOutputOptions): what it is, and the conversions to Dolby Vision, HDR10, HDR10+, SDR.
+enum class TitleOutput : int
+{
+  None = -1,
+  DolbyVision = 0,
+  HDR10 = 1,
+  HDR10Plus = 2,
+  HLG = 3,
+  SDR = 4,
+};
+inline const char* TitleOutputName(TitleOutput output)
+{
+  static constexpr const char* names[]{"Dolby Vision", "HDR10", "HDR10+", "HLG", "SDR"};
+  const int index = static_cast<int>(output);
+  return index >= 0 && index < 5 ? names[index] : "none";
+}
+
+// HDR10 videos as Dolby Vision (TitleOutput DolbyVision of an HDR10 video): each picture with
+// dvvk_hdr10_to_dovi's static metadata, where the HDR10+ conversion makes metadata from the
+// picture's HDR10+ (playbackHDR10PlusToDV). The same Dolby Vision output only.
+inline std::atomic<bool> playbackHDR10ToDV{false};
+// HDR10, HDR10+ and HLG videos through the SDR output also where Kodi would show them as HDR
+// (TitleOutput SDR of such a video).
+inline std::atomic<bool> playbackPlainSDR{false};
+// The playing video's pictures carry HDR10+ (the decoder says so): its OSD choices are an
+// HDR10+ video's.
+inline std::atomic<bool> playbackSourceHDR10Plus{false};
+
+namespace detail
+{
+struct TitleOverride
