+namespace
+{
+using DVBRIDGE::TitleOutput;
+
+// The video OSD's Output mode: what the playing video is, the outputs this display and the
+// engine have for it now (the tests of the Output mode setting and of the HDR10+ conversion),
+// and the one it has.
+struct TitleChoices
+{
+  TitleOutput source{TitleOutput::None}; // DolbyVision, HDR10, HDR10Plus, HLG; None: SDR
+  std::vector<TitleOutput> offered;
+  TitleOutput current{TitleOutput::None};
+};
+
+TitleChoices PlayingTitleChoices()
+{
+  TitleChoices choices;
+  const auto player = CServiceBroker::GetAppComponents().GetComponent<CApplicationPlayer>();
+  auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  if (!window || !player || !player->IsPlayingVideo())
+    return choices;
+  VideoStreamInfo info;
+  player->GetVideoStreamInfo(CURRENT_STREAM, info);
+  // The stream says HDR10 for an HDR10+ video too: its pictures say HDR10+.
+  switch (info.hdrType)
+  {
+    case StreamHdrType::HDR_TYPE_DOLBYVISION:
+      choices.source = TitleOutput::DolbyVision;
+      break;
+    case StreamHdrType::HDR_TYPE_HDR10:
+    case StreamHdrType::HDR_TYPE_HDR10PLUS:
+      choices.source = info.hdrType == StreamHdrType::HDR_TYPE_HDR10PLUS ||
+                               DVBRIDGE::playbackSourceHDR10Plus.load()
+                           ? TitleOutput::HDR10Plus
+                           : TitleOutput::HDR10;
+      break;
+    case StreamHdrType::HDR_TYPE_HLG:
+      choices.source = TitleOutput::HLG;
+      break;
+    default:
+      return choices;
+  }
+  const bool engine = CDVPrivateVulkan::Usable();
+  const bool dolbyVision = engine && window->SupportsNativeDVOutput();
+  {
+    std::lock_guard lock(DVBRIDGE::detail::titleLock);
+    choices.current = DVBRIDGE::detail::title.output;
+  }
+  if (choices.source == TitleOutput::DolbyVision)
+  {
+    // The Output mode setting's outputs (OutputModeOptions), Dolby Vision where the TV has it.
+    if (dolbyVision)
+      choices.offered.push_back(TitleOutput::DolbyVision);
+    if (window->SupportsTunnelHDR10())
+      choices.offered.push_back(TitleOutput::HDR10);
+    if (window->SupportsTunnelHDR10Plus())
+      choices.offered.push_back(TitleOutput::HDR10Plus);
+    if (window->SupportsSDROutput())
+      choices.offered.push_back(TitleOutput::SDR);
+    if (choices.current != TitleOutput::None || !engine)
+      return choices;
+    switch (window->DVOutput())
+    {
+      case DVBRIDGE::OutputMode::Standard:
+        choices.current = TitleOutput::DolbyVision;
+        break;
+      case DVBRIDGE::OutputMode::HDR10:
+        choices.current = TitleOutput::HDR10;
+        break;
+      case DVBRIDGE::OutputMode::HDR10Plus:
+        // (HDR10 on a TV without HDR10+, or after a picture HDR10+ could not represent)
+        choices.current = window->SupportsTunnelHDR10Plus() &&
+                                  !DVBRIDGE::playbackHDR10PlusFallback.load()
+                              ? TitleOutput::HDR10Plus
+                              : TitleOutput::HDR10;
+        break;
+      case DVBRIDGE::OutputMode::SDR:
+        choices.current = TitleOutput::SDR;
+        break;
+      default:
+        break;
+    }
+    return choices;
+  }
+  // A video without Dolby Vision: itself where Kodi shows it as HDR, Dolby Vision on the
+  // HDR10+ and HDR10 conversions' terms (HDR10PlusToDVAvailable), the SDR output.
+  const bool hlg = choices.source == TitleOutput::HLG;
+  const auto convertStatic = DVHDR10PlusToDovi::StaticFunction();
+  if (window->ShowsHDR(hlg))
+    choices.offered.push_back(choices.source);
+  const bool toDolbyVision = choices.source == TitleOutput::HDR10Plus
+                                 ? DVHDR10PlusToDovi::Available()
+                                 : choices.source == TitleOutput::HDR10 && convertStatic;
+  if (dolbyVision && toDolbyVision)
+    choices.offered.push_back(TitleOutput::DolbyVision);
+  const char* sources = std::getenv("DV_SDR_HDR_SOURCES");
+  if (!(sources && std::strcmp(sources, "0") == 0) && window->SupportsSDROutput() && convertStatic)
+    choices.offered.push_back(TitleOutput::SDR);
+  if (choices.current != TitleOutput::None)
+    return choices;
+  if (choices.source == TitleOutput::HDR10Plus && DVBRIDGE::playbackHDR10PlusToDV.load() &&
+      DVBRIDGE::DolbyVisionOutput() && dolbyVision)
+    choices.current = TitleOutput::DolbyVision;
+  else if (DVBRIDGE::PlainSourceOutput(hlg))
+    choices.current = TitleOutput::SDR;
+  else if (window->ShowsHDR(hlg))
+    choices.current = choices.source;
+  return choices;
+}
+} // namespace
+
+bool DVBRIDGE::TitleOutputOffered()
+{
+  return PlayingTitleChoices().offered.size() >= 2;
+}
+
+int DVBRIDGE::TitleOutputCurrent()
+{
+  return static_cast<int>(PlayingTitleChoices().current);
+}
+
+void DVBRIDGE::TitleOutputOptions(const std::shared_ptr<const CSetting>& /*setting*/,
+                                  IntegerSettingOptions& list,
+                                  int& /*current*/)
+{
+  auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  const auto choices = PlayingTitleChoices();
+  const bool dolbyVision = choices.source == TitleOutput::DolbyVision;
+  for (const auto output : choices.offered)
+  {
+    int label = 45126; // Convert to SDR
+    switch (output)
+    {
+      case TitleOutput::DolbyVision:
+        label = dolbyVision ? 45124 : 45145; // Dolby Vision, Convert to Dolby Vision
+        break;
+      case TitleOutput::HDR10:
+        label = dolbyVision ? 45013 : 45142; // Convert to HDR10, HDR10 (original)
+        break;
+      case TitleOutput::HDR10Plus:
+        label = dolbyVision ? 45120 : 45143; // Convert to HDR10+, HDR10+ (original)
+        break;
+      case TitleOutput::HLG:
+        label = 45144; // HLG (original)
+        break;
+      default:
+        break;
+    }
+    list.emplace_back(strings.Get(label), static_cast<int>(output));
+  }
+}
+
+bool DVBRIDGE::SelectTitleOutput(int value)
+{
+  const auto choices = PlayingTitleChoices();
+  const auto output = static_cast<TitleOutput>(value);
+  if (output == choices.current ||
+      std::find(choices.offered.begin(), choices.offered.end(), output) == choices.offered.end())
+    return false;
+  detail::TitleOverride title;
+  title.output = output;
+  if (choices.source == TitleOutput::DolbyVision)
+    title.mode = output == TitleOutput::HDR10       ? OutputMode::HDR10
+                 : output == TitleOutput::HDR10Plus ? OutputMode::HDR10Plus
+                 : output == TitleOutput::SDR       ? OutputMode::SDR
+                                                    : OutputMode::Standard;
+  else
+  {
+    // (the conversions to Dolby Vision are the Dolby Vision output's)
+    title.mode = OutputMode::Standard;
+    title.hdr10PlusToDV = output == TitleOutput::DolbyVision &&
+                          choices.source == TitleOutput::HDR10Plus;
+    title.hdr10ToDV = output == TitleOutput::DolbyVision && choices.source == TitleOutput::HDR10;
+    title.plainSDR = output == TitleOutput::SDR;
+  }
+  // HDR10 <-> HDR10+ of a Dolby Vision video through the tunnel: the engine and the window
+  // follow these within the title, as they do for the HDR10+ fallback (WantedOutputMode).
+  // Anything else is another signal: the title restarts where it is, as for StartFailed().
+  const auto tunnelHDR10 = [](TitleOutput o)
+  { return o == TitleOutput::HDR10 || o == TitleOutput::HDR10Plus; };
+  const bool live = choices.source == TitleOutput::DolbyVision && tunnelHDR10(choices.current) &&
+                    tunnelHDR10(output) && playbackTunnelHDR10.load() && !playbackSDR.load() &&
+                    !playbackHDR10PlusFallback.load();
+  {
+    std::lock_guard lock(detail::titleLock);
+    title.path = detail::titlePath;
+    detail::title = title;
+  }
+  detail::titleState = live ? 2 : 1;
+  CLog::Log(LOGINFO, "DVBridge: video OSD: this title's output {} -> {} ({}; the settings are "
+            "unchanged)", TitleOutputName(choices.current), TitleOutputName(output),
+            live ? "switched while it plays" : "the title restarts where it is");
+  if (live)
+  {
+    playbackMode.store(title.mode);
+    playbackTunnelHDR10Plus.store(output == TitleOutput::HDR10Plus);
+    return false;
+  }
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
+  return true;
+}
