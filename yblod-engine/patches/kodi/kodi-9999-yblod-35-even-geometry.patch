+// The picture sizes the Vulkan engine takes (CDVBridgeGLES::SourceEligible unscaled): decided
+// when the video opens, so another size plays as the base layer instead of not at all. An
+// unknown size is left to the per-picture check.
+bool SourceSizeSupported(unsigned width, unsigned height, bool enhancement)
+{
+  const unsigned align = enhancement ? 4 : 2;
+  return !width || !height ||
+         (width <= 3840 && height <= 2160 && width % align == 0 && height % align == 0);
