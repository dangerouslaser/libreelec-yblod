+// HDR10 Rendering Reference's black: CroqueMr's CB1 presets OLED 0, LCD 0.005, projector 0.05
+// cd/m2, or the custom value (0.0001 cd/m2 in the setting).
+inline Values HDR10TargetBlack(const Settings& s)
+{
+  static constexpr const char* presets[] = {"0", "0.005", "0.05"};
+  const int preset = s->GetInt("dvbridge.hdr10black");
+  if (preset >= 0 && preset <= 2)
+    return {{"DV_HDR10_TARGET_BLACK", presets[preset]}};
+  const int black = s->GetInt("dvbridge.hdr10blackcustom");
+  return {{"DV_HDR10_TARGET_BLACK",
+           StringUtils::Format("{:.4f}", (black >= 0 && black <= 5000 ? black : 0) / 10000.0)}};
+}
