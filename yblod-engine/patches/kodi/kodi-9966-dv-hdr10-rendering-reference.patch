+bool DVBRIDGE::HDR10TargetAvailable(const std::string& /*condition*/,
+                                    const std::string& /*value*/,
+                                    const std::shared_ptr<const CSetting>& /*setting*/)
+{
+  auto* window = dynamic_cast<CWinSystemGbmGLESContext*>(CServiceBroker::GetWinSystem());
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  return (window && window->SupportsTunnelHDR10() &&
+          (CDVPrivateVulkan::TargetFlags() & DVVK_HDR10_TARGET)) ||
+         settings->GetInt("dvbridge.hdr10method") != 0;
+}
+
+void DVBRIDGE::HDR10TargetOptions(const std::shared_ptr<const CSetting>& setting,
+                                  IntegerSettingOptions& list,
+                                  int& /*current*/)
+{
+  // The engine's ranges for the display: peak 50 to 10000 cd/m2, black 0 to 0.5 cd/m2 (in
+  // 0.0001 cd/m2).
+  const std::string id = setting ? setting->GetId() : "";
+  if (id == "dvbridge.hdr10peak")
+    for (const int nits : {50, 100, 150, 200, 250, 300, 350, 400, 450, 500, 600, 700, 800, 900,
+                           1000, 1100, 1200, 1300, 1400, 1500, 1600, 1800, 2000, 2500, 3000, 4000,
+                           5000, 10000})
+      list.emplace_back(StringUtils::Format("{} nits", nits), nits);
+  else if (id == "dvbridge.hdr10blackcustom")
+    for (const int black : {0, 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000, 5000})
+      list.emplace_back(StringUtils::Format("{:g}", black / 10000.0), black);
+}
