+// HDR10 Rendering Reference (DVVK_OUTPUT_HDR10 with DVVK_HDR10_TARGET: CroqueMr's CB1 Expert
+// recipe to a stated display), from the environment Settings > Player > Dolby Vision sets
+// (DVEngineSettings.h):
+//   DV_HDR10_TARGET        1: the HDR10 output maps to this display; else (the default) it is the
+//                          Master Reference conversion, and nothing below is read
+//   DV_HDR10_TARGET_PEAK   the display's peak, 50-10000 cd/m2 (1000)
+//   DV_HDR10_TARGET_BLACK  its black, 0-0.5 cd/m2 below the peak (0)
+//   DV_HDR10_TARGET_GAMUT  p3 (P3-D65, the default), bt2020 or bt709
+// False: not asked for, or (with a log line) values out of range or a library without it; the
+// HDR10 output is then the Master Reference conversion, an HDR10 picture all the same.
+bool Hdr10Target(dvvk_output_mode& mode, std::string& name)
+{
+  mode = {};
+  if (!EnvIs("DV_HDR10_TARGET", "1"))
+    return false;
+  const auto number = [](const char* variable, float fallback) {
+    const char* value = std::getenv(variable);
+    if (!value || !value[0])
+      return fallback;
+    char* end = nullptr;
+    const float parsed = std::strtof(value, &end);
+    return *end ? -1.0f : parsed;
+  };
+  const float peak = number("DV_HDR10_TARGET_PEAK", 1000.0f);
+  const float black = number("DV_HDR10_TARGET_BLACK", 0.0f);
+  const char* gamut = std::getenv("DV_HDR10_TARGET_GAMUT");
+  uint32_t primaries = 0; // (not a gamut: out of range)
+  if (!gamut || !gamut[0] || std::strcmp(gamut, "p3") == 0)
+    primaries = DVVK_GAMUT_P3D65;
+  else if (std::strcmp(gamut, "bt2020") == 0)
+    primaries = DVVK_GAMUT_BT2020;
+  else if (std::strcmp(gamut, "bt709") == 0)
+    primaries = DVVK_GAMUT_BT709;
+  static constexpr const char* gamuts[] = {"?", "BT.709", "P3-D65", "BT.2020"};
+  name = StringUtils::Format("{:g} nits, black {:.4f}, {}", peak, black, gamuts[primaries]);
+  const char* missing =
+      !(peak >= 50.0f && peak <= 10000.0f && black >= 0.0f && black <= 0.5f && black < peak &&
+        primaries)
+          ? "out of range"
+      : !(CDVPrivateVulkan::TargetFlags() & DVVK_HDR10_TARGET) ? "this engine library does not take it"
+                                                             : nullptr;
+  if (missing)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine: no HDR10 Rendering Reference for the display {} ({}); the "
+              "HDR10 output is the Master Reference conversion", name, missing);
+    return false;
+  }
+  mode.mode = DVVK_OUTPUT_HDR10;
+  mode.flags = DVVK_HDR10_TARGET;
+  mode.peak_nits = peak;
+  mode.min_nits = black;
+  mode.reserved[DVVK_TARGET_GAMUT_WORD] = primaries;
+  return true;
+}
