diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateDrain.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateDrain.h
new file mode 100644
index 0000000..dc02830
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateDrain.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+class CDVPrivateDrain
+{
+public:
+  enum class Result { Idle, Complete, Cancelled, TimedOut };
+  static bool Enabled()
+  {
+    const char* value = std::getenv("DV_PRIVATE_DRAIN_EOF");
+    return value && std::strcmp(value, "1") == 0;
+  }
+  static CDVPrivateDrain& Get()
+  {
+    static CDVPrivateDrain state;
+    return state;
+  }
+  void Queue(const void* owner, int64_t pts)
+  {
+    std::lock_guard lock(m_mutex);
+    ++m_serial;
+    m_owner = owner;
+    m_pts = pts;
+    m_changed.notify_all();
+  }
+  uint64_t Ticket(const void* owner, int64_t pts)
+  {
+    std::lock_guard lock(m_mutex);
+    return owner && owner == m_owner && pts == m_pts ? m_serial : 0;
+  }
+  void Commit(uint64_t ticket)
+  {
+    std::lock_guard lock(m_mutex);
+    if (ticket && ticket == m_serial && m_owner)
+    {
+      m_committed = ticket;
+      m_changed.notify_all();
+    }
+  }
+  void Cancel()
+  {
+    std::lock_guard lock(m_mutex);
+    ++m_serial;
+    m_owner = nullptr;
+    m_changed.notify_all();
+  }
+  Result Wait(const volatile std::atomic_bool& abort, std::chrono::milliseconds timeout)
+  {
+    std::unique_lock lock(m_mutex);
+    if (!m_owner)
+      return Result::Idle;
+    const auto serial = m_serial;
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    for (;;)
+    {
+      if (abort || serial != m_serial)
+        return Result::Cancelled;
+      if (m_committed == serial)
+        return Result::Complete;
+      const auto now = std::chrono::steady_clock::now();
+      if (now >= deadline)
+        return Result::TimedOut;
+      m_changed.wait_until(lock, std::min(deadline, now + std::chrono::milliseconds(20)));
+    }
+  }
+private:
+  std::mutex m_mutex;
+  std::condition_variable m_changed;
+  uint64_t m_serial{0}, m_committed{0};
+  const void* m_owner{nullptr}; // Identity only; frame leases remain with Kodi.
+  int64_t m_pts{0};
+};
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateLayerGeometry.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateLayerGeometry.h
new file mode 100644
index 0000000..238e380
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateLayerGeometry.h
@@ -0,0 +1,32 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+extern "C"
+{
+#include <libavutil/dovi_meta.h>
+}
+
+inline bool DVPrivateLayerGeometryMatches(const void* data, size_t size,
+                                         unsigned width, unsigned height,
+                                         int enhancementWidth, int enhancementHeight)
+{
+  if (!data || size < sizeof(AVDOVIMetadata) || !width || !height)
+    return false;
+  AVDOVIMetadata metadata;
+  std::memcpy(&metadata, data, sizeof(metadata));
+  if (metadata.header_offset < sizeof(metadata) || metadata.header_offset > size ||
+      sizeof(AVDOVIRpuDataHeader) > size - metadata.header_offset)
+    return false;
+  AVDOVIRpuDataHeader header;
+  std::memcpy(&header, static_cast<const unsigned char*>(data) + metadata.header_offset,
+              sizeof(header));
+  if (header.el_spatial_resampling_filter_flag > 1 ||
+      enhancementWidth <= 0 || enhancementHeight <= 0)
+    return false;
+  const unsigned scale = header.el_spatial_resampling_filter_flag ? 2 : 1;
+  return width % scale == 0 && height % scale == 0 &&
+         static_cast<unsigned>(enhancementWidth) == width / scale &&
+         static_cast<unsigned>(enhancementHeight) == height / scale;
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateOverlay.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateOverlay.h
new file mode 100644
index 0000000..d3360bd
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateOverlay.h
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+struct DVPrivateOverlay
+{
+  unsigned texture{0};
+  unsigned flipY{0};
+  uint64_t revision{0};      // nonzero: trusted to name the contents (DV_PRIVATE_GUI_REVISION=1)
+  // Counts every time GL may have drawn into the texture (its framebuffer was bound for a
+  // GUI pass, cleared or not) and every replacement of its storage: an equal count is the
+  // same pixels in the same buffer. Not a judgement of what the GUI drew.
+  uint64_t writes{0};
+  double rgbToLms[9]{};
+  double whiteNits{203.0};
+  // The texture's storage as a single-plane dmabuf (Kodi's GUI framebuffer
+  // shared with the Vulkan engine), or -1: the engine reads it in place.
+  int dmabufFd{-1};
+  uint32_t dmabufFormat{0}, dmabufStride{0}, dmabufOffset{0};
+  uint64_t dmabufModifier{0};
+  bool SameContents(const DVPrivateOverlay& other) const
+  {
+    return revision && revision == other.revision && texture == other.texture &&
+           flipY == other.flipY && whiteNits == other.whiteNits &&
+           std::memcmp(rgbToLms, other.rgbToLms, sizeof(rgbToLms)) == 0;
+  }
+};
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.cpp
new file mode 100644
index 0000000..06b1ad0
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.cpp
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVPrivateScanout.h"
+
+bool CDVPrivateScanout::Initialize(gbm_device* device, unsigned buffers)
+{
+  if (!device || m_initialized || buffers < 2 || buffers > kMaxBuffers) return false;
+  dv_scanout_slots_init(&m_slots);
+  m_initialized = true;
+  m_buffers = buffers;
+  for (unsigned slot = 0; slot < m_buffers; ++slot)
+  {
+    m_bo[slot] = gbm_bo_create(device, 3840, 2160, GBM_FORMAT_ARGB8888,
+        GBM_BO_USE_RENDERING | GBM_BO_USE_SCANOUT | GBM_BO_USE_LINEAR);
+    if (!m_bo[slot]) return false;
+  }
+  return true;
+}
+bool CDVPrivateScanout::Begin(uint64_t frame, int64_t pts)
+{ return m_initialized && dv_scanout_slots_acquire(&m_slots,{frame,pts},&m_lease) == 0; }
+bool CDVPrivateScanout::Written(dv_scanout_outcome outcome)
+{ return m_initialized && dv_scanout_slots_written(&m_slots,&m_lease,outcome) == 0; }
+bool CDVPrivateScanout::Presented(bool success)
+{ return m_initialized && dv_scanout_slots_committed(&m_slots,&m_lease,success ? DV_SCANOUT_ACCEPTED : DV_SCANOUT_REJECTED) == 0; }
+bool CDVPrivateScanout::Queued()
+{ return m_initialized && m_buffers == kMaxBuffers && dv_scanout_slots_queue(&m_slots,&m_lease) == 0; }
+bool CDVPrivateScanout::Flipped()
+{ return m_initialized && dv_scanout_slots_flipped(&m_slots) == 0; }
+bool CDVPrivateScanout::ResetStream()
+{ return !m_initialized || dv_scanout_slots_reset_stream(&m_slots) == 0; }
+void CDVPrivateScanout::Drained()
+{ if (m_initialized) dv_scanout_slots_drained(&m_slots); }
+bool CDVPrivateScanout::Replaced()
+{
+  if (!m_initialized) return true;
+  if (m_slots.writing || m_slots.quarantined) return false;
+  dv_scanout_slots_restored(&m_slots);
+  return true;
+}
+bool CDVPrivateScanout::CanClose() const
+{ return !m_initialized || dv_scanout_slots_can_destroy(&m_slots); }
+bool CDVPrivateScanout::Close()
+{
+  if (!CanClose()) return false;
+  for (unsigned slot=0;slot<kMaxBuffers;++slot)
+  {
+    if (m_bo[slot]) gbm_bo_destroy(m_bo[slot]);
+    m_bo[slot]=nullptr;
+  }
+  m_initialized=false;
+  return true;
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.h
new file mode 100644
index 0000000..2d063aa
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateScanout.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include "dv_scanout_slots.h"
+#include <gbm.h>
+#include <cstddef>
+
+/* The private scanout buffers the Vulkan engine writes (linear ARGB8888,
+ * 3840x2160) and their ownership (dv_scanout_slots.h): which one may be
+ * written, which one is ready, which one the display scans out, and which one
+ * it has taken in a flip that is still to come. Two buffers; three when flips
+ * are queued, so that a picture can be written while one is on screen and one
+ * is on its way there. */
+class CDVPrivateScanout
+{
+public:
+  static constexpr unsigned kMaxBuffers = 3;
+  bool Initialize(gbm_device* device, unsigned buffers = 2);
+  bool Begin(uint64_t frame, int64_t pts);
+  bool Written(dv_scanout_outcome outcome);
+  bool Presented(bool success);
+  // The display took the ready buffer without waiting for its flip.
+  bool Queued();
+  // A flip is queued; and: it has completed.
+  bool FlipQueued() const { return m_slots.queued >= 0; }
+  bool Flipped();
+  bool ResetStream();
+  // The engine has drained and is destroyed: a write it left unfinished is over.
+  void Drained();
+  bool Replaced();
+  bool CanClose() const;
+  bool Close();
+  unsigned Buffers() const { return m_buffers; }
+  gbm_bo* Buffer(unsigned slot) const { return m_bo[slot]; }
+  unsigned Slot() const { return m_lease.slot; }
+  unsigned Packet() const { return m_lease.packet_id; }
+  bool Refresh() const { return m_lease.refresh != 0; }
+  gbm_bo* ReadyBuffer() const { return m_slots.ready ? m_bo[m_lease.slot] : nullptr; }
+  // The slot of the newest picture the display has taken: the queued one, else
+  // the one on screen (-1: none of these buffers); and whether the next
+  // picture has to carry a metadata refresh.
+  int Front() const { return m_slots.queued >= 0 ? m_slots.queued : m_slots.current; }
+  bool NextRefresh() const { return m_slots.refresh != 0; }
+private:
+  dv_scanout_slots m_slots{};
+  dv_scanout_lease m_lease{};
+  bool m_initialized{false};
+  unsigned m_buffers{2};
+  gbm_bo* m_bo[kMaxBuffers]{};
+};
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp
new file mode 100644
index 0000000..87e3938
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.cpp
@@ -0,0 +1,525 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVPrivateSource.h"
+#include "DVPrivateOverlay.h"
+#include "DVPrivateDrain.h"
+#include "DVPrivateScanout.h"
+#include "DVPrivateVulkan.h"
+#include "DVPrivateLayerGeometry.h"
+#include "ServiceBroker.h"
+#include "windowing/gbm/WinSystemGbm.h"
+#include "windowing/gbm/drm/DRMAtomic.h"
+#include "cores/VideoPlayer/Buffers/VideoBuffer.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/VAAPI.h"
+#include "utils/log.h"
+#include <EGL/egl.h>
+#include <GLES3/gl3.h>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+extern "C"
+{
+#include <libavutil/frame.h>
+#include <libavutil/hwcontext.h>
+#include <libavutil/hwcontext_vaapi.h>
+}
+
+namespace
+{
+bool EnvIs(const char* name, const char* value)
+{
+  const char* current = std::getenv(name);
+  return current && std::strcmp(current, value) == 0;
+}
+
+// CVideoBuffer has no accessor for its pool; a derived class may name the
+// protected member, and the pointer to it applies to any video buffer.
+struct BufferPool : CVideoBuffer
+{
+  static const void* Of(const CVideoBuffer& buffer) { return (buffer.*&BufferPool::m_pool).get(); }
+};
+} // namespace
+
+bool CDVPrivateSource::PoolChanged(const CVideoBuffer* owner, const AVFrame* enhancement) const
+{
+  const auto* picture = dynamic_cast<const VAAPI::CVaapiRenderPicture*>(owner);
+  if (!picture || BufferPool::Of(*picture) != m_poolBuffers ||
+      picture->procPic.source != m_poolPostproc)
+    return true;
+  // A picture without an enhancement layer leaves that layer's pool as it is (held).
+  return enhancement && (!m_poolFrames || enhancement->hw_frames_ctx->data != m_poolFrames->data);
+}
+
+bool CDVPrivateSource::HoldPool(CVideoBuffer* owner, const AVFrame* enhancement)
+{
+  const auto* picture = dynamic_cast<const VAAPI::CVaapiRenderPicture*>(owner);
+  if (!picture)
+    return false;
+  if (enhancement && (!m_poolFrames || enhancement->hw_frames_ctx->data != m_poolFrames->data))
+  {
+    AVBufferRef* frames = av_buffer_ref(enhancement->hw_frames_ctx);
+    if (!frames)
+      return false;
+    av_buffer_unref(&m_poolFrames);
+    m_poolFrames = frames;
+  }
+  // The newest picture stands for its pool: holding the first one instead
+  // would keep a decoder surface from the decoder for the whole title.
+  owner->Acquire();
+  if (m_poolPicture)
+    m_poolPicture->Release();
+  m_poolPicture = owner;
+  m_poolBuffers = BufferPool::Of(*picture);
+  m_poolPostproc = picture->procPic.source;
+  return true;
+}
+
+void CDVPrivateSource::ReleasePool()
+{
+  if (m_poolPicture)
+    m_poolPicture->Release();
+  m_poolPicture = nullptr;
+  m_poolBuffers = m_poolPostproc = nullptr;
+  av_buffer_unref(&m_poolFrames);
+}
+
+bool CDVPrivateSource::MasterReference()
+{
+  if (m_masterReference < 0)
+    m_masterReference = CDVPrivateVulkan::MasterReference();
+  return m_masterReference != 0;
+}
+
+bool CDVPrivateSource::Initialize(void* display)
+{
+  if (eglGetCurrentContext() == EGL_NO_CONTEXT)
+    return false;
+  auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+  const auto drm = window ? window->GetDrm() : nullptr;
+  if (drm)
+  {
+    const int fd = drm->GetRenderNodeFileDescriptor() >= 0 ? drm->GetRenderNodeFileDescriptor()
+                                                            : drm->GetFileDescriptor();
+    // The engine writes the private scanout buffers itself; their slot
+    // bookkeeping is Kodi's (dv_scanout_slots.cpp). An engine started again
+    // after a failure takes the buffers there are: one may be on screen. A
+    // third one where flips are queued (DV_PRIVATE_NONBLOCK=1).
+    if (!m_scanout)
+    {
+      m_scanout = new CDVPrivateScanout;
+      if (!m_scanout->Initialize(window->GetGBMDevice().Get(),
+                                 KODI::WINDOWING::GBM::CDRMAtomic::DVNonblock() ? 3 : 2))
+      {
+        m_scanout->Close();
+        delete m_scanout;
+        m_scanout = nullptr;
+      }
+    }
+    if (m_scanout)
+    {
+      m_vulkan = new CDVPrivateVulkan;
+      gbm_bo* outputs[CDVPrivateScanout::kMaxBuffers]{};
+      for (unsigned slot = 0; slot < m_scanout->Buffers(); ++slot)
+        outputs[slot] = m_scanout->Buffer(slot);
+      if (m_vulkan->Initialize(display, fd, window->GetGBMDevice().Get(), outputs,
+                               m_scanout->Buffers(), MasterReference()))
+      {
+        m_display = display;
+        CLog::Log(LOGINFO, "Private source direct scanout initialized: {} cached buffers, Vulkan engine",
+                  m_scanout->Buffers());
+        return true;
+      }
+    }
+  }
+  // No second renderer: the window gives this title back to plain playback.
+  m_startFailed = true;
+  if (!CloseVulkan())
+    m_unsafe = true;
+  CDVPrivateVulkan::StartFailed();
+  return false;
+}
+
+bool CDVPrivateSource::CloseVulkan()
+{
+  // The engine's imports go before their GBM storage.
+  glFinish();
+  if (m_vulkan)
+  {
+    if (!m_vulkan->Close()) return false;
+    delete m_vulkan;
+    m_vulkan = nullptr;
+  }
+  m_masterReference = -1;
+  // A buffer on screen stays until the display has been handed back (Close()).
+  if (m_scanout && m_scanout->CanClose())
+  {
+    if (!m_scanout->Close()) return false;
+    delete m_scanout;
+    m_scanout = nullptr;
+  }
+  return true;
+}
+
+bool CDVPrivateSource::DestroyEngine()
+{
+  // The engine's contract after a failure, and the order at any end: every
+  // input stays until all submitted work has drained and the engine is
+  // destroyed. False: it did not drain, and nothing is released.
+  if (m_vulkan)
+  {
+    if (!m_vulkan->Close()) return false;
+    delete m_vulkan;
+    m_vulkan = nullptr;
+  }
+  m_masterReference = -1;
+  for (InFlight& frame : m_inFlight)
+  {
+    frame.enhancement.reset();
+    if (frame.owner) frame.owner->Release();
+  }
+  m_inFlight.clear();
+  ReleaseInputs();
+  ReleasePool();
+  if (m_scanout) m_scanout->Drained();
+  m_shown.valid = m_preparing.valid = false;
+  m_ready = false;
+  return true;
+}
+
+bool CDVPrivateSource::Recover(const char* stage)
+{
+  if (!DestroyEngine())
+  {
+    // Fail-stop: its work may still read the decoded surfaces.
+    m_unsafe = true;
+    CLog::Log(LOGFATAL, "Private source: the Vulkan engine failed ({}) and did not drain; retaining "
+              "frame leases, no Dolby Vision picture until it does", stage);
+    return false;
+  }
+  // A failure now and then over a long title is recovered every time; one
+  // that comes straight back is not retried for ever.
+  if (m_processed - m_recoveryMark > 1000)
+    m_recoveries = 0;
+  m_recoveryMark = m_processed;
+  if (++m_recoveries > 2)
+  {
+    CLog::Log(LOGERROR, "Private source: the Vulkan engine failed again ({}); drained and destroyed, "
+              "not started again for this video", stage);
+    m_startFailed = true;
+    CDVPrivateVulkan::StartFailed();
+  }
+  else
+    CLog::Log(LOGWARNING, "Private source: the Vulkan engine failed ({}); drained and destroyed, "
+              "starting again with the next picture (recovery {})", stage, m_recoveries);
+  return true;
+}
+
+void CDVPrivateSource::ReleaseInputs()
+{
+  m_enhancement.reset();
+  if (m_owner)
+    m_owner->Release();
+  m_owner = nullptr;
+}
+
+void CDVPrivateSource::SettleFlip()
+{
+  // A queued flip the display has completed: its buffer is the one on screen.
+  if (!m_scanout || !m_scanout->FlipQueued())
+    return;
+  auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+  const auto drm = window ? std::dynamic_pointer_cast<KODI::WINDOWING::GBM::CDRMAtomic>(window->GetDrm())
+                          : nullptr;
+  if (!drm || drm->DVFlipDone() >= m_flip)
+    m_scanout->Flipped();
+}
+
+bool CDVPrivateSource::RetireVulkan(bool wait, size_t keep)
+{
+  // In submission order; with wait, all of them but the newest `keep`.
+  while (m_inFlight.size() > (wait ? keep : 0))
+  {
+    InFlight& frame = m_inFlight.front();
+    const int done = m_vulkan ? m_vulkan->Done(frame.ticket, frame.pts, wait) : CDVPrivateVulkan::DV_VULKAN_FAILED;
+    if (done == 0) return true;
+    if (done != 1)
+    {
+      // The surfaces may still be read: their leases stay until the engine
+      // has drained (the caller's Recover()).
+      CLog::Log(LOGERROR, "Private source Vulkan frame pts={} did not complete", frame.pts);
+      return false;
+    }
+    frame.enhancement.reset();
+    if (frame.owner) frame.owner->Release();
+    m_inFlight.pop_front();
+  }
+  return true;
+}
+
+int CDVPrivateSource::AcquireFrame(void* display, CVideoBuffer* owner,
+                                  const AVFrame* enhancement, int64_t pts,
+                                  const dv_source_geometry& geometry,
+                                  const void* metadata, size_t size)
+{
+  if (m_unsafe)
+    return -1;
+  if (!display || !owner)
+    return 0;
+  if (enhancement)
+  {
+    if (enhancement->format != AV_PIX_FMT_VAAPI ||
+        !DVPrivateLayerGeometryMatches(metadata, size, geometry.width, geometry.height,
+                                       enhancement->width, enhancement->height) ||
+        !enhancement->hw_frames_ctx || enhancement->pts != pts)
+      return 0;
+    auto* frames = reinterpret_cast<AVHWFramesContext*>(enhancement->hw_frames_ctx->data);
+    auto* va = reinterpret_cast<AVVAAPIDeviceContext*>(frames->device_ctx->hwctx);
+    if (frames->sw_format != AV_PIX_FMT_P010 || va->display != display)
+      return 0;
+  }
+  if (!m_vulkan)
+  {
+    // A title whose engine did not start, or kept failing, plays without it
+    // (CDVPrivateVulkan::StartFailed); a later title starts it again.
+    if (m_startFailed && !CDVPrivateVulkan::Usable())
+      return -1;
+    m_startFailed = false;
+    if (!Initialize(display))
+      return -1;
+  }
+  if (m_display != display)
+    return -1;
+  // Surfaces from another allocation may have the ids of the ones the engine
+  // imported: the frames reading the old ones finish, and the engine forgets
+  // its imports, before it sees a new one. With nothing held it has none.
+  if (m_poolPicture && PoolChanged(owner, enhancement))
+  {
+    CLog::Log(LOGINFO, "Private source: decoded surfaces come from a new pool; engine reset (pts={})", pts);
+    Reset();
+    // A reset that failed left no engine (destroyed to start again) or no way on.
+    if (m_unsafe || !m_vulkan)
+      return -1;
+  }
+  if (!HoldPool(owner, enhancement))
+    return -1;
+  if (enhancement)
+  {
+    auto* copy = av_frame_clone(enhancement);
+    if (!copy)
+      return -1;
+    m_enhancement = {copy, [](AVFrame* frame) { av_frame_free(&frame); }};
+  }
+  owner->Acquire();
+  m_owner = owner;
+  return 1;
+}
+
+int CDVPrivateSource::Prepare(void* display, unsigned surface, CVideoBuffer* owner,
+                              const AVFrame* enhancement, const void* metadata,
+                              size_t size, int64_t pts, const dv_source_geometry& geometry, const dv_source_input& input,
+                              const DVPrivateOverlay* overlay, uint64_t sequence, bool mayHold)
+{
+  m_ready = false;
+  if (m_unsafe) return -1;
+  SettleFlip();
+  // Done Vulkan frames give their surfaces back; at most two stay in flight.
+  // With queued flips the newest one is the picture on its way to the screen,
+  // still being rendered while this one is prepared: only the one before it is
+  // waited for.
+  const size_t keep = m_scanout && m_scanout->Buffers() > 2 ? 1 : 0;
+  if (m_vulkan && (!RetireVulkan(false) || (m_inFlight.size() >= 2 && !RetireVulkan(true, keep))))
+  {
+    Recover("frame completion");
+    return -1;
+  }
+  // The same queued picture again, with nothing changed that it is made of:
+  // the buffer on screen is that picture already. Nothing is rendered and
+  // nothing committed (a pause, or a 24p film on a 60 Hz mode, would otherwise
+  // run the whole pipeline every refresh).
+  static const bool skipRepeats = !EnvIs("DV_PRIVATE_SKIP_REPEATS", "0");
+  if (skipRepeats && mayHold && sequence && m_vulkan && m_scanout && m_shown.valid &&
+      m_shown.sequence == sequence && m_shown.owner == owner && display == m_display &&
+      m_shown.slot == m_scanout->Front() && !m_scanout->NextRefresh() &&
+      m_vulkan->Repeats(surface,
+                        enhancement ? static_cast<unsigned>(reinterpret_cast<uintptr_t>(enhancement->data[3]))
+                                    : UINT32_MAX,
+                        metadata, size, pts, geometry, input, false, overlay))
+  {
+    // Shown is committed: a wait for this picture's commit (the first one of
+    // a start, the last one at the end) is over.
+    if (CDVPrivateDrain::Enabled())
+      CDVPrivateDrain::Get().Commit(CDVPrivateDrain::Get().Ticket(owner, pts));
+    if (++m_held <= 3 || m_held % 600 == 0)
+      CLog::Log(LOGINFO, "Private source frame held: pts={} held={} (already on screen)", pts, m_held);
+    return 2;
+  }
+  const bool trace = (m_transitionFrames && EnvIs("DV_PRIVATE_TRANSITION_TIMING", "1")) ||
+                     (m_processed < 480 && EnvIs("DV_PRIVATE_FRAME_TIMING", "1"));
+  const auto entered = std::chrono::steady_clock::now();
+  const int acquired = AcquireFrame(display, owner, enhancement, pts, geometry, metadata, size);
+  if (acquired != 1) return acquired;
+  if (overlay && !overlay->texture)
+  {
+    ReleaseInputs();
+    return -1;
+  }
+  const auto started = std::chrono::steady_clock::now();
+  if (!m_scanout->Begin(m_serial + 1, pts))
+  {
+    ReleaseInputs();
+    return -1;
+  }
+  ++m_serial;
+  const unsigned packet = m_scanout->Packet();
+  const bool refresh = m_scanout->Refresh();
+  const unsigned elSurface = enhancement ? static_cast<unsigned>(reinterpret_cast<uintptr_t>(enhancement->data[3])) : UINT32_MAX;
+  // Whatever comes of it, the engine's last frame is no longer the one on screen.
+  m_shown.valid = m_preparing.valid = false;
+  // The engine waits for the decoder's and the GUI's implicit fences on the GPU.
+  const int result = m_vulkan->Render(m_scanout->Slot(), surface, elSurface, metadata, size, pts,
+                                      geometry, input, packet, refresh, overlay);
+  const auto renderDone = trace ? std::chrono::steady_clock::now() : started;
+  if (m_serial <= 12)
+    CLog::Log(LOGINFO, "Private source consume: pts={} status={}", pts, result);
+  if (result == CDVPrivateVulkan::DV_VULKAN_FAILED)
+  {
+    // Drained, the write into the slot is over (Recover() tells the slots);
+    // not drained, nobody knows what is in it.
+    if (!Recover("submission"))
+      m_scanout->Written(DV_SCANOUT_UNCERTAIN);
+    return -1;
+  }
+  if (result == 0 && m_vulkan->Async())
+  {
+    // Written means submitted: the commit waits for the buffer's fence.
+    m_inFlight.push_back({m_vulkan->Ticket(), pts, m_owner, std::move(m_enhancement)});
+    m_enhancement.reset();
+    m_owner = nullptr;
+  }
+  else
+    ReleaseInputs();
+  if (!m_scanout->Written(result == 0 ? DV_SCANOUT_ACCEPTED : DV_SCANOUT_REJECTED))
+  {
+    m_unsafe = true;
+    return -1;
+  }
+  if (result == -2 && !overlay)
+    return 0;
+  if (result != 0)
+  {
+    CLog::Log(LOGERROR, "Private source renderer rejected frame pts={} status={}", pts, result);
+    return -1;
+  }
+  const double elapsed = std::chrono::duration<double, std::milli>(
+      std::chrono::steady_clock::now() - started).count();
+  const double processing = elapsed +
+      std::chrono::duration<double, std::milli>(started - entered).count();
+  m_processingMs += processing;
+  ++m_processed;
+  m_preparedPts = pts;
+  m_drainTicket = CDVPrivateDrain::Enabled() ? CDVPrivateDrain::Get().Ticket(owner, pts) : 0;
+  m_ready = true;
+  m_preparing = {true, sequence, owner, static_cast<int>(m_scanout->Slot())};
+  if (trace)
+  {
+    const auto ms = [](auto end, auto begin) { return std::chrono::duration<double, std::milli>(end - begin).count(); };
+    CLog::Log(LOGINFO, "Private source transition: pts={} overlay={} setup_ms={} render_call_ms={} processing_ms={} remaining={} entered_ns={}",
+        pts, overlay != nullptr, ms(started, entered), ms(renderDone, started), processing,
+        m_transitionFrames,
+        std::chrono::duration_cast<std::chrono::nanoseconds>(entered.time_since_epoch()).count());
+  }
+  if (m_transitionFrames) --m_transitionFrames;
+  if (m_processed == 1 || m_processed % 120 == 0)
+    CLog::Log(LOGINFO, "Private source frame: serial={} pts={} prepared=true processing_ms={} mean_ms={} submit_ms={}",
+              m_serial, pts, processing, m_processingMs / m_processed, elapsed);
+  return 1;
+}
+
+void CDVPrivateSource::Presented(bool success, bool queued)
+{
+  if (m_ready && EnvIs("DV_PRIVATE_ENDPOINT_TRACE", "1"))
+    CLog::Log(LOGINFO, "Private endpoint display commit: pts={} success={} queued={} direct=true",
+              m_preparedPts, success, queued);
+  // The window waited for a queued flip before this commit.
+  SettleFlip();
+  if (m_scanout && m_ready &&
+      !(success && queued ? m_scanout->Queued() : m_scanout->Presented(success)))
+    m_unsafe = true;
+  if (m_ready && success && queued)
+  {
+    auto* window = dynamic_cast<KODI::WINDOWING::GBM::CWinSystemGbm*>(CServiceBroker::GetWinSystem());
+    const auto drm = window ? std::dynamic_pointer_cast<KODI::WINDOWING::GBM::CDRMAtomic>(window->GetDrm())
+                            : nullptr;
+    m_flip = drm ? drm->DVFlipQueued() : 0;
+  }
+  if (m_ready && success)
+  {
+    if (!m_unsafe)
+      CDVPrivateDrain::Get().Commit(m_drainTicket);
+    ++m_presented;
+    m_shown = m_preparing;
+  }
+  m_preparing.valid = false;
+  m_ready = false;
+}
+
+void CDVPrivateSource::Reset()
+{
+  if (m_unsafe) return;
+  SettleFlip();
+  ReleaseInputs();
+  if (m_scanout && !m_scanout->ResetStream()) m_unsafe = true;
+  if (m_vulkan)
+  {
+    // A reset is not a recovery: an engine that cannot complete its frames
+    // or its reset is drained and destroyed.
+    const bool retired = RetireVulkan(true);
+    if (retired) m_vulkan->Reset();
+    if (!retired || m_vulkan->Failed()) Recover("reset");
+  }
+  // The pools stay until no frame can read their surfaces any more.
+  if (!m_unsafe) ReleasePool();
+  m_shown.valid = m_preparing.valid = false;
+  m_ready = false;
+  m_transitionFrames = 3;
+}
+
+bool CDVPrivateSource::Close()
+{
+  glFinish();
+  // Frames in flight are waited for (their error flags logged); whether or
+  // not that worked, the drain decides if anything may still be read.
+  if (m_vulkan) RetireVulkan(true);
+  if (!DestroyEngine()) return false;
+  m_unsafe = false;
+  if (m_scanout && !m_scanout->CanClose()) return false;
+  if (m_scanout)
+  {
+    if (!m_scanout->Close()) return false;
+    delete m_scanout;
+    m_scanout = nullptr;
+  }
+  CLog::Log(LOGINFO, "Private source renderer closed: processed={} submissions={} presented={} held={}",
+            m_processed, m_serial, m_presented, m_held);
+  return true;
+}
+
+gbm_bo* CDVPrivateSource::ScanoutBuffer() const
+{ return m_ready && m_scanout ? m_scanout->ReadyBuffer() : nullptr; }
+
+bool CDVPrivateSource::DisplayReplaced()
+{
+  if (!m_scanout) return true;
+  SettleFlip();
+  // After a failure that did not drain: by now it may have. Not on every
+  // page of a menu: a drain that still fails takes its whole timeout.
+  const auto now = std::chrono::steady_clock::now();
+  if (m_unsafe && now - m_unsafeChecked >= std::chrono::seconds(10))
+  {
+    m_unsafeChecked = now;
+    if (DestroyEngine()) m_unsafe = false;
+  }
+  if (!m_scanout->Replaced()) return false;
+  m_shown.valid = m_preparing.valid = false;
+  m_ready = false;
+  return true;
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h
new file mode 100644
index 0000000..d46d65c
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateSource.h
@@ -0,0 +1,116 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include "source_geometry.h"
+#include "source_input.h"
+#include "DVPrivateOverlay.h"
+
+class CVideoBuffer;
+class CDVPrivateScanout;
+class CDVPrivateVulkan;
+struct gbm_bo;
+struct AVFrame;
+struct AVBufferRef;
+
+/* The native Dolby Vision route: decoded VAAPI surfaces to the Vulkan engine
+ * (CDVPrivateVulkan, yblod-engine/vk), which writes one of two private
+ * scanout buffers (CDVPrivateScanout) that the window commits with the
+ * tunnel's signal. The Vulkan engine is YBLOD's only Dolby Vision renderer. */
+class CDVPrivateSource
+{
+public:
+  /* 1 the picture is in a scanout buffer; 2 it is the picture on screen
+   * already, which stays (nothing written, nothing to present); 0 not a
+   * picture the engine takes (nothing written); -1 failed (the engine did not
+   * start, or rejected it). sequence names one queued picture (0: unknown);
+   * mayHold: the caller can do without a new buffer for this refresh. */
+  int Prepare(void* display, unsigned surface, CVideoBuffer* owner,
+              const AVFrame* enhancement, const void* metadata, size_t size, int64_t pts,
+              const dv_source_geometry& geometry, const dv_source_input& input,
+              const DVPrivateOverlay* overlay = nullptr, uint64_t sequence = 0,
+              bool mayHold = false);
+  bool Close();
+  void Reset();
+  /* The window's commit of the prepared picture. queued: the display took it
+   * without waiting for its flip (CDRMAtomic::FlipPageTransactional). */
+  void Presented(bool success, bool queued = false);
+  gbm_bo* ScanoutBuffer() const;
+  /* The enhancement layer upscaling of this adapter's engine: read from the
+   * setting once, before the engine starts, and kept while that engine lives.
+   * The chroma siting chosen for each picture and the engine's contract must
+   * come from the same value, also when the setting changes during a title. */
+  bool MasterReference();
+  bool DisplayReplaced();
+private:
+  bool Initialize(void* display);
+  bool CloseVulkan();
+  void ReleaseInputs();
+  bool RetireVulkan(bool wait, size_t keep = 0);
+  void SettleFlip();
+  bool DestroyEngine();
+  bool Recover(const char* stage);
+  int AcquireFrame(void* display, CVideoBuffer* owner, const AVFrame* enhancement,
+                   int64_t pts, const dv_source_geometry& geometry,
+                   const void* metadata, size_t size);
+  bool PoolChanged(const CVideoBuffer* owner, const AVFrame* enhancement) const;
+  bool HoldPool(CVideoBuffer* owner, const AVFrame* enhancement);
+  void ReleasePool();
+  void* m_display{nullptr};
+  CDVPrivateScanout* m_scanout{nullptr};
+  CDVPrivateVulkan* m_vulkan{nullptr};
+  CVideoBuffer* m_owner{nullptr};
+  std::shared_ptr<AVFrame> m_enhancement;
+  // Vulkan frames submitted without waiting: their decoded surfaces stay
+  // leased until the engine is done with them.
+  struct InFlight
+  {
+    uint64_t ticket;
+    int64_t pts;
+    CVideoBuffer* owner;
+    std::shared_ptr<AVFrame> enhancement;
+  };
+  std::deque<InFlight> m_inFlight;
+  // The engine knows a decoded surface by its VASurfaceID until it is reset,
+  // so its imports stand for one allocation of surfaces per layer. The base
+  // layer's is named by the buffer pool (one per decoder, which creates its
+  // surfaces once) and the postprocessor (which may own the surfaces instead)
+  // of the last picture submitted; the enhancement layer's by its frame pool.
+  // The picture and the frame pool are held: what is held cannot be freed, so
+  // nothing allocated later can have the same address and compare equal.
+  CVideoBuffer* m_poolPicture{nullptr};
+  const void* m_poolBuffers{nullptr};
+  const void* m_poolPostproc{nullptr};
+  AVBufferRef* m_poolFrames{nullptr};
+  uint64_t m_serial{0}, m_presented{0};
+  // The picture on screen, while it is the last one given to the engine: asked
+  // for again unchanged, it is not rendered again (DV_PRIVATE_SKIP_REPEATS=0:
+  // always rendered).
+  struct Shown
+  {
+    bool valid{false};
+    uint64_t sequence{0};
+    const CVideoBuffer* owner{nullptr};
+    int slot{-1};
+  } m_shown, m_preparing;
+  uint64_t m_held{0};
+  // The number the DRM layer gave the flip the scanout slots hold as queued.
+  uint64_t m_flip{0};
+  uint64_t m_processed{0};
+  double m_processingMs{0};
+  int64_t m_preparedPts{0};
+  uint64_t m_drainTicket{0};
+  unsigned m_transitionFrames{3};
+  // m_unsafe: the engine failed and could not be drained, so work of its may
+  // still read the leased surfaces: nothing is released and no frame is taken
+  // until a later drain succeeds (DisplayReplaced(), Close()).
+  bool m_ready{false}, m_unsafe{false}, m_startFailed{false};
+  // Engine failures answered by draining, destroying and starting it again.
+  int m_masterReference{-1};
+  unsigned m_recoveries{0};
+  uint64_t m_recoveryMark{0};
+  std::chrono::steady_clock::time_point m_unsafeChecked{};
+};
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
new file mode 100644
index 0000000..d4c0d51
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.cpp
@@ -0,0 +1,820 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#include "DVPrivateVulkan.h"
+#include "ServiceBroker.h"
+#include "cores/VideoPlayer/DVDCodecs/Video/DVOutputSettings.h"
+#include "dialogs/GUIDialogKaiToast.h"
+#include "messaging/ApplicationMessenger.h"
+#include "resources/LocalizeStrings.h"
+#include "resources/ResourcesComponent.h"
+#include "utils/log.h"
+#include "windowing/gbm/WinSystemGbm.h"
+#include <GLES3/gl3.h>
+#include <drm_fourcc.h>
+#include <dlfcn.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace
+{
+// Its library is missing or of another ABI, or it failed to start for three
+// titles: Dolby Vision titles play as plain base-layer video until Kodi restarts.
+std::atomic<bool> engineFailed{false};
+std::atomic<bool> failureReported{false};
+// A title whose engine did not start plays without it: 1 from the failure
+// until that title's restart has configured its output, 2 while it plays.
+std::atomic<int> titleWithout{0};
+std::atomic<unsigned> startFailures{0};
+constexpr unsigned kStartFailureLimit = 3;
+
+void ReportUnavailable(const char* reason)
+{
+  engineFailed = true;
+  if (failureReported.exchange(true))
+    return;
+  CLog::Log(LOGERROR, "Dolby Vision: the Vulkan engine is not available ({}); Dolby Vision titles "
+            "play as plain base-layer video until Kodi restarts", reason);
+  auto& strings = CServiceBroker::GetResourcesComponent().GetLocalizeStrings();
+  CGUIDialogKaiToast::QueueNotification(CGUIDialogKaiToast::Error, strings.Get(45010),
+                                        strings.Get(45100));
+}
+
+bool EnvIs(const char* name, const char* value)
+{
+  const char* current = std::getenv(name);
+  return current && std::strcmp(current, value) == 0;
+}
+
+unsigned EnvNumber(const char* name, unsigned fallback, unsigned limit)
+{
+  const char* value = std::getenv(name);
+  if (!value || !value[0]) return fallback;
+  char* end = nullptr;
+  const unsigned long number = std::strtoul(value, &end, 10);
+  if (*end || number > limit)
+  {
+    CLog::Log(LOGWARNING, "Vulkan engine: {}={} is not 0-{}; using {}", name, value, limit, fallback);
+    return fallback;
+  }
+  return static_cast<unsigned>(number);
+}
+
+// CroqueMr's optional CM2.9 -> CM4.0 metadata and L2 trim removal
+// (dvvk_plan_in.dm_options): DV_VULKAN_CM4 off, no-l2, always, auto, auto2;
+// DV_VULKAN_CM4_TRIGGER (auto) source, 1000, 2000, 4000, 10000;
+// DV_VULKAN_CM4_HEADROOM (auto2) 0-50 %; DV_VULKAN_TV_PEAK in nits (0: the
+// TV's EDID); DV_VULKAN_NO_L2=1. Metadata only: no pixel changes.
+// Settings > Player > Dolby Vision > Dolby Vision metadata "CM4.0 auto" is
+// auto2 (L1 max within the TV's peak plus the headroom); without a known TV
+// peak it is auto with a 1000-nit trigger (mastered at up to 1000 nits).
+uint32_t DmOptions()
+{
+  static const char* const modes[] = {"off", "no-l2", "always", "auto", "auto2"};
+  static const char* const triggers[] = {"source", "1000", "2000", "4000", "10000"};
+  const char* mode = std::getenv("DV_VULKAN_CM4");
+  const char* trigger = std::getenv("DV_VULKAN_CM4_TRIGGER");
+  unsigned m = 0, t = 0;
+  if (mode && mode[0])
+  {
+    while (m < 5 && std::strcmp(mode, modes[m]) != 0) ++m;
+    if (m == 5)
+    {
+      CLog::Log(LOGWARNING, "Vulkan engine: DV_VULKAN_CM4={} is not off, no-l2, always, auto or auto2; off", mode);
+      m = 0;
+    }
+  }
+  if (trigger && trigger[0])
+  {
+    while (t < 5 && std::strcmp(trigger, triggers[t]) != 0) ++t;
+    if (t == 5)
+    {
+      CLog::Log(LOGWARNING, "Vulkan engine: DV_VULKAN_CM4_TRIGGER={} is not source, 1000, 2000, 4000 or 10000; source",
+                trigger);
+      t = 0;
+    }
+  }
+  const unsigned headroom = EnvNumber("DV_VULKAN_CM4_HEADROOM", 20, 50);
+  unsigned peak = EnvNumber("DV_VULKAN_TV_PEAK", 0, 10000);
+  if (!peak && (m == DVVK_CM4_AUTO2 || (m == DVVK_CM4_AUTO && t == 0)))
+  {
+    const auto* window = dynamic_cast<const KODI::WINDOWING::GBM::CWinSystemGbm*>(
+        CServiceBroker::GetWinSystem());
+    peak = window ? window->DisplayPeakNits() : 0;
+    if (peak)
+      CLog::Log(LOGINFO, "Vulkan engine CM4: TV peak {} nits from the TV's EDID", peak);
+    else if (m == DVVK_CM4_AUTO2)
+    {
+      m = DVVK_CM4_AUTO;
+      t = 1; // 1000 nits
+      CLog::Log(LOGINFO, "Vulkan engine CM4: no TV peak (setting or EDID); auto by the mastering peak (1000 nits)");
+    }
+  }
+  const bool noL2 = EnvIs("DV_VULKAN_NO_L2", "1");
+  if (!m && !noL2) return 0;   // the stream's metadata as is
+  return DVVK_DM_OPTIONS(m, t, headroom, noL2, peak);
+}
+} // namespace
+
+bool CDVPrivateVulkan::Usable()
+{
+  if (engineFailed || titleWithout.load() != 0)
+    return false;
+  // The library loads and is the ABI Kodi was built with (checked once).
+  static std::once_flag probed;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+    {
+      CLog::Log(LOGERROR, "Vulkan engine load failed: {}", dlerror());
+      ReportUnavailable("library not loaded");
+      return;
+    }
+    auto abi = reinterpret_cast<uint32_t (*)()>(dlsym(handle, "dvvk_abi_version"));
+    const uint32_t version = abi ? abi() : 0;
+    dlclose(handle);
+    if (version != DVVK_ABI_VERSION)
+    {
+      CLog::Log(LOGERROR, "Vulkan engine {}: ABI {}, Kodi needs {}", library, version, DVVK_ABI_VERSION);
+      ReportUnavailable("library ABI mismatch");
+    }
+  });
+  return !engineFailed;
+}
+
+void CDVPrivateVulkan::StartFailed()
+{
+  // A cause that passes (memory, a GPU reset) must not cost Dolby Vision for
+  // the rest of the Kodi run; one that stays must not restart every title.
+  const unsigned failures = ++startFailures;
+  if (failures >= kStartFailureLimit)
+    ReportUnavailable("the engine did not start");
+  else
+    CLog::Log(LOGERROR, "Dolby Vision: the Vulkan engine did not start ({} of {}); this video plays as "
+              "plain base-layer video, the next one tries again", failures, kStartFailureLimit);
+  titleWithout = 1;
+  // The title that tried it starts again where it was, as plain playback.
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_MEDIA_RESTART);
+}
+
+void CDVPrivateVulkan::VideoConfigured()
+{
+  int restarting = 1;
+  titleWithout.compare_exchange_strong(restarting, 2);
+}
+
+void CDVPrivateVulkan::PlaybackIdle()
+{
+  int playing = 2;
+  titleWithout.compare_exchange_strong(playing, 0);
+}
+
+bool CDVPrivateVulkan::HasHDR10()
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!Usable())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    has = dlsym(handle, "dvvk_set_output_mode") && dlsym(handle, "dvvk_output_signal");
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: HDR10 output {}", library, has ? "available" : "not available");
+  });
+  return has;
+}
+
+bool CDVPrivateVulkan::HasHDR10Plus()
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!HasHDR10())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    has = dlsym(handle, "dvvk_hdr10plus_packet") != nullptr;
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: HDR10+ output {}", library, has ? "available" : "not available");
+  });
+  return has;
+}
+
+uint32_t CDVPrivateVulkan::WantedOutputMode() const
+{
+  // HDR10 when the window asks for it (the tunnel's format follows the
+  // signal this publishes), HDR10+ when it asks for that too, until a picture
+  // could not be represented as HDR10+ (then HDR10 for the rest of the
+  // title); otherwise Dolby Vision.
+  if (!DVBRIDGE::playbackTunnelHDR10.load())
+    return DVVK_OUTPUT_DV;
+  return DVBRIDGE::playbackTunnelHDR10Plus.load() && !DVBRIDGE::playbackHDR10PlusFallback.load() &&
+                 m_hdr10PlusPacket
+             ? DVVK_OUTPUT_HDR10PLUS
+             : DVVK_OUTPUT_HDR10;
+}
+
+void CDVPrivateVulkan::SelectOutputMode()
+{
+  const uint32_t want = WantedOutputMode();
+  if (want == m_outputMode)
+    return;
+  if (!m_setOutputMode)
+  {
+    if (want != DVVK_OUTPUT_DV && m_reports < 16)
+    {
+      ++m_reports;
+      CLog::Log(LOGERROR, "Vulkan engine: no HDR10 output in this library; Dolby Vision pictures");
+    }
+    return;
+  }
+  dvvk_output_mode mode{};
+  mode.mode = want;
+  const int result = m_setOutputMode(m_engine, &mode);
+  if (result != 0)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine refused output mode {} ({})", want, result);
+    return;
+  }
+  m_outputMode = want;
+  CLog::Log(LOGINFO, "Vulkan engine output: {}", want == DVVK_OUTPUT_HDR10PLUS
+            ? "HDR10+, the Master Reference reconstruction with per-picture HDR10+ metadata "
+              "(BT.2020 PQ, 12-bit 4:2:2 through the tunnel)"
+            : want == DVVK_OUTPUT_HDR10
+            ? "HDR10, the Master Reference conversion (BT.2020 PQ, 12-bit 4:2:2 through the tunnel)"
+            : "Dolby Vision");
+}
+
+void CDVPrivateVulkan::PublishSignal(int64_t pts)
+{
+  dvvk_hdr_signal signal{};
+  // HDR10 and HDR10+ pictures carry the same static metadata.
+  if (m_outputMode == DVVK_OUTPUT_DV || !m_outputSignal || m_outputSignal(m_engine, &signal) != 0 ||
+      signal.mode != m_outputMode)
+  {
+    DVBRIDGE::PublishTunnelHDR10(nullptr);
+    return;
+  }
+  DVBRIDGE::TunnelHDR10Signal out;
+  std::memcpy(out.primaries, signal.primaries, sizeof(out.primaries));
+  out.white[0] = signal.white[0];
+  out.white[1] = signal.white[1];
+  out.maxLuminance = signal.max_luminance;
+  out.minLuminance = signal.min_luminance;
+  out.maxCll = signal.max_cll;
+  out.maxFall = signal.max_fall;
+  DVBRIDGE::PublishTunnelHDR10(&out);
+  if (std::memcmp(&signal, &m_loggedSignal, sizeof(signal)) != 0)
+  {
+    m_loggedSignal = signal;
+    CLog::Log(LOGINFO, "Vulkan engine HDR10 pts={}: mastering {} / {:.4f} cd/m2, MaxCLL {}, MaxFALL {}, "
+              "primaries {:.4f},{:.4f} {:.4f},{:.4f} {:.4f},{:.4f} white {:.4f},{:.4f}",
+              pts, signal.max_luminance, signal.min_luminance / 10000.0, signal.max_cll, signal.max_fall,
+              signal.primaries[0][0] / 50000.0, signal.primaries[0][1] / 50000.0,
+              signal.primaries[1][0] / 50000.0, signal.primaries[1][1] / 50000.0,
+              signal.primaries[2][0] / 50000.0, signal.primaries[2][1] / 50000.0,
+              signal.white[0] / 50000.0, signal.white[1] / 50000.0);
+  }
+}
+
+void CDVPrivateVulkan::PublishHDR10Plus(uint64_t ticket, int64_t pts)
+{
+  DVBRIDGE::TunnelHDR10PlusPacket packet;
+  if (m_outputMode != DVVK_OUTPUT_HDR10PLUS || !m_hdr10PlusPacket)
+  {
+    DVBRIDGE::PublishTunnelHDR10Plus(packet); // None
+    return;
+  }
+  // The packet is latched with its picture (the kernel's presentation contract: no_delay).
+  const uint32_t flags = DVBRIDGE::playbackHDR10PlusFlags.load() | DVVK_HDR10PLUS_NO_DELAY;
+  dvvk_hdr10plus_metadata metadata{};
+  const int result = m_hdr10PlusPacket(m_engine, ticket, flags, &metadata);
+  switch (result)
+  {
+    case 0:
+      packet.state = DVBRIDGE::TunnelHDR10PlusPacket::State::Send;
+      std::memcpy(packet.vsif, metadata.vsif, sizeof(packet.vsif));
+      if ((metadata.coverage != m_hdr10PlusCoverage || metadata.reason != m_hdr10PlusReason) &&
+          m_hdr10PlusReports < 16)
+      {
+        ++m_hdr10PlusReports;
+        CLog::Log(LOGINFO, "Vulkan engine HDR10+ pts={}: V{} coverage {} reason {} (statistics of "
+                  "frame {}: average maxRGB {:.1f} cd/m2, MaxSCL {:.0f}/{:.0f}/{:.0f}; curve error "
+                  "{:.4f}, colour error {:.4f})", pts, metadata.application_version,
+                  metadata.coverage, metadata.reason, metadata.statistics_ticket,
+                  metadata.average_maxrgb, metadata.maxscl[0], metadata.maxscl[1],
+                  metadata.maxscl[2], metadata.maximum_curve_pq_error,
+                  metadata.maximum_color_pq_error);
+      }
+      m_hdr10PlusCoverage = metadata.coverage;
+      m_hdr10PlusReason = metadata.reason;
+      break;
+    case 1:
+      // No finished picture's statistics yet: the property stays as it is.
+      packet.state = DVBRIDGE::TunnelHDR10PlusPacket::State::Keep;
+      break;
+    case DVVK_HDR10PLUS_FALLBACK:
+      // Not representable: HDR10 (the Master Reference conversion) for the rest of the title,
+      // from the next picture; this one is sent without HDR10+.
+      if (!DVBRIDGE::playbackHDR10PlusFallback.exchange(true))
+        CLog::Log(LOGWARNING, "Vulkan engine HDR10+ pts={}: not representable (coverage {} reason "
+                  "{}); HDR10 for the rest of this video", pts, metadata.coverage, metadata.reason);
+      break;
+    default:
+      packet.state = DVBRIDGE::TunnelHDR10PlusPacket::State::Keep;
+      if (m_hdr10PlusReports < 16)
+      {
+        ++m_hdr10PlusReports;
+        CLog::Log(LOGERROR, "Vulkan engine HDR10+ pts={}: no packet for frame {} ({})", pts, ticket,
+                  result);
+      }
+      break;
+  }
+  DVBRIDGE::PublishTunnelHDR10Plus(packet);
+}
+
+bool CDVPrivateVulkan::MasterReference()
+{
+  // dvbridge.elupscaler: annexb (the default) or bilinear (DVEngineSettings).
+  return !EnvIs("DV_EL_SCALER", "bilinear");
+}
+
+bool CDVPrivateVulkan::Initialize(void* vaDisplay, int drmFd, gbm_device* device,
+                                  gbm_bo* const* outputs, unsigned count, bool masterReference)
+{
+  if (m_library || !vaDisplay || drmFd < 0 || !device || !outputs || count < 2) return false;
+  for (unsigned slot = 0; slot < count; ++slot)
+    if (!outputs[slot]) return false;
+  const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+  if (!library || !library[0]) library = DVVK_LIBRARY;
+  m_library = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+  if (!m_library)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine load failed: {}", dlerror());
+    return false;
+  }
+#define LOAD(member, symbol) member = reinterpret_cast<decltype(member)>(dlsym(m_library, #symbol)); if (!member) { CLog::Log(LOGERROR, "Vulkan engine: no {} in {}", #symbol, library); return false; }
+  LOAD(m_create, dvvk_create);
+  LOAD(m_setOutput, dvvk_set_output);
+  LOAD(m_setOverlay, dvvk_set_overlay);
+  LOAD(m_submit, dvvk_submit);
+  LOAD(m_poll, dvvk_poll);
+  LOAD(m_wait, dvvk_wait);
+  LOAD(m_reset, dvvk_reset);
+  LOAD(m_destroy, dvvk_destroy);
+#undef LOAD
+  // The structs Kodi was built with (dv_engine_vk.h) must be the library's.
+  auto abi = reinterpret_cast<uint32_t (*)()>(dlsym(m_library, "dvvk_abi_version"));
+  if (!abi || abi() != DVVK_ABI_VERSION)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine {}: ABI {}, Kodi needs {}", library, abi ? abi() : 0u, DVVK_ABI_VERSION);
+    return false;
+  }
+  // A finite drain before destruction, and a reset that reports failure.
+  m_drain = reinterpret_cast<decltype(m_drain)>(dlsym(m_library, "dvvk_drain"));
+  m_resetChecked = reinterpret_cast<decltype(m_resetChecked)>(dlsym(m_library, "dvvk_reset_checked"));
+  m_dmStatus = reinterpret_cast<decltype(m_dmStatus)>(dlsym(m_library, "dvvk_dm_status"));
+  m_setOutputMode = reinterpret_cast<decltype(m_setOutputMode)>(dlsym(m_library, "dvvk_set_output_mode"));
+  m_outputSignal = reinterpret_cast<decltype(m_outputSignal)>(dlsym(m_library, "dvvk_output_signal"));
+  m_hdr10PlusPacket = reinterpret_cast<decltype(m_hdr10PlusPacket)>(dlsym(m_library, "dvvk_hdr10plus_packet"));
+  if (!m_setOutputMode || !m_outputSignal)
+    m_setOutputMode = nullptr, m_outputSignal = nullptr, m_hdr10PlusPacket = nullptr;
+  // Reading Kodi's GUI framebuffer in place needs the flag and the read fences.
+  m_setOverlayEx = reinterpret_cast<decltype(m_setOverlayEx)>(dlsym(m_library, "dvvk_set_overlay_ex"));
+  m_implicitFailed = reinterpret_cast<decltype(m_implicitFailed)>(dlsym(m_library, "dvvk_implicit_failed"));
+  // The engine logs its reasons on stderr (the journal).
+  if (m_create(drmFd, vaDisplay, &m_engine) != 0 || !m_engine)
+  {
+    m_engine = nullptr;
+    CLog::Log(LOGERROR, "Vulkan engine did not start (no Vulkan device for the DRM node?)");
+    return false;
+  }
+  for (unsigned slot = 0; slot < count; ++slot)
+  {
+    const int fd = gbm_bo_get_fd(outputs[slot]);
+    // The engine imports its own duplicate.
+    const int result = fd < 0 ? -1 : m_setOutput(m_engine, slot, fd, gbm_bo_get_stride(outputs[slot]));
+    if (fd >= 0) close(fd);
+    if (result != 0)
+    {
+      CLog::Log(LOGERROR, "Vulkan engine could not import scanout buffer {}", slot);
+      return false;
+    }
+  }
+  // Enhancement layer upscaling (dvbridge.elupscaler, DV_EL_SCALER):
+  //  annexb   Annex B (Master Reference): CB1 Master Reference's processing
+  //           (cb1_contract) for unscaled pictures, the Annex B EL filter for all;
+  //  bilinear yblod's own processing with the bilinear EL pass, for every picture.
+  m_cb1 = masterReference;
+  m_elScaler = m_cb1 ? kElScalerAnnexB : kElScalerBilinear;
+  m_fel = !EnvIs("DV_FEL", "0");
+  m_async = !EnvIs("DV_VULKAN_ASYNC", "0");
+  m_dmOptions = DmOptions();
+  m_device = device;
+  CLog::Log(LOGINFO, "Vulkan engine started ({}): el_scaler={} fel={} async={} cb1_reference={} dm_options={:#x}",
+            library, m_elScaler, m_fel, m_async, m_cb1, m_dmOptions);
+  return true;
+}
+
+void CDVPrivateVulkan::ReleaseGui(Gui& gui)
+{
+  if (gui.framebuffer) glDeleteFramebuffers(1, &gui.framebuffer);
+  if (gui.texture) glDeleteTextures(1, &gui.texture);
+  if (gui.image != EGL_NO_IMAGE_KHR) m_destroyImage(m_display, gui.image);
+  if (gui.fd >= 0) close(gui.fd);
+  if (gui.bo) gbm_bo_destroy(gui.bo);
+  gui = Gui{};
+}
+
+bool CDVPrivateVulkan::InitializeGui(unsigned index)
+{
+  // The engine reads the GUI as a dmabuf, top row first: a linear RGBA8 copy
+  // of Kodi's GUI texture (byte for byte, flipped by the blit when needed).
+  Gui& gui = m_guis[index];
+  m_display = eglGetCurrentDisplay();
+  auto create = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(eglGetProcAddress("eglCreateImageKHR"));
+  m_destroyImage = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(eglGetProcAddress("eglDestroyImageKHR"));
+  using Target = void (*)(GLenum, void*);
+  auto target = reinterpret_cast<Target>(eglGetProcAddress("glEGLImageTargetTexture2DOES"));
+  if (!create || !m_destroyImage || !target || m_display == EGL_NO_DISPLAY) return false;
+  gui.bo = gbm_bo_create(m_device, 3840, 2160, GBM_FORMAT_ABGR8888,
+                         GBM_BO_USE_RENDERING | GBM_BO_USE_LINEAR);
+  if (!gui.bo) return false;
+  gui.fd = gbm_bo_get_fd(gui.bo);
+  if (gui.fd < 0) return false;
+  const uint32_t stride = gbm_bo_get_stride(gui.bo);
+  const EGLint attrs[] = {EGL_WIDTH, 3840, EGL_HEIGHT, 2160, EGL_LINUX_DRM_FOURCC_EXT, DRM_FORMAT_ABGR8888,
+      EGL_DMA_BUF_PLANE0_FD_EXT, gui.fd, EGL_DMA_BUF_PLANE0_OFFSET_EXT, 0,
+      EGL_DMA_BUF_PLANE0_PITCH_EXT, static_cast<EGLint>(stride), EGL_NONE};
+  gui.image = create(m_display, EGL_NO_CONTEXT, EGL_LINUX_DMA_BUF_EXT, nullptr, attrs);
+  if (gui.image == EGL_NO_IMAGE_KHR) return false;
+  GLint texture, draw;
+  glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  glGenTextures(1, &gui.texture);
+  glBindTexture(GL_TEXTURE_2D, gui.texture);
+  target(GL_TEXTURE_2D, gui.image);
+  glBindTexture(GL_TEXTURE_2D, texture);
+  glGenFramebuffers(1, &gui.framebuffer);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, gui.framebuffer);
+  glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, gui.texture, 0);
+  const bool complete = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  if (!complete || glGetError() != GL_NO_ERROR) return false;
+  gui.dmabuf.width = 3840;
+  gui.dmabuf.height = 2160;
+  gui.dmabuf.format = DRM_FORMAT_ABGR8888;
+  gui.dmabuf.modifier = DRM_FORMAT_MOD_LINEAR;
+  gui.dmabuf.num_planes = 1;
+  gui.dmabuf.fd[0] = gui.fd;
+  gui.dmabuf.fd[1] = gui.dmabuf.fd[2] = gui.dmabuf.fd[3] = -1;
+  gui.dmabuf.stride[0] = stride;
+  gui.ready = true;
+  return true;
+}
+
+bool CDVPrivateVulkan::CopyGui(const DVPrivateOverlay& overlay, unsigned index)
+{
+  GLint read, draw;
+  glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &read);
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &draw);
+  const bool scissor = glIsEnabled(GL_SCISSOR_TEST), dither = glIsEnabled(GL_DITHER);
+  glDisable(GL_SCISSOR_TEST);
+  glDisable(GL_DITHER);
+  if (!m_readFramebuffer) glGenFramebuffers(1, &m_readFramebuffer);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, m_readFramebuffer);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, overlay.texture, 0);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, m_guis[index].framebuffer);
+  if (overlay.flipY)
+    glBlitFramebuffer(0, 0, 3840, 2160, 0, 2160, 3840, 0, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  else
+    glBlitFramebuffer(0, 0, 3840, 2160, 0, 0, 3840, 2160, GL_COLOR_BUFFER_BIT, GL_NEAREST);
+  glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+  glBindFramebuffer(GL_READ_FRAMEBUFFER, read);
+  glBindFramebuffer(GL_DRAW_FRAMEBUFFER, draw);
+  if (scissor) glEnable(GL_SCISSOR_TEST);
+  if (dither) glEnable(GL_DITHER);
+  // Flushed, the blit's fence is on the dmabuf; the engine waits for it on the GPU.
+  glFlush();
+  return glGetError() == GL_NO_ERROR;
+}
+
+dvvk_frame CDVPrivateVulkan::Frame(unsigned blSurface, unsigned elSurface, const void* metadata,
+                                   size_t size, int64_t pts, const dv_source_geometry& geometry,
+                                   const dv_source_input& input, bool refresh,
+                                   const DVPrivateOverlay* overlay) const
+{
+  const bool resized = geometry.destination_width &&
+      (geometry.destination_width != geometry.width || geometry.destination_height != geometry.height);
+  dvvk_frame frame{};
+  frame.plan.width = geometry.width;
+  frame.plan.height = geometry.height;
+  frame.plan.x = geometry.x;
+  frame.plan.y = geometry.y;
+  frame.plan.dw = resized ? geometry.destination_width : 0;
+  frame.plan.dh = resized ? geometry.destination_height : 0;
+  frame.plan.chroma_top_left = geometry.chroma_siting == DV_SOURCE_CHROMA_TOP_LEFT;
+  frame.plan.has_el = elSurface != UINT32_MAX;
+  frame.plan.nv12 = input.format == DV_SOURCE_INPUT_NV12;
+  frame.plan.el_scaler = m_elScaler;
+  frame.plan.fel = m_fel;
+  frame.plan.refresh = refresh;
+  // CB1 Master Reference's processing (CroqueMr's CB1, byte for byte): its
+  // siting (DVBridgeGLES chose it for this picture), 4:2:0 reshaping, no
+  // chroma pre-filter, the Annex B EL and 4:2:2 filters, its metadata block
+  // order, L5 and packet ids (the engine's own then). Unscaled pictures only,
+  // as CB1's; scaled ones stay yblod's. Its refresh: the first picture, a
+  // step back or a gap over 0.1 s; a repeated picture keeps its value.
+  if (m_cb1 && !resized)
+  {
+    frame.plan.cb1_contract = 1;
+    frame.plan.el_scaler = kElScalerAnnexB;
+    frame.plan.refresh = !m_cb1Frames ? true
+                         : pts != m_cb1LastPts ? pts < m_cb1LastPts || pts - m_cb1LastPts > 100000
+                                               : m_cb1Refresh;
+  }
+  frame.plan.pts = pts;
+  frame.plan.dm_options = m_dmOptions;
+  // The GUI colour stays that of the last GUI, so hiding it changes no coefficients.
+  const DVPrivateOverlay& colour = overlay ? *overlay : m_gui;
+  std::memcpy(frame.plan.rgb_to_lms, colour.rgbToLms, sizeof(frame.plan.rgb_to_lms));
+  frame.plan.white_nits = colour.whiteNits;
+  frame.bl_surface = blSurface;
+  frame.el_surface = elSurface;
+  frame.metadata = metadata;
+  frame.metadata_size = size;
+  frame.flags = DVVK_FRAME_AUTO_OVERLAY;
+  return frame;
+}
+
+bool CDVPrivateVulkan::Repeats(unsigned blSurface, unsigned elSurface, const void* metadata,
+                               size_t size, int64_t pts, const dv_source_geometry& geometry,
+                               const dv_source_input& input, bool refresh,
+                               const DVPrivateOverlay* overlay) const
+{
+  if (!m_engine || m_failed || !m_last.valid || overlay || m_last.overlay || m_last.overlayBefore ||
+      m_outputMode == DVVK_OUTPUT_HDR10PLUS || WantedOutputMode() != m_outputMode ||
+      m_last.outputMode != m_outputMode)
+    return false;
+  const dvvk_frame frame = Frame(blSurface, elSurface, metadata, size, pts, geometry, input, refresh, nullptr);
+  const dvvk_plan_in& a = frame.plan;
+  const dvvk_plan_in& b = m_last.frame.plan;
+  // Every member of the plan but the packet id (a new member is a new size).
+  static_assert(sizeof(dvvk_plan_in) == 160, "Repeats() compares dvvk_plan_in member by member");
+  return a.width == b.width && a.height == b.height && a.x == b.x && a.y == b.y && a.dw == b.dw &&
+         a.dh == b.dh && a.chroma_top_left == b.chroma_top_left && a.has_el == b.has_el &&
+         a.nv12 == b.nv12 && a.el_scaler == b.el_scaler && a.fel == b.fel && a.refresh == b.refresh &&
+         a.overlay == b.overlay && a.overlay_visible_before == b.overlay_visible_before &&
+         a.pts == b.pts && std::memcmp(a.rgb_to_lms, b.rgb_to_lms, sizeof(a.rgb_to_lms)) == 0 &&
+         a.white_nits == b.white_nits && a.cb1_contract == b.cb1_contract &&
+         a.dm_options == b.dm_options && frame.bl_surface == m_last.frame.bl_surface &&
+         frame.el_surface == m_last.frame.el_surface && frame.flags == m_last.frame.flags &&
+         frame.release_wait == m_last.frame.release_wait && size == m_last.metadata.size() &&
+         std::memcmp(metadata, m_last.metadata.data(), size) == 0;
+}
+
+int CDVPrivateVulkan::Render(unsigned slot, unsigned blSurface, unsigned elSurface,
+                             const void* metadata, size_t size, int64_t pts,
+                             const dv_source_geometry& geometry, const dv_source_input& input,
+                             unsigned packet, bool refresh, const DVPrivateOverlay* overlay)
+{
+  if (!m_engine || m_failed) return DV_VULKAN_FAILED;
+  m_guiDirect = overlay && overlay->dmabufFd >= 0 && m_setOverlayEx && m_implicitFailed;
+  if (m_guiDirect)
+  {
+    // Kodi's GUI framebuffer, read in place. Giving it to the engine says
+    // "new contents": the engine scans it all again and repaints the whole
+    // canvas. When GL has not touched the buffer since the engine was given
+    // it (Kodi skipped its GUI pass: no draw, no clear), the engine is not
+    // told again and keeps its scan and its damage.
+    static const bool skipUnchanged = !EnvIs("DV_PRIVATE_GUI_UNCHANGED_SKIP", "0");
+    const bool unchanged = skipUnchanged && m_guiShown && m_guiDirectSet &&
+                           overlay->writes == m_gui.writes && overlay->texture == m_gui.texture &&
+                           overlay->flipY == m_gui.flipY && overlay->dmabufFd == m_gui.dmabufFd &&
+                           overlay->dmabufFormat == m_gui.dmabufFormat &&
+                           overlay->dmabufStride == m_gui.dmabufStride &&
+                           overlay->dmabufOffset == m_gui.dmabufOffset &&
+                           overlay->dmabufModifier == m_gui.dmabufModifier;
+    if (!unchanged)
+    {
+      // Flushed, the GUI's writes are fenced on the buffer, and the engine's
+      // read fence on it makes the next GUI drawing wait on the GPU.
+      glFlush();
+      dvvk_dmabuf gui{};
+      gui.width = 3840;
+      gui.height = 2160;
+      gui.format = overlay->dmabufFormat;
+      gui.modifier = overlay->dmabufModifier;
+      gui.num_planes = 1;
+      gui.fd[0] = overlay->dmabufFd;
+      gui.fd[1] = gui.fd[2] = gui.fd[3] = -1;
+      gui.offset[0] = overlay->dmabufOffset;
+      gui.stride[0] = overlay->dmabufStride;
+      if (m_setOverlayEx(m_engine, &gui, ++m_guiId, DVVK_OVERLAY_FLIP_Y) != 0)
+      {
+        m_guiShown = m_guiDirectSet = false;
+        return -1;
+      }
+    }
+    m_gui = *overlay;
+    m_guiShown = m_guiDirectSet = true;
+  }
+  else if (overlay)
+  {
+    // A nonzero revision names unchanged contents; without one, copy every frame.
+    if (!m_guiShown || !overlay->SameContents(m_gui))
+    {
+      // Into the other copy, once the last frame that read it is done.
+      const unsigned next = m_guiShown ? m_guiIndex ^ 1u : m_guiIndex;
+      if (m_guis[next].ticket && Done(m_guis[next].ticket, pts, true) != 1) return DV_VULKAN_FAILED;
+      m_guiDirectSet = false;
+      // The copies exist only on this path: 33 MB each that a GUI read in
+      // place never needs.
+      if (!m_guis[next].ready && !InitializeGui(next))
+      {
+        ReleaseGui(m_guis[next]);
+        m_guiShown = false;
+        return -1;
+      }
+      if (!CopyGui(*overlay, next) || m_setOverlay(m_engine, &m_guis[next].dmabuf, ++m_guiId) != 0)
+      {
+        m_guiShown = false;
+        return -1;
+      }
+      m_guiIndex = next;
+      m_gui = *overlay;
+      m_guiShown = true;
+    }
+  }
+  else if (m_guiShown)
+  {
+    if (m_setOverlay(m_engine, nullptr, 0) != 0) return -1;
+    m_guiShown = m_guiDirectSet = false;
+  }
+  dvvk_frame frame = Frame(blSurface, elSurface, metadata, size, pts, geometry, input, refresh, overlay);
+  frame.plan.packet_id = packet;
+  frame.output = slot;
+  const bool cb1 = frame.plan.cb1_contract != 0;
+  if (cb1)
+    m_cb1Refresh = frame.plan.refresh != 0;
+  uint64_t ticket = 0;
+  SelectOutputMode();
+  const int result = m_submit(m_engine, &frame, &ticket);
+  if (result == 0)
+  {
+    PublishSignal(pts);
+    PublishHDR10Plus(ticket, pts);
+  }
+  if (result != 0)
+  {
+    if (m_reports < 16)
+    {
+      ++m_reports;
+      CLog::Log(LOGWARNING, "Vulkan engine {} frame pts={} ({}): {}x{}{} at {},{}",
+                result == -2 ? "does not take this" : "failed on", pts, result,
+                geometry.width, geometry.height, frame.plan.has_el ? " + EL" : "", geometry.x, geometry.y);
+    }
+    return result;
+  }
+  m_ticket = ticket;
+  m_last.overlayBefore = m_last.overlay;
+  m_last.overlay = m_guiShown;
+  m_last.frame = frame;
+  m_last.frame.metadata = nullptr;
+  m_last.metadata.assign(static_cast<const unsigned char*>(metadata),
+                         static_cast<const unsigned char*>(metadata) + size);
+  m_last.outputMode = m_outputMode;
+  m_last.valid = true;
+  if (m_dmOptions && m_dmStatus)
+  {
+    // CM4 / L2 per frame: logged when it changes.
+    const uint32_t status = m_dmStatus(m_engine);
+    if (status != m_lastDmStatus && m_dmReports < 16)
+    {
+      ++m_dmReports;
+      CLog::Log(LOGINFO, "Vulkan engine CM4 pts={}: status {} ({}), {} L2 blocks removed", pts, status & 0xffu,
+                (status & 0xffu) == DVVK_CM4_STATUS_APPENDED ? "appended" : "as the stream has it",
+                (status >> 8) & 0xffu);
+    }
+    m_lastDmStatus = status;
+  }
+  if (cb1)
+  {
+    m_cb1LastPts = pts;
+    ++m_cb1Frames;
+  }
+  if (m_guiShown && !m_guiDirect) m_guis[m_guiIndex].ticket = ticket;
+  // Without implicit fences (an older kernel) nothing waits for the frame on
+  // the GPU: the commit would show an unfinished buffer, and Kodi could draw
+  // into the GUI framebuffer before the engine has read it. Each ticket is
+  // waited for here instead.
+  const bool fenced = !m_implicitFailed || !m_implicitFailed(m_engine);
+  if (m_async && fenced) return 0;
+  // Synchronous: written means GPU complete, and an out-of-range sample
+  // rejects the picture, as with the OpenCL engine.
+  bool range = false;
+  const int done = Complete(ticket, pts, true, range);
+  if (done != 1) return DV_VULKAN_FAILED;
+  return range ? -4 : 0;
+}
+
+int CDVPrivateVulkan::Done(uint64_t ticket, int64_t pts, bool wait)
+{
+  bool range = false;
+  return Complete(ticket, pts, wait, range);
+}
+
+int CDVPrivateVulkan::Complete(uint64_t ticket, int64_t pts, bool wait, bool& range)
+{
+  if (!m_engine) return DV_VULKAN_FAILED;
+  if (wait && m_wait(m_engine, ticket, 2000000000ull) != 1)
+  {
+    CLog::Log(LOGERROR, "Vulkan engine frame pts={} did not complete", pts);
+    return DV_VULKAN_FAILED;
+  }
+  int done = 0;
+  uint32_t flags = 0;
+  if (m_poll(m_engine, ticket, &done, &flags) != 0) return DV_VULKAN_FAILED;
+  if (!done) return wait ? DV_VULKAN_FAILED : 0;
+  range = (flags & 3u) != 0;
+  if (range && m_rangeReports < 16)
+  {
+    // Submitted without waiting, the picture is already on its way to the display.
+    ++m_rangeReports;
+    CLog::Log(LOGERROR, "Vulkan engine range check failed pts={} flags={:#x}{}", pts, flags,
+              m_async ? " (already presented)" : "");
+  }
+  if ((flags & 0x100u) && m_colourReports < 8)
+  {
+    ++m_colourReports;
+    CLog::Log(LOGWARNING, "Vulkan engine: overlay colour out of range, shown clamped (pts={})", pts);
+  }
+  return 1;
+}
+
+void CDVPrivateVulkan::Reset()
+{
+  // Drains, then drops the surface imports; a failure leaves the engine
+  // unusable (its imports kept) until it is closed.
+  if (m_engine && !m_failed)
+  {
+    if (!m_resetChecked)
+      m_reset(m_engine);
+    else if (m_resetChecked(m_engine, 2000000000ull) != 1)
+    {
+      m_failed = true;
+      CLog::Log(LOGERROR, "Vulkan engine reset failed: the engine stops for this playback");
+    }
+  }
+  m_last.valid = false;
+  // CB1's refresh rule starts over: the next picture is a first one.
+  m_cb1Frames = 0;
+  m_cb1LastPts = 0;
+  m_cb1Refresh = true;
+  m_reports = 0;
+  m_lastDmStatus = UINT32_MAX;
+  m_dmReports = 0;
+  m_hdr10PlusCoverage = m_hdr10PlusReason = UINT32_MAX;
+  m_hdr10PlusReports = 0;
+}
+
+bool CDVPrivateVulkan::Close()
+{
+  if (m_engine)
+  {
+    // All submitted work, also a frame that failed without a ticket; until
+    // then the engine and its inputs stay.
+    if (m_drain ? m_drain(m_engine, 2000000000ull) != 1
+                : m_ticket && m_wait(m_engine, m_ticket, 2000000000ull) != 1)
+      return false;
+    m_destroy(m_engine);
+    m_engine = nullptr;
+    // an engine made again starts in Dolby Vision
+    m_outputMode = DVVK_OUTPUT_DV;
+    DVBRIDGE::PublishTunnelHDR10(nullptr);
+    DVBRIDGE::PublishTunnelHDR10Plus({});
+  }
+  for (Gui& gui : m_guis)
+    ReleaseGui(gui);
+  if (m_readFramebuffer) glDeleteFramebuffers(1, &m_readFramebuffer);
+  m_readFramebuffer = 0;
+  m_guiIndex = 0;
+  m_ticket = 0;
+  m_guiShown = m_guiDirectSet = false;
+  m_last = Submitted{};
+  m_failed = false;
+  if (m_library) dlclose(m_library);
+  m_library = nullptr;
+  return true;
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.h b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.h
new file mode 100644
index 0000000..8670562
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/DVPrivateVulkan.h
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#pragma once
+#include "source_geometry.h"
+#include "source_input.h"
+#include "DVPrivateOverlay.h"
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <gbm.h>
+#include <dv-engine-vk/dv_engine_vk.h>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+/* yblod's engine on Vulkan compute (DVVK_LIBRARY, yblod-engine/vk), YBLOD's
+ * only Dolby Vision renderer. It writes the private scanout buffers itself
+ * and reads the GUI in place (or from a GBM copy of Kodi's GUI texture).
+ * Frames are submitted without waiting (DV_VULKAN_ASYNC=0 waits for each):
+ * the engine puts the frame's fence on the scanout buffer as an implicit
+ * write fence, which the atomic commit waits for, and the caller keeps the
+ * decoded surfaces until Done() reports the ticket complete. */
+class CDVPrivateVulkan
+{
+public:
+  static constexpr int DV_VULKAN_FAILED = -8; // dv_status DV_BACKEND
+  /* dvvk_plan_in.el_scaler (ABI 3): the enhancement layer upscale. Annex B
+   * (the Master Reference filters; forced by cb1_contract) or bilinear. */
+  static_assert(DVVK_ABI_VERSION == 3, "Kodi's el_scaler values are those of engine ABI 3");
+  static constexpr uint32_t kElScalerAnnexB = DVVK_EL_ANNEXB;
+  static constexpr uint32_t kElScalerBilinear = DVVK_EL_BILINEAR;
+  /* The engine library loads with Kodi's ABI and has not failed to start. */
+  static bool Usable();
+  /* The engine library has HDR10 output (dvvk_set_output_mode and
+   * dvvk_output_signal, optional symbols): checked once, by loading it. */
+  static bool HasHDR10();
+  /* ... and HDR10+ output (dvvk_hdr10plus_packet, optional symbol). */
+  static bool HasHDR10Plus();
+  /* Enhancement layer upscaling Annex B (Master Reference), not Bilinear:
+   * the setting as it is now. An engine keeps the value it started with
+   * (CDVPrivateSource::MasterReference). */
+  static bool MasterReference();
+  /* The engine did not start, or failed more often than it may be started
+   * again: the current title restarts as plain base-layer playback, and the
+   * next title tries the engine again. After three such titles in a Kodi run
+   * the engine stays off until Kodi restarts, with one notification. */
+  static void StartFailed();
+  /* The window's view of playback, for StartFailed(): a video configured its
+   * output, and no video is playing any more. */
+  static void VideoConfigured();
+  static void PlaybackIdle();
+  bool Initialize(void* vaDisplay, int drmFd, gbm_device* device, gbm_bo* const* outputs,
+                  unsigned count, bool masterReference);
+  /* 0 the picture is in the slot (submitted; Ticket() names it); -2 not this
+   * engine's frame (ordinary picture); -8 the engine or a wait failed
+   * (outputs uncertain); other negative: rejected, nothing written. */
+  int Render(unsigned slot, unsigned blSurface, unsigned elSurface, const void* metadata,
+             size_t size, int64_t pts, const dv_source_geometry& geometry,
+             const dv_source_input& input, unsigned packet, bool refresh,
+             const DVPrivateOverlay* overlay);
+  /* A frame from these inputs would be the frame last submitted over again:
+   * the same surfaces, plan, metadata bytes and output mode, without an
+   * overlay in it or in the frame before it (the engine marks overlay edges
+   * in the metadata). refresh is the flag the next slot would carry. The
+   * packet id is left out: CB1's processing advances it only when the
+   * payload changes, and yblod's own would send the next id with the same
+   * payload, where holding the picture sends the same id again, as CB1 does.
+   * Never in HDR10+: a picture's packet carries the statistics of the
+   * picture before it until its own are measured. */
+  bool Repeats(unsigned blSurface, unsigned elSurface, const void* metadata, size_t size,
+               int64_t pts, const dv_source_geometry& geometry, const dv_source_input& input,
+               bool refresh, const DVPrivateOverlay* overlay) const;
+  bool Async() const { return m_async; }
+  uint64_t Ticket() const { return m_ticket; }
+  /* 1 frame `ticket` is complete (its error flags logged), 0 still running
+   * (with wait, after the timeout), -8 failure. */
+  int Done(uint64_t ticket, int64_t pts, bool wait);
+  void Reset();
+  /* A reset did not complete: the engine takes no more frames until Close(). */
+  bool Failed() const { return m_failed; }
+  bool Close();
+private:
+  bool InitializeGui(unsigned index);
+  bool CopyGui(const DVPrivateOverlay& overlay, unsigned index);
+  int Complete(uint64_t ticket, int64_t pts, bool wait, bool& range);
+  // The frame these inputs make (the output slot and packet id are the
+  // caller's); changes nothing.
+  dvvk_frame Frame(unsigned blSurface, unsigned elSurface, const void* metadata, size_t size,
+                   int64_t pts, const dv_source_geometry& geometry, const dv_source_input& input,
+                   bool refresh, const DVPrivateOverlay* overlay) const;
+  // The frame last submitted, for Repeats().
+  struct Submitted
+  {
+    bool valid{false};
+    dvvk_frame frame{};
+    std::vector<unsigned char> metadata;
+    uint32_t outputMode{DVVK_OUTPUT_DV};
+    bool overlay{false}, overlayBefore{false};
+  } m_last;
+  void* m_library{nullptr};
+  dvvk_engine* m_engine{nullptr};
+  decltype(&dvvk_create) m_create{nullptr};
+  decltype(&dvvk_set_output) m_setOutput{nullptr};
+  decltype(&dvvk_set_overlay) m_setOverlay{nullptr};
+  decltype(&dvvk_submit) m_submit{nullptr};
+  decltype(&dvvk_poll) m_poll{nullptr};
+  decltype(&dvvk_wait) m_wait{nullptr};
+  decltype(&dvvk_reset) m_reset{nullptr};
+  decltype(&dvvk_destroy) m_destroy{nullptr};
+  decltype(&dvvk_set_overlay_ex) m_setOverlayEx{nullptr};     // optional
+  decltype(&dvvk_implicit_failed) m_implicitFailed{nullptr};  // optional
+  decltype(&dvvk_drain) m_drain{nullptr};                     // optional
+  decltype(&dvvk_reset_checked) m_resetChecked{nullptr};      // optional
+  decltype(&dvvk_dm_status) m_dmStatus{nullptr};              // optional
+  decltype(&dvvk_set_output_mode) m_setOutputMode{nullptr};    // optional (HDR10 output)
+  decltype(&dvvk_output_signal) m_outputSignal{nullptr};       // optional (HDR10 output)
+  decltype(&dvvk_hdr10plus_packet) m_hdr10PlusPacket{nullptr}; // optional (HDR10+ output)
+  // The output mode the engine has (DVVK_OUTPUT_*): DVBRIDGE::playbackTunnelHDR10
+  // for each frame, and the last HDR10 signal logged.
+  uint32_t m_outputMode{DVVK_OUTPUT_DV};
+  uint32_t WantedOutputMode() const;
+  void SelectOutputMode();
+  void PublishSignal(int64_t pts);
+  // HDR10+ output: the frame's packet for the window (DVBRIDGE::PublishTunnelHDR10Plus).
+  void PublishHDR10Plus(uint64_t ticket, int64_t pts);
+  uint32_t m_hdr10PlusCoverage{UINT32_MAX}, m_hdr10PlusReason{UINT32_MAX};
+  unsigned m_hdr10PlusReports{0};
+  dvvk_hdr_signal m_loggedSignal{};
+  // Two GUI copies, made when the GUI framebuffer cannot be read in place:
+  // a new GUI goes into the one no frame in flight reads.
+  struct Gui
+  {
+    gbm_bo* bo{nullptr};
+    EGLImageKHR image{EGL_NO_IMAGE_KHR};
+    unsigned texture{0}, framebuffer{0};
+    int fd{-1};
+    dvvk_dmabuf dmabuf{};
+    uint64_t ticket{0}; // the last frame submitted reading it
+    bool ready{false};
+  } m_guis[2];
+  void ReleaseGui(Gui& gui);
+  gbm_device* m_device{nullptr};
+  EGLDisplay m_display{EGL_NO_DISPLAY};
+  PFNEGLDESTROYIMAGEKHRPROC m_destroyImage{nullptr};
+  unsigned m_readFramebuffer{0}, m_guiIndex{0};
+  DVPrivateOverlay m_gui{};
+  bool m_guiShown{false}, m_async{true};
+  bool m_guiDirect{false}; // the engine reads Kodi's GUI framebuffer in place
+  bool m_guiDirectSet{false}; // ... and m_gui is the buffer it was last given
+  uint64_t m_guiId{0}, m_ticket{0};
+  unsigned m_elScaler{kElScalerAnnexB}, m_reports{0}, m_colourReports{0}, m_rangeReports{0};
+  bool m_fel{true};
+  bool m_failed{false}; // a checked reset failed: no more frames until Close
+  // CM4 / L2 options for every frame (DV_VULKAN_CM4, DV_VULKAN_NO_L2), and
+  // the last result reported.
+  uint32_t m_dmOptions{0}, m_lastDmStatus{UINT32_MAX};
+  unsigned m_dmReports{0};
+  // CB1 Master Reference's processing for unscaled pictures (enhancement
+  // layer upscaling Annex B) and its metadata refresh rule over the pictures
+  // handed to the engine.
+  bool m_cb1{false}, m_cb1Refresh{true};
+  int64_t m_cb1LastPts{0};
+  uint64_t m_cb1Frames{0};
+};
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/dv_scanout_slots.cpp b/xbmc/cores/VideoPlayer/VideoRenderers/dv_scanout_slots.cpp
new file mode 100644
index 0000000..a31660f
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/dv_scanout_slots.cpp
@@ -0,0 +1,169 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* The private scanout buffers' ownership (dv_scanout_slots.h), in Kodi
+ * itself: yblod-engine/src/dv_scanout_slots.c, which the OpenCL engine
+ * library exported, unchanged in behaviour. The Vulkan engine only writes
+ * the buffers; this bookkeeping was always the caller's. */
+#include "dv_scanout_slots.h"
+
+#include <cstring>
+
+namespace
+{
+// dv_status (yblod-engine/src/dv_engine.h)
+constexpr int DV_OK = 0;
+constexpr int DV_INVALID = -1;
+constexpr int DV_IDENTITY = -6;
+constexpr int DV_BACKEND = -8;
+
+bool Matches(const dv_scanout_slots* p, const dv_scanout_lease* l)
+{
+  return l && l->serial == p->pending.serial && l->slot == p->pending.slot &&
+         l->identity.frame_id == p->pending.identity.frame_id &&
+         l->identity.pts == p->pending.identity.pts && l->packet_id == p->pending.packet_id &&
+         l->refresh == p->pending.refresh;
+}
+} // namespace
+
+extern "C"
+{
+void dv_scanout_slots_init(dv_scanout_slots* p)
+{
+  std::memset(p, 0, sizeof(*p));
+  p->current = -1;
+  p->queued = -1;
+  p->refresh = 1;
+}
+
+int dv_scanout_slots_acquire(dv_scanout_slots* p, dv_scanout_identity id, dv_scanout_lease* out)
+{
+  if (!p || !out)
+    return DV_INVALID;
+  if (p->quarantined)
+    return DV_BACKEND;
+  if (p->writing || p->ready)
+    return DV_SCANOUT_BUSY;
+  if (p->serial == UINT64_MAX)
+    return DV_BACKEND;
+  unsigned slot = 0;
+  while (static_cast<int>(slot) == p->current || static_cast<int>(slot) == p->queued)
+    ++slot;
+  const dv_scanout_lease lease{++p->serial, id, slot, p->packet_id, p->refresh};
+  p->pending = lease;
+  p->writing = 1;
+  *out = lease;
+  return DV_OK;
+}
+
+int dv_scanout_slots_written(dv_scanout_slots* p, const dv_scanout_lease* l,
+                             dv_scanout_outcome result)
+{
+  if (!p || result < DV_SCANOUT_REJECTED || result > DV_SCANOUT_UNCERTAIN)
+    return DV_INVALID;
+  if (p->quarantined)
+    return DV_BACKEND;
+  if (!p->writing || !Matches(p, l))
+    return DV_IDENTITY;
+  if (result == DV_SCANOUT_UNCERTAIN)
+  {
+    p->quarantined = 1;
+    return DV_BACKEND;
+  }
+  p->writing = 0;
+  p->ready = result == DV_SCANOUT_ACCEPTED;
+  if (!p->ready)
+    p->refresh = 1;
+  return DV_OK;
+}
+
+int dv_scanout_slots_committed(dv_scanout_slots* p, const dv_scanout_lease* l,
+                               dv_scanout_outcome result)
+{
+  if (!p || result < DV_SCANOUT_REJECTED || result > DV_SCANOUT_UNCERTAIN)
+    return DV_INVALID;
+  if (p->quarantined)
+    return DV_BACKEND;
+  if (!p->ready || !Matches(p, l))
+    return DV_IDENTITY;
+  if (result == DV_SCANOUT_UNCERTAIN)
+  {
+    p->quarantined = 1;
+    return DV_BACKEND;
+  }
+  if (result == DV_SCANOUT_ACCEPTED && p->queued >= 0)
+    return DV_SCANOUT_BUSY;
+  p->ready = 0;
+  if (result == DV_SCANOUT_ACCEPTED)
+  {
+    p->current = static_cast<int>(l->slot);
+    p->packet_id = (p->packet_id + 1) & 15u;
+    p->refresh = 0;
+  }
+  else
+    p->refresh = 1;
+  return DV_OK;
+}
+
+int dv_scanout_slots_queue(dv_scanout_slots* p, const dv_scanout_lease* l)
+{
+  if (!p)
+    return DV_INVALID;
+  if (p->quarantined)
+    return DV_BACKEND;
+  if (!p->ready || !Matches(p, l))
+    return DV_IDENTITY;
+  if (p->queued >= 0)
+    return DV_SCANOUT_BUSY;
+  p->ready = 0;
+  p->queued = static_cast<int>(l->slot);
+  p->packet_id = (p->packet_id + 1) & 15u;
+  p->refresh = 0;
+  return DV_OK;
+}
+
+int dv_scanout_slots_flipped(dv_scanout_slots* p)
+{
+  if (!p)
+    return DV_INVALID;
+  if (p->quarantined)
+    return DV_BACKEND;
+  if (p->queued < 0)
+    return DV_IDENTITY;
+  p->current = p->queued;
+  p->queued = -1;
+  return DV_OK;
+}
+
+int dv_scanout_slots_reset_stream(dv_scanout_slots* p)
+{
+  if (!p)
+    return DV_INVALID;
+  if (p->quarantined)
+    return DV_BACKEND;
+  if (p->writing)
+    return DV_SCANOUT_BUSY;
+  p->ready = 0;
+  p->packet_id = 0;
+  p->refresh = 1;
+  return DV_OK;
+}
+
+void dv_scanout_slots_drained(dv_scanout_slots* p)
+{
+  p->quarantined = 0;
+  p->writing = 0;
+  p->ready = 0;
+  p->refresh = 1;
+}
+
+void dv_scanout_slots_restored(dv_scanout_slots* p)
+{
+  const uint64_t serial = p->serial;
+  dv_scanout_slots_init(p);
+  p->serial = serial;
+}
+
+int dv_scanout_slots_can_destroy(const dv_scanout_slots* p)
+{
+  return p && p->current < 0 && p->queued < 0 && !p->writing && !p->ready && !p->quarantined;
+}
+}
diff --git a/xbmc/cores/VideoPlayer/VideoRenderers/dv_scanout_slots.h b/xbmc/cores/VideoPlayer/VideoRenderers/dv_scanout_slots.h
new file mode 100644
index 0000000..a428dfd
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/VideoRenderers/dv_scanout_slots.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef DV_SCANOUT_SLOTS_H
+#define DV_SCANOUT_SLOTS_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum {DV_SCANOUT_BUSY=1};
+typedef enum {DV_SCANOUT_REJECTED=0,DV_SCANOUT_ACCEPTED=1,DV_SCANOUT_UNCERTAIN=2} dv_scanout_outcome;
+typedef struct {uint64_t frame_id;int64_t pts;} dv_scanout_identity;
+typedef struct {
+    uint64_t serial;
+    dv_scanout_identity identity;
+    unsigned slot,packet_id,refresh;
+} dv_scanout_lease;
+typedef struct {
+    uint64_t serial;
+    dv_scanout_lease pending;
+    int current,writing,ready,quarantined;
+    unsigned packet_id,refresh;
+    int queued; /* slot of a queued flip the display has not completed, or -1 */
+} dv_scanout_slots;
+/* Single render-thread bookkeeping, no allocation or implicit GPU/KMS waits.
+ * Two externally owned BOs, or three for a caller that queues flips
+ * (dv_scanout_slots_queue): slot 2 is only ever leased while one BO is on
+ * screen and another is queued. Initialize once before any is used. */
+void dv_scanout_slots_init(dv_scanout_slots *);
+/* The lease's slot is neither the one on screen nor the one queued. */
+int dv_scanout_slots_acquire(dv_scanout_slots *,dv_scanout_identity,dv_scanout_lease *);
+/* ACCEPTED certifies GPU completion AND release of producer ownership.
+ * REJECTED certifies all attempted writes have drained. Otherwise UNCERTAIN. */
+int dv_scanout_slots_written(dv_scanout_slots *,const dv_scanout_lease *,dv_scanout_outcome);
+/* ACCEPTED means a successful BLOCKING replacement commit, not a queued flip
+ * (DV_SCANOUT_BUSY while one is queued: it completes first).
+ * REJECTED means old scanout is unchanged. Unknown outcomes quarantine both BOs. */
+int dv_scanout_slots_committed(dv_scanout_slots *,const dv_scanout_lease *,dv_scanout_outcome);
+/* The display took the ready BO in a non-blocking commit: it will be scanned
+ * out, but is not yet, and the BO on screen stays there until then. One flip
+ * at a time: DV_SCANOUT_BUSY while another is queued. The packet id advances
+ * as with an accepted blocking commit. */
+int dv_scanout_slots_queue(dv_scanout_slots *,const dv_scanout_lease *);
+/* The queued flip completed: its BO is the one on screen. DV_IDENTITY when
+ * none is queued. */
+int dv_scanout_slots_flipped(dv_scanout_slots *);
+/* Stream reset retains current display ownership, and a queued flip. Pending
+ * writes must first finish/drain; ready but uncommitted output may be discarded. */
+int dv_scanout_slots_reset_stream(dv_scanout_slots *);
+/* Caller certifies every producer of the BOs has drained and is gone (the
+ * engine was destroyed): a write in progress or left uncertain is over and
+ * counts as rejected, and the quarantine it caused is lifted. What the display
+ * scans out, or has queued, is unchanged. */
+void dv_scanout_slots_drained(dv_scanout_slots *);
+/* Caller certifies external scanout was restored and all GPU work drained.
+ * Preserves serial so pre-reset leases cannot authorize a later frame. */
+void dv_scanout_slots_restored(dv_scanout_slots *);
+int dv_scanout_slots_can_destroy(const dv_scanout_slots *);
+#ifdef __cplusplus
+}
+#endif
+#endif
