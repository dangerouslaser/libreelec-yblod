+bool CDVPrivateVulkan::HasScaler()
+{
+  static std::once_flag probed;
+  static bool has = false;
+  if (!Usable())
+    return false;
+  std::call_once(probed, [] {
+    const char* library = std::getenv("DV_VULKAN_ENGINE_LIBRARY");
+    if (!library || !library[0]) library = DVVK_LIBRARY;
+    void* handle = dlopen(library, RTLD_NOW | RTLD_LOCAL);
+    if (!handle)
+      return;
+    has = dlsym(handle, "dvvk_set_scaler") != nullptr;
+    dlclose(handle);
+    CLog::Log(LOGINFO, "Vulkan engine {}: upscaler {}", library, has ? "available" : "not available");
+  });
+  return has;
+}
+
+bool DVBRIDGE::UpscalerAvailable(const std::string& /*condition*/, const std::string& /*value*/,
+                                 const std::shared_ptr<const CSetting>& /*setting*/)
+{
+  // (also shown while one is saved without the upscaler, so it can be set back)
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  return CDVPrivateVulkan::HasScaler() || settings->GetInt("dvbridge.upscalerhd") != 0 ||
+         settings->GetInt("dvbridge.upscalersd") != 0;
+}
+
+namespace
+{
+// DV_UPSCALER, DV_UPSCALER_SD: bilinear (the default), fsr1 (EASU) or fsr1-sharp (EASU, then
+// RCAS).
+uint32_t ScalerFromEnv(const char* variable)
+{
+  if (EnvIs(variable, "fsr1"))
+    return DVVK_SCALER_FSR1_EASU;
+  if (EnvIs(variable, "fsr1-sharp"))
+    return DVVK_SCALER_FSR1_RCAS;
+  if (const char* value = std::getenv(variable); value && value[0] && std::strcmp(value, "bilinear"))
+    CLog::Log(LOGWARNING, "Vulkan engine: {}={} is not bilinear, fsr1 or fsr1-sharp; bilinear",
+              variable, value);
+  return DVVK_SCALER_BILINEAR;
+}
+
+const char* ScalerName(uint32_t method)
+{
+  return method == DVVK_SCALER_FSR1_RCAS   ? "FSR 1 + sharpening (RCAS)"
+         : method == DVVK_SCALER_FSR1_EASU ? "FSR 1 (EASU)"
+                                           : "bilinear";
+}
+} // namespace
+
+void CDVPrivateVulkan::SelectScaler(const dv_source_geometry& geometry)
+{
+  // 1080p and above: 1920 wide or 1080 high (a 1920x800 film too), as CroqueMr's CB1 sorts them.
+  const bool large = geometry.width >= 1920 || geometry.height >= 1080;
+  uint32_t& want = large ? m_scalerLarge : m_scalerSmall;
+  if (want == m_scaler)
+    return;
+  const int result = m_setScaler ? m_setScaler(m_engine, want) : -2;
+  if (result != 0)
+  {
+    // Not another method in its place: the one the engine has, and not asked again.
+    CLog::Log(LOGERROR, "Vulkan engine: this library has no upscaler {} ({}); {} stays",
+              ScalerName(want), result, ScalerName(m_scaler));
+    want = m_scaler;
+    return;
+  }
+  m_scaler = want;
+  CLog::Log(LOGINFO, "Vulkan engine upscaler: {} for enlarged pictures of {} sources",
+            ScalerName(m_scaler), large ? "1080p and larger" : "smaller");
+}
