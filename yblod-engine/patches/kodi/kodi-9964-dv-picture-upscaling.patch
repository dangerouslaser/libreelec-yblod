   SelectOutputMode();
+  SelectScaler(geometry);
   // The display's signal is the window's (the tunnel, or an ordinary picture for SDR): a
   // picture of the other kind is never written, whatever kept the engine from changing.
   if ((m_outputMode == DVVK_OUTPUT_SDR) != (WantedOutputMode() == DVVK_OUTPUT_SDR) ||
@@ -904,6 +984,15 @@ int CDVPrivateVulkan::Render(unsigned slot, unsigned blSurface, unsigned elSurfa
   if (result == 0)
   {
     DVBRIDGE::pictureSDRBT2020.store(m_outputMode == DVVK_OUTPUT_SDR && m_outputBT2020);
+    // The upscaler the engine used (scaler.rs effective): an enlarged picture's, neither side
+    // smaller (a resized plan is never the source's own size).
+    const bool enlarged = frame.plan.dw && frame.plan.dw >= frame.plan.width &&
+                          frame.plan.dh >= frame.plan.height;
+    CDVPlaybackInfo::upscaler.store(
+        !enlarged ? 0u
+        : CDVPlaybackInfo::ENLARGED | (m_scaler == DVVK_SCALER_FSR1_RCAS   ? CDVPlaybackInfo::RCAS
+                                       : m_scaler == DVVK_SCALER_FSR1_EASU ? CDVPlaybackInfo::FSR1
+                                                                           : 0u));
     PublishSignal(pts);
     PublishHDR10Plus(ticket, pts);
   }
@@ -1036,6 +1125,7 @@ bool CDVPrivateVulkan::Close()
     m_outputHLG = false;
     m_outputBT2020 = false;
     DVBRIDGE::pictureSDRBT2020.store(false);
+    CDVPlaybackInfo::upscaler.store(0);
     DVBRIDGE::PublishTunnelHDR10(nullptr);
     DVBRIDGE::PublishTunnelHDR10Plus({});
   }
