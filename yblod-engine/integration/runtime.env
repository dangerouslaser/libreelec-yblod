# Kodi's Dolby Vision environment, installed by yblod-engine-vk as
# /usr/lib/kodi/native-dv.env; /storage/.config/native-dv.env overrides it.
# YBLOD 0.4.0: the Vulkan engine is the only Dolby Vision engine. Every
# variable below is read by Kodi's adapter or the engine (audited from the
# code, not from older files); Settings > Player > Dolby Vision sets the
# ones it shows (DVEngineSettings.h) and takes precedence over this file.

# The engine library (DVVK_LIBRARY when unset).
DV_VULKAN_ENGINE_LIBRARY=/usr/lib/libdv_engine_vk.so.1
# 0: wait for each frame before presenting it (the commit waits for its fence otherwise).
DV_VULKAN_ASYNC=1
# The engine imports each decoded surface once and then knows it by its id
# (no VA export per frame). Kodi's adapter resets it when either layer's
# surfaces come from another pool (CDVPrivateSource::PoolChanged). 1: the
# engine also exports every surface every frame and compares (the 0.4
# behaviour, for a suspected stale picture).
DVVK_SURFACE_CHECK=0

# Settings > Player > Dolby Vision > Video
# Enhancement layer upscaling: annexb (Annex B with CB1 Master Reference's
# processing for unscaled pictures) or bilinear (yblod's own processing).
DV_EL_SCALER=annexb
# Dolby Vision metadata: off (Original), auto2 (CM4.0 auto: the TV's peak,
# from DV_VULKAN_TV_PEAK or the EDID; auto by a 1000-nit mastering trigger
# without one), always (CM4.0 always); also no-l2 and auto. Tunables
# DV_VULKAN_CM4_TRIGGER (auto: source, 1000, 2000, 4000, 10000) and
# DV_VULKAN_CM4_HEADROOM (auto2: 0-50 %, default 20).
DV_VULKAN_CM4=off
# Remove L2 trims.
DV_VULKAN_NO_L2=0
# TV peak brightness in nits; 0: from the TV's EDID.
DV_VULKAN_TV_PEAK=0

# Presentation (Kodi's adapter and window)
# A picture asked for again unchanged (a pause, 24p on a 60 Hz mode) stays on
# screen: nothing rendered, nothing committed. 0: rendered every refresh.
DV_PRIVATE_SKIP_REPEATS=1
# The engine is given the GUI buffer again only when Kodi drew into it (it
# keeps its tile scan and damage otherwise). 0: on every frame.
DV_PRIVATE_GUI_UNCHANGED_SKIP=1
# 1: stable pictures are committed without blocking (a third scanout buffer,
# one flip queued, one refresh more latency, compensated; no TEST_ONLY commit
# before strict commits), so Kodi's work on a picture and the GPU's overlap.
# Tested on an Intel N150 (0.5.0-t2: 247,800 queued flips, none busy or timed out,
# verified pictures; 60p Dolby Vision 40.5 -> 56 fps, FEL with the OSD open holds
# 24 fps). Off by default until it has been seen on a TV and run on AMD; set 1 in
# /storage/.config/native-dv.env to use it. See integration/README.md.
DV_PRIVATE_NONBLOCK=0
# 1: one log line per queued flip (a summary every 600 flips is always logged).
DV_PRIVATE_FLIP_TRACE=0

# Playback start and end (Kodi)
DV_PRIVATE_DRAIN_EOF=1
DV_PRIVATE_STARTUP_COMMIT=1
DV_PRIVATE_STARTUP_FULLSCREEN=1
DV_PRIVATE_STARTUP_LATENCY=1
DV_PRIVATE_STARTUP_RESYNC=1

# Settings > Player > Dolby Vision > Performance (Kodi's GUI over the video)
DV_PRIVATE_GUI_CACHE=1
DV_PRIVATE_GUI_CACHE_HOME=1
DV_PRIVATE_GUI_HALF=0
# Disabled after a controls-flicker A/B test; the engine checks the pixels.
DV_PRIVATE_GUI_REVISION=0

# Settings > Player > Dolby Vision > Diagnostics (all off)
# Verify output: every k-th frame rendered again by the engine's reference route.
DVVK_VERIFY=0
# Frame timing log: Kodi's first-480-frame timing lines, the engine's deadline JSON.
DV_PRIVATE_FRAME_TIMING=0
DVVK_DEADLINE_TRACE=0
# GPU timing log: GPU time per engine pass over 120 frames.
DVVK_PROFILE=0
# Bounded GUI coverage readback (never during performance measurements).
DV_PRIVATE_GUI_COVERAGE=0
