+# Opt-in build wiring. Included from tools/dvbridge/CMakeLists.txt only when the
+# public standalone engine directory has been explicitly staged beside it.
+# This file never selects the runtime route or changes the default renderer.
+set(YB_NATIVE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/../native_engine")
+set(YB_NATIVE_EXPERIMENTAL "${YB_NATIVE_ROOT}/experimental")
+foreach(required IN ITEMS native_playback_context.c native_vaapi_gl_import.c
+    native_gpu_preparation.c native_gpu_ycc_backend.c)
+  if(NOT EXISTS "${YB_NATIVE_EXPERIMENTAL}/${required}")
+    message(FATAL_ERROR "Incomplete native playback candidate: ${required}")
+  endif()
+endforeach()
+set(YBLOD_BUILD_EXPERIMENTAL_PLAYBACK ON)
+set(BUILD_TESTING OFF)
+add_subdirectory("${YB_NATIVE_ROOT}" "${CMAKE_CURRENT_BINARY_DIR}/native-engine")
+foreach(pair IN ITEMS PREPARATION COMPOSER YCC)
+  if(pair STREQUAL "PREPARATION")
+    set(shader native_gpu_preparation_probe.comp)
+  elseif(pair STREQUAL "COMPOSER")
+    set(shader native_gpu_composer_backend.comp)
+  else()
+    set(shader native_gpu_reconstructed_ycc.comp)
+  endif()
+  file(READ "${YB_NATIVE_EXPERIMENTAL}/${shader}" YB_NATIVE_${pair})
+  string(FIND "${YB_NATIVE_${pair}}" ")YB_NATIVE\"" delimiter_collision)
+  if(NOT delimiter_collision EQUAL -1)
+    message(FATAL_ERROR "Native shader contains the C++ embedding delimiter")
+  endif()
+endforeach()
+configure_file("${CMAKE_CURRENT_SOURCE_DIR}/DVBridgeNativeShaders.h.in"
+  "${CMAKE_CURRENT_BINARY_DIR}/DVBridgeNativeShaders.h" @ONLY)
+target_include_directories(dvbridge_core PUBLIC "${CMAKE_CURRENT_BINARY_DIR}")
+target_link_libraries(dvbridge_core PUBLIC yblod_playback_native)
+target_compile_definitions(dvbridge_core PUBLIC HAVE_YBLOD_NATIVE_PLAYBACK=1)
