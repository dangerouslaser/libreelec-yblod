@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef DVBRIDGE_NATIVE_COLOUR_H
+#define DVBRIDGE_NATIVE_COLOUR_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+/* Caller-owned admission evidence, not an authentication token. Only the
+ * native VAAPI/P010 caller may construct this after native finish succeeds.
+ * No original BL/EL textures are represented or invented here. */
+struct dvbridge_native_colour_association {
+    unsigned version, width, height, enhancement_width, enhancement_height;
+    unsigned vaapi_p010_admitted, unrotated, reconstructed_depth;
+    int64_t bl_pts, el_pts;
+    int timebase_num, timebase_den;
+    uint8_t expected_frame_id[32], reconstructed_frame_id[32];
+    double presentation_pts, enhancement_presentation_pts;
+};
+static inline bool dvbridge_native_colour_association_valid(const struct dvbridge_native_colour_association *p)
+{
+    if (!p || p->version != 1 || !p->width || !p->height ||
+        p->width > 3840 || p->height > 2160 || ((p->width | p->height) & 1U) ||
+        !p->enhancement_width || !p->enhancement_height ||
+        p->enhancement_width > 3840 || p->enhancement_height > 2160 ||
+        p->vaapi_p010_admitted != 1 || p->unrotated != 1 || p->reconstructed_depth != 12 ||
+        p->bl_pts == INT64_MIN || p->el_pts == INT64_MIN || p->bl_pts != p->el_pts ||
+        p->timebase_num <= 0 || p->timebase_den <= 0 ||
+        !isfinite(p->presentation_pts) || !isfinite(p->enhancement_presentation_pts) ||
+        fabs(p->presentation_pts - p->enhancement_presentation_pts) >= 0.00001 ||
+        memcmp(p->expected_frame_id, p->reconstructed_frame_id, 32))
+        return false;
+    unsigned nonzero = 0;
+    for (unsigned i = 0; i < 32; ++i) nonzero |= p->expected_frame_id[i];
+    return nonzero != 0;
+}
+#endif
